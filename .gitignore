# fails the build if it does); developer keys live in $COSMO_KEYDIR.
*.key

# A developer-provided Linux kernel Image for the optional Linux boot test
# (docs/kernel-services/virtualization/testing.md). Not committed: it is
# 34 MB and someone else's binary. The test skips cleanly when absent.
tests/hv/aarch64/Image

# tools/sched-balance-probe.py snapshots (a run that was not reverted)
*.sched-balance-probe.orig

# tools/nettest-retry-probe.py snapshot (a run that was not reverted)
*.nettest-retry-probe.orig

