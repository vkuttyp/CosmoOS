# Shell completeness S3: process tools over /proc (docs/kernel-services/
# filesystem/procfs/api.md). /bin/ps and /bin/kill come before the native
# /sbin/ps and /sbin/kill in PATH.
ps
kill
# Shell completeness S4: ownership (fchownat and fchown in the Linux
# personality) and su, which needs PRIV_CRED to become another uid.
chown
chgrp
su
# Shell completeness S5: power and clock. reboot and halt signal init
# (SIGTERM, SIGUSR1) or, with -f, call reboot(2); hwclock reads and sets
# /dev/rtc0; ntpd -q steps the clock with settimeofday. Each change needs
# PRIV_SYS_ADMIN.
reboot
halt
hwclock
ntpd
# Shell completeness S6: mounting over the Linux mount(2) and umount2(2)
# doors, under PRIV_MOUNT; mount -a reads /etc/fstab (from /etc/rc).
# /bin/mount and /bin/umount come before the native /sbin/mount and
# /sbin/umount in PATH. BusyBox has no lsblk, and its blkid neither knows
# cosmofs nor prints PARTUUID: /sbin/lsblk and /sbin/blkid are native.
mount
umount
# Roadmap 1.2 A5: nice values (LX-13) over getpriority(2) and
# setpriority(2); ps -o nice shows them.
nice
renice
