+#if ENABLE_FEATURE_WGET_HTTPS
+/* CosmoOS: the ssl_client serving this connection, 0 for none. When it
+ * refused the server (a certificate, a handshake), it has said why and
+ * exited non-zero; wget then adds nothing, where it said "error getting
+ * response" with whatever errno an earlier call left (the resolver's
+ * EAGAIN, "Resource temporarily unavailable", for a URL with a name). */
+static pid_t ssl_client_pid;
+
+static void die_if_ssl_client_refused(void)
+{
+	int status;
+
+	if (ssl_client_pid > 0
+	 && safe_waitpid(ssl_client_pid, &status, 0) == ssl_client_pid
+	 && WIFEXITED(status) && WEXITSTATUS(status) != 0
+	) {
+		xfunc_die();
+	}
+}
+#else
+# define die_if_ssl_client_refused() ((void)0)
+#endif
+
