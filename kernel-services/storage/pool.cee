// pool.cee - The storage pool over one or more member block devices (kernel/include/kernel/storage.h;
// kernel-services/storage/README.md), in CeeSafe: roadmap 2.0 SA7. tests/host/test_pool.c holds it to the digest of the
// C it replaced.
//
// A block is named by a DVA (member, block). A member is a mirror group of one or more devices holding the same blocks
// at the same offsets, so the address does not change when a group gains a copy. Member 0 at block b is the same
// sector as the single-member pool always addressed, so a filesystem written before members existed reads back
// unchanged.
//
// Each copy has a state, and a copy that is not ONLINE has a record of the regions it missed
// (docs/kernel-services/filesystem/cosmofs/design.md, "Format version 13"). The pool keeps both in memory; the
// filesystem writes them into its own format.
//
// struct spool, its members and their copies stay C (storage.h): cosmofs reads and fills them. pool_floor.c keeps
// g_pool_fault_errors, the sysctl's C variable, and the module exports.

@header("kernel/blk.h", "kernel/kmalloc.h", "kernel/storage.h", "kernel/string.h")
extern "C" {
    struct blkdev {
        obj: kobject;
        name: [u8; 16];
        sector_size: u32;
        capacity: u64;
        gone: u32;
    }
    struct pool_copy {
        dev: *mut blkdev;
        sectors_per_block: u32;
        state: u32;
        whole: bool;
        since: u64;
        cursor: u64;
        read_errors: u32;
        write_errors: u32;
        csum_errors: u32;
        peer: u64;
        dirty: *mut u8;
    }
    struct spool_member {
        copy: [pool_copy; 4];
        ncopies: u32;
        nblocks: u64;
        region_blocks: u32;
        recent: *mut u8;
    }
    struct spool {
        m: *mut spool_member;
        nmembers: u32;
        cap: u32;
        block_size: u32;
        nblocks: u64;
        reads: u64;
        writes: u64;
        flushes: u64;
        epoch: u64;
        state_seq: u64;
        name: *CChar;
        notify: extern "C" fn(*mut void);
        notify_arg: *mut void;
        nspares: u32;
    }

    /// pool_floor.c: the address of g_pool_fault_errors (sysctl fs.fault_errors), read and written atomically.
    fn pool_floor_fault_errors() -> *mut u32;
    /// pool_floor.c: the address of the pool's spare slot `i` (struct blkdev *spare[POOL_MAX_SPARES]) and of its tag.
    fn pool_floor_spare(p: *mut spool, i: u32) -> *mut *mut blkdev;
    fn pool_floor_spare_tag(p: *mut spool, i: u32) -> *mut u64;
    fn blk_read(bd: *mut blkdev, sector: u64, nsectors: u32, buf: *mut void) -> i32;
    fn blk_write(bd: *mut blkdev, sector: u64, nsectors: u32, buf: *void) -> i32;
    fn blk_write_flags(bd: *mut blkdev, sector: u64, nsectors: u32, buf: *void, flags: u32) -> i32;
    fn blk_flush(bd: *mut blkdev) -> i32;
    fn kzalloc(size: usize) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    fn strlen(s: *CChar) -> usize;
}

// ---- errno.h, blk.h and storage.h values (asserted in tests/host/test_pool.c and pool_floor.c) ----

const EINVAL: i32 = 22;
const ENOSPC: i32 = 28;
const EEXIST: i32 = 17;
const ENODEV: i32 = 19;
const EIO: i32 = 5;
const ENOMEM: i32 = 12;
const EAGAIN: i32 = 11;
const EBUSY: i32 = 16;
const ENOENT: i32 = 2;
const BIO_PREFLUSH: u32 = 1;
const BIO_FUA: u32 = 2;
const POOL_BLOCK: u32 = 4096;
const POOL_MAX_MEMBERS: u32 = 255;
const POOL_MAX_COPIES: u32 = 4;
const POOL_MAX_SPARES: u32 = 4;
const POOL_WRITE_ONLINE: u32 = 0x80000000;
const POOL_DVA_SHIFT: u64 = 56;
const POOL_DVA_BLK_MASK: u64 = 0x00FFFFFFFFFFFFFF;
const POOL_DIRTY_BYTES: usize = 944;
const POOL_DIRTY_BITS: u64 = 7552;
const ONLINE: u32 = 0;
const MISSING: u32 = 1;
const OFFLINE: u32 = 2;
const FAULTED: u32 = 3;
const RESILVERING: u32 = 4;
const NSTATES: u32 = 5;
/// The stack slot a copy is swapped through, in words (checked against its C size).
const COPY_WORDS: usize = 16;

// ---- The C state, through its addresses ----

/// Member `v` of the pool.
/// Safety: `p` is a pool and `v` below its `cap`.
unsafe fn memberAt(p: *mut spool, v: u32) -> *mut spool_member => Ptr.toBorrow(p as *spool).m.add(v as usize);

/// Copy slot `c` of a member.
/// Safety: `m` is a member; `c` below POOL_MAX_COPIES (the index is checked).
unsafe fn copyAt(m: *mut spool_member, c: u32) -> *mut pool_copy =>
    borrow mut Ptr.toBorrowMut(m).copy[c as usize] as *mut pool_copy;

/// Safety: `p` is a pool.
unsafe fn members(p: *mut spool) -> u32 => Ptr.toBorrow(p as *spool).nmembers;

/// Safety: `m` is a member.
unsafe fn ncopies(m: *mut spool_member) -> u32 => Ptr.toBorrow(m as *spool_member).ncopies;

/// Safety: `cp` is a copy slot.
unsafe fn stateOf(cp: *mut pool_copy) -> u32 => Ptr.toBorrow(cp as *pool_copy).state;

/// Safety: `cp` is a copy slot.
unsafe fn devOf(cp: *mut pool_copy) -> *mut blkdev => Ptr.toBorrow(cp as *pool_copy).dev;

/// Safety: `cp` is a copy slot.
unsafe fn dirtyOf(cp: *mut pool_copy) -> *mut u8 => Ptr.toBorrow(cp as *pool_copy).dirty;

/// The sysctl's failure count, read as the C read it.
/// Safety: pool_floor_fault_errors returns the address of a static uint32_t.
unsafe fn faultErrors() -> u32 =>
    Ptr.toBorrow(pool_floor_fault_errors() as *AtomicU32).loadWith(LoadOrdering.Relaxed);

/// Safety: `bd` is a blkdev.
unsafe fn blkdevGet(bd: *mut blkdev) { kobject_get(borrow mut Ptr.toBorrowMut(bd).obj as *mut kobject); }

/// Safety: `bd` is a blkdev the caller holds a reference on, which this drops.
unsafe fn blkdevPut(bd: *mut blkdev) { kobject_put(borrow mut Ptr.toBorrowMut(bd).obj as *mut kobject); }

/// Safety: `bd` is a blkdev.
unsafe fn goneOf(bd: *mut blkdev) -> bool =>
    Ptr.toBorrow(borrow mut Ptr.toBorrowMut(bd).gone as *mut u32 as *AtomicU32).loadWith(LoadOrdering.Relaxed) != 0;

/// The member a DVA names.
fn dvaVdev(dva: u64) -> u32 => truncate<u32>(dva >> POOL_DVA_SHIFT);

/// The block within it.
fn dvaBlk(dva: u64) -> u64 => dva & POOL_DVA_BLK_MASK;

// ---- The bitmaps: POOL_DIRTY_BYTES bytes, a bit per region ----

/// Bit `r` of a bitmap.
/// Safety: `bits` is a bitmap; `r` below POOL_DIRTY_BITS.
unsafe fn bitSet(bits: *mut u8, r: u64) -> bool =>
    ((bits.add(truncate<usize>(r / 8)).read() as u32 >> truncate<u32>(r % 8)) & 1) != 0;

/// Safety: as bitSet.
unsafe fn bitMark(bits: *mut u8, r: u64) {
    let q = bits.add(truncate<usize>(r / 8));
    q.write(q.read() | truncate<u8>(1u32 << truncate<u32>(r % 8)));
}

/// Safety: as bitSet.
unsafe fn bitClear(bits: *mut u8, r: u64) {
    let q = bits.add(truncate<usize>(r / 8));
    q.write(q.read() & truncate<u8>((1u32 << truncate<u32>(r % 8)) ^ 0xFF));
}

/// Safety: `bits` is a bitmap.
unsafe fn anyByte(bits: *mut u8) -> bool {
    for (i in 0..POOL_DIRTY_BYTES) {
        if (bits.add(i).read() != 0) {
            return true;
        }
    }
    return false;
}

/// Safety: `bits` is a bitmap.
unsafe fn bitsZero(bits: *mut u8) { memset(bits as *mut void, 0, POOL_DIRTY_BYTES); }

/// `dst |= src`, byte by byte.
/// Safety: both are bitmaps.
unsafe fn bitsOr(dst: *mut u8, src: *mut u8) {
    for (i in 0..POOL_DIRTY_BYTES) {
        let q = dst.add(i);
        q.write(q.read() | src.add(i).read());
    }
}

// ---- Names ----

/// storage.h's pool_copy_state_name.
@export("pool_copy_state_name")
fn copyStateName(s: u32) -> *CChar {
    let name = match (s) {
        0 => "ONLINE\0",
        1 => "MISSING\0",
        2 => "OFFLINE\0",
        3 => "FAULTED\0",
        4 => "RESILVERING\0",
        _ => "?\0",
    };
    return name.ptr as *CChar;
}

// ---- What a copy may do ----

/// The member and offset a DVA names, or null when it names neither.
/// Safety: `p` is a pool.
unsafe fn memberOf(p: *mut spool, dva: u64, blk: borrow mut u64) -> *mut spool_member {
    let v = dvaVdev(dva);
    if (v >= members(p)) {
        return 0 as *mut spool_member;
    }
    let b = dvaBlk(dva);
    let m = memberAt(p, v);
    if (b >= Ptr.toBorrow(m as *spool_member).nblocks) {
        return 0 as *mut spool_member;
    }
    blk = b;
    return m;
}

/// Safety: `cp` is a copy slot.
unsafe fn readable(cp: *mut pool_copy) -> bool => !devOf(cp).isNull() && stateOf(cp) == ONLINE;

/// Safety: `cp` is a copy slot.
unsafe fn writable(cp: *mut pool_copy) -> bool {
    let s = stateOf(cp);
    return !devOf(cp).isNull() && (s == ONLINE || s == RESILVERING);
}

/// A hole: a block this ONLINE copy failed to take while another copy took it (its bit in the copy's bitmap). Not
/// read from until rebuilt.
/// Safety: `cp` is a copy slot of `m`.
unsafe fn hole(m: *mut spool_member, cp: *mut pool_copy, blk: u64) -> bool {
    let d = dirtyOf(cp);
    if (d.isNull()) {
        return false;
    }
    let r = blk / Ptr.toBorrow(m as *spool_member).region_blocks as u64;
    return r < POOL_DIRTY_BITS && bitSet(d, r);
}

/// Safety: as hole.
unsafe fn readableAt(m: *mut spool_member, cp: *mut pool_copy, blk: u64) -> bool =>
    readable(cp) && !hole(m, cp, blk);

/// Safety: `cp` is a copy slot.
unsafe fn anyBit(cp: *mut pool_copy) -> bool {
    let d = dirtyOf(cp);
    return !d.isNull() && anyByte(d);
}

/// Safety: `m` is a member.
unsafe fn onlineCopies(m: *mut spool_member) -> u32 {
    var n: u32 = 0;
    for (c in 0u32..ncopies(m)) {
        if (readable(copyAt(m, c))) {
            n += 1;
        }
    }
    return n;
}

/// Safety: `bits` is a bitmap of `m`.
unsafe fn regionSet(bits: *mut u8, m: *mut spool_member, blk: u64) {
    var r = blk / Ptr.toBorrow(m as *spool_member).region_blocks as u64;
    if (r >= POOL_DIRTY_BITS) {
        r = POOL_DIRTY_BITS - 1; // cannot happen: region_blocks covers nblocks
    }
    bitMark(bits, r);
}

/// Blocks per dirty bit: POOL_DIRTY_BITS regions cover the member.
fn regionBlocksFor(nblocks: u64) -> u32 {
    let r = nblocks.wrappingAdd(POOL_DIRTY_BITS - 1) / POOL_DIRTY_BITS;
    return if (r != 0) truncate<u32>(r) else 1;
}

/// The bitmaps a member needs once it has a second slot: one per copy and the since-the-last-root one.
/// Safety: `m` is a member.
unsafe fn memberBitmaps(m: *mut spool_member) -> i32 {
    let mm = Ptr.toBorrowMut(m);
    if (mm.recent.isNull()) {
        let recent = kzalloc(POOL_DIRTY_BYTES) as *mut u8;
        if (recent.isNull()) {
            return -ENOMEM;
        }
        mm.recent = recent;
    }
    for (c in 0u32..ncopies(m)) {
        let cp = Ptr.toBorrowMut(copyAt(m, c));
        if (cp.dirty.isNull()) {
            let dirty = kzalloc(POOL_DIRTY_BYTES) as *mut u8;
            if (dirty.isNull()) {
                return -ENOMEM;
            }
            cp.dirty = dirty;
        }
    }
    return 0;
}

/// A sector size the pool block is a whole number of.
/// Safety: `bd` is null or a blkdev.
unsafe fn sectorsOk(bd: *mut blkdev) -> bool {
    if (bd.isNull()) {
        return false;
    }
    let size = Ptr.toBorrow(bd as *blkdev).sector_size;
    return size != 0 && POOL_BLOCK % size == 0;
}

/// Safety: `cp` is a copy slot without a device; `bd` null or a blkdev.
unsafe fn attach(cp: *mut pool_copy, bd: *mut blkdev) -> i32 {
    if (!sectorsOk(bd)) {
        return -EINVAL;
    }
    blkdevGet(bd);
    let spb = POOL_BLOCK / Ptr.toBorrow(bd as *blkdev).sector_size;
    let c = Ptr.toBorrowMut(cp);
    c.dev = bd;
    c.sectors_per_block = spb;
    return 0;
}

/// storage.h's pool_add_member.
/// Safety: `p` is a pool the caller serialises; `bd` null or a blkdev; `vdev` null or writable.
@export("pool_add_member")
unsafe fn addMember(p: *mut spool, bd: *mut blkdev, vdev: *mut u32) -> i32 {
    let n = members(p);
    if (n >= POOL_MAX_MEMBERS) {
        return -ENOSPC;
    }
    let size = layoutOf<spool_member>().size;
    if (n == Ptr.toBorrow(p as *spool).cap) {
        let was = Ptr.toBorrow(p as *spool).cap;
        var cap = if (was != 0) was * 2 else 1;
        if (cap > POOL_MAX_MEMBERS) {
            cap = POOL_MAX_MEMBERS;
        }
        let grown = kzalloc(cap as usize * size) as *mut spool_member;
        if (grown.isNull()) {
            return -ENOMEM;
        }
        let old = Ptr.toBorrow(p as *spool).m;
        if (!old.isNull()) {
            memcpy(grown as *mut void, old as *void, n as usize * size);
        }
        kfree(old as *mut void);
        let pp = Ptr.toBorrowMut(p);
        pp.m = grown;
        pp.cap = cap;
    }
    let m = memberAt(p, n);
    let first = copyAt(m, 0);
    let rc = attach(first, bd);
    if (rc != 0) {
        return rc;
    }
    let blocks = Ptr.toBorrow(bd as *blkdev).capacity / Ptr.toBorrow(first as *pool_copy).sectors_per_block as u64;
    let mm = Ptr.toBorrowMut(m);
    mm.ncopies = 1;
    mm.nblocks = blocks;
    mm.region_blocks = regionBlocksFor(blocks);
    let pp = Ptr.toBorrowMut(p);
    pp.nmembers = n + 1;
    if (n == 0) {
        pp.nblocks = blocks;
    }
    if (!vdev.isNull()) {
        vdev.write(n);
    }
    return 0;
}

/// A copy must cover the group's blocks. A larger device is allowed and its tail is unused: the group's size is
/// decided by the member table, not by whichever disk happens to be biggest.
/// Safety: `m` is a member; `bd` null or a blkdev.
unsafe fn fits(m: *mut spool_member, bd: *mut blkdev) -> i32 {
    if (!sectorsOk(bd)) {
        return -EINVAL;
    }
    let d = Ptr.toBorrow(bd as *blkdev);
    let blocks = d.capacity / (POOL_BLOCK / d.sector_size) as u64;
    if (blocks < Ptr.toBorrow(m as *spool_member).nblocks) {
        return -EINVAL;
    }
    return 0;
}

/// storage.h's pool_add_copy.
/// Safety: as addMember.
@export("pool_add_copy")
unsafe fn addCopy(p: *mut spool, vdev: u32, bd: *mut blkdev) -> i32 {
    if (vdev >= members(p)) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let n = ncopies(m);
    if (n >= POOL_MAX_COPIES) {
        return -ENOSPC;
    }
    var rc = fits(m, bd);
    if (rc != 0) {
        return rc;
    }
    let member = Ptr.toBorrowMut(m);
    member.ncopies = n + 1;
    rc = memberBitmaps(m);
    if (rc == 0) {
        rc = attach(copyAt(m, n), bd);
    }
    if (rc != 0) {
        member.ncopies = n;
        return rc;
    }
    let r = Ptr.toBorrowMut(copyAt(m, n));
    r.state = ONLINE;
    return 0;
}

/// storage.h's pool_set_copies.
/// Safety: `p` is a pool the caller serialises.
@export("pool_set_copies")
unsafe fn setCopies(p: *mut spool, vdev: u32, n: u32) -> i32 {
    if (vdev >= members(p) || n == 0 || n > POOL_MAX_COPIES) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let was = ncopies(m);
    if (n < was) {
        return -EINVAL; // slots are only added here; a detach is its own operation
    }
    let member = Ptr.toBorrowMut(m);
    member.ncopies = n;
    if (n > 1) {
        let rc = memberBitmaps(m);
        if (rc != 0) {
            // The slots it did not get: their bitmaps too, which nothing past ncopies would free.
            for (c in was..n) {
                let cp = Ptr.toBorrowMut(copyAt(m, c));
                kfree(cp.dirty as *mut void);
                cp.dirty = 0 as *mut u8;
            }
            member.ncopies = was;
            return rc;
        }
    }
    for (c in was..n) {
        let cp = Ptr.toBorrowMut(copyAt(m, c));
        cp.state = MISSING;
        cp.whole = true; // nobody knows what it missed
        cp.since = 0;
    }
    if (n > was) {
        let pp = Ptr.toBorrowMut(p);
        pp.state_seq = pp.state_seq.wrappingAdd(1);
    }
    return 0;
}

/// storage.h's pool_attach_copy.
/// Safety: as addMember.
@export("pool_attach_copy")
unsafe fn attachCopy(p: *mut spool, vdev: u32, c: u32, bd: *mut blkdev, state: u32) -> i32 {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev)) || state >= NSTATES) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let cp = copyAt(m, c);
    if (!devOf(cp).isNull()) {
        return -EBUSY;
    }
    var rc = fits(m, bd);
    if (rc == 0) {
        rc = attach(cp, bd);
    }
    if (rc != 0) {
        return rc;
    }
    if (stateOf(cp) != state) {
        let pp = Ptr.toBorrowMut(p);
        pp.state_seq = pp.state_seq.wrappingAdd(1);
    }
    let slot = Ptr.toBorrowMut(cp);
    slot.state = state;
    return 0;
}

/// storage.h's pool_swap_copies: the two slots' bytes, through a stack slot.
/// Safety: `p` is a pool the caller serialises.
@export("pool_swap_copies")
unsafe fn swapCopies(p: *mut spool, vdev: u32, a: u32, b: u32) {
    if (vdev >= members(p) || a == b || a >= ncopies(memberAt(p, vdev)) || b >= ncopies(memberAt(p, vdev))) {
        return;
    }
    let size = layoutOf<pool_copy>().size;
    if (size > COPY_WORDS * 8) {
        return; // pool_floor.c asserts that it fits
    }
    let m = memberAt(p, vdev);
    var slot = [0u64; 16];
    let t = borrow mut slot as *mut [u64; 16] as *mut void;
    memcpy(t, copyAt(m, a) as *void, size);
    memcpy(copyAt(m, a) as *mut void, copyAt(m, b) as *void, size);
    memcpy(copyAt(m, b) as *mut void, t as *void, size);
}

/// storage.h's pool_copies.
/// Safety: `p` is a pool.
@export("pool_copies")
unsafe fn copies(p: *spool, dva: u64) -> u32 {
    let v = dvaVdev(dva);
    let pm = p as *mut spool;
    return if (v < members(pm)) ncopies(memberAt(pm, v)) else 0;
}

/// storage.h's pool_copy_readable.
/// Safety: `p` is a pool.
@export("pool_copy_readable")
unsafe fn copyReadable(p: *spool, dva: u64, c: u32) -> bool {
    let pm = p as *mut spool;
    let v = dvaVdev(dva);
    let blk = dvaBlk(dva);
    if (v >= members(pm)) {
        return false;
    }
    let m = memberAt(pm, v);
    return c < ncopies(m) && blk < Ptr.toBorrow(m as *spool_member).nblocks && readableAt(m, copyAt(m, c), blk);
}

/// storage.h's pool_copy_online.
/// Safety: `p` is a pool.
@export("pool_copy_online")
unsafe fn copyOnline(p: *spool, vdev: u32, c: u32) -> bool {
    let pm = p as *mut spool;
    return vdev < members(pm) && c < ncopies(memberAt(pm, vdev)) && readable(copyAt(memberAt(pm, vdev), c));
}

/// storage.h's pool_member_degraded. A copy out, or an ONLINE one with holes: either way the member is not whole, and
/// its record is kept (design.md, "Degraded operation").
/// Safety: `p` is a pool.
@export("pool_member_degraded")
unsafe fn memberDegraded(p: *spool, vdev: u32) -> bool {
    let pm = p as *mut spool;
    if (vdev >= members(pm)) {
        return false;
    }
    let m = memberAt(pm, vdev);
    let n = ncopies(m);
    for (c in 0u32..n) {
        let cp = copyAt(m, c);
        if (!readable(cp) || (n > 1 && anyBit(cp))) {
            return true;
        }
    }
    return false;
}

/// storage.h's pool_set_member_blocks.
/// Safety: `p` is a pool the caller serialises.
@export("pool_set_member_blocks")
unsafe fn setMemberBlocks(p: *mut spool, vdev: u32, nblocks: u64) {
    if (vdev >= members(p) || nblocks == 0 || nblocks > Ptr.toBorrow(memberAt(p, vdev) as *spool_member).nblocks) {
        return;
    }
    let m = Ptr.toBorrowMut(memberAt(p, vdev));
    m.nblocks = nblocks;
    m.region_blocks = regionBlocksFor(nblocks);
    if (vdev == 0) {
        let pool = Ptr.toBorrowMut(p);
        pool.nblocks = nblocks;
    }
}

/// storage.h's pool_degraded.
/// Safety: `p` is a pool.
@export("pool_degraded")
unsafe fn degraded(p: *spool) -> bool {
    for (v in 0u32..members(p as *mut spool)) {
        if (memberDegraded(p, v)) {
            return true;
        }
    }
    return false;
}

/// storage.h's pool_open.
/// Safety: `bd` null or a blkdev; `out` writable.
@export("pool_open")
unsafe fn open(bd: *mut blkdev, out: *mut *mut spool) -> i32 {
    let p = kzalloc(layoutOf<spool>().size) as *mut spool;
    if (p.isNull()) {
        return -ENOMEM;
    }
    let pool = Ptr.toBorrowMut(p);
    pool.block_size = POOL_BLOCK;
    let rc = addMember(p, bd, 0 as *mut u32);
    if (rc != 0) {
        kfree(Ptr.toBorrow(p as *spool).m as *mut void);
        kfree(p as *mut void);
        return rc;
    }
    out.write(p);
    return 0;
}

/// storage.h's pool_close.
/// Safety: `p` is a pool nobody else uses; it is freed.
@export("pool_close")
unsafe fn close(p: *mut spool) {
    for (v in 0u32..members(p)) {
        let m = memberAt(p, v);
        for (c in 0u32..ncopies(m)) {
            let cp = copyAt(m, c);
            if (!devOf(cp).isNull()) {
                blkdevPut(devOf(cp));
            }
            kfree(dirtyOf(cp) as *mut void);
        }
        kfree(Ptr.toBorrow(m as *spool_member).recent as *mut void);
    }
    for (i in 0u32..Ptr.toBorrow(p as *spool).nspares) {
        blkdevPut(pool_floor_spare(p, i).read());
    }
    kfree(Ptr.toBorrow(p as *spool).m as *mut void);
    kfree(p as *mut void);
}

// ---- The console lines ----

/// A C string, appended.
/// Safety: `s` is a C string.
unsafe fn cText(line: borrow mut TextWriter, s: *CChar) { line.bytes(Slice.fromRaw(s as *u8, strlen(s))); }

/// "pool: <name>: member <vdev> copy <c> (<device>) ", the start of every line.
/// Safety: `p` is a pool; `bd` null or a blkdev.
unsafe fn lineStart(line: borrow mut TextWriter, p: *mut spool, vdev: u32, c: u32, bd: *mut blkdev) {
    line.text("pool: ");
    let name = Ptr.toBorrow(p as *spool).name;
    if (!name.isNull()) {
        cText(mut line, name);
        line.text(": ");
    }
    line.text("member ");
    line.decimal(vdev as u64);
    line.text(" copy ");
    line.decimal(c as u64);
    line.text(" (");
    if (bd.isNull()) {
        line.text("no device");
    } else {
        cText(mut line, borrow mut Ptr.toBorrowMut(bd).name as *mut [u8; 16] as *CChar);
    }
    line.text(") ");
}

/// Safety: `p` is a pool.
unsafe fn memberWord(p: *mut spool, vdev: u32) -> StringView =>
    if (memberDegraded(p as *spool, vdev)) "degraded" else "whole";

/// Safety: `p` is a pool.
unsafe fn changed(p: *mut spool) {
    let pp = Ptr.toBorrowMut(p);
    pp.state_seq = pp.state_seq.wrappingAdd(1);
    let notify = pp.notify;
    let arg = pp.notify_arg;
    if (!notify.isNull()) {
        notify(arg);
    }
}

// ---- Copy states ----

/// storage.h's pool_copy_set_state.
/// Safety: `p` is a pool the caller serialises.
@export("pool_copy_set_state")
unsafe fn copySetState(p: *mut spool, vdev: u32, c: u32, state: u32, why: i32) -> i32 {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev)) || state >= NSTATES) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let cp = copyAt(m, c);
    let was = stateOf(cp);
    if (was == state) {
        return 0;
    }
    if (state == OFFLINE && readable(cp) && onlineCopies(m) == 1) {
        return -EBUSY; // the operator may not take the last copy away
    }
    let epoch = Ptr.toBorrow(p as *spool).epoch;
    if (state == ONLINE) {
        // Only a copy that missed nothing: anything else is a resilver.
        if (devOf(cp).isNull()) {
            return -ENODEV;
        }
        let k = Ptr.toBorrow(cp as *pool_copy);
        if (k.whole || k.since != epoch) {
            return -EAGAIN;
        }
        if (anyBit(cp)) {
            return -EAGAIN;
        }
    }
    if (was == ONLINE) {
        // From here it misses writes. Whatever reached it since the last root may be only in its cache, so that is
        // added to the holes it already had.
        let k = Ptr.toBorrowMut(cp);
        k.since = epoch;
        k.whole = false;
        let recent = Ptr.toBorrow(m as *spool_member).recent;
        if (!dirtyOf(cp).isNull() && !recent.isNull()) {
            bitsOr(dirtyOf(cp), recent);
        }
    }
    if (state == ONLINE && !dirtyOf(cp).isNull()) {
        bitsZero(dirtyOf(cp));
    }
    let slot = Ptr.toBorrowMut(cp);
    slot.state = state;
    changed(p);
    var buffer = [0u8; 192];
    var line = TextWriter.create(mut buffer[..]);
    lineStart(mut line, p, vdev, c, devOf(cp));
    cText(mut line, copyStateName(state));
    if (why != 0) {
        line.text(" (");
        line.signed(why as i64);
        line.text(")");
    } else {
        line.text(", was ");
        cText(mut line, copyStateName(was));
    }
    line.text(": the member is ");
    line.text(memberWord(p, vdev));
    KernelLog.send(LogLevel.Warn, line);
    return 0;
}

/// One failure on copy `c`: -ENODEV takes it out at once, anything else counts towards FAULTED -- but never the
/// member's last ONLINE copy, which is still the best there is.
/// Safety: `p` is a pool the caller serialises; `vdev` and `c` name a slot.
unsafe fn copyFailed(p: *mut spool, vdev: u32, c: u32, rc: i32) {
    let m = memberAt(p, vdev);
    let cp = copyAt(m, c);
    if (rc == -ENODEV) {
        let _ = copySetState(p, vdev, c, MISSING, rc);
        return;
    }
    let limit = faultErrors();
    let k = Ptr.toBorrow(cp as *pool_copy);
    let total = k.read_errors.wrappingAdd(k.write_errors);
    if (limit == 0 || total <= limit || k.state == FAULTED) {
        return;
    }
    if (k.state == ONLINE && onlineCopies(m) == 1) {
        return;
    }
    let _ = copySetState(p, vdev, c, FAULTED, rc);
}

/// storage.h's pool_copy_csum_error. Counted, and not towards FAULTED: a copy that answers with the wrong bytes is one
/// read repair and the scrub put right, and a faulted copy is one they could no longer write to.
/// Safety: `p` is a pool the caller serialises.
@export("pool_copy_csum_error")
unsafe fn copyCsumError(p: *mut spool, dva: u64, c: u32) {
    let v = dvaVdev(dva);
    if (v >= members(p) || c >= ncopies(memberAt(p, v))) {
        return;
    }
    let k = Ptr.toBorrowMut(copyAt(memberAt(p, v), c));
    k.csum_errors = k.csum_errors.wrappingAdd(1);
}

/// storage.h's pool_mark_missed.
/// Safety: `p` is a pool the caller serialises.
@export("pool_mark_missed")
unsafe fn markMissed(p: *mut spool, dva: u64) {
    var blk: u64 = 0;
    let m = memberOf(p, dva, mut blk);
    if (m.isNull()) {
        return;
    }
    for (c in 0u32..ncopies(m)) {
        let cp = copyAt(m, c);
        if (!writable(cp) && !dirtyOf(cp).isNull()) {
            regionSet(dirtyOf(cp), m, blk);
        }
    }
}

/// storage.h's pool_copy_missed.
/// Safety: `p` is a pool.
@export("pool_copy_missed")
unsafe fn copyMissed(p: *spool, dva: u64, c: u32) -> bool {
    let pm = p as *mut spool;
    let v = dvaVdev(dva);
    let blk = dvaBlk(dva);
    if (v >= members(pm)) {
        return false;
    }
    let m = memberAt(pm, v);
    if (c >= ncopies(m) || blk >= Ptr.toBorrow(m as *spool_member).nblocks) {
        return false;
    }
    let cp = copyAt(m, c);
    if (Ptr.toBorrow(cp as *pool_copy).whole) {
        return true;
    }
    let d = dirtyOf(cp);
    if (d.isNull()) {
        return false;
    }
    return bitSet(d, blk / Ptr.toBorrow(m as *spool_member).region_blocks as u64);
}

/// storage.h's pool_commit_done.
/// Safety: `p` is a pool the caller serialises.
@export("pool_commit_done")
unsafe fn commitDone(p: *mut spool, gen: u64) {
    let pool = Ptr.toBorrowMut(p);
    pool.epoch = gen;
    for (v in 0u32..members(p)) {
        let recent = Ptr.toBorrow(memberAt(p, v) as *spool_member).recent;
        if (!recent.isNull()) {
            bitsZero(recent);
        }
    }
}

// ---- I/O ----

/// Safety: `p` is a pool the caller serialises; `v` and `c` name a slot with a device; `buf` a pool block.
unsafe fn readOne(p: *mut spool, v: u32, blk: u64, c: u32, buf: *mut void) -> i32 {
    let cp = copyAt(memberAt(p, v), c);
    let pp = Ptr.toBorrowMut(p);
    pp.reads = pp.reads.wrappingAdd(1);
    let spb = Ptr.toBorrow(cp as *pool_copy).sectors_per_block;
    let rc = blk_read(devOf(cp), blk.wrappingMul(spb as u64), spb, buf);
    if (rc != 0) {
        let k = Ptr.toBorrowMut(cp);
        k.read_errors = k.read_errors.wrappingAdd(1);
        copyFailed(p, v, c, rc);
    }
    // A device that went away during the I/O is the copy's state now (MISSING); to the caller it is an I/O error like
    // any other (CF26): -ENODEV from the pool means "that copy may not be read".
    return if (rc == -ENODEV) -EIO else rc;
}

/// storage.h's pool_read_copy.
/// Safety: `p` is a pool the caller serialises; `buf` a DMA-able pool block.
@export("pool_read_copy")
unsafe fn readCopy(p: *mut spool, dva: u64, copy: u32, buf: *mut void) -> i32 {
    var blk: u64 = 0;
    let m = memberOf(p, dva, mut blk);
    if (m.isNull() || copy >= ncopies(m)) {
        return -EINVAL;
    }
    if (!readableAt(m, copyAt(m, copy), blk)) {
        return -ENODEV;
    }
    return readOne(p, dvaVdev(dva), blk, copy, buf);
}

/// A write that did not reach copy `c`: its region is one the copy missed. An ONLINE copy's are holes, set by the
/// writer only when another copy took the block (pool_write_flags): one leaving ONLINE adds the regions written since
/// the last root, which include this one.
/// Safety: `m` is a member; `c` one of its slots.
unsafe fn missed(m: *mut spool_member, c: u32, blk: u64) {
    let cp = copyAt(m, c);
    if (!dirtyOf(cp).isNull() && stateOf(cp) != ONLINE) {
        regionSet(dirtyOf(cp), m, blk);
    }
}

/// Safety: as readOne, with `buf` read.
unsafe fn writeOne(p: *mut spool, v: u32, blk: u64, c: u32, buf: *void, flags: u32) -> i32 {
    let m = memberAt(p, v);
    let cp = copyAt(m, c);
    let pp = Ptr.toBorrowMut(p);
    pp.writes = pp.writes.wrappingAdd(1);
    if ((flags & BIO_PREFLUSH) != 0) {
        pp.flushes = pp.flushes.wrappingAdd(1);
    }
    if ((flags & BIO_FUA) != 0) {
        pp.flushes = pp.flushes.wrappingAdd(1);
    }
    let spb = Ptr.toBorrow(cp as *pool_copy).sectors_per_block;
    let sector = blk.wrappingMul(spb as u64);
    let rc = if (flags != 0) blk_write_flags(
        devOf(cp),
        sector,
        spb,
        buf,
        flags,
    ) else blk_write(devOf(cp), sector, spb, buf);
    if (rc != 0) {
        let k = Ptr.toBorrowMut(cp);
        k.write_errors = k.write_errors.wrappingAdd(1);
        missed(m, c, blk);
        copyFailed(p, v, c, rc);
    }
    return if (rc == -ENODEV) -EIO else rc; // as readOne
}

/// storage.h's pool_write_copy.
/// Safety: `p` is a pool the caller serialises; `buf` a DMA-able pool block.
@export("pool_write_copy")
unsafe fn writeCopy(p: *mut spool, dva: u64, copy: u32, buf: *void) -> i32 {
    var blk: u64 = 0;
    let m = memberOf(p, dva, mut blk);
    if (m.isNull() || copy >= ncopies(m)) {
        return -EINVAL;
    }
    let cp = copyAt(m, copy);
    if (!writable(cp)) {
        return -ENODEV;
    }
    let wasOnline = stateOf(cp) == ONLINE;
    let rc = writeOne(p, dvaVdev(dva), blk, copy, buf, 0);
    // A repair that did not take: the copy still lacks the block, and another copy has it (it is what the repair was
    // from).
    if (rc != 0 && wasOnline && stateOf(cp) == ONLINE && onlineCopies(m) > 1 && !dirtyOf(cp).isNull()) {
        regionSet(dirtyOf(cp), m, blk);
    }
    return rc;
}

/// storage.h's pool_read: the first ONLINE copy that answers.
/// Safety: as readCopy.
@export("pool_read")
unsafe fn read(p: *mut spool, dva: u64, buf: *mut void) -> i32 {
    var blk: u64 = 0;
    let m = memberOf(p, dva, mut blk);
    if (m.isNull()) {
        return -EINVAL;
    }
    var first: i32 = 0;
    for (c in 0u32..ncopies(m)) {
        if (!readableAt(m, copyAt(m, c), blk)) {
            continue;
        }
        let rc = readOne(p, dvaVdev(dva), blk, c, buf);
        if (rc == 0) {
            return 0;
        }
        if (first == 0) {
            first = rc;
        }
    }
    return if (first != 0) first else -EIO;
}

/// storage.h's pool_write_flags.
///
/// Every writable copy, and every one is attempted even after a failure: a device that refuses one write is not a
/// reason to leave the others holding an older block. A copy that does not take it -- not writable, or failed -- has
/// the block's region recorded as missed. The write succeeds when an ONLINE copy took it (design.md, "Degraded
/// operation"); otherwise the caller is inside a transaction that has not published a root, so a write that reached no
/// good copy is never something a later mount can find.
/// Safety: as writeCopy.
@export("pool_write_flags")
unsafe fn writeFlags(p: *mut spool, dva: u64, buf: *void, flags: u32) -> i32 {
    var blk: u64 = 0;
    let m = memberOf(p, dva, mut blk);
    if (m.isNull()) {
        return -EINVAL;
    }
    let v = dvaVdev(dva);
    let onlineOnly = (flags & POOL_WRITE_ONLINE) != 0;
    let bioFlags = flags & (POOL_WRITE_ONLINE ^ 0xFFFFFFFF);
    let recent = Ptr.toBorrow(m as *spool_member).recent;
    if (!recent.isNull()) {
        regionSet(recent, m, blk);
    }
    var first: i32 = 0;
    var landed = false;
    var failedOnline = [false; 4];
    for (c in 0u32..ncopies(m)) {
        let cp = copyAt(m, c);
        if (!writable(cp)) {
            missed(m, c, blk);
            continue;
        }
        // The root, skipped on purpose for a copy being rebuilt: not a block it missed -- the resilver copies the
        // superblock slots last, when the copy holds everything they name.
        if (onlineOnly && !readable(cp)) {
            continue;
        }
        let wasOnline = stateOf(cp) == ONLINE;
        let rc = writeOne(p, v, blk, c, buf, bioFlags);
        if (rc == 0 && wasOnline) {
            landed = true;
        } else if (rc != 0 && wasOnline) {
            failedOnline[c as usize] = true;
        }
        if (rc != 0 && first == 0) {
            first = rc;
        }
    }
    if (!landed) {
        return if (first != 0) first else -EIO;
    }
    // An ONLINE copy that failed it, below its fault count: still ONLINE, and holding the old block. That is a hole,
    // recorded and not read from until it is rebuilt -- forgetting it would let the copy serve the stale block, or come
    // back from a later fault as if it held it. Only when another copy took the write: with none, the write failed and
    // nothing will name the block.
    for (c in 0u32..ncopies(m)) {
        let cp = copyAt(m, c);
        if (failedOnline[c as usize] && stateOf(cp) == ONLINE && !dirtyOf(cp).isNull()) {
            regionSet(dirtyOf(cp), m, blk);
        }
    }
    return 0;
}

/// storage.h's pool_write.
/// Safety: as writeCopy.
@export("pool_write")
unsafe fn write(p: *mut spool, dva: u64, buf: *void) -> i32 => writeFlags(p, dva, buf, 0);

/// storage.h's pool_flush.
///
/// Every writable copy of every member. A copy whose flush fails has missed everything since the last root -- which
/// is what its bitmap starts from when it leaves ONLINE -- so it is taken out: MISSING for -ENODEV, FAULTED otherwise,
/// except a member's last ONLINE copy. The flush succeeds for a member when an ONLINE copy flushed: a commit durable on
/// one device of a member is durable, and on none is not.
/// Safety: `p` is a pool the caller serialises.
@export("pool_flush")
unsafe fn flush(p: *mut spool) -> i32 {
    var first: i32 = 0;
    for (v in 0u32..members(p)) {
        let m = memberAt(p, v);
        var mfirst: i32 = 0;
        var flushed = false; // an ONLINE copy is durable
        for (c in 0u32..ncopies(m)) {
            let cp = copyAt(m, c);
            if (!writable(cp)) {
                continue;
            }
            let wasOnline = stateOf(cp) == ONLINE;
            let pp = Ptr.toBorrowMut(p);
            pp.flushes = pp.flushes.wrappingAdd(1);
            let rc = blk_flush(devOf(cp));
            if (rc == 0) {
                flushed = flushed || wasOnline;
                continue;
            }
            let k = Ptr.toBorrowMut(cp);
            k.write_errors = k.write_errors.wrappingAdd(1);
            if (mfirst == 0) {
                mfirst = rc;
            }
            if (rc == -ENODEV) {
                let _ = copySetState(p, v, c, MISSING, rc);
            } else if (!(stateOf(cp) == ONLINE && onlineCopies(m) == 1)) {
                let _ = copySetState(p, v, c, FAULTED, rc);
            }
        }
        // Durable on one ONLINE copy is durable; on none -- even the last copy left ONLINE after its flush failed --
        // it is not.
        if (!flushed && first == 0) {
            first = if (mfirst == 0 || mfirst == -ENODEV) -EIO else mfirst;
        }
    }
    return first;
}

// ---- The regions ----

/// storage.h's pool_region_clear.
/// Safety: `p` is a pool the caller serialises.
@export("pool_region_clear")
unsafe fn regionClear(p: *mut spool, vdev: u32, c: u32, r: u64) {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev)) || r >= POOL_DIRTY_BITS) {
        return;
    }
    let d = dirtyOf(copyAt(memberAt(p, vdev), c));
    if (!d.isNull()) {
        bitClear(d, r);
    }
}

/// storage.h's pool_region_missed.
/// Safety: `p` is a pool.
@export("pool_region_missed")
unsafe fn regionMissed(p: *spool, vdev: u32, c: u32, r: u64) -> bool {
    let pm = p as *mut spool;
    if (vdev >= members(pm) || c >= ncopies(memberAt(pm, vdev)) || r >= POOL_DIRTY_BITS) {
        return false;
    }
    let cp = copyAt(memberAt(pm, vdev), c);
    if (Ptr.toBorrow(cp as *pool_copy).whole) {
        return true;
    }
    let d = dirtyOf(cp);
    return !d.isNull() && bitSet(d, r);
}

/// storage.h's pool_copy_any_missed.
/// Safety: `p` is a pool.
@export("pool_copy_any_missed")
unsafe fn copyAnyMissed(p: *spool, vdev: u32, c: u32) -> bool {
    let pm = p as *mut spool;
    if (vdev >= members(pm) || c >= ncopies(memberAt(pm, vdev))) {
        return false;
    }
    let cp = copyAt(memberAt(pm, vdev), c);
    if (Ptr.toBorrow(cp as *pool_copy).whole) {
        return true;
    }
    return anyBit(cp);
}

// ---- Resilvers, replacements, detaches ----

/// storage.h's pool_copy_resilvered.
/// Safety: `p` is a pool the caller serialises.
@export("pool_copy_resilvered")
unsafe fn copyResilvered(p: *mut spool, vdev: u32, c: u32) -> i32 {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev))) {
        return -EINVAL;
    }
    let cp = copyAt(memberAt(p, vdev), c);
    if (stateOf(cp) != RESILVERING || devOf(cp).isNull()) {
        return -EINVAL;
    }
    let epoch = Ptr.toBorrow(p as *spool).epoch;
    let k = Ptr.toBorrowMut(cp);
    k.state = ONLINE;
    k.whole = false;
    k.cursor = 0;
    k.since = epoch;
    if (!dirtyOf(cp).isNull()) {
        bitsZero(dirtyOf(cp));
    }
    changed(p);
    var buffer = [0u8; 192];
    var line = TextWriter.create(mut buffer[..]);
    lineStart(mut line, p, vdev, c, devOf(cp));
    line.text("ONLINE: resilvered; the member is ");
    line.text(memberWord(p, vdev));
    KernelLog.send(LogLevel.Warn, line);
    return 0;
}

/// storage.h's pool_copy_replace_dev.
/// Safety: as addMember.
@export("pool_copy_replace_dev")
unsafe fn copyReplaceDev(p: *mut spool, vdev: u32, c: u32, bd: *mut blkdev, state: u32) -> i32 {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev)) || state >= NSTATES) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let cp = copyAt(m, c);
    if (readable(cp) && onlineCopies(m) == 1) {
        return -EBUSY; // the member's last good copy is not given away
    }
    var rc = fits(m, bd);
    if (rc != 0) {
        return rc;
    }
    let old = devOf(cp);
    let slot = Ptr.toBorrowMut(cp);
    slot.dev = 0 as *mut blkdev;
    rc = attach(cp, bd);
    if (rc != 0) {
        slot.dev = old;
        return rc;
    }
    if (!old.isNull()) {
        blkdevPut(old);
    }
    slot.state = state;
    slot.whole = state != ONLINE;
    slot.cursor = 0;
    slot.since = 0;
    slot.read_errors = 0;
    slot.write_errors = 0;
    slot.csum_errors = 0;
    slot.peer = 0;
    if (!dirtyOf(cp).isNull()) {
        bitsZero(dirtyOf(cp));
    }
    changed(p);
    return 0;
}

/// storage.h's pool_detach_copy.
/// Safety: `p` is a pool the caller serialises.
@export("pool_detach_copy")
unsafe fn detachCopy(p: *mut spool, vdev: u32, c: u32) -> i32 {
    if (vdev >= members(p) || c >= ncopies(memberAt(p, vdev))) {
        return -EINVAL;
    }
    let m = memberAt(p, vdev);
    let n = ncopies(m);
    if (n == 1 || (readable(copyAt(m, c)) && onlineCopies(m) == 1)) {
        return -EBUSY;
    }
    let goneDev = devOf(copyAt(m, c));
    let goneDirty = dirtyOf(copyAt(m, c));
    let size = layoutOf<pool_copy>().size;
    var k = c;
    while (k + 1 < n) {
        memcpy(copyAt(m, k) as *mut void, copyAt(m, k + 1) as *void, size);
        k += 1;
    }
    let member = Ptr.toBorrowMut(m);
    member.ncopies = n - 1;
    memset(copyAt(m, n - 1) as *mut void, 0, size);
    // The line names the device: written before the pool's reference on it goes.
    var buffer = [0u8; 192];
    var line = TextWriter.create(mut buffer[..]);
    lineStart(mut line, p, vdev, c, goneDev);
    line.text("detached; ");
    line.decimal((n - 1) as u64);
    line.text(" copies");
    if (!goneDev.isNull()) {
        blkdevPut(goneDev);
    }
    kfree(goneDirty as *mut void);
    changed(p);
    KernelLog.send(LogLevel.Warn, line);
    return 0;
}

// ---- Spares ----

/// storage.h's pool_add_spare.
/// Safety: as addMember.
@export("pool_add_spare")
unsafe fn addSpare(p: *mut spool, bd: *mut blkdev, tag: u64) -> i32 {
    if (!sectorsOk(bd)) {
        return -EINVAL;
    }
    let n = Ptr.toBorrow(p as *spool).nspares;
    for (i in 0u32..n) {
        if (pool_floor_spare(p, i).read() == bd) {
            return -EEXIST;
        }
    }
    if (n >= POOL_MAX_SPARES) {
        return -ENOSPC;
    }
    blkdevGet(bd);
    pool_floor_spare(p, n).write(bd);
    pool_floor_spare_tag(p, n).write(tag);
    let pool = Ptr.toBorrowMut(p);
    pool.nspares = n + 1;
    return 0;
}

/// Spare `i` out of the list, the later ones moving down.
/// Safety: `p` is a pool the caller serialises; `i` below its nspares.
unsafe fn spareDrop(p: *mut spool, i: u32) {
    let n = Ptr.toBorrow(p as *spool).nspares;
    var k = i;
    while (k + 1 < n) {
        pool_floor_spare(p, k).write(pool_floor_spare(p, k + 1).read());
        pool_floor_spare_tag(p, k).write(pool_floor_spare_tag(p, k + 1).read());
        k += 1;
    }
    let pool = Ptr.toBorrowMut(p);
    pool.nspares = n - 1;
    pool_floor_spare(p, n - 1).write(0 as *mut blkdev);
    pool_floor_spare_tag(p, n - 1).write(0);
}

/// storage.h's pool_remove_spare.
/// Safety: `p` is a pool the caller serialises.
@export("pool_remove_spare")
unsafe fn removeSpare(p: *mut spool, bd: *mut blkdev) -> i32 {
    for (i in 0u32..Ptr.toBorrow(p as *spool).nspares) {
        if (pool_floor_spare(p, i).read() == bd) {
            spareDrop(p, i);
            blkdevPut(bd);
            return 0;
        }
    }
    return -ENOENT;
}

/// storage.h's pool_take_spare: the list's reference, now the caller's.
/// Safety: `p` is a pool the caller serialises; `tag` null or writable.
@export("pool_take_spare")
unsafe fn takeSpare(p: *mut spool, vdev: u32, tag: *mut u64) -> *mut blkdev {
    if (vdev >= members(p)) {
        return 0 as *mut blkdev;
    }
    for (i in 0u32..Ptr.toBorrow(p as *spool).nspares) {
        let bd = pool_floor_spare(p, i).read();
        if (goneOf(bd) || fits(memberAt(p, vdev), bd) != 0) {
            continue;
        }
        if (!tag.isNull()) {
            tag.write(pool_floor_spare_tag(p, i).read());
        }
        spareDrop(p, i);
        return bd;
    }
    return 0 as *mut blkdev;
}

/// storage.h's pool_find_dev.
/// Safety: `p` is a pool; `vdev` and `c` writable.
@export("pool_find_dev")
unsafe fn findDev(p: *spool, bd: *blkdev, vdev: *mut u32, c: *mut u32) -> bool {
    let pm = p as *mut spool;
    for (v in 0u32..members(pm)) {
        let m = memberAt(pm, v);
        for (k in 0u32..ncopies(m)) {
            if (devOf(copyAt(m, k)) as *blkdev == bd) {
                vdev.write(v);
                c.write(k);
                return true;
            }
        }
    }
    return false;
}
