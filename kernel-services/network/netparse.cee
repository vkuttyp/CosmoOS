// netparse.cee - the network receive path's decoders (kernel/net/netparse.h; roadmap 2.0 SA5, the network-frame,
// TCP-segment, and DHCP-and-DNS families). Every check and field read the stack makes on bytes a frame brought: ether_input, arp_input, ipv4_input,
// the quoted headers of ICMP errors (icmp_quoted_flow, nat_in_icmp_error), ipv6_input, nd_input_ns and nd_input_na,
// udp_input, the transport identifiers NAT and the firewall key on, TCP's header and options (tcp_input, parse_mss),
// and DHCP and DNS: the options walk both ends share, the tap server's frame and message checks, the client's message
// and lease, a host name a server offers, the DNS proxy's id, and the resolver address it is configured with. The callers keep the mbufs, the tables and the
// policy.
//
// Each decoder is a safe function over a slice of exactly the bytes the header's comment names; the exports below make
// those slices from the caller's pointer, so an index past them is a bounds panic, never a read of another buffer.
// tests/host/test_netparse.c holds them to the C they replaced: the same digests over 200,000 inputs each.

// The decoders' results, which C reads: CeeSafe's, with C's layout; ceesafec writes kernel/net/netparse_types.h from
// them (netparse.h includes it, with the result codes).

/// An ARP packet's fields (netparse_arp): op is ARP_OP_REQUEST, ARP_OP_REPLY or another; the addresses in network order.
@repr(C)
public struct netparse_arp {
    op: u16;
    sha: [u8; 6];
    spa: [u8; 4];
    tpa: [u8; 4];
}

/// A neighbour solicitation's or advertisement's target, and its link-layer address when has_mac.
@repr(C)
public struct netparse_nd {
    target: [u8; 16];
    mac: [u8; 6];
    has_mac: bool;
}

/// A UDP header: len is the datagram's, header included (8..its payload); a zero checksum field means none.
@repr(C)
public struct netparse_udp {
    len: u16;
    sport: u16;
    dport: u16;
    has_cksum: bool;
}

/// A TCP header: hlen is the header's, options included (20..60, at most the segment's); flags are TH_*.
@repr(C)
public struct netparse_tcp {
    hlen: u32;
    sport: u16;
    dport: u16;
    seq: u32;
    ack: u32;
    flags: u8;
    win: u16;
}

/// A DHCP message: its type (option 53), the BOOTP fields read, and options 54 and 50 when they are 4 bytes.
@repr(C)
public struct netparse_dhcp {
    msg_type: u8;
    xid: [u8; 4];
    flags: u16;
    ciaddr: [u8; 4];
    yiaddr: [u8; 4];
    chaddr: [u8; 6];
    server: [u8; 4];
    has_server: bool;
    reqip: [u8; 4];
    has_reqip: bool;
}

/// An ACK's lease: the address, the lease (0xffffffff: infinite), options 1 and 3 when present, up to DHCP_MAX_DNS
/// servers, a usable host name (else empty), T1 and T2 (0 when absent).
@repr(C)
public struct netparse_dhcp_lease {
    addr: [u8; 4];
    lease: u32;
    mask: [u8; 4];
    has_mask: bool;
    router: [u8; 4];
    has_router: bool;
    ndns: u8;
    dns: [u8; 12];
    hostname: [u8; 64];
    t1: u32;
    t2: u32;
}

/// The identifiers NAT, the firewall and ICMP errors key a flow on, every field read as its protocol would be.
@repr(C)
public struct netparse_l4 {
    sport: u16;
    dport: u16;
    seq: u32;
    icmp_type: u8;
    icmp_id: u16;
    tcp_flags: u8;
}

// netparse.h's results.
const ETH_OTHER: u32 = 0;
const ETH_OWN: u32 = 1;
const ETH_UNICAST: u32 = 2;
const ETH_BROADCAST: u32 = 3;
const ETH_MULTICAST: u32 = 4;
const OK: u32 = 0;
const BAD: u32 = 1;
const BAD_CKSUM: u32 = 2;
const FRAGMENT: u32 = 3;

// The sizes of what each decoder reads.
const ETH_HLEN: usize = 14;
const ARP_LEN: usize = 28;
const IPV4_MIN: usize = 20;
const IPV6_HLEN: usize = 40;
const ND_LEN: usize = 32;
const UDP_HLEN: usize = 8;
const L4_MIN: usize = 8;
const L4_TCP_FLAGS: usize = 14;
const TCP_HLEN: usize = 20;
const TCP_MIN_MSS: u16 = 536;

// DHCP (dhcp.h): the BOOTP header's fields, the cookie, the options.
const BOOTP_REQUEST: u8 = 1;
const DHCP_FIXED: usize = 240;
const DHCP_HTYPE_ETHER: u8 = 1;
const DHCP_SERVER_PORT: u16 = 67;
const OPT_PAD: u8 = 0;
const OPT_END: u8 = 255;
const OPT_SUBNET: u8 = 1;
const OPT_ROUTER: u8 = 3;
const OPT_DNS: u8 = 6;
const OPT_HOSTNAME: u8 = 12;
const OPT_REQIP: u8 = 50;
const OPT_LEASE: u8 = 51;
const OPT_MSGTYPE: u8 = 53;
const OPT_SERVERID: u8 = 54;
const OPT_T1: u8 = 58;
const OPT_T2: u8 = 59;
const DHCP_MAX_DNS: u8 = 3;
const DHCP_HOSTNAME_MAX: usize = 64;

/// The big-endian 16-bit field at `at`.
fn be16(b: Slice<u8>, at: usize) -> u16 => (b[at] as u16) << 8 | b[at + 1] as u16;

/// The big-endian 32-bit field at `at`.
fn be32(b: Slice<u8>, at: usize) -> u32 =>
    (b[at] as u32) << 24 | (b[at + 1] as u32) << 16 | (b[at + 2] as u32) << 8 | b[at + 3] as u32;

/// The six bytes at `at` as one 48-bit integer, so a MAC is compared in one operation (as memcmp does).
fn mac48(b: Slice<u8>, at: usize) -> u64 =>
    (b[at] as u64) << 40 | (b[at + 1] as u64) << 32 | (b[at + 2] as u64) << 24 | (b[at + 3] as u64) << 16 |
        (b[at + 4] as u64) << 8 | b[at + 5] as u64;

// --- Ethernet --------------------------------------------------------------------------------------------------------

/// The header of a frame arriving on an interface whose MAC is `mac`: its class, and its EtherType in `etherType`.
fn ether(hdr: Slice<u8>, mac: Slice<u8>, etherType: borrow mut u16) -> u32 {
    let dst = mac48(hdr, 0);
    let self = mac48(mac, 0);
    let bcast = dst == 0xffffffffffff;
    let mcast = (hdr[0] & 1) != 0;
    etherType = be16(hdr, 12);
    if (!bcast && !mcast && dst != self) {
        return ETH_OTHER;
    }
    if (mac48(hdr, 6) == self) {
        return ETH_OWN;
    }
    if (bcast) {
        return ETH_BROADCAST;
    }
    if (mcast) {
        return ETH_MULTICAST;
    }
    return ETH_UNICAST;
}

// --- IPv4 ------------------------------------------------------------------------------------------------------------

/// The header length the first byte gives, in bytes (0-60).
fn ihlOf(b: Slice<u8>) -> u32 => ((b[0] & 0xf) as u32) * 4;

/// The fixed part of an IPv4 header in a packet of `pktLen` bytes.
fn ipv4Outer(hdr: Slice<u8>, pktLen: u32, ihl: borrow mut u32, total: borrow mut u32) -> u32 {
    let hl = ihlOf(hdr);
    let len = be16(hdr, 2) as u32;
    if ((hdr[0] >> 4) != 4 || hl < 20 || len < hl || len > pktLen) {
        return BAD;
    }
    ihl = hl;
    total = len;
    return OK;
}

/// The whole header: its checksum (RFC 1071: a correct header sums to 0xffff), then its fragment fields.
fn ipv4Header(hdr: Slice<u8>) -> u32 {
    var sum: u32 = 0;
    var i: usize = 0;
    while (i + 1 < hdr.length) {
        sum += be16(hdr, i) as u32;
        i += 2;
    }
    while ((sum >> 16) != 0) {
        sum = (sum & 0xffff) + (sum >> 16);
    }
    if (sum != 0xffff) {
        return BAD_CKSUM;
    }
    if ((be16(hdr, 6) & 0x3fff) != 0) {
        return FRAGMENT;
    }
    return OK;
}

/// A quoted IPv4 header: version 4 and at least 20 bytes.
fn ipv4Quote(q: Slice<u8>, ihl: borrow mut u32) -> bool {
    let hl = ihlOf(q);
    if ((q[0] >> 4) != 4 || hl < 20) {
        return false;
    }
    ihl = hl;
    return true;
}

// --- IPv6 ------------------------------------------------------------------------------------------------------------

/// The fixed header of a packet of `pktLen` bytes.
fn ipv6(hdr: Slice<u8>, pktLen: u32, plen: borrow mut u32) -> u32 {
    let len = be16(hdr, 4) as u32;
    // pktLen is a packet's length, under 2^32 - 40 by far; widened so the sum cannot overflow.
    if ((hdr[0] >> 4) != 6 || (len as u64) + 40 > pktLen as u64) {
        return BAD;
    }
    plen = len;
    return OK;
}

// --- TCP ------------------------------------------------------------------------------------------------------------

/// The maximum segment size the options announce (kind 2, length 4), raised to 536; `dflt` when there is none, or the
/// list ends (kind 0) or is malformed first: a kind with no length byte, a length below 2, or one past the options.
fn tcpMss(o: Slice<u8>, dflt: u16) -> u16 {
    var i: usize = 0;
    while (i < o.length) {
        let kind = o[i];
        if (kind == 0) {
            return dflt;
        }
        if (kind == 1) {
            i += 1;
            continue;
        }
        if (i + 1 >= o.length) {
            return dflt;
        }
        let len = o[i + 1] as usize;
        if (len < 2 || len > o.length - i) {
            return dflt;
        }
        if (kind == 2 && len == 4) {
            let mss = be16(o, i + 2);
            return if (mss < TCP_MIN_MSS) TCP_MIN_MSS else mss;
        }
        i += len;
    }
    return dflt;
}

// --- DHCP and DNS ---------------------------------------------------------------------------------------------------

/// Where option `code` is in the options `o`: its value's offset, with its length in `olen`. The walk stops at the end
/// option, skips pads, and ends at an option whose length byte is missing or whose value runs past the options.
fn dhcpOpt(o: Slice<u8>, code: u8, olen: borrow mut u8) -> usize? {
    var i: usize = 0;
    while (i < o.length) {
        let c = o[i];
        i += 1;
        if (c == OPT_END) {
            return null;
        }
        if (c == OPT_PAD) {
            continue;
        }
        if (i >= o.length) {
            return null;
        }
        let l = o[i];
        i += 1;
        if (l as usize > o.length - i) {
            return null;
        }
        if (c == code) {
            olen = l;
            return i;
        }
        i += l as usize;
    }
    return null;
}

/// Four bytes of `from` at `at` into `to`, as four stores: the fields here are 4 bytes, and a copy call of a length
/// known only at run time costs more than the stores (each still bounds-checked).
fn put4(to: SliceMut<u8>, from: Slice<u8>, at: usize) {
    to[0] = from[at];
    to[1] = from[at + 1];
    to[2] = from[at + 2];
    to[3] = from[at + 3];
}

/// Option `code` when it is exactly 4 bytes, into `out`.
fn opt4(o: Slice<u8>, code: u8, out: SliceMut<u8>) -> bool {
    var l: u8 = 0;
    match (dhcpOpt(o, code, borrow mut l)) {
        Some(at) => {
            if (l != 4) {
                return false;
            }
            put4(out, o, at);
            return true;
        }
        null => { return false; }
    }
}

/// A DHCP message whose op is `op`: its fields, or BAD (dhcp_filter's and dhcp_client_input's checks).
fn dhcp(dh: Slice<u8>, op: u8, m: borrow mut netparse_dhcp) -> u32 {
    if (dh.length < DHCP_FIXED) {
        return BAD;
    }
    // The cookie byte by byte (0x63825363): under the length check above these reads need no bounds checks.
    if (dh[0] != op ||
        dh[1] != DHCP_HTYPE_ETHER || dh[2] != 6 || dh[236] != 0x63 || dh[237] != 0x82 || dh[238] != 0x53 ||
        dh[239] != 0x63) {
        return BAD;
    }
    let o = dh[DHCP_FIXED..];
    var l: u8 = 0;
    match (dhcpOpt(o, OPT_MSGTYPE, borrow mut l)) {
        Some(at) => {
            if (l != 1) {
                return BAD;
            }
            m.msg_type = o[at];
        }
        null => { return BAD; }
    }
    put4(mut m.xid[..], dh, 4);
    m.flags = (dh[10] as u16) << 8 | dh[11] as u16;
    put4(mut m.ciaddr[..], dh, 12);
    put4(mut m.yiaddr[..], dh, 16);
    put4(mut m.chaddr[..], dh, 28);
    m.chaddr[4] = dh[32];
    m.chaddr[5] = dh[33];
    m.has_server = opt4(o, OPT_SERVERID, mut m.server[..]);
    if (!m.has_server) {
        m.server[..].fill(0);
    }
    m.has_reqip = opt4(o, OPT_REQIP, mut m.reqip[..]);
    if (!m.has_reqip) {
        m.reqip[..].fill(0);
    }
    return OK;
}

/// A host name a server offers (option 12), into `name` with its NUL: kept only when it is 1-63 letters, digits, '-'
/// and '.' after an optional trailing NUL is dropped (RFC 1123's characters); else `name` is left empty. It lands in
/// /etc/hostname and at prompts, so nothing else is let through.
fn hostname(v: Slice<u8>, name: SliceMut<u8>) {
    name[0] = 0;
    var l = v.length;
    if (l > 0 && v[l - 1] == 0) {
        l -= 1;
    }
    if (l == 0 || l >= DHCP_HOSTNAME_MAX) {
        return;
    }
    for (i in 0..l) {
        let ch = v[i];
        let ok = (ch >= 0x61 && ch <= 0x7a) || (ch >= 0x41 && ch <= 0x5a) || (ch >= 0x30 && ch <= 0x39) || ch == 0x2d ||
            ch == 0x2e;
        if (!ok) {
            return;
        }
    }
    name[..l].copyFrom(v[..l]);
    name[l] = 0;
}

/// An ACK's lease: false with no address, no lease time, or a lease of 0 (RFC 2131 table 3).
fn dhcpLease(dh: Slice<u8>, ls: borrow mut netparse_dhcp_lease) -> bool {
    let o = dh[DHCP_FIXED..];
    put4(mut ls.addr[..], dh, 16);
    ls.lease = 0;
    ls.mask[..].fill(0);
    ls.has_mask = false;
    ls.router[..].fill(0);
    ls.has_router = false;
    ls.ndns = 0;
    ls.dns[..].fill(0);
    ls.hostname[..].fill(0);
    ls.t1 = 0;
    ls.t2 = 0;
    let yi = be32(dh, 16);
    var lease: [u8; 4] = [0, 0, 0, 0];
    if (yi == 0 || yi == 0xffffffff || !opt4(o, OPT_LEASE, mut lease[..])) {
        return false;
    }
    ls.lease = be32(lease[..], 0);
    if (ls.lease == 0) {
        return false;
    }
    ls.has_mask = opt4(o, OPT_SUBNET, mut ls.mask[..]);
    var ol: u8 = 0;
    match (dhcpOpt(o, OPT_ROUTER, borrow mut ol)) {
        Some(at) => {
            if (ol >= 4) {
                put4(mut ls.router[..], o, at); // the first router
                ls.has_router = true;
            }
        }
        null => {}
    }
    match (dhcpOpt(o, OPT_DNS, borrow mut ol)) {
        Some(at) => {
            let l = ol as usize;
            var i: usize = 0;
            var n: u8 = 0;
            while (i + 4 <= l && n < DHCP_MAX_DNS) {
                let k = 4 * n as usize;
                put4(mut ls.dns[k..k + 4], o, at + i);
                n += 1;
                i += 4;
            }
            ls.ndns = n;
        }
        null => {}
    }
    match (dhcpOpt(o, OPT_HOSTNAME, borrow mut ol)) {
        Some(at) => { hostname(o[at..at + ol as usize], mut ls.hostname[..]); }
        null => {}
    }
    var t: [u8; 4] = [0, 0, 0, 0];
    if (opt4(o, OPT_T1, mut t[..])) {
        ls.t1 = be32(t[..], 0);
    }
    if (opt4(o, OPT_T2, mut t[..])) {
        ls.t2 = be32(t[..], 0);
    }
    return true;
}

/// A guest's frame to the tap: whether it is an IPv4 UDP datagram to the DHCP server port with its headers whole,
/// and where its DHCP message starts.
fn dhcpFrame(f: Slice<u8>, dhOff: borrow mut u32) -> bool {
    if (f.length < ETH_HLEN + IPV4_MIN + UDP_HLEN) {
        return false;
    }
    if (f[12] != 0x08 || f[13] != 0x00) {
        return false;
    }
    let ihl = ((f[14] & 0xf) as u32) * 4;
    if ((f[14] >> 4) != 4 || ihl < 20 || f[14 + 9] != 17) {
        return false;
    }
    let off = 14 + ihl + 8; // at most 14 + 60 + 8
    if (off as usize > f.length) {
        return false;
    }
    // The destination port, read in place: be16 is a call clang does not inline here, and this check runs on every
    // frame a guest sends.
    let port = off as usize - 6;
    if (f[port] != 0 || f[port + 1] as u16 != DHCP_SERVER_PORT) {
        return false;
    }
    dhOff = off;
    return true;
}

/// A dotted quad: four decimal parts of at most 255, each with a digit, nothing else.
fn ipv4Text(s: Slice<u8>, out: SliceMut<u8>) -> bool {
    var o: [u8; 4] = [0, 0, 0, 0];
    var part: usize = 0;
    var digits: u32 = 0;
    var v: u32 = 0;
    var i: usize = 0;
    while (true) {
        let c = if (i < s.length) s[i] else 0;
        if (c >= 0x30 && c <= 0x39) {
            v = v * 10 + (c - 0x30) as u32;
            digits += 1;
            if (v > 255) {
                return false;
            }
        } else if (c == 0x2e || c == 0) {
            if (digits == 0 || part > 3) {
                return false;
            }
            o[part] = truncate<u8>(v); // at most 255, checked as each digit was added
            part += 1;
            v = 0;
            digits = 0;
            if (c == 0) {
                break;
            }
        } else {
            return false;
        }
        i += 1;
    }
    if (part != 4) {
        return false;
    }
    out.copyFrom(o[..]);
    return true;
}

// --- the exports -----------------------------------------------------------------------------------------------------

/// Safety: `hdr` points to ETH_HLEN readable bytes and `mac` to 6 (netparse.h); `etherType` is writable.
@export("netparse_ether")
unsafe fn etherC(hdr: *u8, mac: *u8, etherType: *mut u16) -> u32 =>
    ether(Slice.fromRaw(hdr, ETH_HLEN), Slice.fromRaw(mac, 6), Ptr.toBorrowMut(etherType));

/// Safety: `pkt` points to ARP_LEN readable bytes and `out` to a writable struct (netparse.h).
@export("netparse_arp")
unsafe fn arpC(pkt: *u8, out: *mut netparse_arp) -> bool {
    let p = Slice.fromRaw(pkt, ARP_LEN);
    // htype 1 (Ethernet), ptype 0x0800 (IPv4), hlen 6, plen 4.
    if (be16(p, 0) != 1 || be16(p, 2) != 0x0800 || p[4] != 6 || p[5] != 4) {
        return false;
    }
    let a = Ptr.toBorrowMut(out);
    a.op = be16(p, 6);
    a.sha[..].copyFrom(p[8..14]);
    a.spa[..].copyFrom(p[14..18]);
    a.tpa[..].copyFrom(p[24..28]);
    return true;
}

/// Safety: `hdr` points to IPV4_MIN readable bytes; `ihl` and `total` are writable.
@export("netparse_ipv4_outer")
unsafe fn ipv4OuterC(hdr: *u8, pktLen: u32, ihl: *mut u32, total: *mut u32) -> u32 =>
    ipv4Outer(Slice.fromRaw(hdr, IPV4_MIN), pktLen, Ptr.toBorrowMut(ihl), Ptr.toBorrowMut(total));

/// Safety: `hdr` points to `ihl` readable bytes, as netparse_ipv4_outer gave it (20-60).
@export("netparse_ipv4_header")
unsafe fn ipv4HeaderC(hdr: *u8, ihl: u32) -> u32 => ipv4Header(Slice.fromRaw(hdr, ihl as usize));

/// Safety: `q` points to IPV4_MIN readable bytes; `ihl` is writable.
@export("netparse_ipv4_quote")
unsafe fn ipv4QuoteC(q: *u8, ihl: *mut u32) -> bool => ipv4Quote(Slice.fromRaw(q, IPV4_MIN), Ptr.toBorrowMut(ihl));

/// Safety: `hdr` points to IPV6_HLEN readable bytes; `plen` is writable.
@export("netparse_ipv6")
unsafe fn ipv6C(hdr: *u8, pktLen: u32, plen: *mut u32) -> u32 =>
    ipv6(Slice.fromRaw(hdr, IPV6_HLEN), pktLen, Ptr.toBorrowMut(plen));

/// Safety: `msg` points to ND_LEN readable bytes and `out` to a writable struct.
@export("netparse_nd")
unsafe fn ndC(msg: *u8, optType: u8, out: *mut netparse_nd) {
    let m = Slice.fromRaw(msg, ND_LEN);
    let nd = Ptr.toBorrowMut(out);
    // Bulk copies: one check each rather than one per byte (type-system.md §16.5).
    nd.target[..].copyFrom(m[8..24]);
    let hasMac = m[24] == optType && m[25] == 1;
    nd.has_mac = hasMac;
    if (hasMac) {
        nd.mac[..].copyFrom(m[26..32]);
    } else {
        nd.mac[..].fill(0);
    }
}

/// Safety: `hdr` points to UDP_HLEN readable bytes and `out` to a writable struct.
@export("netparse_udp")
unsafe fn udpC(hdr: *u8, pktLen: u32, out: *mut netparse_udp) -> u32 {
    let h = Slice.fromRaw(hdr, UDP_HLEN);
    let len = be16(h, 4);
    if (len < 8 || len as u32 > pktLen) {
        return BAD;
    }
    let u = Ptr.toBorrowMut(out);
    u.len = len;
    u.sport = be16(h, 0);
    u.dport = be16(h, 2);
    u.has_cksum = h[6] != 0 || h[7] != 0;
    return OK;
}

/// Safety: `b` points to `avail` readable bytes, at least L4_MIN, and `out` to a writable struct.
@export("netparse_l4")
unsafe fn l4C(b: *u8, avail: u32, out: *mut netparse_l4) {
    let n = if (avail as usize >= L4_TCP_FLAGS) L4_TCP_FLAGS else L4_MIN;
    let h = Slice.fromRaw(b, n);
    let l = Ptr.toBorrowMut(out);
    l.sport = be16(h, 0);
    l.dport = be16(h, 2);
    l.seq = be32(h, 4);
    l.icmp_type = h[0];
    l.icmp_id = be16(h, 4);
    l.tcp_flags = if (n == L4_TCP_FLAGS) h[13] else 0;
}

/// Safety: `hdr` points to TCP_HLEN readable bytes and `out` to a writable struct.
@export("netparse_tcp")
unsafe fn tcpC(hdr: *u8, segLen: u32, out: *mut netparse_tcp) -> u32 {
    let h = Slice.fromRaw(hdr, TCP_HLEN);
    let hlen = ((h[12] >> 4) as u32) * 4;
    if (hlen < 20 || hlen > segLen) {
        return BAD;
    }
    let d = Ptr.toBorrowMut(out);
    d.hlen = hlen;
    d.sport = be16(h, 0);
    d.dport = be16(h, 2);
    d.seq = be32(h, 4);
    d.ack = be32(h, 8);
    d.flags = h[13];
    d.win = be16(h, 14);
    return OK;
}

/// Safety: `opts` points to `optlen` readable bytes (at most 40: the header's options).
@export("netparse_tcp_mss")
unsafe fn tcpMssC(opts: *u8, optlen: u32, dflt: u16) -> u16 => tcpMss(Slice.fromRaw(opts, optlen as usize), dflt);

/// Safety: `opts` points to `len` readable bytes and `olen` is writable.
@export("netparse_dhcp_opt")
unsafe fn dhcpOptC(opts: *u8, len: u32, code: u8, olen: *mut u8) -> i32 {
    match (dhcpOpt(Slice.fromRaw(opts, len as usize), code, Ptr.toBorrowMut(olen))) {
        // An offset into a u32-sized buffer; one past i32's range (no DHCP message is 2 GiB) reads as absent.
        Some(at) => { return if (at <= 0x7fffffff) truncate<i32>(at) else -1; }
        null => { return -1; }
    }
}

/// Safety: `dh` points to `dhlen` readable bytes and `out` to a writable struct.
@export("netparse_dhcp")
unsafe fn dhcpC(dh: *u8, dhlen: u32, op: u8, out: *mut netparse_dhcp) -> u32 =>
    dhcp(Slice.fromRaw(dh, dhlen as usize), op, Ptr.toBorrowMut(out));

/// Safety: `dh` points to `dhlen` readable bytes, at least DHCP_FIXED, and `out` to a writable struct.
@export("netparse_dhcp_lease")
unsafe fn dhcpLeaseC(dh: *u8, dhlen: u32, out: *mut netparse_dhcp_lease) -> bool =>
    dhcpLease(Slice.fromRaw(dh, dhlen as usize), Ptr.toBorrowMut(out));

/// Safety: `frame` points to `len` readable bytes and `dhOff` is writable.
@export("netparse_dhcp_frame")
unsafe fn dhcpFrameC(frame: *u8, len: u32, dhOff: *mut u32) -> bool =>
    dhcpFrame(Slice.fromRaw(frame, len as usize), Ptr.toBorrowMut(dhOff));

/// Safety: `msg` points to `len` readable bytes, at least the 12-byte header.
@export("netparse_dns_id")
unsafe fn dnsIdC(msg: *u8, len: u32) -> u16 => be16(Slice.fromRaw(msg, len as usize), 0);

/// Safety: `s` points to `len` readable characters and `out` to 4 writable bytes.
@export("netparse_ipv4_text")
unsafe fn ipv4TextC(s: *CChar, len: u32, out: *mut u8) -> bool =>
    ipv4Text(Slice.fromRaw(s as *u8, len as usize), SliceMut.fromRaw(out, 4));
