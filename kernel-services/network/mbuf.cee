// mbuf.cee - packet buffers (kernel/include/kernel/mbuf.h), in CeeSafe: roadmap 2.0 SA6. An mbuf holds part of a
// packet, inline (MHLEN bytes) or in a shared cluster (MCLBYTES); a packet is a chain of them, the first carrying the
// packet header. tests/host/test_mbuf.c holds them to the digest of the C they replaced.
//
// Every mbuf and cluster is a C object, from a slab cache, which drivers and protocols read and change: CeeSafe reaches
// them through pointers, and their bytes through slices of the lengths the buffers record. The reference counts are
// changed atomically by every CPU (ADR 0041 §3.1); the statistics are under an interrupt-safe spin lock, so a snapshot
// is one instant, as the C's was.

@header("kernel/mbuf.h", "kernel/compiler.h")
extern "C" {
    struct mbuf {
        next: *mut mbuf;
        nextpkt: *mut mbuf;
        data: *mut u8;
        len: u32;
        flags: u32;
        refcount: AtomicU32;
        buf: *mut u8;
        size: u32;
        pkt: mbuf_pkt;
        cl: *mut mbuf_cluster;
        inl: [u8; 128];
    }
    /// The packet header: CeeSafe reads and writes its length, and copies the whole of it by C's size of it.
    struct mbuf_pkt {
        len: u32;
    }
    struct mbuf_cluster {
        refcount: AtomicU32;
        data: [u8; 2048];
    }
    struct mbufq {
        head: *mut mbuf;
        tail: *mut mbuf;
        len: u32;
        maxlen: u32;
        lock: spinlock_t;
    }
    struct mbuf_stats {
        mbufs_alive: u64;
        clusters_alive: u64;
        allocs: u64;
        frees: u64;
        alloc_failures: u64;
        double_enqueues: u64;
    }
    /// compiler.h: whether this is a debug build (CONFIG_DEBUG).
    @constant
    fn COSMO_CONFIG_DEBUG() -> bool;
}

/// mbuf.h's sizes and flags.
const MCLBYTES: u32 = 2048;
const MHLEN: u32 = 128;
const NET_HEADROOM: u32 = 128;
const M_PKTHDR: u32 = 1;
const M_EXT: u32 = 2;
const M_BCAST: u32 = 4;
const M_MCAST: u32 = 8;
const M_CSUM_OK: u32 = 16;
const M_QUEUED: u32 = 64;
/// kernel/errno.h's ENOMEM.
const ENOMEM: i32 = 12;

/// Whether a free with no reference left panics: the C checked it in debug builds only.
static DEBUG_CHECKS: bool = COSMO_CONFIG_DEBUG();

/// The slab caches mbuf_init makes: their addresses, written once at start-up, then only read.
static MBUF_CACHE: AtomicUSize = AtomicUSize.constant(0);
static CLUSTER_CACHE: AtomicUSize = AtomicUSize.constant(0);

struct Stats {
    mbufsAlive: u64;
    clustersAlive: u64;
    allocs: u64;
    frees: u64;
    allocFailures: u64;
    doubleEnqueues: u64;
}

static STATS: IrqSpinLock<Stats> = IrqSpinLock<Stats>.constant(
    "mbuf-stats\0".ptr as *CChar,
    Stats { mbufsAlive: 0, clustersAlive: 0, allocs: 0, frees: 0, allocFailures: 0, doubleEnqueues: 0 },
);

/// -1 for a counter, as the C's `(uint64_t)((int64_t)f + d)` added it.
const LESS: u64 = 0xffffffffffffffff;

/// Changes the counters by these amounts, wrapping as the C's did, under the lock (one lock for what the C did in
/// several: a snapshot sees all of a change or none of it).
fn account(mbufs: u64, clusters: u64, allocs: u64, frees: u64, failures: u64) {
    var guard = STATS.lock();
    let s = guard.data();
    s.mbufsAlive = s.mbufsAlive.wrappingAdd(mbufs);
    s.clustersAlive = s.clustersAlive.wrappingAdd(clusters);
    s.allocs = s.allocs.wrappingAdd(allocs);
    s.frees = s.frees.wrappingAdd(frees);
    s.allocFailures = s.allocFailures.wrappingAdd(failures);
}

fn min(a: u32, b: u32) -> u32 => if (a < b) a else b;

/// The bytes free before an mbuf's data (mbuf.h's m_leadingspace).
fn leading(m: borrow mbuf) -> u32 => truncate<u32>((m.data as usize).wrappingSub(m.buf as usize));

/// The bytes free after it (m_trailingspace).
fn trailing(m: borrow mbuf) -> u32 => m.size.wrappingSub(leading(m)).wrappingSub(m.len);

/// Copies `length` bytes from `from` to `to`, which do not overlap.
/// Safety: `from` has `length` readable bytes and `to` `length` writable ones, which nothing else uses meanwhile.
unsafe fn copy(to: *mut u8, from: *u8, length: u32) {
    SliceMut.fromRaw(to, length as usize).copyFrom(Slice.fromRaw(from, length as usize));
}

/// Copies `from`'s packet header to `to`'s, all of it, by C's size of it.
/// Safety: both are live mbufs; `to` is not otherwise used meanwhile.
unsafe fn copyHeader(to: *mut mbuf, from: *mbuf) {
    let at = offsetOf<mbuf>(pkt);
    copy((to as *mut u8).add(at), (from as *u8).add(at), truncate<u32>(layoutOf<mbuf_pkt>().size));
}

// ---- Buffers ----

/// mbuf.h's m_get: an empty mbuf with its inline storage, or null.
/// Safety: mbuf_init has made the cache; kmem_cache_alloc returns null or an unused object of an mbuf's size, which
/// this initialises before anything else sees it.
@export("m_get")
unsafe fn get() -> *mut mbuf {
    let m = kmem_cache_alloc(MBUF_CACHE.loadWith(LoadOrdering.Relaxed) as *mut kmem_cache, 0) as *mut mbuf;
    if (m.isNull()) {
        account(0, 0, 0, 0, 1);
        return m;
    }
    SliceMut.fromRaw(m as *mut u8, offsetOf<mbuf>(inl)).fill(0); // everything before the inline bytes, as the C did
    let b = Ptr.toBorrowMut(m);
    let inline = borrow mut b.inl as *mut [u8; 128] as *mut u8;
    b.buf = inline;
    b.size = MHLEN;
    b.data = inline;
    b.refcount.storeWith(1, StoreOrdering.Relaxed); // nothing else has it yet
    account(1, 0, 1, 0, 0);
    return m;
}

/// m_getcl: an mbuf with a cluster, the headroom before its data, or null.
/// Safety: as m_get.
@export("m_getcl")
unsafe fn getCluster() -> *mut mbuf {
    let m = get();
    if (m.isNull()) {
        return m;
    }
    let cl = kmem_cache_alloc(CLUSTER_CACHE.loadWith(LoadOrdering.Relaxed) as *mut kmem_cache, 0) as *mut mbuf_cluster;
    if (cl.isNull()) {
        free(m);
        account(0, 0, 0, 0, 1);
        return 0 as *mut mbuf;
    }
    let c = Ptr.toBorrowMut(cl);
    c.refcount.storeWith(1, StoreOrdering.Relaxed);
    let data = borrow mut c.data as *mut [u8; 2048] as *mut u8;
    let b = Ptr.toBorrowMut(m);
    b.cl = cl;
    b.buf = data;
    b.size = MCLBYTES;
    b.data = data.add(NET_HEADROOM as usize);
    b.flags = M_PKTHDR | M_EXT;
    account(0, 1, 0, 0, 0);
    return m;
}

/// m_free: drops one reference to `m` (and, with the last, its cluster's), returning the next mbuf of the chain.
/// Safety: `m` is null or an mbuf the caller holds a reference to, which it gives up.
@export("m_free")
unsafe fn free(m: *mut mbuf) -> *mut mbuf {
    if (m.isNull()) {
        return m;
    }
    let b = Ptr.toBorrowMut(m);
    let next = b.next;
    let refs = b.refcount.fetchSubWith(1, Ordering.AcquireRelease);
    if (DEBUG_CHECKS && refs == 0) {
        // A second free of the same mbuf finds no reference left. It used to pass silently and did harm only when
        // another CPU had reused the mbuf in between, so the second free took a live packet (the ping unit's raw
        // queue); the slab's own check cannot see it, since nothing reaches the slab.
        var buffer: [u8; 128] = [0; 128];
        var line = TextWriter.create(mut buffer[..]);
        line.text("m_free: mbuf 0x");
        line.hex(m as usize as u64, 0);
        line.text(" freed with no reference left (a double free)");
        KernelLog.panic(line);
    }
    if (refs != 1) {
        return next;
    }
    var clusters: u64 = 0;
    if ((b.flags & M_EXT) != 0) {
        let cl = b.cl;
        if (Ptr.toBorrow(cl).refcount.fetchSubWith(1, Ordering.AcquireRelease) == 1) {
            kmem_cache_free(CLUSTER_CACHE.loadWith(LoadOrdering.Relaxed) as *mut kmem_cache, cl as *mut void);
            clusters = LESS;
        }
    }
    kmem_cache_free(MBUF_CACHE.loadWith(LoadOrdering.Relaxed) as *mut kmem_cache, m as *mut void);
    account(LESS, clusters, 0, 1, 0);
    return next;
}

/// m_freem: frees every mbuf of a chain.
/// Safety: as m_free, for each.
@export("m_freem")
unsafe fn freeChain(m: *mut mbuf) {
    var at = m;
    while (!at.isNull()) {
        at = free(at);
    }
}

/// m_ref: a new mbuf sharing `m`'s cluster (its data and length, not its packet header), or null.
/// Safety: `m` is a live mbuf; the cluster's count holds it for the new mbuf.
@export("m_ref")
unsafe fn reference(m: *mut mbuf) -> *mut mbuf {
    let from = Ptr.toBorrow(m as *mbuf);
    if ((from.flags & M_EXT) == 0) {
        return 0 as *mut mbuf;
    }
    let n = get();
    if (n.isNull()) {
        return n;
    }
    Ptr.toBorrow(from.cl as *mbuf_cluster).refcount.fetchAddWith(1, Ordering.AcquireRelease);
    let b = Ptr.toBorrowMut(n);
    b.cl = from.cl;
    b.buf = from.buf;
    b.size = from.size;
    b.data = from.data;
    b.len = from.len;
    b.flags = (from.flags & ((M_PKTHDR | M_QUEUED) ^ 0xffffffff)) | M_EXT;
    return n;
}

/// m_length: the bytes of a chain.
/// Safety: `m` is null or a live chain.
@export("m_length")
unsafe fn length(m: *mbuf) -> u32 {
    var n: u32 = 0;
    var at = m;
    while (!at.isNull()) {
        let b = Ptr.toBorrow(at);
        n = n.wrappingAdd(b.len);
        at = b.next as *mbuf;
    }
    return n;
}

// ---- Headers ----

/// m_prepend: `n` bytes in front of the packet, in its first mbuf if there is room, else in a new one in front; the
/// packet, or null (and it is freed) if a buffer cannot be had.
/// Safety: `m` is a live chain the caller hands over; no caller asks for more than a cluster.
@export("m_prepend")
unsafe fn prepend(m: *mut mbuf, n: u32) -> *mut mbuf {
    let b = Ptr.toBorrowMut(m);
    if (leading(b) >= n) {
        b.data = b.data.sub(n as usize);
        b.len = b.len.wrappingAdd(n);
        if ((b.flags & M_PKTHDR) != 0) {
            b.pkt.len = b.pkt.len.wrappingAdd(n);
        }
        return m;
    }
    let h = if (n > MHLEN) getCluster() else get();
    if (h.isNull()) {
        freeChain(m);
        return h;
    }
    let hb = Ptr.toBorrowMut(h);
    if (hb.size.wrappingSub(leading(hb)) < n) {
        hb.data = hb.buf;
    }
    hb.len = n;
    if ((b.flags & M_PKTHDR) != 0) {
        hb.flags = hb.flags | M_PKTHDR;
        copyHeader(h, m as *mbuf);
        hb.pkt.len = b.pkt.len.wrappingAdd(n);
        b.flags = b.flags & (M_PKTHDR ^ 0xffffffff);
    }
    hb.next = m;
    return h;
}

/// m_pullup: the first `n` bytes of the packet together in its first mbuf; the packet, or null (and it is freed) if
/// they cannot be.
/// Safety: `m` is a live chain the caller hands over.
@export("m_pullup")
unsafe fn pullup(m: *mut mbuf, n: u32) -> *mut mbuf {
    let first = Ptr.toBorrowMut(m);
    if (first.len >= n) {
        return m;
    }
    if (n > MCLBYTES) {
        freeChain(m);
        return 0 as *mut mbuf;
    }
    let h = getCluster();
    if (h.isNull()) {
        freeChain(m);
        return h;
    }
    let hb = Ptr.toBorrowMut(h);
    // Keep the headroom when the pulled-up bytes fit behind it, so a reply built on this packet (ICMP, a TCP RST or
    // ACK) prepends in place.
    if (n > MCLBYTES - NET_HEADROOM) {
        hb.data = hb.buf;
    }
    if ((first.flags & M_PKTHDR) != 0) {
        copyHeader(h, m as *mbuf);
        first.flags = first.flags & (M_PKTHDR ^ 0xffffffff);
    } else {
        hb.flags = hb.flags & (M_PKTHDR ^ 0xffffffff);
    }
    // n bytes from the chain into h, consuming whole buffers.
    var got: u32 = 0;
    var at = m;
    while (got < n && !at.isNull()) {
        let b = Ptr.toBorrowMut(at);
        let take = min(b.len, n - got);
        copy(hb.data.add(got as usize), b.data as *u8, take);
        b.data = b.data.add(take as usize);
        b.len -= take;
        got += take;
        if (b.len == 0) {
            at = free(at);
        }
    }
    if (got < n) {
        freeChain(h);
        freeChain(at);
        return 0 as *mut mbuf;
    }
    hb.len = n;
    hb.next = at;
    return h;
}

/// m_adj: trims `n` bytes from the front of the packet (n > 0) or `-n` from its end (n < 0); buffers emptied stay in
/// the chain.
/// Safety: `m` is null or a live chain the caller holds.
@export("m_adj")
unsafe fn adjust(m: *mut mbuf, n: i32) {
    if (m.isNull() || n == 0) {
        return;
    }
    let head = Ptr.toBorrowMut(m);
    if (n > 0) {
        var left = truncate<u32>(n);
        var at = m;
        while (!at.isNull() && left != 0) {
            let b = Ptr.toBorrowMut(at);
            let take = min(b.len, left);
            b.data = b.data.add(take as usize);
            b.len -= take;
            left -= take;
            at = b.next;
        }
        if ((head.flags & M_PKTHDR) != 0) {
            head.pkt.len = head.pkt.len.wrappingSub(truncate<u32>(n).wrappingSub(left));
        }
        return;
    }
    var left = 0u32.wrappingSub(truncate<u32>(n)); // -n, as the C's (uint32_t)(-n)
    let total = length(m as *mbuf);
    if (left > total) {
        left = total;
    }
    let keep = total - left;
    var seen: u32 = 0;
    var at = m;
    while (!at.isNull()) {
        let b = Ptr.toBorrowMut(at);
        if (seen.wrappingAdd(b.len) <= keep) {
            seen = seen.wrappingAdd(b.len);
        } else {
            b.len = if (keep > seen) keep - seen else 0;
            seen = keep;
        }
        at = b.next;
    }
    if ((head.flags & M_PKTHDR) != 0) {
        head.pkt.len = head.pkt.len.wrappingSub(left);
    }
}

// ---- Data ----

/// m_copydata: `len` bytes from offset `off` of the packet to `to`; false if the packet is shorter.
/// Safety: `m` is null or a live chain; `to` has `len` writable bytes nothing else uses meanwhile.
@export("m_copydata")
unsafe fn copyData(m: *mbuf, off: u32, len: u32, to: *mut void) -> bool {
    var at = m;
    var skip = off;
    while (!at.isNull() && skip >= Ptr.toBorrow(at).len) {
        skip -= Ptr.toBorrow(at).len;
        at = Ptr.toBorrow(at).next as *mbuf;
    }
    var out = to as *mut u8;
    var left = len;
    while (left > 0 && !at.isNull()) {
        let b = Ptr.toBorrow(at);
        let take = min(b.len - skip, left);
        copy(out, (b.data as *u8).add(skip as usize), take);
        out = out.add(take as usize);
        left -= take;
        skip = 0;
        at = b.next as *mbuf;
    }
    return left == 0;
}

/// m_append: `len` bytes from `from` at the end of the packet, in new clusters when the last buffer is full; 0, or
/// -ENOMEM if one cannot be had (what fitted is kept).
/// Safety: `m` is a live chain the caller holds; `from` has `len` readable bytes.
@export("m_append")
unsafe fn append(m: *mut mbuf, from: *void, len: u32) -> i32 {
    var last = m;
    while (!Ptr.toBorrow(last).next.isNull()) {
        last = Ptr.toBorrow(last).next;
    }
    let header = (Ptr.toBorrow(m).flags & M_PKTHDR) != 0;
    var input = from as *u8;
    var left = len;
    while (left > 0) {
        var room = trailing(Ptr.toBorrow(last));
        if (room == 0) {
            let n = getCluster();
            if (n.isNull()) {
                return -ENOMEM;
            }
            let nb = Ptr.toBorrowMut(n);
            nb.flags = nb.flags & (M_PKTHDR ^ 0xffffffff);
            nb.data = nb.buf;
            let tail = Ptr.toBorrowMut(last);
            tail.next = n;
            last = n;
            room = trailing(Ptr.toBorrow(last));
        }
        let take = min(room, left);
        let b = Ptr.toBorrowMut(last);
        copy(b.data.add(b.len as usize), input, take);
        b.len += take;
        input = input.add(take as usize);
        left -= take;
        if (header) {
            let p = Ptr.toBorrowMut(m);
            p.pkt.len = p.pkt.len.wrappingAdd(take);
        }
    }
    return 0;
}

/// m_copypacket: a copy of the packet in clusters of its own, its header and receive flags kept; or null.
/// Safety: `m` is a live chain.
@export("m_copypacket")
unsafe fn copyPacket(m: *mbuf) -> *mut mbuf {
    let total = length(m);
    let n = getCluster();
    if (n.isNull()) {
        return n;
    }
    if (total <= trailing(Ptr.toBorrow(n))) {
        // One cluster: linear, with the headroom kept.
        if (!copyData(m, 0, total, Ptr.toBorrow(n).data as *mut void)) {
            freeChain(n);
            return 0 as *mut mbuf;
        }
        let only = Ptr.toBorrowMut(n);
        only.len = total;
    } else {
        // Longer: a chain of clusters (a 16 KiB loopback segment held by a test filter used to be refused).
        var bounce: [u8; 512] = [0; 512];
        let piece = borrow mut bounce as *mut [u8; 512] as *mut u8;
        var off: u32 = 0;
        while (off < total) {
            let k = min(total - off, 512);
            if (!copyData(m, off, k, piece as *mut void) || append(n, piece as *void, k) != 0) {
                freeChain(n);
                return 0 as *mut mbuf;
            }
            off += k;
        }
    }
    let from = Ptr.toBorrow(m);
    if ((from.flags & M_PKTHDR) != 0) {
        copyHeader(n, m);
    }
    let b = Ptr.toBorrowMut(n);
    b.pkt.len = total;
    b.flags = b.flags | (from.flags & (M_BCAST | M_MCAST | M_CSUM_OK));
    return n;
}

// ---- Queues ----

/// The queue's lock, by C's offset of it.
/// Safety: `q` points to a queue; the address is only computed here.
unsafe fn queueLock(q: *mut mbufq) -> *mut spinlock_t => (q as *mut u8).add(offsetOf<mbufq>(lock)) as *mut spinlock_t;

/// mbufq_init: an empty queue of at most `maxlen` packets, its lock named `name`.
/// Safety: `q` is a queue nothing else uses yet; `name` is a static string.
@export("mbufq_init")
unsafe fn queueInit(q: *mut mbufq, maxlen: u32, name: *CChar) {
    let b = Ptr.toBorrowMut(q);
    b.head = 0 as *mut mbuf;
    b.tail = 0 as *mut mbuf;
    b.len = 0;
    b.maxlen = maxlen;
    spinlock_init(queueLock(q), name);
}

/// mbufq_enqueue: puts a packet at the tail, true; false and the packet freed if the queue is full; false and the
/// packet untouched if it is already on a queue (counted and logged: clearing its link would orphan what is behind it
/// on that queue, which left a worker spinning on a count over an empty list).
/// Safety: `q` is an initialised queue; `m` a packet the caller hands over, unless it is already queued.
@export("mbufq_enqueue")
unsafe fn enqueue(q: *mut mbufq, m: *mut mbuf) -> bool {
    let lock = queueLock(q);
    let state = spin_lock_irqsave(lock);
    let b = Ptr.toBorrowMut(m);
    if ((b.flags & M_QUEUED) != 0) {
        spin_unlock_irqrestore(lock, state);
        var guard = STATS.lock();
        let s = guard.data();
        s.doubleEnqueues = s.doubleEnqueues.wrappingAdd(1);
        KernelLog.write(
            LogLevel.Warn,
            "WARN at kernel-services/network/mbuf.cee: mbufq: an mbuf already on a queue was enqueued again; refused",
        );
        return false;
    }
    b.nextpkt = 0 as *mut mbuf;
    let queue = Ptr.toBorrowMut(q);
    if (queue.len >= queue.maxlen) {
        spin_unlock_irqrestore(lock, state);
        freeChain(m);
        return false;
    }
    b.flags = b.flags | M_QUEUED;
    if (!queue.tail.isNull()) {
        let last = Ptr.toBorrowMut(queue.tail);
        last.nextpkt = m;
    } else {
        queue.head = m;
    }
    queue.tail = m;
    queue.len += 1;
    spin_unlock_irqrestore(lock, state);
    return true;
}

/// mbufq_dequeue: the packet at the head, or null.
/// Safety: `q` is an initialised queue.
@export("mbufq_dequeue")
unsafe fn dequeue(q: *mut mbufq) -> *mut mbuf {
    let lock = queueLock(q);
    let state = spin_lock_irqsave(lock);
    let queue = Ptr.toBorrowMut(q);
    let m = queue.head;
    if (!m.isNull()) {
        let b = Ptr.toBorrowMut(m);
        queue.head = b.nextpkt;
        if (queue.head.isNull()) {
            queue.tail = 0 as *mut mbuf;
        }
        queue.len -= 1;
        b.nextpkt = 0 as *mut mbuf;
        b.flags = b.flags & (M_QUEUED ^ 0xffffffff);
    }
    spin_unlock_irqrestore(lock, state);
    return m;
}

/// mbufq_drain: frees every packet on the queue.
/// Safety: as mbufq_dequeue.
@export("mbufq_drain")
unsafe fn drain(q: *mut mbufq) {
    loop {
        let m = dequeue(q);
        if (m.isNull()) {
            return;
        }
        freeChain(m);
    }
}

/// mbufq_len: how many packets are on the queue.
/// Safety: as mbufq_dequeue.
@export("mbufq_len")
unsafe fn queueLength(q: *mut mbufq) -> u32 {
    let lock = queueLock(q);
    let state = spin_lock_irqsave(lock);
    let n = Ptr.toBorrow(q as *mbufq).len;
    spin_unlock_irqrestore(lock, state);
    return n;
}

// ---- Start-up and statistics ----

/// mbuf_init: the caches. Panics if they cannot be made.
/// Safety: net_init calls it once, before any mbuf is made; kmem_cache_create keeps the names, static strings.
@export("mbuf_init")
unsafe fn init() {
    let mbufs = kmem_cache_create("mbuf\0".ptr as *CChar, layoutOf<mbuf>().size, 64);
    let clusters = kmem_cache_create("mcluster\0".ptr as *CChar, layoutOf<mbuf_cluster>().size, 64);
    MBUF_CACHE.storeWith(mbufs as usize, StoreOrdering.Release);
    CLUSTER_CACHE.storeWith(clusters as usize, StoreOrdering.Release);
    if (mbufs.isNull() || clusters.isNull()) {
        var buffer: [u8; 32] = [0; 32];
        var line = TextWriter.create(mut buffer[..]);
        line.text("mbuf: cannot create caches");
        KernelLog.panic(line);
    }
}

/// mbuf_get_stats: the counters, as one snapshot.
/// Safety: `out` is writable and nothing else uses it meanwhile.
@export("mbuf_get_stats")
unsafe fn getStats(out: *mut mbuf_stats) {
    var guard = STATS.lock();
    let s = guard.data();
    let o = Ptr.toBorrowMut(out);
    o.mbufs_alive = s.mbufsAlive;
    o.clusters_alive = s.clustersAlive;
    o.allocs = s.allocs;
    o.frees = s.frees;
    o.alloc_failures = s.allocFailures;
    o.double_enqueues = s.doubleEnqueues;
}
