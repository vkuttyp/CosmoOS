// nettest_harness.cee - the host harness's guest side, in CeeSafe: roadmap 2.0 SA6 (nettest, the twenty-third batch).
// net-harness, as nettest.c had it (docs/kernel-services/network/testing.md, "The host harness"): echo services over
// the real interface for the harness's port forwards (TCP and UDP on port 7, the write-write-read exchange on port 8),
// and the back-connection to the harness through the gateway, retried up to HARNESS_ATTEMPTS times, which then carries
// the reverse write-write-read exchange. tests/boot/nettest.py and run_boot_test.py read the `NETTEST:` lines, which
// are printed with kprintf as the C printed them, byte for byte.
//
// The services' state (the C's file-scope volatiles) is atomic statics; each service thread takes its socket as its
// argument, holding the reference the harness took for it, and its buffer is a room where the C's took one from
// kmalloc. The debug build's injected break of the first attempts (CONFIG_HARNESS_BREAK, `make test-harness-retry`)
// is nettest.h's constant macro, 0 outside debug builds.

@header("nettest.h", "kernel/fwcfg.h", "kernel/log.h", "kernel/net/inet.h", "kernel/net/tcp.h", "kernel/netif.h", "kernel/socket.h", "kernel/selftest.h", "kernel/sched.h", "kernel/thread.h", "kernel/timer.h")
extern "C" {
    struct netaddr;
    struct thread;
    struct timer {
        expires_ns: u64;
        cpu: u32;
        state: u32;
    }
    struct net_work {
        queued: AtomicU32;
    }
    struct tcp_pcb {
        state: u32;
        rto_ns: u64;
        rexmit: timer;
        work: net_work;
        work_flags: AtomicU32;
    }
    struct socket {
        tcp: *mut tcp_pcb;
    }
    struct netif_ip4 {
        addr: u32;
        gateway: u32;
    }
    struct netif {
        ip4: netif_ip4;
    }
    struct tcp_stats {
        segs_out: u64;
        retransmits: u64;
        rsts_in: u64;
        out_refused: u64;
    }

    /// nettest.h: CONFIG_HARNESS_BREAK in a debug build, 0 otherwise.
    @constant
    fn NETTEST_HARNESS_BREAK() -> u32;

    fn nettest_ksock_create(family: i32, kind: i32, uid: u32, out: *mut *mut socket) -> i32;
    fn nettest_ksock_put(s: *mut socket);

    fn kprintf(format: *CChar, ...);
    fn fwcfg_get_string(key: *CChar, buf: *mut CChar, len: usize) -> bool;
    fn netif_default() -> *mut netif;
    fn netif_put(nif: *mut netif);
    fn ksock_get(s: *mut socket);
    fn ksock_put(s: *mut socket);
    fn ksock_bind(s: *mut socket, addr: *netaddr) -> i32;
    fn ksock_listen(s: *mut socket, backlog: i32) -> i32;
    fn ksock_accept(s: *mut socket, out: *mut *mut socket, peer: *mut netaddr) -> i32;
    fn ksock_connect(s: *mut socket, addr: *netaddr) -> i32;
    fn ksock_sendto(s: *mut socket, buf: *void, len: usize, to: *netaddr) -> i64;
    fn ksock_recvfrom(s: *mut socket, buf: *mut void, len: usize, from: *mut netaddr) -> i64;
    fn ksock_shutdown(s: *mut socket, how: i32) -> i32;
    fn ksock_error(s: *mut socket) -> i32;
    fn tcp_get_stats(out: *mut tcp_stats);
    fn tcp_send_space(pcb: *mut tcp_pcb) -> u32;
    fn tcp_state_of(pcb: *mut tcp_pcb) -> u32;
    fn thread_create(entry: extern "C" fn(*mut void), arg: *mut void, name: *CChar, priority: i32) -> *mut thread;
    fn thread_exit(code: i32);
    fn thread_sleep_ns(ns: u64);
    fn sched_watchdog_kick();
    fn clock_now_ns() -> u64;
}

// ---- syscall.h and the harness's values (asserted against the headers and tests/boot/nettest.py in nettest.c) ----

const AF_INET: u32 = 2;
const AF_INET_I32: i32 = 2;
const SOCK_STREAM: i32 = 1;
const SOCK_DGRAM: i32 = 2;
const SHUT_RD: i32 = 0;
const SHUT_RDWR: i32 = 2;
/// The write-write-read exchange: a request of two WWR_HALF-byte halves; WWR_ROUNDS rounds per mode
/// (tests/boot/nettest.py carries the same two constants).
const WWR_HALF: usize = 16;
const WWR_ROUNDS: usize = 50;
/// How many times the guest will run the back-connection exchange (see net-harness below).
const HARNESS_ATTEMPTS: u32 = 3;
const MS: u64 = 1000000;
/// INADDR_LOOPBACK_N: 127.0.0.1 in network order, as it lies in a little-endian u32.
const LOOPBACK_N: u32 = 0x0100007f;

/// The first attempts broken on purpose (`make test-harness-retry`): CONFIG_HARNESS_BREAK in a debug build.
static BREAK_ATTEMPTS: u32 = NETTEST_HARNESS_BREAK();

/// A failed check: its reason, for the runner's report, and false.
/// Safety: `reason` is the runner's; `why` is a zero-terminated literal, which outlives the report.
fn failed(reason: *mut *CChar, why: StringView) -> bool {
    unsafe {
        let r = Ptr.toBorrowMut(reason);
        put(r, why.ptr as *CChar);
    }
    return false;
}

fn put(slot: borrow mut *CChar, why: *CChar) {
    slot = why;
}

/// Safety: a sleep of the calling thread's.
fn sleepMs(ms: u64) {
    unsafe {
        thread_sleep_ns(ms * MS);
    }
}

/// Safety: the monotonic clock.
fn now() -> u64 => unsafe { clock_now_ns() };

/// `line` and a newline through kprintf, as the C's kprintf printed the same text.
/// Safety: kprintf with a %s format and the writer's zero-terminated text.
fn print(line: borrow TextWriter) {
    unsafe {
        kprintf("%s\n\0".ptr as *CChar, line.cText());
    }
}

/// A struct netaddr for `ip`:`port`, as five words (its size and alignment, asserted in nettest.c): the family and the
/// port (host order) in the first, as they lie in a little-endian u32, then the address.
fn v4addr(ip: u32, port: u16) -> [u32; 5] => [AF_INET | ((port as u32) << 16), ip, 0, 0, 0];

fn na(a: borrow [u32; 5]) -> *netaddr => a as *[u32; 5] as *netaddr;

// ---- The services ----

// The services' state (the C's g_h_quit, g_h_stop and counters).
static QUIT: AtomicU32 = AtomicU32.constant(0);
static STOP: AtomicU32 = AtomicU32.constant(0);
static TCP_CONNS: AtomicU32 = AtomicU32.constant(0);
static UDP_PKTS: AtomicU32 = AtomicU32.constant(0);
static WWR_CONNS: AtomicU32 = AtomicU32.constant(0);
// The echo services' buffers (the C's kmalloc'd 8 KiB and 2 KiB), each its thread's.
static mut TCP_BUF: [u8; 8192] = [0; 8192];
static mut UDP_BUF: [u8; 2048] = [0; 2048];

/// The write-write-read service on port 8 (docs/kernel-services/network/testing.md, "The host harness"): each request
/// of two WWR_HALF-byte halves, written as two sends, is answered with the request once both halves are in. The host
/// drives it with its default socket (Nagle on) and again with TCP_NODELAY.
/// Safety: `arg` is the listener, with the reference the harness took for this thread.
@callback
unsafe fn wwrMain(arg: *mut void) {
    let ls = arg as *mut socket;
    while (true) {
        var c = 0 as *mut socket;
        if (ksock_accept(ls, borrow mut c as *mut *mut socket, 0 as *mut netaddr) != 0) {
            break;
        }
        WWR_CONNS.fetchAddWith(1, Ordering.Relaxed);
        var req: [u8; 32] = [0; 32];
        let at = borrow mut req as *mut [u8; 32] as *mut u8;
        while (true) {
            var have: usize = 0;
            var eof = false;
            while (have < 2 * WWR_HALF) {
                let n = ksock_recvfrom(c, at.add(have) as *mut void, 2 * WWR_HALF - have, 0 as *mut netaddr);
                if (n <= 0) {
                    eof = true;
                    break;
                }
                have += truncate<usize>(n);
            }
            if (eof || ksock_sendto(c, at as *void, 2 * WWR_HALF, 0 as *netaddr) != 32) {
                break;
            }
        }
        ksock_put(c);
    }
    ksock_put(ls); // its own reference: the harness took one for it
    thread_exit(0);
}

/// The TCP echo on port 7, until a connection says QUIT.
/// Safety: as wwrMain.
@callback
unsafe fn tcpEchoMain(arg: *mut void) {
    let ls = arg as *mut socket;
    let buf = borrow mut TCP_BUF as *mut [u8; 8192] as *mut u8;
    while (true) {
        var c = 0 as *mut socket;
        if (ksock_accept(ls, borrow mut c as *mut *mut socket, 0 as *mut netaddr) != 0) {
            break;
        }
        TCP_CONNS.fetchAddWith(1, Ordering.Relaxed);
        var quit = false;
        while (true) {
            let n = ksock_recvfrom(c, buf as *mut void, 8192, 0 as *mut netaddr);
            if (n <= 0) {
                break;
            }
            let b = Slice.fromRaw(buf as *u8, 4);
            if (n >= 4 && b[0] == 0x51 && b[1] == 0x55 && b[2] == 0x49 && b[3] == 0x54) { // "QUIT"
                quit = true;
                break;
            }
            if (ksock_sendto(c, buf as *void, truncate<usize>(n), 0 as *netaddr) != n) {
                break;
            }
        }
        ksock_put(c);
        if (quit) {
            QUIT.storeWith(1, StoreOrdering.Release);
            break;
        }
    }
    ksock_put(ls); // its own reference: the harness took one for it
    thread_exit(0);
}

/// The UDP echo on port 7, until told to stop.
/// Safety: `arg` is the socket, with the reference the harness took for this thread.
@callback
unsafe fn udpEchoMain(arg: *mut void) {
    let s = arg as *mut socket;
    let buf = borrow mut UDP_BUF as *mut [u8; 2048] as *mut u8;
    while (STOP.loadWith(LoadOrdering.Acquire) == 0) {
        var from: [u32; 5] = [0; 5];
        let n = ksock_recvfrom(s, buf as *mut void, 2048, borrow mut from as *mut [u32; 5] as *mut netaddr);
        if (n <= 0) {
            break;
        }
        if (STOP.loadWith(LoadOrdering.Acquire) != 0) {
            break;
        }
        UDP_PKTS.fetchAddWith(1, Ordering.Relaxed);
        ksock_sendto(s, buf as *void, truncate<usize>(n), na(borrow from));
    }
    ksock_put(s); // its own reference: the harness took one for it
    thread_exit(0);
}

// ---- The reverse write-write-read exchange ----

// Each mode's round times, in microseconds (the C's static us[2][WWR_ROUNDS]).
static mut ROUND_US: [u64; 100] = [0; 100];

/// Insertion sort of a mode's round times.
fn sortRounds(v: SliceMut<u64>) {
    for (i in 1..v.length) {
        let x = v[i];
        var j = i;
        while (j > 0 && v[j - 1] > x) {
            v[j] = v[j - 1];
            j -= 1;
        }
        v[j] = x;
    }
}

/// "NETTEST: wwr guest-client: <what> in mode <m> round <r>" for a round that did not complete.
fn roundFailed(what: StringView, m: u32, r: u32) {
    var buffer: [u8; 160] = [0; 160];
    var line = TextWriter.create(mut buffer[..]);
    line.text("NETTEST: wwr guest-client: ");
    line.text(what);
    line.text(" in mode ");
    line.decimal(m as u64);
    line.text(" round ");
    line.decimal(r as u64);
    print(borrow line);
}

/// The guest's side of the reverse exchange, on the back-connection after the hello: WWR_ROUNDS rounds with the host's
/// Nagle on, then WWR_ROUNDS with it off (the host switches after the first batch). Prints one line per mode; false if
/// a round did not complete.
/// Safety: `c` is the connected back-connection; ROUND_US is this test's.
unsafe fn wwrClient(c: *mut socket) -> bool {
    var half: [u8; 16] = [0x77; 16]; // 'w'
    var reply: [u8; 32] = [0; 32];
    let halfAt = borrow half as *[u8; 16] as *void;
    let replyAt = borrow mut reply as *mut [u8; 32] as *mut u8;
    for (m in 0..2) {
        let mode = truncate<u32>(m);
        for (r in 0..WWR_ROUNDS) {
            let round = truncate<u32>(r);
            let t0 = now();
            if (ksock_sendto(c, halfAt, WWR_HALF, 0 as *netaddr) != 16 ||
                ksock_sendto(c, halfAt, WWR_HALF, 0 as *netaddr) != 16) {
                roundFailed("send failed", mode, round);
                return false;
            }
            var have: usize = 0;
            while (have < 2 * WWR_HALF) {
                let n = ksock_recvfrom(c, replyAt.add(have) as *mut void, 2 * WWR_HALF - have, 0 as *mut netaddr);
                if (n <= 0) {
                    var buffer: [u8; 160] = [0; 160];
                    var line = TextWriter.create(mut buffer[..]);
                    line.text("NETTEST: wwr guest-client: recv ");
                    line.signed(n);
                    line.text(" in mode ");
                    line.decimal(mode as u64);
                    line.text(" round ");
                    line.decimal(round as u64);
                    line.text(" after ");
                    line.decimal(have as u64);
                    line.text(" bytes");
                    print(borrow line);
                    return false;
                }
                have += truncate<usize>(n);
            }
            ROUND_US[truncate<usize>(m) * WWR_ROUNDS + r] = (now() - t0) / 1000;
            var same = true;
            for (k in 0..2 * WWR_HALF) {
                if (reply[k] != half[k % WWR_HALF]) {
                    same = false;
                }
            }
            if (!same) {
                roundFailed("the reply is not the request", mode, round);
                return false;
            }
        }
        let base = truncate<usize>(m) * WWR_ROUNDS;
        let us = SliceMut.fromRaw((borrow mut ROUND_US as *mut [u64; 100] as *mut u64).add(base), WWR_ROUNDS);
        sortRounds(us);
        var buffer: [u8; 160] = [0; 160];
        var line = TextWriter.create(mut buffer[..]);
        line.text("NETTEST: wwr guest-client host-nagle=");
        line.text(if (m == 0) "on" else "off");
        line.text(" rounds=");
        line.decimal(WWR_ROUNDS as u64);
        line.text(" min=");
        line.decimal(us[0]);
        line.text(" p50=");
        line.decimal(us[WWR_ROUNDS / 2]);
        line.text(" p90=");
        line.decimal(us[WWR_ROUNDS * 9 / 10]);
        line.text(" max=");
        line.decimal(us[WWR_ROUNDS - 1]);
        line.text(" us");
        print(borrow line);
    }
    return true;
}

// ---- The back-connection ----

/// TCP's counters the failure line reads.
struct Tcp {
    segsOut: u64;
    retransmits: u64;
    refused: u64;
    rstsIn: u64;
}

static mut TCP_ROOM: [u64; 128] = [0; 128];

/// Safety: the runner runs one test at a time, so the room is this test's.
unsafe fn tcpNow() -> Tcp {
    let p = borrow mut TCP_ROOM as *mut [u64; 128] as *mut tcp_stats;
    tcp_get_stats(p);
    let s = Ptr.toBorrow(p as *tcp_stats);
    return Tcp { segsOut: s.segs_out, retransmits: s.retransmits, refused: s.out_refused, rstsIn: s.rsts_in };
}

/// "NETTEST: <text> (attempt|...) <a> of <HARNESS_ATTEMPTS>" lines.
fn attemptLine(before: StringView, a: u32, after: StringView) {
    var buffer: [u8; 96] = [0; 96];
    var line = TextWriter.create(mut buffer[..]);
    line.text(before);
    line.decimal(a as u64);
    line.text(" of ");
    line.decimal(HARNESS_ATTEMPTS as u64);
    line.text(after);
    print(borrow line);
}

/// One attempt at the back-connection: the hello, then the reverse exchange. `wwrOk` says whether that completed too.
/// Every attempt's outcome is printed, so a passing boot whose first attempt was reset is still a sighting.
/// Safety: the runner's `reason`; `host` is the harness's address.
unsafe fn attemptOnce(reason: *mut *CChar, attempt: u32, host: borrow [u32; 5], wwrOk: borrow mut bool) -> i32 {
    var c = 0 as *mut socket;
    if (nettest_ksock_create(AF_INET_I32, SOCK_STREAM, 0, borrow mut c as *mut *mut socket) != 0) {
        failed(reason, "check failed: nt_ksock_create(COSMO_AF_INET, COSMO_SOCK_STREAM, 0, &c) == 0\0");
        return -1; // a CHECK: the test fails here
    }
    // Sampled BEFORE the connect. PR #169's window opened after it returned, so a reset arriving during the handshake
    // or before the first sample fell outside it -- which is why one failure showed `rsts_in +0` and another `+1` for
    // the same defect.
    let t0 = tcpNow();
    let ns0 = now();
    let rc = ksock_connect(c, na(host));
    let connectMs = (now() - ns0) / MS;
    if (rc == 0 && attempt <= BREAK_ATTEMPTS) {
        // The injected shape: connected, and then unusable.
        ksock_shutdown(c, SHUT_RDWR);
        var buffer: [u8; 64] = [0; 64];
        var line = TextWriter.create(mut buffer[..]);
        line.text("NETTEST: attempt ");
        line.decimal(attempt as u64);
        line.text(" broken on purpose");
        print(borrow line);
    }

    // This exchange has failed repeatedly, on both architectures and on CI and locally (the tally is kept in
    // docs/testing/flakes.md, "The count", and deliberately nowhere else), and once said only "client failed (0)" --
    // the *connect's* result, printed for a failure in a later step (docs/audit/next-subsystem-twelve-bytes.md).
    //
    // What is asked instead is the connection itself. Data sits in the send buffer until it is acknowledged, so
    // `space` before the send, after it and after the read says whether the twelve bytes were queued and whether they
    // were ever acknowledged -- for this connection, which the global counters below cannot be, since they count this
    // connect's own SYN and every other socket's traffic.
    //
    // The distinction matters because QEMU's user-mode networking is a proxy rather than a wire: it terminates the
    // guest's TCP in its own stack and writes onward to a separate host socket, so it acknowledges these bytes into its
    // own buffer before the host has seen them. A drained send buffer with nothing at the far end is therefore a real
    // and expected outcome, and it is the one that says this kernel is not at fault.
    var sent: i64 = -1;
    var got: i64 = -1;
    var space0: u32 = 0;
    var space1: u32 = 0;
    var space2: u32 = 0;
    var sendMs: u64 = 0;
    var recvMs: u64 = 0;
    var clientOk = false;
    let pcb = Ptr.toBorrow(c as *socket).tcp;
    if (rc == 0) {
        space0 = tcp_send_space(pcb);
        let ns1 = now();
        sent = ksock_sendto(c, "cosmo hello\n".ptr as *void, 12, 0 as *netaddr);
        sendMs = (now() - ns1) / MS;
        space1 = tcp_send_space(pcb);
        if (sent == 12) {
            var buf: [u8; 32] = [0; 32];
            let ns2 = now();
            got = ksock_recvfrom(c, borrow mut buf as *mut [u8; 32] as *mut void, 32, 0 as *mut netaddr);
            recvMs = (now() - ns2) / MS;
            let want = "cosmo world\n".bytes();
            clientOk = got == 12;
            for (k in 0..12) {
                if (buf[truncate<usize>(k)] != want[truncate<usize>(k)]) {
                    clientOk = false;
                }
            }
        }
        space2 = tcp_send_space(pcb);
    }
    // The reverse write-write-read exchange rides on this connection once the hello has been answered: the host serves
    // it before closing.
    wwrOk = clientOk && wwrClient(c);
    let t1 = tcpNow();
    let st = tcp_state_of(pcb);
    // The socket's own verdict: `rsts_in` is machine-wide and says a reset happened somewhere, where this names the
    // errno THIS connection died of.
    let pending = ksock_error(c);
    // The connection's timer and work state, read while the socket is still ours: the put below closes the pcb and
    // frees the socket.
    var rxState: i32 = -1;
    var rxCpu: u32 = 0;
    var rxInMs: i64 = 0;
    var rtoMs: u64 = 0;
    var workQueued: i32 = -1;
    var workFlags: u32 = 0;
    var pcbState: i32 = -1;
    if (!pcb.isNull()) {
        let p = Ptr.toBorrow(pcb as *tcp_pcb);
        rxState = truncate<i32>(p.rexmit.state);
        rxCpu = p.rexmit.cpu;
        rxInMs = (truncate<i64>(p.rexmit.expires_ns) - truncate<i64>(now())) / 1000000;
        rtoMs = p.rto_ns / MS;
        workQueued = truncate<i32>(p.work.queued.loadWith(LoadOrdering.Acquire));
        workFlags = p.work_flags.loadWith(LoadOrdering.Acquire);
        pcbState = truncate<i32>(p.state);
    }
    nettest_ksock_put(c);
    if (clientOk) {
        attemptLine("NETTEST: client ok (attempt ", attempt, ")");
        return 1;
    }
    // The three samples are labelled by *when*, not by what they are taken to mean. space1 is read after ksock_sendto
    // has released the pcb lock, so an acknowledgement can already have drained the buffer -- "outstanding after the
    // send" is 0 in that case and nothing is wrong, whereas calling it "queued" would print `sent 12, queued 0` and
    // contradict itself. The discriminator is the third: still outstanding after the read gave up means the twelve
    // bytes were never acknowledged.
    //
    // The connection's own timer and work state first, on a short line of its own: the long line below has been cut
    // mid-way by another thread's print in the logs this is for.
    var b1: [u8; 192] = [0; 192];
    var l1 = TextWriter.create(mut b1[..]);
    l1.text("NETTEST: client state: rexmit timer state ");
    l1.signed(rxState as i64);
    l1.text(" on cpu ");
    l1.decimal(rxCpu as u64);
    l1.text(" expiring in ");
    l1.signed(rxInMs);
    l1.text(" ms (rto ");
    l1.decimal(rtoMs);
    l1.text(" ms), work queued ");
    l1.signed(workQueued as i64);
    l1.text(" flags 0x");
    l1.hex(workFlags as u64, 1);
    l1.text(", pcb state ");
    l1.signed(pcbState as i64);
    print(borrow l1);
    var b2: [u8; 512] = [0; 512];
    var l2 = TextWriter.create(mut b2[..]);
    l2.text("NETTEST: client failed: connect ");
    l2.signed(rc as i64);
    l2.text(" in ");
    l2.decimal(connectMs);
    l2.text(" ms, sent ");
    l2.signed(sent);
    l2.text(" in ");
    l2.decimal(sendMs);
    l2.text(" ms, recv ");
    l2.signed(got);
    l2.text(" in ");
    l2.decimal(recvMs);
    l2.text(" ms, pending error ");
    l2.signed(pending as i64);
    l2.text(", sndbuf free ");
    l2.decimal(space0 as u64);
    l2.text(" before, ");
    l2.decimal(space1 as u64);
    l2.text(" after send, ");
    l2.decimal(space2 as u64);
    l2.text(" after read (outstanding ");
    l2.signed(truncate<i32>((space0 as i64) - (space1 as i64)) as i64);
    l2.text(" then ");
    l2.signed(truncate<i32>((space0 as i64) - (space2 as i64)) as i64);
    l2.text("), state ");
    l2.signed(truncate<i32>(st) as i64);
    l2.text(", segs_out +");
    l2.decimal(t1.segsOut - t0.segsOut);
    l2.text(" retransmits +");
    l2.decimal(t1.retransmits - t0.retransmits);
    l2.text(" refused +");
    l2.decimal(t1.refused - t0.refused);
    l2.text(" rsts_in +");
    l2.decimal(t1.rstsIn - t0.rstsIn);
    l2.text(" (counters from before the connect)");
    print(borrow l2);
    attemptLine("NETTEST: client attempt ", attempt, " failed");
    return 0;
}

/// The harness's back port from opt/cosmo/nettest's `tcp=<port>`, 0 for none.
fn backPort(cfg: borrow [u8; 64]) -> u32 {
    var port: u32 = 0;
    if (cfg[0] == 0x74 && cfg[1] == 0x63 && cfg[2] == 0x70 && cfg[3] == 0x3d) { // "tcp="
        var k: usize = 4;
        while (k < 64 && cfg[k] >= 0x30 && cfg[k] <= 0x39) {
            port = port * 10 + ((cfg[k] - 0x30) as u32);
            k += 1;
        }
    }
    return port;
}

/// A socket of the test's bound to any address on `port` (and listening, for a stream); null when a step failed.
/// Safety: thread context.
unsafe fn service(kind: i32, port: u16) -> *mut socket {
    var s = 0 as *mut socket;
    if (nettest_ksock_create(AF_INET_I32, kind, 0, borrow mut s as *mut *mut socket) != 0) {
        return 0 as *mut socket;
    }
    let a = v4addr(0, port);
    if (ksock_bind(s, na(borrow a)) != 0 || (kind == SOCK_STREAM && ksock_listen(s, 4) != 0)) {
        return 0 as *mut socket;
    }
    return s;
}

/// A service thread over `s`, which takes a reference of its own; false when it could not be made.
/// Safety: `s` is a socket of the test's.
unsafe fn serve(entry: extern "C" fn(*mut void), s: *mut socket, name: StringView) -> bool {
    return !thread_create(entry, s as *mut void, name.ptr as *CChar, 32).isNull();
}

/// net-harness: echo services for the host harness, and the back-connection to it.
/// Safety: the runner's `reason`.
@export("selftest_net_harness")
unsafe fn harness(reason: *mut *CChar) -> bool {
    var cfg: [u8; 64] = [0; 64];
    if (!fwcfg_get_string("nettest\0".ptr as *CChar, borrow mut cfg as *mut [u8; 64] as *mut CChar, 64)) {
        var buffer: [u8; 96] = [0; 96];
        var line = TextWriter.create(mut buffer[..]);
        line.text("selftest: net-harness: no opt/cosmo/nettest parameter; skipping");
        KernelLog.send(LogLevel.Info, line);
        return true;
    }
    let nif = netif_default();
    if (nif.isNull() || Ptr.toBorrow(nif as *netif).ip4.addr == 0) {
        return failed(reason, "check failed: nif != NULL && nif->ip4.addr != 0\0");
    }
    let gateway = Ptr.toBorrow(nif as *netif).ip4.gateway;
    netif_put(nif);
    let hostport = backPort(borrow cfg);
    if (hostport == 0 || hostport >= 65536) {
        return failed(reason, "check failed: hostport > 0 && hostport < 65536\0");
    }

    // Echo services on port 7 for the harness's port forwards, and the write-write-read service on port 8.
    let tls = service(SOCK_STREAM, 7);
    if (tls.isNull()) {
        return failed(reason, "check failed: the TCP echo listener on port 7\0");
    }
    let us = service(SOCK_DGRAM, 7);
    if (us.isNull()) {
        return failed(reason, "check failed: the UDP echo socket on port 7\0");
    }
    let wls = service(SOCK_STREAM, 8);
    if (wls.isNull()) {
        return failed(reason, "check failed: the write-write-read listener on port 8\0");
    }
    QUIT.storeWith(0, StoreOrdering.Relaxed);
    STOP.storeWith(0, StoreOrdering.Relaxed);
    TCP_CONNS.storeWith(0, StoreOrdering.Relaxed);
    UDP_PKTS.storeWith(0, StoreOrdering.Relaxed);
    WWR_CONNS.storeWith(0, StoreOrdering.Relaxed);
    ksock_get(tls);
    ksock_get(us);
    ksock_get(wls);
    if (!serve(tcpEchoMain, tls, "nettest-tcp\0")) {
        return failed(reason, "check failed: thread_create(h_tcp_echo_thread, tls, \"nettest-tcp\", 32) != NULL\0");
    }
    if (!serve(udpEchoMain, us, "nettest-udp\0")) {
        return failed(reason, "check failed: thread_create(h_udp_echo_thread, us, \"nettest-udp\", 32) != NULL\0");
    }
    if (!serve(wwrMain, wls, "nettest-wwr\0")) {
        return failed(reason, "check failed: thread_create(h_wwr_thread, wls, \"nettest-wwr\", 32) != NULL\0");
    }
    kprintf("NETTEST: ready tcp=7 udp=7 wwr=8\n\0".ptr as *CChar);

    // Connect back to the harness through the gateway (QEMU forwards 10.0.2.2 to the host's loopback), and do it up
    // to HARNESS_ATTEMPTS times.
    //
    // The retry is not for this kernel's benefit. QEMU's user-mode networking resets the guest's half of one
    // connection while keeping its own half open, and answers a probe through the same instance a millisecond later;
    // the guest is correct from first SYN to final reset, verified against a packet capture. Three units localised
    // that, and a fourth could only find the same answer, because what is left is in slirp's source
    // (docs/audit/next-subsystem-nettest-retry.md). Three attempts, and the number comes from the shape of the defect
    // rather than taste: every recorded sighting is a *single* connection being reset, never a sequence, and slirp
    // answered a probe through the same instance in 1 ms while one connection was dead. If a second and a third
    // attempt both die, what is being measured is no longer the flake this bound was written for, and the test says so
    // by failing.
    //
    // So the exchange retries, and three things keep it honest: the bound is a **failure**, not a fallback --
    // exhausting it fails the test exactly as one reset does, with every attempt's full diagnostics; every attempt
    // prints those diagnostics, so a boot that needed a second one says what went wrong with the first; and both
    // outcome lines name the attempt, so a *passing* boot whose first attempt was reset is still a sighting, countable
    // by the same grep, and `docs/testing/flakes.md` keeps counting it. A retry that hid the flake would be worse than
    // the flake.
    //
    // The debug build's injected break (`make test-harness-retry`) shuts the first CONFIG_HARNESS_BREAK attempts down
    // both ways after the connect, which is the shape the defect leaves behind -- a connection that completed its
    // handshake and cannot carry the exchange -- so the retry path runs on every boot of a build that asks for it.
    var clientOk = false;
    var wwrOk = false;
    let host = v4addr(gateway, truncate<u16>(hostport));
    var attempt: u32 = 1;
    while (attempt <= HARNESS_ATTEMPTS && !clientOk) {
        let r = attemptOnce(reason, attempt, borrow host, mut wwrOk);
        if (r < 0) {
            return false;
        }
        clientOk = r == 1;
        attempt += 1;
    }
    if (!clientOk) {
        attemptLine("NETTEST: client failed every attempt (", HARNESS_ATTEMPTS, ")");
    }

    // Serve echo until the harness sends QUIT (60 s budget).
    for (i in 0..6000) {
        if (QUIT.loadWith(LoadOrdering.Acquire) != 0) {
            break;
        }
        sleepMs(10);
        sched_watchdog_kick();
    }
    STOP.storeWith(1, StoreOrdering.Release);
    ksock_shutdown(tls, SHUT_RD); // accept returns
    ksock_shutdown(wls, SHUT_RD);
    let self = v4addr(LOOPBACK_N, 7);
    ksock_sendto(us, "x".ptr as *void, 1, na(borrow self)); // the UDP thread wakes and exits
    sleepMs(50);
    let quit = QUIT.loadWith(LoadOrdering.Acquire) != 0;
    var buffer: [u8; 128] = [0; 128];
    var line = TextWriter.create(mut buffer[..]);
    line.text("NETTEST: done tcp_conns=");
    line.decimal(TCP_CONNS.loadWith(LoadOrdering.Relaxed) as u64);
    line.text(" udp_pkts=");
    line.decimal(UDP_PKTS.loadWith(LoadOrdering.Relaxed) as u64);
    line.text(" wwr_conns=");
    line.decimal(WWR_CONNS.loadWith(LoadOrdering.Relaxed) as u64);
    line.text(" quit=");
    line.text(if (quit) "1" else "0");
    print(borrow line);
    nettest_ksock_put(tls);
    nettest_ksock_put(us);
    nettest_ksock_put(wls);
    if (!clientOk) {
        return failed(reason, "check failed: client_ok\0");
    }
    if (!wwrOk) {
        return failed(reason, "check failed: wwr_ok\0");
    }
    if (!quit) {
        return failed(reason, "check failed: g_h_quit\0");
    }
    return true;
}
