// nettest_hostin.cee - the host chain, in CeeSafe: roadmap 2.0 SA6 (nettest, the tenth batch). net-hostinput, as
// nettest.c had it (docs/audit/next-subsystem-host-input.md), and the world side of the uplink tap every host test
// drives a connection by hand with -- exported as nettest_hin_mk_tcp, nettest_hin_send, nettest_hin_recv,
// nettest_hin_drain, nettest_hin_recv_stream, nettest_hin_accept, nettest_hin_recv_sock, nettest_hin_udp_listener
// and nettest_hin_tcp_listener (nettest.h) for the host-state tests. The datagram read back, struct hin_seg, is
// nettest.h's; the host's own outbound connect, whose thread may outlive the test, is nettest_frame.cee's, behind
// nettest_hin_connect, nettest_hin_connect_done and nettest_hin_connect_join.
//
// An address is a [u32; 5], struct netaddr's size and alignment (asserted in nettest_floor.c): the family and the port
// (host order) in its first word as they lie in memory, the IPv4 address in the second.

@header("nettest.h", "kernel/net/inet.h", "kernel/net/ip.h", "kernel/net/ether.h", "kernel/net/tcp.h", "kernel/net/udp.h", "kernel/net/nat.h", "kernel/net/fw.h", "kernel/net/tap.h", "uapi/cosmo/netctl.h", "kernel/netif.h", "kernel/mbuf.h", "kernel/socket.h", "kernel/vfs.h", "kernel/selftest.h", "kernel/thread.h")
extern "C" {
    struct netaddr;
    struct netif;
    struct file;
    struct tap;
    struct socket;
    struct mbuf;
    struct hin_seg {
        src: u32;
        dst: u32;
        proto: u8;
        flags: u8;
        sport: u16;
        dport: u16;
        win: u16;
        paylen: u16;
        seq: u32;
        ack: u32;
    }
    struct fw_stats {
        in_accept_rule: u64;
        hin_accept_rule: u64;
        hin_drop_rule: u64;
        hin_accept_default: u64;
        hin_drop_default: u64;
    }
    struct ip_stats {
        in_filtered: u64;
        rx_offlink: u64;
        hin_quiet: u64;
        icmp_quiet_dropped: u64;
    }
    struct tcp_stats {
        retransmits: u64;
        rsts_in: u64;
        syn_cached: u64;
        syn_cookies_sent: u64;
        challenge_acks: u64;
        keepalive_probes: u64;
        quiet_dropped: u64;
    }
    struct udp_stats {
        quiet_dropped: u64;
    }
    struct fw_rule {
        direction: u8;
        proto: u8;
        verdict: u8;
        dst_port: u16;
        src_prefix: u8;
        src_ip: u32;
    }
    struct cosmo_netctl_filter {
        version: u16;
        op: u16;
        guest_addr: u32;
        direction: u8;
        proto: u8;
        verdict: u8;
        dst_port: u16;
        src_addr: u32;
        src_prefix: u8;
    }
    struct cosmo_netctl_list {
        count: u16;
    }
    struct cosmo_netctl_rule {
        proto: u8;
    }
    struct cosmo_netctl_filter_list {
        version: u16;
        rule_count: u16;
        guest_count: u16;
    }
    struct cosmo_netctl_filter_guest {
        guest_addr: u32;
        policy_from_uplink: u8;
    }
    struct cosmo_netctl_filter_rule {
        guest_addr: u32;
        direction: u8;
        verdict: u8;
        dst_port: u16;
        src_addr: u32;
        src_prefix: u8;
    }

    fn nettest_tap_create(name: *CChar, ip: u32, mask: u32, mac: *u8) -> *mut tap;
    fn nettest_tap_destroy(t: *mut tap);
    fn nettest_vfs_open(path: *CChar, flags: u32, out: *mut *mut file) -> i32;
    fn nettest_file_put(f: *mut file);
    fn nettest_ksock_create(family: i32, kind: i32, uid: u32, out: *mut *mut socket) -> i32;
    fn nettest_ksock_accept(s: *mut socket, out: *mut *mut socket, peer: *mut netaddr) -> i32;
    fn nettest_ksock_put(s: *mut socket);
    fn nettest_tcp_set_keepalive(idleNs: u64, intvlNs: u64, cnt: u32);
    fn nettest_hin_connect(ip: u32, port: u16, name: *CChar) -> bool;
    fn nettest_hin_connect_done(rc: *mut i32) -> bool;
    fn nettest_hin_connect_join() -> *mut socket;
    fn nettest_seed_arp(nif: *mut netif, peerIp: u32, peerMac: *u8);
    fn nettest_l4cksum(sip: u32, dip: u32, proto: u8, l4: *void, len: u16) -> u16;
    fn nettest_wrap(
        frame: *mut u8,
        dmac: *u8,
        smac: *u8,
        sip: u32,
        dip: u32,
        ttl: u8,
        proto: u8,
        l4: *void,
        l4len: u16,
    ) -> u32;
    fn nettest_mk_udp(l4: *mut u8, sip: u32, dip: u32, sp: u16, dp: u16, pl: *u8, pllen: u16) -> u16;
    fn nettest_fwt_send(
        from: *mut file,
        tapmac: *u8,
        gmac: *u8,
        sip: u32,
        dip: u32,
        proto: u8,
        l4: *u8,
        l4len: u16,
    ) -> bool;
    fn nettest_fwt_recv(to: *mut file, rx: *mut u8, cap: usize, tries: u32) -> i64;
    fn nettest_fwt_mk_icmp_ck(l4: *mut u8, kind: u8, id: u16) -> u16;

    fn tap_netif(t: *mut tap) -> *mut netif;
    fn tap_inject(t: *mut tap, frame: *void, len: u32) -> i32;
    fn tap_recv(t: *mut tap) -> *mut mbuf;
    fn m_freem(m: *mut mbuf);
    fn m_length(m: *mbuf) -> u32;
    fn m_copydata(m: *mbuf, off: u32, len: u32, to: *mut void) -> bool;
    fn ksock_bind(s: *mut socket, addr: *netaddr) -> i32;
    fn ksock_listen(s: *mut socket, backlog: i32) -> i32;
    fn ksock_connect(s: *mut socket, addr: *netaddr) -> i32;
    fn ksock_sendto(s: *mut socket, buf: *void, len: usize, to: *netaddr) -> i64;
    fn ksock_recvfrom(s: *mut socket, buf: *mut void, len: usize, from: *mut netaddr) -> i64;
    fn ksock_set_nonblock(s: *mut socket, on: bool);
    fn file_read(f: *mut file, buf: *mut void, len: usize) -> i64;
    fn file_write(f: *mut file, buf: *void, len: usize) -> i64;
    fn netif_find(name: *CChar) -> *mut netif;
    fn netif_put(nif: *mut netif);
    fn ipv4_get_stats(out: *mut ip_stats);
    fn tcp_get_stats(out: *mut tcp_stats);
    fn udp_get_stats(out: *mut udp_stats);
    fn nat_flush();
    fn nat_pf_add(proto: u8, hostPort: u16, guestIp: u32, guestPort: u16) -> i32;
    fn nat_pf_del(proto: u8, hostPort: u16) -> bool;
    fn fw_flush();
    fn fw_get_stats(out: *mut fw_stats);
    fn fw_policy_set(guestIp: u32, direction: u8, verdict: u8) -> i32;
    fn fw_policy_get(
        guestIp: u32,
        toUplink: *mut u8,
        toGuest: *mut u8,
        toHost: *mut u8,
        fromUplink: *mut u8,
        output: *mut u8,
    ) -> i32;
    fn fw_rule_add(guestIp: u32, atIndex: u32, r: *fw_rule) -> i32;
    fn fw_rule_del(guestIp: u32, r: *fw_rule) -> i32;
    fn fw_rule_list(guestIp: u32, out: *mut fw_rule, max: u32) -> u32;
    fn thread_sleep_ns(ns: u64);
}

// ---- errno.h, ip.h, tcp.h, fw.h, netctl.h, socket values (asserted in nettest_floor.c) ----

const ENOENT: i32 = 2;
const EAGAIN: i32 = 11;
const EINVAL: i32 = 22;
const ECONNRESET: i32 = 104;
const ETH_HLEN: usize = 14;
const ETH_HLEN32: u32 = 14;
const IPPROTO_ICMP: u8 = 1;
const IPPROTO_TCP: u8 = 6;
const IPPROTO_UDP: u8 = 17;
const ICMP_ECHO_REPLY: u8 = 0;
const ICMP_DEST_UNREACH: u8 = 3;
const ICMP_ECHO: u8 = 8;
const TH_FIN: u8 = 0x01;
const TH_SYN: u8 = 0x02;
const TH_RST: u8 = 0x04;
const TH_PSH: u8 = 0x08;
const TH_ACK: u8 = 0x10;
const TCP_CHALLENGE_PER_SEC: u64 = 100;
const FW_DROP: u8 = 0;
const FW_ACCEPT: u8 = 1;
const FW_DIR_ANY: u8 = 0;
const FW_DIR_TO_HOST: u8 = 3;
const FW_DIR_FROM_UPLINK: u8 = 4;
const FW_HOST_GUEST_IP: u32 = 0;
const NETCTL_VERSION: u16 = 8;
const NETCTL_FILTER_ADD: u16 = 3;
const NETCTL_FILTER_DEL: u16 = 4;
const NETCTL_PROTO_TCP: u8 = 6;
const NETCTL_DIR_TO_HOST: u8 = 3;
const NETCTL_DIR_FROM_UPLINK: u8 = 4;
const NETCTL_VERDICT_DROP: u8 = 0;
const NETCTL_VERDICT_ACCEPT: u8 = 1;
const NETCTL_HOST_ADDR: u32 = 0;
const O_RDWR: u32 = 0x0002;
const O_NONBLOCK: u32 = 0x0800;
const AF_INET: u32 = 2;
const AF_INET_S: i32 = 2;
const SOCK_STREAM: i32 = 1;
const SOCK_DGRAM: i32 = 2;
/// The C's HIN_TRIES: how long a *positive* wait polls (it returns as soon as what it waits for arrives).
const HIN_TRIES: u32 = 200;
/// htonl(0xffffff00): a /24 mask as it lies in a little-endian u32.
const MASK24_N: u32 = 0x00ffffff;

/// IPV4_ADDR(a, b, c, d) as it lies in a little-endian u32 (inet.h's IPV4_ADDR and htonl assume the order).
fn ip4(a: u32, b: u32, c: u32, d: u32) -> u32 => a | (b << 8) | (c << 16) | (d << 24);

fn loopbackN() -> u32 => ip4(127, 0, 0, 1);

// ---- The checks ----

/// A failed check: its reason, for the runner's report, and false.
/// Safety: `reason` is the runner's; `why` is a zero-terminated literal, which outlives the report.
fn failed(reason: *mut *CChar, why: StringView) -> bool {
    unsafe {
        let r = Ptr.toBorrowMut(reason);
        put(r, why.ptr as *CChar);
    }
    return false;
}

fn put(slot: borrow mut *CChar, why: *CChar) {
    slot = why;
}

/// Safety: a sleep of the calling thread's.
fn sleepMs(ms: u64) {
    unsafe {
        thread_sleep_ns(ms * 1000000);
    }
}

fn tooSmall() {
    var buffer: [u8; 64] = [0; 64];
    var line = TextWriter.create(mut buffer[..]);
    line.text("nettest: a scratch is too small");
    KernelLog.panic(line);
}

/// A small C struct's room (a rule, a command).
struct Cmd {
    words: [u64; 8];
}

fn cmd(bytes: usize) -> Cmd {
    if (bytes > 64) {
        tooSmall();
    }
    return Cmd { words: [0; 8] };
}

// ---- Bytes ----

fn be16(b: SliceMut<u8>, at: usize, v: u16) {
    b[at] = truncate<u8>(v >> 8);
    b[at + 1] = truncate<u8>(v);
}

fn be32(b: SliceMut<u8>, at: usize, v: u32) {
    b[at] = truncate<u8>(v >> 24);
    b[at + 1] = truncate<u8>(v >> 16);
    b[at + 2] = truncate<u8>(v >> 8);
    b[at + 3] = truncate<u8>(v);
}

/// A u16 as it lies in memory (a checksum nettest_l4cksum returned).
fn half(b: SliceMut<u8>, at: usize, v: u16) {
    b[at] = truncate<u8>(v);
    b[at + 1] = truncate<u8>(v >> 8);
}

fn rd16(b: Slice<u8>, at: usize) -> u16 => ((b[at] as u16) << 8) | (b[at + 1] as u16);

fn rd32(b: Slice<u8>, at: usize) -> u32 => ((b[at] as u32) << 24) | ((b[at + 1] as u32) << 16) |
    ((b[at + 2] as u32) << 8) | (b[at + 3] as u32);

/// A u32 as it lies in memory (an address in network order).
fn wordOf(b: Slice<u8>, at: usize) -> u32 => (b[at] as u32) | ((b[at + 1] as u32) << 8) | ((b[at + 2] as u32) << 16) |
    ((b[at + 3] as u32) << 24);

/// The first `n` bytes at `p` are `want`'s.
/// Safety: `p` points to `n` readable bytes.
unsafe fn same(p: *u8, want: Slice<u8>, n: usize) -> bool {
    let b = Slice.fromRaw(p, n);
    for (i in 0..n) {
        if (b[i] != want[i]) {
            return false;
        }
    }
    return true;
}

// ---- Addresses ----

/// struct netaddr for an IPv4 address and port.
fn v4addr(ip: u32, port: u16) -> [u32; 5] => [AF_INET | ((port as u32) << 16), ip, 0, 0, 0];

fn na(a: borrow [u32; 5]) -> *netaddr => a as *[u32; 5] as *netaddr;

// ---- The world side of the uplink tap (nettest.h) ----

/// A TCP segment with every field the world side needs to drive a connection by hand: sequence, acknowledgment,
/// flags, window and payload, checksummed. Its length.
/// Safety: `l4` has room for 20 + `pllen` bytes, `pl` `pllen` readable ones.
@export("nettest_hin_mk_tcp")
unsafe fn mkTcp(
    l4: *mut u8,
    sip: u32,
    dip: u32,
    sp: u16,
    dp: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    win: u16,
    pl: *void,
    pllen: u16,
) -> u16 {
    let len = 20 + pllen;
    let b = SliceMut.fromRaw(l4, len as usize);
    for (i in 0..20) {
        b[truncate<usize>(i)] = 0;
    }
    be16(b, 0, sp);
    be16(b, 2, dp);
    be32(b, 4, seq);
    be32(b, 8, ack);
    b[12] = 5 << 4;
    b[13] = flags;
    be16(b, 14, win);
    if (pllen != 0) {
        let src = Slice.fromRaw(pl as *u8, pllen as usize);
        for (i in 0..pllen as usize) {
            b[20 + i] = src[i];
        }
    }
    half(b, 16, nettest_l4cksum(sip, dip, IPPROTO_TCP, l4 as *void, len));
    return len;
}

/// The world sends one IPv4 datagram in on the uplink tap.
/// Safety: `u` is the test's tap; the MACs are 6 bytes, `l4` `l4len` readable ones (at most 222).
@export("nettest_hin_send")
unsafe fn send(u: *mut tap, umac: *u8, wmac: *u8, sip: u32, dip: u32, proto: u8, l4: *u8, l4len: u16) -> bool {
    var frame: [u8; 256] = [0; 256];
    let fp = borrow mut frame as *mut [u8; 256] as *mut u8;
    let flen = nettest_wrap(fp, umac, wmac, sip, dip, 64, proto, l4 as *void, l4len);
    return tap_inject(u, fp as *void, flen) == 0;
}

/// Zero a struct hin_seg's fields and its payload.
/// Safety: `o` is a struct hin_seg; its payload is the 64 bytes at `pay`.
unsafe fn clearSeg(o: *mut hin_seg, pay: SliceMut<u8>) {
    let w = Ptr.toBorrowMut(o);
    w.src = 0;
    w.dst = 0;
    w.proto = 0;
    w.flags = 0;
    w.sport = 0;
    w.dport = 0;
    w.win = 0;
    w.paylen = 0;
    w.seq = 0;
    w.ack = 0;
    for (i in 0..64) {
        pay[truncate<usize>(i)] = 0;
    }
}

/// One datagram as the world sees it, from the frame in `m`. A window big enough for the headers and the first of the
/// payload is copied: a frame may be far longer (a full-sized segment), so the *header fields* say how much data the
/// datagram carries, never how much was copied.
/// Safety: `m` is a packet of the caller's; `o` is a struct hin_seg.
unsafe fn parse(m: *mut mbuf, o: *mut hin_seg) -> bool {
    var rx: [u8; 128] = [0; 128];
    let n = m_length(m as *mbuf);
    let take: u32 = if (n < 128) n else 128;
    if (n < ETH_HLEN32 + 20 ||
        !m_copydata(m as *mbuf, 0, take, borrow mut rx as *mut [u8; 128] as *mut void) || rx[12] != 0x08 ||
        rx[13] != 0x00) {
        return false;
    }
    let ihl = ((rx[ETH_HLEN] & 0xf) as u32) * 4;
    let total = rd16(rx[..], ETH_HLEN + 2) as u32;
    if (total < ihl || ETH_HLEN32 + total > n || ETH_HLEN32 + ihl + 8 > take) {
        return false;
    }
    // The 64 payload bytes of the struct hin_seg (nettest_floor.c asserts the offset).
    let pay = SliceMut.fromRaw((o as *mut u8).add(28), 64);
    clearSeg(o, pay);
    let w = Ptr.toBorrowMut(o);
    let proto = rx[ETH_HLEN + 9];
    w.src = wordOf(rx[..], ETH_HLEN + 12);
    w.dst = wordOf(rx[..], ETH_HLEN + 16);
    w.proto = proto;
    let l4 = ETH_HLEN + (ihl as usize);
    let l4len = total - ihl;
    var hl: u32 = 0;
    if (proto == IPPROTO_TCP && l4len >= 20) {
        hl = ((rx[l4 + 12] >> 4) as u32) * 4;
        if (hl > l4len || ETH_HLEN32 + ihl + hl > take) {
            return false;
        }
        w.sport = rd16(rx[..], l4);
        w.dport = rd16(rx[..], l4 + 2);
        w.seq = rd32(rx[..], l4 + 4);
        w.ack = rd32(rx[..], l4 + 8);
        w.flags = rx[l4 + 13];
        w.win = rd16(rx[..], l4 + 14);
        w.paylen = truncate<u16>(l4len - hl);
    } else if (proto == IPPROTO_UDP && l4len >= 8) {
        hl = 8;
        w.sport = rd16(rx[..], l4);
        w.dport = rd16(rx[..], l4 + 2);
        w.paylen = rd16(rx[..], l4 + 4).wrappingSub(8);
    } else {
        if (proto == IPPROTO_ICMP && l4len >= 4) {
            w.flags = rx[l4];
        }
        return true;
    }
    // As much of the payload as the window holds, up to what `pay` takes.
    let have = take - (ETH_HLEN32 + ihl + hl);
    let paylen = w.paylen as u32;
    let cp = if (paylen < have) paylen else have;
    let k = if (cp < 64) cp else 64;
    for (i in 0..k as usize) {
        pay[i] = rx[l4 + (hl as usize) + i];
    }
    return true;
}

/// The next datagram of `proto` the host emitted on the uplink tap toward world port `wport` (0 = any), within tries x
/// 10 ms; everything else the tap carries (ARP, another connection's segments) is skipped. False when none arrived --
/// the check a silent DROP is proved by.
/// Safety: `u` is the test's tap; `o` is a struct hin_seg.
@export("nettest_hin_recv")
unsafe fn recv(u: *mut tap, proto: u8, wport: u16, o: *mut hin_seg, tries: u32) -> bool {
    for (i in 0..tries) {
        var m = tap_recv(u);
        while (!m.isNull()) {
            let ok = parse(m, o);
            m_freem(m);
            let s = Ptr.toBorrow(o as *hin_seg);
            if (ok && s.proto == proto && (wport == 0 || s.dport == wport)) {
                return true;
            }
            m = tap_recv(u);
        }
        sleepMs(10);
    }
    return false;
}

/// Safety: `u` is the test's tap.
@export("nettest_hin_drain")
unsafe fn drain(u: *mut tap) {
    sleepMs(20);
    var m = tap_recv(u);
    while (!m.isNull()) {
        m_freem(m);
        m = tap_recv(u);
    }
}

/// Every byte of [base, base + total) of one direction arrives (docs/audit/next-subsystem-zero-window.md). A data
/// segment may repeat bytes already seen -- a zero-window probe sent again, a retransmission from snd_una -- and may
/// arrive in any order: the retransmit work builds its probe under the pcb's lock but sends it after, so a window
/// update's data can reach the wire first, and a receiver reassembles. It never reaches outside the range (a byte
/// before `base` wraps `off` past it). A bare ACK is passed over; a SYN, FIN or RST fails. `covered` bytes from `base`
/// are already seen, and `have` says `sg` holds a segment the caller read and has not yet counted. At most 8 segments:
/// 50 bytes one at a time is a regression, not a delivery.
/// Safety: `u` is the test's tap; `sg` is a struct hin_seg.
@export("nettest_hin_recv_stream")
unsafe fn recvStream(
    u: *mut tap,
    wport: u16,
    base: u32,
    covered: u32,
    total: u32,
    sg: *mut hin_seg,
    haveIn: bool,
) -> bool {
    var seen: [u8; 64] = [0; 64];
    if (total > 64 || covered > total) {
        return false;
    }
    for (i in 0..covered as usize) {
        seen[i] = 1;
    }
    var n = covered;
    var have = haveIn;
    var k: u32 = 0;
    while (n < total && k < 8) {
        k += 1;
        if (!have && !recv(u, IPPROTO_TCP, wport, sg, HIN_TRIES)) {
            return false;
        }
        have = false;
        let s = Ptr.toBorrow(sg as *hin_seg);
        if ((s.flags & (TH_SYN | TH_FIN | TH_RST)) != 0) {
            return false;
        }
        let paylen = s.paylen as u32;
        if (paylen != 0) {
            let off = s.seq.wrappingSub(base);
            if (off >= total || paylen > total - off) {
                return false;
            }
            for (i in off as usize..(off + paylen) as usize) {
                if (seen[i] == 0) {
                    n += 1;
                }
                seen[i] = 1;
            }
        }
    }
    return n == total;
}

/// A non-blocking accept, awaited: the connection, or null.
/// Safety: `ls` is a listener of the test's.
@export("nettest_hin_accept")
unsafe fn accept(ls: *mut socket) -> *mut socket {
    for (i in 0..100) {
        var a = 0 as *mut socket;
        var peer: [u32; 5] = [0; 5];
        if (nettest_ksock_accept(
            ls,
            borrow mut a as *mut *mut socket,
            borrow mut peer as *mut [u32; 5] as *mut netaddr,
        ) ==
            0) {
            return a;
        }
        sleepMs(10);
    }
    return 0 as *mut socket;
}

/// A non-blocking receive, awaited: bytes, 0 at EOF, or the error (-EAGAIN when nothing came in tries x 10 ms).
/// Safety: `s` is a socket of the test's; `buf` has room for `cap` bytes.
@export("nettest_hin_recv_sock")
unsafe fn recvSock(s: *mut socket, buf: *mut void, cap: usize, tries: u32) -> i64 {
    let again = -(EAGAIN as i64);
    var n = again;
    var i: u32 = 0;
    while (i < tries && n == again) {
        n = ksock_recvfrom(s, buf, cap, 0 as *mut netaddr);
        if (n == again) {
            sleepMs(10);
        }
        i += 1;
    }
    return n;
}

/// A non-blocking UDP socket bound to `ip`:`port`, released however the test returns.
/// Safety: `out` is the caller's slot.
@export("nettest_hin_udp_listener")
unsafe fn udpListener(out: *mut *mut socket, ip: u32, port: u16) -> bool {
    if (nettest_ksock_create(AF_INET_S, SOCK_DGRAM, 0, out) != 0) {
        return false;
    }
    let s = Ptr.toBorrow(out as **mut socket);
    let a = v4addr(ip, port);
    if (ksock_bind(s, na(borrow a)) != 0) {
        return false;
    }
    ksock_set_nonblock(s, true);
    return true;
}

/// A non-blocking TCP listener on `port`, released however the test returns.
/// Safety: `out` is the caller's slot.
@export("nettest_hin_tcp_listener")
unsafe fn tcpListener(out: *mut *mut socket, port: u16) -> bool {
    if (nettest_ksock_create(AF_INET_S, SOCK_STREAM, 0, out) != 0) {
        return false;
    }
    let s = Ptr.toBorrow(out as **mut socket);
    let a = v4addr(0, port);
    if (ksock_bind(s, na(borrow a)) != 0 || ksock_listen(s, 4) != 0) {
        return false;
    }
    ksock_set_nonblock(s, true);
    return true;
}

// ---- The counters ----

/// A counter net-hostinput awaits or compares: the host chain's verdicts on the firewall's side, its quiet deliveries
/// and drops on the IP, TCP and UDP sides.
enum Counter {
    InAcceptRule,
    HinAcceptRule,
    HinDropRule,
    HinAcceptDefault,
    HinDropDefault,
    InFiltered,
    RxOfflink,
    HinQuiet,
    IcmpQuietDropped,
    Retransmits,
    RstsIn,
    SynCached,
    SynCookiesSent,
    ChallengeAcks,
    KeepaliveProbes,
    TcpQuietDropped,
    UdpQuietDropped,
}

// The four statistics structs' rooms, off the stack: 1 KiB each (checked).
static mut STATS: [u64; 512] = [0; 512];

/// The `i`th of the four rooms.
/// Safety: the runner runs one test at a time, so the statics are this test's.
unsafe fn statsRoom(i: usize, bytes: usize) -> *mut u8 {
    if (bytes > 1024) {
        tooSmall();
    }
    return (borrow mut STATS as *mut [u64; 512] as *mut u8).add(i * 1024);
}

/// The counter's value now.
/// Safety: the rooms hold the statistics structs (statsRoom checks).
fn now(c: Counter) -> u64 {
    unsafe {
        return match (c) {
            Counter.InAcceptRule => Ptr.toBorrow(fwNow()).in_accept_rule,
            Counter.HinAcceptRule => Ptr.toBorrow(fwNow()).hin_accept_rule,
            Counter.HinDropRule => Ptr.toBorrow(fwNow()).hin_drop_rule,
            Counter.HinAcceptDefault => Ptr.toBorrow(fwNow()).hin_accept_default,
            Counter.HinDropDefault => Ptr.toBorrow(fwNow()).hin_drop_default,
            Counter.InFiltered => Ptr.toBorrow(ipNow()).in_filtered,
            Counter.RxOfflink => Ptr.toBorrow(ipNow()).rx_offlink,
            Counter.HinQuiet => Ptr.toBorrow(ipNow()).hin_quiet,
            Counter.IcmpQuietDropped => Ptr.toBorrow(ipNow()).icmp_quiet_dropped,
            Counter.Retransmits => Ptr.toBorrow(tcpNow()).retransmits,
            Counter.RstsIn => Ptr.toBorrow(tcpNow()).rsts_in,
            Counter.SynCached => Ptr.toBorrow(tcpNow()).syn_cached,
            Counter.SynCookiesSent => Ptr.toBorrow(tcpNow()).syn_cookies_sent,
            Counter.ChallengeAcks => Ptr.toBorrow(tcpNow()).challenge_acks,
            Counter.KeepaliveProbes => Ptr.toBorrow(tcpNow()).keepalive_probes,
            Counter.TcpQuietDropped => Ptr.toBorrow(tcpNow()).quiet_dropped,
            Counter.UdpQuietDropped => Ptr.toBorrow(udpNow()).quiet_dropped,
        };
    }
}

/// The firewall's statistics, read now into their room.
/// Safety: as statsRoom.
unsafe fn fwNow() -> *fw_stats {
    let p = statsRoom(0, layoutOf<fw_stats>().size) as *mut fw_stats;
    fw_get_stats(p);
    return p as *fw_stats;
}

/// Safety: as statsRoom.
unsafe fn ipNow() -> *ip_stats {
    let p = statsRoom(1, layoutOf<ip_stats>().size) as *mut ip_stats;
    ipv4_get_stats(p);
    return p as *ip_stats;
}

/// Safety: as statsRoom.
unsafe fn tcpNow() -> *tcp_stats {
    let p = statsRoom(2, layoutOf<tcp_stats>().size) as *mut tcp_stats;
    tcp_get_stats(p);
    return p as *tcp_stats;
}

/// Safety: as statsRoom.
unsafe fn udpNow() -> *udp_stats {
    let p = statsRoom(3, layoutOf<udp_stats>().size) as *mut udp_stats;
    udp_get_stats(p);
    return p as *udp_stats;
}

/// The C's FWT_RISES: true once the counter exceeds `base`, read up to 40 times 10 ms apart.
fn rises(c: Counter, base: u64) -> bool {
    for (i in 0..40) {
        if (now(c) > base) {
            return true;
        }
        sleepMs(10);
    }
    return false;
}

// ---- net-hostinput ----

static mut L4: [u8; 160] = [0; 160];
static mut BUF: [u8; 256] = [0; 256];
static mut SNAP: [u8; 65536] = [0; 65536];
// The datagram read back: a struct hin_seg (92 bytes, checked).
static mut SG: [u64; 16] = [0; 16];
static mut U: *mut tap = 0 as *mut tap;
static mut FA: *mut file = 0 as *mut file;

/// Safety: the runner runs one test at a time, so the statics are this test's.
fn l4() -> *mut u8 => unsafe { borrow mut L4 as *mut [u8; 160] as *mut u8 };

/// Safety: as l4.
fn buf() -> *mut u8 => unsafe { borrow mut BUF as *mut [u8; 256] as *mut u8 };

/// Safety: as l4; the room holds a struct hin_seg (checked in the test).
fn sg() -> *mut hin_seg => unsafe { borrow mut SG as *mut [u64; 16] as *mut hin_seg };

/// The datagram read back: its fields.
/// Safety: as sg.
fn sgFlags() -> u8 => unsafe { Ptr.toBorrow(sg() as *hin_seg).flags };

/// Safety: as sg.
fn sgSeq() -> u32 => unsafe { Ptr.toBorrow(sg() as *hin_seg).seq };

/// Safety: as sg.
fn sgAck() -> u32 => unsafe { Ptr.toBorrow(sg() as *hin_seg).ack };

/// Safety: as sg.
fn sgPaylen() -> u16 => unsafe { Ptr.toBorrow(sg() as *hin_seg).paylen };

/// Safety: as sg.
fn sgSport() -> u16 => unsafe { Ptr.toBorrow(sg() as *hin_seg).sport };

/// The uplink and the world on its far side: the uplink's MAC and address, five world peers with theirs.
struct World {
    uip: u32;
    w: [u32; 5];
    umac: [u8; 6];
    wmac: [u8; 30];
}

fn umacOf(x: borrow World) -> *u8 => borrow x.umac as *[u8; 6] as *u8;

/// Safety: `i` < 5.
fn wmacOf(x: borrow World, i: usize) -> *u8 => unsafe { (borrow x.wmac as *[u8; 30] as *u8).add(i * 6) };

/// A segment from `sip` (behind world peer `mi`'s MAC) to the host, with a payload.
/// Safety: U is the test's tap; `pl` has `n` readable bytes.
unsafe fn tcpData(
    x: borrow World,
    sip: u32,
    mi: usize,
    sp: u16,
    dp: u16,
    seq: u32,
    ack: u32,
    flags: u8,
    win: u16,
    pl: *u8,
    n: u16,
) -> bool {
    let len = mkTcp(l4(), sip, x.uip, sp, dp, seq, ack, flags, win, pl as *void, n);
    return send(U, umacOf(x), wmacOf(x, mi), sip, x.uip, IPPROTO_TCP, l4() as *u8, len);
}

/// A bare segment from world peer `i`.
/// Safety: as tcpData.
unsafe fn tcpIn(x: borrow World, i: usize, sp: u16, dp: u16, seq: u32, ack: u32, flags: u8, win: u16) -> bool =>
    tcpData(x, x.w[i], i, sp, dp, seq, ack, flags, win, 0 as *u8, 0);

/// A datagram from world peer 0 to `dip`, the payload `abcd`, or `pl`.
/// Safety: as tcpData.
unsafe fn udpIn(x: borrow World, dip: u32, sp: u16, dp: u16, pl: *u8, n: u16) -> bool {
    let len = nettest_mk_udp(l4(), x.w[0], dip, sp, dp, pl, n);
    return send(U, umacOf(x), wmacOf(x, 0), x.w[0], dip, IPPROTO_UDP, l4() as *u8, len);
}

/// An ICMP echo or reply from world peer 0.
/// Safety: as tcpData.
unsafe fn icmpIn(x: borrow World, kind: u8, id: u16) -> bool {
    let len = nettest_fwt_mk_icmp_ck(l4(), kind, id);
    return send(U, umacOf(x), wmacOf(x, 0), x.w[0], x.uip, IPPROTO_ICMP, l4() as *u8, len);
}

/// The next datagram of `proto` toward world port `wport`, into SG.
/// Safety: as tcpData.
unsafe fn heard(proto: u8, wport: u16, tries: u32) -> bool => recv(U, proto, wport, sg(), tries);

/// A host-chain rule in a zeroed room: what the C's HIN_RULE named, the rest zero.
/// Safety: the room holds a struct fw_rule (cmd checks).
fn hinRule(r: borrow mut Cmd, direction: u8, proto: u8, sip: u32, sp: u8, port: u16, verdict: u8) -> *fw_rule {
    r.words = [0; 8];
    let p = borrow mut r.words as *mut [u64; 8] as *mut fw_rule;
    unsafe {
        let w = Ptr.toBorrowMut(p);
        w.direction = direction;
        w.proto = proto;
        w.verdict = verdict;
        w.dst_port = port;
        w.src_ip = sip;
        w.src_prefix = sp;
    }
    return p as *fw_rule;
}

/// The host object has no rules.
/// Safety: thread context.
unsafe fn noHostRules() -> bool {
    var none = cmd(layoutOf<fw_rule>().size);
    return fw_rule_list(FW_HOST_GUEST_IP, borrow mut none.words as *mut [u64; 8] as *mut fw_rule, 1) == 0;
}

/// A host control command through tapctl: TCP, FROM_UPLINK, DROP, the given port and 10.77.8.0/24, as the C's `c`.
/// Safety: the room holds a struct cosmo_netctl_filter (cmd checks).
fn hostFilter(r: borrow mut Cmd, op: u16, guest: u32, direction: u8, port: u16) -> *cosmo_netctl_filter {
    r.words = [0; 8];
    let p = borrow mut r.words as *mut [u64; 8] as *mut cosmo_netctl_filter;
    unsafe {
        let w = Ptr.toBorrowMut(p);
        w.version = NETCTL_VERSION;
        w.op = op;
        w.guest_addr = guest;
        w.direction = direction;
        w.proto = NETCTL_PROTO_TCP;
        w.verdict = NETCTL_VERDICT_DROP;
        w.dst_port = port;
        w.src_addr = ip4(10, 77, 8, 0);
        w.src_prefix = 24;
    }
    return p as *cosmo_netctl_filter;
}

fn filterLen() -> usize => layoutOf<cosmo_netctl_filter>().size;

/// The control snapshot lists the host's record with policy_from_uplink ACCEPT, and the sourced rule for port 2224.
/// Safety: SNAP holds a snapshot.
unsafe fn snapshotCarries() -> bool {
    let snap = borrow SNAP as *[u8; 65536] as *u8;
    let count = Ptr.toBorrow(snap as *cosmo_netctl_list).count;
    var off = layoutOf<cosmo_netctl_list>().size + (count as usize) * layoutOf<cosmo_netctl_rule>().size;
    let fh = Ptr.toBorrow(snap.add(off) as *cosmo_netctl_filter_list);
    if (fh.version != NETCTL_VERSION || fh.guest_count < 2) {
        return false;
    }
    let guests = fh.guest_count;
    let rules = fh.rule_count;
    off += layoutOf<cosmo_netctl_filter_list>().size;
    var hostSeen = false;
    for (i in 0..guests as usize) {
        let fg = Ptr.toBorrow(snap.add(off) as *cosmo_netctl_filter_guest);
        if (fg.guest_addr == NETCTL_HOST_ADDR) {
            hostSeen = fg.policy_from_uplink == NETCTL_VERDICT_ACCEPT;
        }
        off += layoutOf<cosmo_netctl_filter_guest>().size;
    }
    var ruleSeen = false;
    for (i in 0..rules as usize) {
        let fr = Ptr.toBorrow(
            snap.add(off + i * layoutOf<cosmo_netctl_filter_rule>().size) as *cosmo_netctl_filter_rule,
        );
        if (fr.guest_addr == NETCTL_HOST_ADDR && fr.dst_port == 2224) {
            ruleSeen = fr.direction == NETCTL_DIR_FROM_UPLINK && fr.src_addr == ip4(10, 77, 8, 0) &&
                fr.src_prefix == 24 && fr.verdict == NETCTL_VERDICT_DROP;
        }
    }
    return hostSeen && ruleSeen;
}

/// A loopback sender reaches the loopback-bound listener.
/// Safety: `ul` is the test's listener.
unsafe fn loopbackHeard(ul: *mut socket) -> bool {
    var lo = 0 as *mut socket;
    if (nettest_ksock_create(AF_INET_S, SOCK_DGRAM, 0, borrow mut lo as *mut *mut socket) != 0) {
        return false;
    }
    let pl: [u8; 4] = [0x61, 0x62, 0x63, 0x64];
    let to = v4addr(loopbackN(), 7002);
    let ok = ksock_sendto(lo, borrow pl as *[u8; 4] as *void, 4, na(borrow to)) == 4 &&
        recvSock(ul, buf() as *mut void, 256, HIN_TRIES) == 4;
    nettest_ksock_put(lo);
    return ok;
}

/// The host's services, and the sockets the test made.
struct Socks {
    ls1: *mut socket;
    ls2: *mut socket;
    us: *mut socket;
    uc: *mut socket;
    ul: *mut socket;
}

/// The body, with U and FA open and the services listening.
/// Safety: the runner's `reason`.
unsafe fn hostinputBody(reason: *mut *CChar, x: borrow World, k: borrow Socks, ga: u32, gwa: u32) -> bool {
    let amac: [u8; 6] = [0x52, 0x54, 0x00, 0x0f, 0x00, 0x0a];
    let tap0mac: [u8; 6] = [0x52, 0x54, 0x00, 0xaa, 0xbb, 0xcc];
    let am = borrow amac as *[u8; 6] as *u8;
    let t0 = borrow tap0mac as *[u8; 6] as *u8;
    let pl: [u8; 4] = [0x61, 0x62, 0x63, 0x64];
    let plp = borrow pl as *[u8; 4] as *u8;
    let uip = x.uip;
    let w = x.w;
    drain(U);

    // (1) the host object ships with default ACCEPT and no rules, and the world reaches the host's services under it.
    var pol: [u8; 5] = [0; 5];
    let pp = borrow mut pol as *mut [u8; 5] as *mut u8;
    if (fw_policy_get(FW_HOST_GUEST_IP, pp, pp.add(1), pp.add(2), pp.add(3), pp.add(4)) != 0 || pol[3] != FW_ACCEPT ||
        pol[4] != FW_ACCEPT) {
        return failed(reason, "check failed: net-hostinput: the host defaults\0");
    }
    if (!noHostRules()) {
        return failed(reason, "check failed: net-hostinput: no host rules\0");
    }
    var base = now(Counter.HinAcceptDefault);
    if (!tcpIn(x, 0, 40001, 2222, 1000, 0, TH_SYN, 64240) || !heard(IPPROTO_TCP, 40001, HIN_TRIES) ||
        (sgFlags() & (TH_SYN | TH_ACK)) != (TH_SYN | TH_ACK) || sgAck() != 1001) {
        return failed(reason, "check failed: net-hostinput: C1's SYN-ACK under the default\0");
    }
    let iss1 = sgSeq();
    if (!rises(Counter.HinAcceptDefault, base)) {
        return failed(reason, "check failed: net-hostinput: accepted by the default\0");
    }
    if (!udpIn(x, uip, 6000, 7000, plp, 4) || recvSock(k.us, buf() as *mut void, 256, HIN_TRIES) != 4 ||
        !same(buf() as *u8, pl[..], 4)) {
        return failed(reason, "check failed: net-hostinput: the UDP listener hears the world\0");
    }

    // (2) a DROP rule with a source: the prefix is matched, in both senses.
    var srcRoom = cmd(layoutOf<fw_rule>().size);
    let rSrc = hinRule(mut srcRoom, FW_DIR_FROM_UPLINK, IPPROTO_TCP, ip4(10, 77, 8, 0), 24, 2222, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rSrc) != 0) {
        return failed(reason, "check failed: net-hostinput: the sourced rule is added\0");
    }
    base = now(Counter.HinDropRule);
    var quiet = now(Counter.HinQuiet);
    var tq = now(Counter.TcpQuietDropped);
    drain(U);
    if (!tcpIn(x, 1, 40002, 2222, 2000, 0, TH_SYN, 64240) || !rises(Counter.HinDropRule, base) ||
        !rises(Counter.HinQuiet, quiet) || !rises(Counter.TcpQuietDropped, tq)) {
        return failed(reason, "check failed: net-hostinput: the prefix matches: dropped quiet\0");
    }
    if (heard(IPPROTO_TCP, 40002, 15)) {
        return failed(reason, "check failed: net-hostinput: no SYN-ACK, no RST\0");
    }
    base = now(Counter.HinAcceptDefault);
    tq = now(Counter.TcpQuietDropped);
    let far = ip4(10, 0, 9, 9); // outside the prefix
    if (!tcpData(x, far, 1, 40009, 2222, 2000, 0, TH_SYN, 64240, 0 as *u8, 0) ||
        !rises(Counter.HinAcceptDefault, base)) {
        return failed(reason, "check failed: net-hostinput: outside the prefix: the default\0");
    }
    if (now(Counter.TcpQuietDropped) != tq) {
        return failed(reason, "check failed: net-hostinput: and not quiet\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rSrc) != 0) {
        return failed(reason, "check failed: net-hostinput: the sourced rule is deleted\0");
    }

    // (3) quiet delivery: the transport decides, and answers nothing. C1's handshake completes under ACCEPT; then a
    // DROP rule covers its port.
    if (!tcpIn(x, 0, 40001, 2222, 1001, iss1.wrappingAdd(1), TH_ACK, 64240)) {
        return failed(reason, "check failed: net-hostinput: C1's ACK\0");
    }
    let a1 = accept(k.ls1);
    if (a1.isNull()) {
        return failed(reason, "check failed: net-hostinput: C1 is accepted\0");
    }
    ksock_set_nonblock(a1, true);
    var r2222Room = cmd(layoutOf<fw_rule>().size);
    let r2222 = hinRule(mut r2222Room, FW_DIR_FROM_UPLINK, IPPROTO_TCP, 0, 0, 2222, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, r2222) != 0) {
        return failed(reason, "check failed: net-hostinput: the port-2222 rule is added\0");
    }
    drain(U);
    quiet = now(Counter.HinQuiet);
    tq = now(Counter.TcpQuietDropped);
    // the established connection's data is delivered and acknowledged
    let hi: [u8; 2] = [0x68, 0x69];
    if (!tcpData(
        x,
        w[0],
        0,
        40001,
        2222,
        1001,
        iss1.wrappingAdd(1),
        TH_ACK | TH_PSH,
        64240,
        borrow hi as *[u8; 2] as *u8,
        2,
    ) ||
        recvSock(a1, buf() as *mut void, 256, HIN_TRIES) != 2 || !same(buf() as *u8, hi[..], 2)) {
        return failed(reason, "check failed: net-hostinput: established data is delivered\0");
    }
    if (!rises(Counter.HinQuiet, quiet)) {
        return failed(reason, "check failed: net-hostinput: quiet\0");
    }
    if (!heard(IPPROTO_TCP, 40001, HIN_TRIES) || (sgFlags() & TH_ACK) == 0 || sgAck() != 1003) {
        return failed(reason, "check failed: net-hostinput: and acknowledged\0");
    }
    if (now(Counter.TcpQuietDropped) != tq) {
        return failed(reason, "check failed: net-hostinput: not dropped\0");
    }
    // an ACK-only probe, and a SYN+ACK, from a source with no connection: freed, no RST
    tq = now(Counter.TcpQuietDropped);
    if (!tcpIn(x, 2, 4444, 2222, 999, 777, TH_ACK, 64240) || !rises(Counter.TcpQuietDropped, tq)) {
        return failed(reason, "check failed: net-hostinput: an ACK probe is freed\0");
    }
    if (heard(IPPROTO_TCP, 4444, 15)) {
        return failed(reason, "check failed: net-hostinput: no RST to the ACK probe\0");
    }
    tq = now(Counter.TcpQuietDropped);
    if (!tcpIn(x, 2, 4445, 2222, 999, 777, TH_SYN | TH_ACK, 64240) || !rises(Counter.TcpQuietDropped, tq)) {
        return failed(reason, "check failed: net-hostinput: a SYN+ACK probe is freed\0");
    }
    if (heard(IPPROTO_TCP, 4445, 15)) {
        return failed(reason, "check failed: net-hostinput: no RST to the SYN+ACK probe\0");
    }
    // a new SYN: no SYN-cache entry, no cookie, no SYN-ACK, no RST
    tq = now(Counter.TcpQuietDropped);
    let cached = now(Counter.SynCached);
    let cookies = now(Counter.SynCookiesSent);
    if (!tcpIn(x, 2, 4446, 2222, 3333, 0, TH_SYN, 64240) || !rises(Counter.TcpQuietDropped, tq)) {
        return failed(reason, "check failed: net-hostinput: a new SYN is freed\0");
    }
    if (now(Counter.SynCached) != cached || now(Counter.SynCookiesSent) != cookies) {
        return failed(reason, "check failed: net-hostinput: no SYN-cache entry, no cookie\0");
    }
    if (heard(IPPROTO_TCP, 4446, 15)) {
        return failed(reason, "check failed: net-hostinput: no SYN-ACK, no RST to the new SYN\0");
    }
    // UDP under a DROP rule: a connected socket's peer is delivered; a listener and an unbound port get nothing back
    // -- no port-unreachable.
    var udpRoom = cmd(layoutOf<fw_rule>().size);
    let rUdp = hinRule(mut udpRoom, FW_DIR_FROM_UPLINK, IPPROTO_UDP, 0, 0, 0, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rUdp) != 0) {
        return failed(reason, "check failed: net-hostinput: the UDP rule is added\0");
    }
    var uq = now(Counter.UdpQuietDropped);
    let conn: [u8; 4] = [0x63, 0x6f, 0x6e, 0x6e];
    if (!udpIn(x, uip, 5555, 7001, borrow conn as *[u8; 4] as *u8, 4) ||
        recvSock(k.uc, buf() as *mut void, 256, HIN_TRIES) != 4 || !same(buf() as *u8, conn[..], 4)) {
        return failed(reason, "check failed: net-hostinput: the connected socket's peer is delivered\0");
    }
    if (now(Counter.UdpQuietDropped) != uq) {
        return failed(reason, "check failed: net-hostinput: not dropped (UDP)\0");
    }
    drain(U);
    if (!udpIn(x, uip, 6001, 7000, plp, 4) || recvSock(k.us, buf() as *mut void, 256, 10) != -(EAGAIN as i64)) {
        return failed(reason, "check failed: net-hostinput: the listener hears nothing\0");
    }
    if (!rises(Counter.UdpQuietDropped, uq)) {
        return failed(reason, "check failed: net-hostinput: dropped quiet (listener)\0");
    }
    uq = now(Counter.UdpQuietDropped);
    if (!udpIn(x, uip, 6002, 7009, plp, 4) || !rises(Counter.UdpQuietDropped, uq)) {
        return failed(reason, "check failed: net-hostinput: dropped quiet (unbound)\0");
    }
    if (heard(IPPROTO_ICMP, 0, 15)) {
        return failed(reason, "check failed: net-hostinput: no port-unreachable\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rUdp) != 0) {
        return failed(reason, "check failed: net-hostinput: the UDP rule is deleted\0");
    }
    if (!udpIn(x, uip, 6003, 7009, plp, 4) || !heard(IPPROTO_ICMP, 0, HIN_TRIES) || sgFlags() != ICMP_DEST_UNREACH) {
        return failed(reason, "check failed: net-hostinput: which ACCEPT draws\0");
    }

    // (4) TCP's own validation, silenced: on C1 under the DROP rule, an out-of-window segment draws no window ACK, a
    // mis-positioned reset, an in-window SYN and an out-of-range ACK draw no challenge ACK -- all are in-window
    // rejections past the window test -- and the connection lives.
    drain(U);
    // Out of window; in window, not rcv_nxt; an in-window SYN; an ACK outside [snd_una - max window, snd_max].
    let badSeq: [u32; 4] = [1003 + 100000, 1003 + 10, 1003, 1003];
    let badAck: [u32; 4] = [0, 0, 0, 0x40000000];
    let badFlags: [u8; 4] = [TH_ACK, TH_RST, TH_SYN, TH_ACK];
    for (i in 0..4) {
        let j = truncate<usize>(i);
        let challenges = now(Counter.ChallengeAcks);
        tq = now(Counter.TcpQuietDropped);
        let ack = if (badFlags[j] == TH_RST) 0 else iss1.wrappingAdd(1).wrappingAdd(badAck[j]);
        if (!tcpIn(x, 0, 40001, 2222, badSeq[j], ack, badFlags[j], 64240)) {
            return failed(reason, "check failed: net-hostinput: a bad segment is sent\0");
        }
        if (heard(IPPROTO_TCP, 40001, 10)) {
            return failed(reason, "check failed: net-hostinput: no window ACK, no challenge\0");
        }
        if (now(Counter.ChallengeAcks) != challenges || now(Counter.TcpQuietDropped) <= tq) {
            return failed(reason, "check failed: net-hostinput: a quiet rejection\0");
        }
    }
    if (recvSock(a1, buf() as *mut void, 256, 2) != -(EAGAIN as i64)) {
        return failed(reason, "check failed: net-hostinput: alive, not reset\0");
    }
    // Rejected probes consume no shared budget: more than TCP_CHALLENGE_PER_SEC in-window SYNs under the rule, then a
    // legitimate in-window SYN on C2 (port 2223, no rule) still draws its RFC 5961 challenge ACK.
    tq = now(Counter.TcpQuietDropped);
    var challenges = now(Counter.ChallengeAcks);
    for (i in 0..truncate<i32>(TCP_CHALLENGE_PER_SEC + 20)) {
        if (!tcpIn(x, 0, 40001, 2222, 1003, iss1.wrappingAdd(1), TH_SYN, 64240)) {
            return failed(reason, "check failed: net-hostinput: an in-window SYN is sent\0");
        }
        if (i % 20 == 19) {
            sleepMs(10); // paced under the receive queue's depth, well inside one budget second
        }
    }
    if (!rises(Counter.TcpQuietDropped, tq + TCP_CHALLENGE_PER_SEC + 19)) {
        return failed(reason, "check failed: net-hostinput: every SYN is a quiet rejection\0");
    }
    if (now(Counter.ChallengeAcks) != challenges) {
        return failed(reason, "check failed: net-hostinput: and none is challenged\0");
    }
    if (!tcpIn(x, 1, 40002, 2223, 3000, 0, TH_SYN, 64240) || !heard(IPPROTO_TCP, 40002, HIN_TRIES) ||
        (sgFlags() & TH_SYN) == 0 || sgAck() != 3001) {
        return failed(reason, "check failed: net-hostinput: C2's SYN-ACK\0");
    }
    let iss2 = sgSeq();
    if (!tcpIn(x, 1, 40002, 2223, 3001, iss2.wrappingAdd(1), TH_ACK, 64240)) {
        return failed(reason, "check failed: net-hostinput: C2's ACK\0");
    }
    let a2 = accept(k.ls2);
    if (a2.isNull()) {
        return failed(reason, "check failed: net-hostinput: C2 is accepted\0");
    }
    ksock_set_nonblock(a2, true);
    challenges = now(Counter.ChallengeAcks);
    if (!tcpIn(x, 1, 40002, 2223, 3001, iss2.wrappingAdd(1), TH_SYN, 64240) || !heard(IPPROTO_TCP, 40002, HIN_TRIES) ||
        sgFlags() != TH_ACK || sgAck() != 3001) {
        return failed(reason, "check failed: net-hostinput: the challenge\0");
    }
    if (!rises(Counter.ChallengeAcks, challenges)) {
        return failed(reason, "check failed: net-hostinput: the challenge is counted\0");
    }

    // The keepalive clock is not refreshed by a rejected segment: with a short idle time armed at C4's establishment
    // and rejected probes arriving every 40 ms under a rule covering the peer, the probe still fires.
    nettest_tcp_set_keepalive(150 * 1000000, 50 * 1000000, 3);
    if (!tcpIn(x, 3, 40004, 2223, 4000, 0, TH_SYN, 64240) || !heard(IPPROTO_TCP, 40004, HIN_TRIES) ||
        (sgFlags() & TH_SYN) == 0 || sgAck() != 4001) {
        return failed(reason, "check failed: net-hostinput: C4's SYN-ACK\0");
    }
    let iss4 = sgSeq();
    // The DROP rule covering the peer lands between the admitted SYN and its completing ACK: the ACK is delivered
    // quiet, and the SYN-cache completion still creates the child -- the fourth acceptance point.
    var w3Room = cmd(layoutOf<fw_rule>().size);
    let rW3 = hinRule(mut w3Room, FW_DIR_FROM_UPLINK, IPPROTO_TCP, w[3], 32, 2223, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rW3) != 0) {
        return failed(reason, "check failed: net-hostinput: the w3 rule is added\0");
    }
    quiet = now(Counter.HinQuiet);
    tq = now(Counter.TcpQuietDropped);
    if (!tcpIn(x, 3, 40004, 2223, 4001, iss4.wrappingAdd(1), TH_ACK, 64240)) {
        return failed(reason, "check failed: net-hostinput: C4's ACK\0");
    }
    let a4 = accept(k.ls2);
    if (a4.isNull()) {
        return failed(reason, "check failed: net-hostinput: C4 is accepted under the rule\0");
    }
    if (!rises(Counter.HinQuiet, quiet)) {
        return failed(reason, "check failed: net-hostinput: its ACK delivered quiet\0");
    }
    if (now(Counter.TcpQuietDropped) != tq) {
        return failed(reason, "check failed: net-hostinput: and not dropped (C4)\0");
    }
    // (the short idle stays in force until the probe has fired: the timer re-reads it when it re-arms, so restoring
    // the default now would arm two hours and prove nothing)
    let probes = now(Counter.KeepaliveProbes);
    tq = now(Counter.TcpQuietDropped);
    for (i in 0..10) {
        if (!tcpIn(x, 3, 40004, 2223, 4001 + 100000, iss4.wrappingAdd(1), TH_ACK, 64240)) {
            return failed(reason, "check failed: net-hostinput: a rejected probe is sent\0");
        }
        sleepMs(40);
    }
    let probesNow = now(Counter.KeepaliveProbes);
    let tqNow = now(Counter.TcpQuietDropped);
    nettest_tcp_set_keepalive(0, 0, 0);
    if (probesNow <= probes) {
        return failed(reason, "check failed: net-hostinput: the keepalive probe fires\0");
    }
    if (tqNow < tq + 10) {
        return failed(reason, "check failed: net-hostinput: the probes were rejected\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rW3) != 0) {
        return failed(reason, "check failed: net-hostinput: the w3 rule is deleted\0");
    }
    nettest_ksock_put(a4);

    // The host's own outbound connection completes under a rule covering the peer (the SYN_SENT acceptance point),
    // and a bare ACK to a tuple with no connection from that peer is freed silently.
    var w4Room = cmd(layoutOf<fw_rule>().size);
    let rW4 = hinRule(mut w4Room, FW_DIR_FROM_UPLINK, IPPROTO_TCP, w[4], 32, 0, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rW4) != 0) {
        return failed(reason, "check failed: net-hostinput: the w4 rule is added\0");
    }
    drain(U);
    if (!nettest_hin_connect(w[4], 9000, "hin-connect\0".ptr as *CChar)) {
        return failed(reason, "check failed: net-hostinput: the connect thread starts\0");
    }
    if (!heard(IPPROTO_TCP, 9000, HIN_TRIES) || sgFlags() != TH_SYN) {
        return failed(reason, "check failed: net-hostinput: the host's SYN\0");
    }
    let hiss = sgSeq();
    let hport = sgSport();
    quiet = now(Counter.HinQuiet);
    if (!tcpIn(
        x,
        4,
        9000,
        hport,
        5000,
        hiss.wrappingAdd(1),
        TH_SYN | TH_ACK,
        64240,
    ) || !rises(Counter.HinQuiet, quiet)) {
        return failed(reason, "check failed: net-hostinput: the peer's SYN-ACK is delivered quiet\0");
    }
    if (!heard(IPPROTO_TCP, 9000, HIN_TRIES) || sgFlags() != TH_ACK || sgAck() != 5001) {
        return failed(reason, "check failed: net-hostinput: the completing ACK\0");
    }
    var rc: i32 = -1;
    var done = false;
    for (i in 0..100) {
        done = nettest_hin_connect_done(borrow mut rc as *mut i32);
        if (done) {
            break;
        }
        sleepMs(10);
    }
    if (!done || rc != 0) {
        return failed(reason, "check failed: net-hostinput: the host's connect completes\0");
    }
    let cs = nettest_hin_connect_join();
    if (cs.isNull()) {
        return failed(reason, "check failed: net-hostinput: the connection's release is deferred\0"); // else put at once
    }
    tq = now(Counter.TcpQuietDropped);
    if (!tcpIn(x, 4, 9001, hport, 5001, hiss.wrappingAdd(1), TH_ACK, 64240) || !rises(Counter.TcpQuietDropped, tq)) {
        return failed(reason, "check failed: net-hostinput: a bare ACK to no connection is freed\0");
    }
    if (heard(IPPROTO_TCP, 9001, 15)) {
        return failed(reason, "check failed: net-hostinput: silently\0");
    }
    // The host closes first: its FIN goes out; the peer's ACK and FIN are accepted (TIME_WAIT); a bare ACK there draws
    // nothing; a retransmitted FIN -- an exact-position match on the connection -- is acknowledged.
    nettest_ksock_put(cs);
    if (!heard(IPPROTO_TCP, 9000, HIN_TRIES) || (sgFlags() & TH_FIN) == 0 || sgSeq() != hiss.wrappingAdd(1)) {
        return failed(reason, "check failed: net-hostinput: the host's FIN\0");
    }
    if (!tcpIn(x, 4, 9000, hport, 5001, hiss.wrappingAdd(2), TH_ACK, 64240) ||
        !tcpIn(
            x,
            4,
            9000,
            hport,
            5001,
            hiss.wrappingAdd(2),
            TH_FIN | TH_ACK,
            64240,
        ) || !heard(IPPROTO_TCP, 9000, HIN_TRIES) ||
        sgFlags() != TH_ACK || sgAck() != 5002) {
        return failed(reason, "check failed: net-hostinput: the peer's FIN is acknowledged\0");
    }
    drain(U);
    if (!tcpIn(x, 4, 9000, hport, 5002, hiss.wrappingAdd(2), TH_ACK, 64240) || heard(IPPROTO_TCP, 9000, 10)) {
        return failed(reason, "check failed: net-hostinput: a bare ACK in TIME_WAIT draws nothing\0");
    }
    if (!tcpIn(
        x,
        4,
        9000,
        hport,
        5001,
        hiss.wrappingAdd(2),
        TH_FIN | TH_ACK,
        64240,
    ) || !heard(IPPROTO_TCP, 9000, HIN_TRIES) ||
        sgFlags() != TH_ACK || sgAck() != 5002) {
        return failed(reason, "check failed: net-hostinput: a retransmitted FIN is acknowledged\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rW4) != 0) {
        return failed(reason, "check failed: net-hostinput: the w4 rule is deleted\0");
    }

    // Accepted segments that do not advance snd_una keep their output (C1, still under the port-2222 DROP rule): three
    // duplicate ACKs build the fast retransmission; a window update from zero re-enables a blocked send; data with an
    // unchanged ACK is delivered and acknowledged; the peer's FIN is acknowledged and the socket reads EOF.
    drain(U);
    var data: [u8; 100] = [0; 100];
    for (i in 0..100) {
        data[truncate<usize>(i)] = truncate<u8>(i);
    }
    let dp = borrow data as *[u8; 100] as *u8;
    if (ksock_sendto(a1, dp as *void, 100, 0 as *netaddr) != 100) {
        return failed(reason, "check failed: net-hostinput: C1 sends 100 bytes\0");
    }
    if (!heard(IPPROTO_TCP, 40001, HIN_TRIES) || sgPaylen() != 100 || sgSeq() != iss1.wrappingAdd(1)) {
        return failed(reason, "check failed: net-hostinput: the 100 bytes go out\0");
    }
    let retx = now(Counter.Retransmits);
    tq = now(Counter.TcpQuietDropped);
    for (i in 0..3) {
        if (!tcpIn(x, 0, 40001, 2222, 1003, iss1.wrappingAdd(1), TH_ACK, 64240)) {
            return failed(reason, "check failed: net-hostinput: a duplicate ACK is sent\0");
        }
    }
    if (!heard(IPPROTO_TCP, 40001, 20) || sgPaylen() != 100 || sgSeq() != iss1.wrappingAdd(1)) {
        return failed(reason, "check failed: net-hostinput: retransmitted\0");
    }
    if (now(Counter.Retransmits) <= retx || now(Counter.TcpQuietDropped) != tq) {
        return failed(reason, "check failed: net-hostinput: a fast retransmission, nothing dropped\0");
    }
    if (!tcpIn(x, 0, 40001, 2222, 1003, iss1.wrappingAdd(101), TH_ACK, 0)) { // all acked, window 0
        return failed(reason, "check failed: net-hostinput: the zero window is sent\0");
    }
    drain(U);
    if (ksock_sendto(a1, dp as *void, 50, 0 as *netaddr) != 50) {
        return failed(reason, "check failed: net-hostinput: C1 sends 50 bytes\0");
    }
    // Blocked by the zero window: nothing of 50 bytes goes out. The retransmit timer may send a one-byte probe
    // meanwhile (its RTO is about this phase's length), and a probe seen here is the run's first byte.
    let zwSeen = heard(IPPROTO_TCP, 40001, 15);
    if (zwSeen && sgPaylen() >= 50) {
        return failed(reason, "check failed: net-hostinput: blocked by the zero window\0");
    }
    let zwCovered: u32 = if (zwSeen && sgSeq() == iss1.wrappingAdd(101) && sgPaylen() == 1) 1 else 0;
    if (!tcpIn(x, 0, 40001, 2222, 1003, iss1.wrappingAdd(101), TH_ACK, 64240)) { // window update
        return failed(reason, "check failed: net-hostinput: the window update is sent\0");
    }
    // Every one of the 50 bytes from iss1.wrappingAdd(101): in one segment, or a probe (read above or not) and the rest past it,
    // in either order (net-zero-window-probe).
    if (!recvStream(U, 40001, iss1.wrappingAdd(101), zwCovered, 50, sg(), false)) {
        return failed(reason, "check failed: net-hostinput: the window update re-enables the send\0");
    }
    drain(U);
    if (!tcpData(x, w[0], 0, 40001, 2222, 1003, iss1.wrappingAdd(151), TH_ACK, 64240, dp, 10) ||
        !tcpData(x, w[0], 0, 40001, 2222, 1013, iss1.wrappingAdd(151), TH_ACK, 64240, dp, 10)) { // unchanged ACK
        return failed(reason, "check failed: net-hostinput: data with an unchanged ACK is sent\0");
    }
    // 20 bytes, whether the read catches them together or one segment at a time (the worker may still be queuing the
    // second).
    var got: i64 = 0;
    while (got < 20) {
        let off = truncate<usize>(got);
        let n = recvSock(a1, buf().add(off) as *mut void, 256 - off, 50);
        if (n <= 0) {
            break;
        }
        got += n;
    }
    if (got != 20) {
        return failed(reason, "check failed: net-hostinput: the 20 bytes are delivered\0");
    }
    // Both segments are acknowledged: at once, or the first at once and the second by the delayed-ACK timer -- the last
    // ACK names 1023.
    var acked = false;
    for (i in 0..3) {
        if (!acked) {
            acked = heard(IPPROTO_TCP, 40001, HIN_TRIES) && (sgFlags() & TH_ACK) != 0 && sgAck() == 1023;
        }
    }
    if (!acked) {
        return failed(reason, "check failed: net-hostinput: and acknowledged (1023)\0");
    }
    if (!tcpIn(
        x,
        0,
        40001,
        2222,
        1023,
        iss1.wrappingAdd(151),
        TH_FIN | TH_ACK,
        64240,
    ) || !heard(IPPROTO_TCP, 40001, HIN_TRIES) ||
        (sgFlags() & TH_ACK) == 0 || sgAck() != 1024) {
        return failed(reason, "check failed: net-hostinput: the peer's FIN is acknowledged (C1)\0");
    }
    if (recvSock(a1, buf() as *mut void, 256, HIN_TRIES) != 0) {
        return failed(reason, "check failed: net-hostinput: EOF\0");
    }
    nettest_ksock_put(a1);
    // A valid reset (seq == rcv_nxt) from a peer under a DROP rule still tears C2 down: the socket reports it, and
    // nothing is emitted.
    var w1Room = cmd(layoutOf<fw_rule>().size);
    let rW1 = hinRule(mut w1Room, FW_DIR_FROM_UPLINK, IPPROTO_TCP, w[1], 32, 2223, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rW1) != 0) {
        return failed(reason, "check failed: net-hostinput: the w1 rule is added\0");
    }
    drain(U);
    let rsts = now(Counter.RstsIn);
    tq = now(Counter.TcpQuietDropped);
    if (!tcpIn(x, 1, 40002, 2223, 3001, iss2.wrappingAdd(1), TH_RST | TH_ACK, 64240) ||
        recvSock(a2, buf() as *mut void, 256, HIN_TRIES) != -(ECONNRESET as i64)) {
        return failed(reason, "check failed: net-hostinput: a valid reset tears C2 down\0");
    }
    if (now(Counter.RstsIn) <= rsts || now(Counter.TcpQuietDropped) != tq) {
        return failed(reason, "check failed: net-hostinput: counted as a reset, not dropped\0");
    }
    if (heard(IPPROTO_TCP, 40002, 10)) {
        return failed(reason, "check failed: net-hostinput: nothing is emitted\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rW1) != 0 || fw_rule_del(FW_HOST_GUEST_IP, r2222) != 0) {
        return failed(reason, "check failed: net-hostinput: the w1 and port-2222 rules are deleted\0");
    }
    nettest_ksock_put(a2);

    // (5) UDP and ICMP are per datagram: an icmp type-8 DROP drops an echo request -- delivered quiet, then freed by
    // icmp_input, the one place that dispatches ICMP (the host-state unit) -- and no reply comes back; a type-0
    // datagram passes the default; without the rule echo is answered.
    var echoRoom = cmd(layoutOf<fw_rule>().size);
    let rEcho = hinRule(mut echoRoom, FW_DIR_FROM_UPLINK, IPPROTO_ICMP, 0, 0, ICMP_ECHO as u16, FW_DROP);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rEcho) != 0) {
        return failed(reason, "check failed: net-hostinput: the echo rule is added\0");
    }
    drain(U);
    base = now(Counter.HinDropRule);
    let iq = now(Counter.IcmpQuietDropped);
    if (!icmpIn(x, ICMP_ECHO, 0x5151) || !rises(Counter.HinDropRule, base) || !rises(Counter.IcmpQuietDropped, iq)) {
        return failed(reason, "check failed: net-hostinput: the echo is dropped by type\0");
    }
    if (heard(IPPROTO_ICMP, 0, 15)) {
        return failed(reason, "check failed: net-hostinput: no reply comes back\0");
    }
    base = now(Counter.HinAcceptDefault);
    if (!icmpIn(x, ICMP_ECHO_REPLY, 0x5151) || !rises(Counter.HinAcceptDefault, base)) {
        return failed(reason, "check failed: net-hostinput: a type-0 datagram passes the default\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rEcho) != 0) {
        return failed(reason, "check failed: net-hostinput: the echo rule is deleted\0");
    }
    if (!icmpIn(x, ICMP_ECHO, 0x5152) || !heard(IPPROTO_ICMP, 0, HIN_TRIES) || sgFlags() != ICMP_ECHO_REPLY) {
        return failed(reason, "check failed: net-hostinput: echo is answered\0");
    }

    // (6) off-link: a link's datagrams are for that link's address. No rule installed. The world's query to guest A's
    // gateway (the tap's DNS proxy) and its datagram to a loopback-bound listener are dropped before any chain; the
    // loopback listener still hears a loopback sender; a guest's datagram to 127.0.0.1 or to the uplink's address is
    // dropped likewise.
    let hinAcceptRule0 = now(Counter.HinAcceptRule);
    let hinDropRule0 = now(Counter.HinDropRule);
    let hinAcceptDefault0 = now(Counter.HinAcceptDefault);
    let hinDropDefault0 = now(Counter.HinDropDefault);
    var offlink = now(Counter.RxOfflink);
    if (!udpIn(x, gwa, 6100, 53, plp, 4) || !rises(Counter.RxOfflink, offlink)) {
        return failed(reason, "check failed: net-hostinput: the world's query to A's gateway is off-link\0");
    }
    offlink = now(Counter.RxOfflink);
    if (!udpIn(x, loopbackN(), 6101, 7002, plp, 4) || !rises(Counter.RxOfflink, offlink)) {
        return failed(reason, "check failed: net-hostinput: the world's datagram to 127.0.0.1 is off-link\0");
    }
    if (recvSock(k.ul, buf() as *mut void, 256, 5) != -(EAGAIN as i64)) {
        return failed(reason, "check failed: net-hostinput: the loopback listener hears nothing of it\0");
    }
    if (!loopbackHeard(k.ul)) {
        return failed(reason, "check failed: net-hostinput: the loopback listener hears a loopback sender\0");
    }
    offlink = now(Counter.RxOfflink);
    var len = nettest_mk_udp(l4(), ga, loopbackN(), 6102, 7002, plp, 4);
    if (!nettest_fwt_send(FA, t0, am, ga, loopbackN(), IPPROTO_UDP, l4() as *u8, len) ||
        !rises(Counter.RxOfflink, offlink)) {
        return failed(reason, "check failed: net-hostinput: a guest's datagram to 127.0.0.1 is off-link\0");
    }
    offlink = now(Counter.RxOfflink);
    let filtered = now(Counter.InFiltered);
    len = nettest_mk_udp(l4(), ga, uip, 6103, 7000, plp, 4);
    if (!nettest_fwt_send(FA, t0, am, ga, uip, IPPROTO_UDP, l4() as *u8, len) || !rises(Counter.RxOfflink, offlink)) {
        return failed(reason, "check failed: net-hostinput: a guest's datagram to the uplink is off-link\0");
    }
    if (now(Counter.InFiltered) != filtered) {
        return failed(reason, "check failed: net-hostinput: not INPUT's default any more\0");
    }
    if (now(Counter.HinAcceptRule) != hinAcceptRule0 || now(Counter.HinDropRule) != hinDropRule0 ||
        now(Counter.HinAcceptDefault) != hinAcceptDefault0 || now(Counter.HinDropDefault) != hinDropDefault0) {
        return failed(reason, "check failed: net-hostinput: before any chain\0");
    }
    // Not this chain's ingress: a guest-tap datagram to the host still takes the INPUT chain (A's DNS seed admits it),
    // and the host chain's counters do not move for it.
    base = now(Counter.InAcceptRule);
    let accDef = now(Counter.HinAcceptDefault);
    let dropDef = now(Counter.HinDropDefault);
    len = nettest_mk_udp(l4(), ga, gwa, 6104, 53, plp, 4);
    if (!nettest_fwt_send(FA, t0, am, ga, gwa, IPPROTO_UDP, l4() as *u8, len) || !rises(Counter.InAcceptRule, base)) {
        return failed(reason, "check failed: net-hostinput: a guest's datagram takes the INPUT chain\0");
    }
    if (now(Counter.HinAcceptDefault) != accDef || now(Counter.HinDropDefault) != dropDef) {
        return failed(reason, "check failed: net-hostinput: not the host chain\0");
    }

    // (7) ordering after nat_in, now provable: with a port-forward to A and the host default DROP, the world's SYN to
    // host:8080 is still DNAT'd to A -- authorized by the pf rule, never re-gated -- and the host chain's counters do
    // not move. Loopback is untouched by the default.
    let pf = nat_pf_add(IPPROTO_TCP, 8080, ga, 80);
    if (pf != 0 || fw_policy_set(FW_HOST_GUEST_IP, FW_DIR_FROM_UPLINK, FW_DROP) != 0) {
        return failed(reason, "check failed: net-hostinput: the forward and the host DROP default\0");
    }
    let dropDef0 = now(Counter.HinDropDefault);
    let dropRule0 = now(Counter.HinDropRule);
    if (!tcpIn(x, 0, 41000, 8080, 7000, 0, TH_SYN, 64240)) {
        return failed(reason, "check failed: net-hostinput: the SYN to 8080 is sent\0");
    }
    var rx: [u8; 160] = [0; 160];
    let n = nettest_fwt_recv(FA, borrow mut rx as *mut [u8; 160] as *mut u8, 160, 50);
    if (n < truncate<i64>(ETH_HLEN + 40)) {
        return failed(reason, "check failed: net-hostinput: DNAT'd to A\0");
    }
    let src = wordOf(rx[..], ETH_HLEN + 12);
    let dst = wordOf(rx[..], ETH_HLEN + 16);
    if (src != w[0] || dst != ga || rx[ETH_HLEN + 9] != IPPROTO_TCP ||
        rd16(rx[..], ETH_HLEN + 20 + 2) != 80) {
        return failed(reason, "check failed: net-hostinput: to A's port 80\0");
    }
    if (now(Counter.HinDropDefault) != dropDef0 || now(Counter.HinDropRule) != dropRule0) {
        return failed(reason, "check failed: net-hostinput: never re-gated\0");
    }
    if (!loopbackHeard(k.ul)) {
        return failed(reason, "check failed: net-hostinput: loopback is untouched by the default\0");
    }
    // Default flip: under DROP an unruled SYN drops; an explicit ACCEPT rule readmits it; back to ACCEPT.
    drain(U);
    base = now(Counter.HinDropDefault);
    if (!tcpIn(x, 2, 40010, 2223, 8000, 0, TH_SYN, 64240) || !rises(Counter.HinDropDefault, base)) {
        return failed(reason, "check failed: net-hostinput: an unruled SYN drops by default\0");
    }
    if (heard(IPPROTO_TCP, 40010, 15)) {
        return failed(reason, "check failed: net-hostinput: unanswered\0");
    }
    var openRoom = cmd(layoutOf<fw_rule>().size);
    let rOpen = hinRule(mut openRoom, FW_DIR_FROM_UPLINK, IPPROTO_TCP, 0, 0, 2223, FW_ACCEPT);
    if (fw_rule_add(FW_HOST_GUEST_IP, 0, rOpen) != 0) {
        return failed(reason, "check failed: net-hostinput: the ACCEPT rule is added\0");
    }
    base = now(Counter.HinAcceptRule);
    if (!tcpIn(x, 2, 40011, 2223, 8000, 0, TH_SYN, 64240) || !heard(IPPROTO_TCP, 40011, HIN_TRIES) ||
        (sgFlags() & TH_SYN) == 0) {
        return failed(reason, "check failed: net-hostinput: the ACCEPT rule readmits it\0");
    }
    if (!rises(Counter.HinAcceptRule, base)) {
        return failed(reason, "check failed: net-hostinput: by rule\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, rOpen) != 0 ||
        fw_policy_set(FW_HOST_GUEST_IP, FW_DIR_FROM_UPLINK, FW_ACCEPT) != 0 || !nat_pf_del(IPPROTO_TCP, 8080)) {
        return failed(reason, "check failed: net-hostinput: back to ACCEPT\0");
    }

    // (8) scope discipline: the host owns FROM_UPLINK and the source; a guest owns the other three and no source; ANY
    // is nobody's on the host.
    var badRoom = cmd(layoutOf<fw_rule>().size);
    let einval = -EINVAL;
    if (fw_rule_add(
        FW_HOST_GUEST_IP,
        0,
        hinRule(mut badRoom, FW_DIR_TO_HOST, IPPROTO_TCP, 0, 0, 22, FW_DROP),
    ) != einval) {
        return failed(reason, "check failed: net-hostinput: the host may not name TO_HOST\0");
    }
    if (fw_rule_add(
        FW_HOST_GUEST_IP,
        0,
        hinRule(mut badRoom, FW_DIR_ANY, IPPROTO_TCP, 0, 0, 22, FW_ACCEPT),
    ) != einval) {
        return failed(reason, "check failed: net-hostinput: nor ANY\0");
    }
    if (fw_rule_add(ga, 0, hinRule(mut badRoom, FW_DIR_FROM_UPLINK, IPPROTO_TCP, 0, 0, 22, FW_DROP)) != einval) {
        return failed(reason, "check failed: net-hostinput: a guest may not name FROM_UPLINK\0");
    }
    if (fw_rule_add(
        ga,
        0,
        hinRule(mut badRoom, FW_DIR_TO_HOST, IPPROTO_TCP, ip4(10, 0, 0, 0), 8, 22, FW_ACCEPT),
    ) != einval) {
        return failed(reason, "check failed: net-hostinput: nor a source\0");
    }
    if (fw_rule_add(
        FW_HOST_GUEST_IP,
        0,
        hinRule(mut badRoom, FW_DIR_FROM_UPLINK, IPPROTO_TCP, ip4(10, 0, 0, 0), 0, 22, FW_DROP),
    ) != einval) {
        return failed(reason, "check failed: net-hostinput: any source is 0/0\0");
    }
    if (fw_policy_set(FW_HOST_GUEST_IP, FW_DIR_TO_HOST, FW_ACCEPT) != einval ||
        fw_policy_set(ga, FW_DIR_FROM_UPLINK, FW_DROP) != einval) {
        return failed(reason, "check failed: net-hostinput: the policies' scopes\0");
    }
    if (fw_rule_del(FW_HOST_GUEST_IP, r2222) != -ENOENT) {
        return failed(reason, "check failed: net-hostinput: the deleted rule is gone\0");
    }

    // (9) the control channel: a host rule with a source written through tapctl (guest_addr 0) is listed in the host's
    // record with its source beside policy_from_uplink; a host rule naming TO_HOST and a version-3 sized write are
    // refused.
    var fctl = 0 as *mut file;
    if (nettest_vfs_open("/dev/net/tapctl\0".ptr as *CChar, O_RDWR, borrow mut fctl as *mut *mut file) != 0 ||
        fctl.isNull()) {
        return failed(reason, "check failed: net-hostinput: the control device opens\0");
    }
    let whole = truncate<i64>(filterLen());
    let einval64 = -(EINVAL as i64);
    var cRoom = cmd(filterLen());
    var c = hostFilter(mut cRoom, NETCTL_FILTER_ADD, NETCTL_HOST_ADDR, NETCTL_DIR_FROM_UPLINK, 2224);
    if (file_write(fctl, c as *void, filterLen()) != whole) {
        return failed(reason, "check failed: net-hostinput: the sourced host rule through the device\0");
    }
    if (file_write(fctl, c as *void, 20) != einval64) {
        return failed(reason, "check failed: net-hostinput: a version-3 sized command is refused\0");
    }
    var cbRoom = cmd(filterLen());
    if (file_write(
        fctl,
        hostFilter(mut cbRoom, NETCTL_FILTER_ADD, NETCTL_HOST_ADDR, NETCTL_DIR_TO_HOST, 2225) as *void,
        filterLen(),
    ) != einval64) {
        return failed(reason, "check failed: net-hostinput: a host rule naming TO_HOST is refused\0");
    }
    if (file_write(
        fctl,
        hostFilter(mut cbRoom, NETCTL_FILTER_ADD, ga, NETCTL_DIR_FROM_UPLINK, 2226) as *void,
        filterLen(),
    ) != einval64) {
        return failed(reason, "check failed: net-hostinput: a guest may not name FROM_UPLINK (device)\0");
    }
    let sn = file_read(fctl, borrow mut SNAP as *mut [u8; 65536] as *mut void, 65536);
    if (sn <= 0 || !snapshotCarries()) {
        return failed(reason, "check failed: net-hostinput: the host record with its source\0");
    }
    c = hostFilter(mut cRoom, NETCTL_FILTER_DEL, NETCTL_HOST_ADDR, NETCTL_DIR_FROM_UPLINK, 2224);
    if (file_write(fctl, c as *void, filterLen()) != whole || !noHostRules()) {
        return failed(reason, "check failed: net-hostinput: and deleted\0");
    }
    nettest_file_put(fctl);
    return true;
}

/// net-hostinput: the world reaches the host under the default, a sourced DROP is matched by prefix, a DROP is quiet,
/// ICMP is dropped by type, off-link datagrams are dropped before any chain, DNAT is never re-gated, the scopes hold,
/// and the control listing carries the host record with its source.
/// Safety: the runner's `reason`.
@export("selftest_net_hostinput")
unsafe fn hostinput(reason: *mut *CChar) -> bool {
    put(Ptr.toBorrowMut(reason), 0 as *CChar);
    if (layoutOf<hin_seg>().size > 128) {
        tooSmall();
    }
    fw_flush();
    nat_flush();

    // The uplink: a real, non-guest link (neither masquerading nor loopback), as net-dnat builds one, with the world on
    // the far side.
    let x = World {
        uip: ip4(10, 77, 8, 1),
        w: [ip4(10, 77, 8, 99), ip4(10, 77, 8, 98), ip4(10, 77, 8, 97), ip4(10, 77, 8, 96), ip4(10, 77, 8, 95)],
        umac: [0x52, 0x54, 0x00, 0x1a, 0x00, 0x01],
        wmac: [
            0x52, 0x54, 0x00, 0x1a, 0x00, 0x63, 0x52, 0x54, 0x00, 0x1a, 0x00, 0x62, 0x52, 0x54, 0x00, 0x1a, 0x00, 0x61,
            0x52, 0x54, 0x00, 0x1a, 0x00, 0x60, 0x52, 0x54, 0x00, 0x1a, 0x00, 0x5f,
        ],
    };
    let xb = borrow x;
    U = nettest_tap_create("hinu\0".ptr as *CChar, x.uip, MASK24_N, umacOf(xb));
    if (U.isNull()) {
        return failed(reason, "check failed: net-hostinput: the uplink tap\0");
    }
    for (i in 0..5) {
        let j = truncate<usize>(i);
        nettest_seed_arp(tap_netif(U), x.w[j], wmacOf(xb, j));
    }
    // And one guest through /dev/net/tap (so it attaches): A on tap0.
    FA = 0 as *mut file;
    if (nettest_vfs_open("/dev/net/tap\0".ptr as *CChar, O_RDWR | O_NONBLOCK, borrow mut FA as *mut *mut file) != 0 ||
        FA.isNull()) {
        return failed(reason, "check failed: net-hostinput: A opens its tap\0");
    }
    let ga = ip4(10, 0, 3, 15);
    let gwa = ip4(10, 0, 3, 1);
    let amac: [u8; 6] = [0x52, 0x54, 0x00, 0x0f, 0x00, 0x0a];
    let tap0 = netif_find("tap0\0".ptr as *CChar);
    if (tap0.isNull()) {
        return failed(reason, "check failed: net-hostinput: tap0\0");
    }
    nettest_seed_arp(tap0, ga, borrow amac as *[u8; 6] as *u8);
    netif_put(tap0);

    // The host's services: two TCP listeners, a UDP listener, a UDP socket connected to a world peer, and a
    // loopback-bound UDP listener.
    var k = Socks {
        ls1: 0 as *mut socket,
        ls2: 0 as *mut socket,
        us: 0 as *mut socket,
        uc: 0 as *mut socket,
        ul: 0 as *mut socket,
    };
    if (!tcpListener(borrow mut k.ls1 as *mut *mut socket, 2222) ||
        !tcpListener(borrow mut k.ls2 as *mut *mut socket, 2223)) {
        return failed(reason, "check failed: net-hostinput: the TCP listeners\0");
    }
    if (!udpListener(borrow mut k.us as *mut *mut socket, 0, 7000) ||
        !udpListener(borrow mut k.uc as *mut *mut socket, 0, 7001)) {
        return failed(reason, "check failed: net-hostinput: the UDP sockets\0");
    }
    let peer = v4addr(x.w[0], 5555);
    if (ksock_connect(k.uc, na(borrow peer)) != 0) {
        return failed(reason, "check failed: net-hostinput: the UDP socket connects\0");
    }
    if (!udpListener(borrow mut k.ul as *mut *mut socket, loopbackN(), 7002)) {
        return failed(reason, "check failed: net-hostinput: the loopback listener\0");
    }

    if (!hostinputBody(reason, xb, borrow k, ga, gwa)) {
        return false;
    }
    nettest_ksock_put(k.ls1);
    nettest_ksock_put(k.ls2);
    nettest_ksock_put(k.us);
    nettest_ksock_put(k.uc);
    nettest_ksock_put(k.ul);
    nettest_file_put(FA);
    drain(U);
    nettest_tap_destroy(U);
    fw_flush();
    nat_flush();
    var buffer: [u8; 768] = [0; 768];
    var line = TextWriter.create(mut buffer[..]);
    line.text(
        "selftest: net-hostinput: the world reached the host under the default, a sourced DROP matched by prefix, a DROP was quiet (established data and the host's own connect completed, probes and new SYNs drew no RST, SYN-ACK, challenge or window ACK, no port-unreachable, no budget spent, no keepalive refresh; dup-ACKs, a window update, data and a FIN kept their output; a valid reset applied), ICMP dropped by type, off-link datagrams dropped before any chain, DNAT never re-gated, the scopes held, and the control listing carried the host record with its source",
    );
    KernelLog.send(LogLevel.Info, line);
    return true;
}
