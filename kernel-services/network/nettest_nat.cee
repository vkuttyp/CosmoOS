// nettest_nat.cee - masquerade across two taps, and a second interface taking over, in CeeSafe: roadmap 2.0 SA6
// (nettest, the twentieth batch). net-nat and net-second-nic, as nettest.c had them. net-nat injects a guest's frames
// into one tap and reads them out of the other, built and checked with nettest_tap.cee's frame builders (nettest.h);
// the frames and the read-back headers are rooms, off the stack. net-second-nic takes the default interface down and
// resolves the gateway through whatever other ethernet interface the machine has.

@header("nettest.h", "kernel/net/inet.h", "kernel/net/ip.h", "kernel/net/ether.h", "kernel/net/tcp.h", "kernel/net/cksum.h", "kernel/net/tap.h", "kernel/net/nat.h", "kernel/netif.h", "kernel/mbuf.h", "kernel/selftest.h", "kernel/thread.h")
extern "C" {
    struct tap;
    struct mbuf_pkt {
        len: u32;
    }
    struct mbuf {
        len: u32;
        pkt: mbuf_pkt;
    }
    struct netif_ip4 {
        gateway: u32;
    }
    struct netif_stats {
        rx_packets: u64;
        tx_packets: u64;
    }
    struct netif {
        name: [u8; 8];
        flags: u32;
        ip4: netif_ip4;
        stats: netif_stats;
    }
    struct nat_stats {
        out_new: u64;
        out_drop_share: u64;
        out_drop_table: u64;
        expired: u64;
        entries: u32;
    }
    struct ip_stats {
        fwd_spoofed: u64;
    }

    fn nettest_tap_create(name: *CChar, ip: u32, mask: u32, mac: *u8) -> *mut tap;
    fn nettest_tap_destroy(t: *mut tap);
    fn nettest_seed_arp(nif: *mut netif, peerIp: u32, peerMac: *u8);
    fn nettest_recv_ip(t: *mut tap) -> *mut mbuf;
    fn nettest_mk_udp(l4: *mut u8, sip: u32, dip: u32, sp: u16, dp: u16, pl: *u8, pllen: u16) -> u16;
    fn nettest_mk_tcp(l4: *mut u8, sip: u32, dip: u32, sp: u16, dp: u16, flags: u8) -> u16;
    fn nettest_mk_icmp(l4: *mut u8, kind: u8, id: u16, seq: u16, pl: *u8, pllen: u16) -> u16;
    fn nettest_l4_ok(sip: u32, dip: u32, proto: u8, l4: *void, len: u16) -> bool;
    fn nettest_wrap(
        frame: *mut u8,
        dmac: *u8,
        smac: *u8,
        sip: u32,
        dip: u32,
        ttl: u8,
        proto: u8,
        l4: *void,
        l4len: u16,
    ) -> u32;

    fn tap_netif(t: *mut tap) -> *mut netif;
    fn tap_inject(t: *mut tap, frame: *void, len: u32) -> i32;
    fn tap_recv(t: *mut tap) -> *mut mbuf;
    fn netif_find(name: *CChar) -> *mut netif;
    fn netif_put(nif: *mut netif);
    fn netif_default() -> *mut netif;
    fn netif_set_up(nif: *mut netif, up: bool);
    fn netif_set_forward(nif: *mut netif, on: bool);
    fn netif_set_masquerade(nif: *mut netif, on: bool);
    fn ipv4_get_stats(out: *mut ip_stats);
    fn nat_flush();
    fn nat_get_stats(out: *mut nat_stats);
    fn nat_age(nowNs: u64);
    fn arp_resolve(nif: *mut netif, ip: u32, mac: *mut u8, m: *mut mbuf) -> i32;
    fn arp_lookup(nif: *netif, ip: u32, mac: *mut u8) -> bool;
    fn arp_delete(nif: *netif, ip: u32);
    fn in_cksum(data: *void, len: usize) -> u16;
    fn m_getcl() -> *mut mbuf;
    fn m_freem(m: *mut mbuf);
    fn m_copydata(m: *mbuf, off: u32, len: u32, to: *mut void) -> bool;
    fn thread_sleep_ns(ns: u64);
    fn clock_now_ns() -> u64;
}

// ---- ip.h, tcp.h, ether.h, nat.h, netif.h, errno.h and time values (asserted in nettest_floor.c) ----

const IPPROTO_ICMP: u8 = 1;
const IPPROTO_TCP: u8 = 6;
const IPPROTO_UDP: u8 = 17;
const ICMP_ECHO_REPLY: u8 = 0;
const ICMP_DEST_UNREACH: u8 = 3;
const ICMP_UNREACH_PORT: u8 = 3;
const ICMP_ECHO: u8 = 8;
const TH_SYN: u8 = 0x02;
const TH_ACK: u8 = 0x10;
const ETH_HLEN: usize = 14;
const ETH_HLEN_U32: u32 = 14;
/// sizeof(struct udp_hdr), sizeof(struct tcp_hdr), sizeof(struct icmp_hdr).
const UDP_HDR: u16 = 8;
const TCP_HDR: u16 = 20;
const ICMP_HDR: u16 = 8;
const NAT_PORT_MIN: u16 = 40000;
const NAT_PORT_MAX: u16 = 49151;
const NAT_TABLE_SIZE: u32 = 256;
const NAT_QUOTA_PER_GUEST: u32 = 32;
const NAT_TIMEOUT_UDP_NS: u64 = 30000000000;
const NETIF_LOOPBACK: u32 = 2;
const EINPROGRESS: i32 = 115;
const MS: u64 = 1000000;
/// 255.255.255.0 in network order, as it lies in a little-endian u32.
const MASK24_N: u32 = 0x00ffffff;
/// The payload's length.
const PL: u16 = 12;

/// IPV4_ADDR(a, b, c, d) as it lies in a little-endian u32 (inet.h's IPV4_ADDR and htonl assume the order).
fn ip4(a: u32, b: u32, c: u32, d: u32) -> u32 => a | (b << 8) | (c << 16) | (d << 24);

// ---- The checks ----

/// A failed check: its reason, for the runner's report, and false.
/// Safety: `reason` is the runner's; `why` is a zero-terminated literal, which outlives the report.
fn failed(reason: *mut *CChar, why: StringView) -> bool {
    unsafe {
        let r = Ptr.toBorrowMut(reason);
        put(r, why.ptr as *CChar);
    }
    return false;
}

fn put(slot: borrow mut *CChar, why: *CChar) {
    slot = why;
}

/// Safety: a sleep of the calling thread's.
fn sleepMs(ms: u64) {
    unsafe {
        thread_sleep_ns(ms * MS);
    }
}

fn macAt(m: borrow [u8; 6]) -> *u8 => m as *[u8; 6] as *u8;

fn be16(b: Slice<u8>, at: usize) -> u16 => ((b[at] as u16) << 8) | (b[at + 1] as u16);

/// A u32 as it lies in memory (an address in network order).
fn wordOf(b: Slice<u8>, at: usize) -> u32 => (b[at] as u32) | ((b[at + 1] as u32) << 8) | ((b[at + 2] as u32) << 16) |
    ((b[at + 3] as u32) << 24);

fn putWord(b: SliceMut<u8>, at: usize, v: u32) {
    b[at] = truncate<u8>(v);
    b[at + 1] = truncate<u8>(v >> 8);
    b[at + 2] = truncate<u8>(v >> 16);
    b[at + 3] = truncate<u8>(v >> 24);
}

/// A u16 as it lies in memory (a checksum in_cksum returned).
fn putHalf(b: SliceMut<u8>, at: usize, v: u16) {
    b[at] = truncate<u8>(v);
    b[at + 1] = truncate<u8>(v >> 8);
}

// ---- net-nat ----

// The test's frames, off the stack: the runner runs one test at a time.
static mut FRAME: [u8; 256] = [0; 256];
static mut L4: [u8; 128] = [0; 128];
static mut HDR: [u8; 80] = [0; 80];     // ETH_HLEN + 20 + 40: what the test reads back of a frame
static mut ICMPERR: [u8; 36] = [0; 36]; // 8 + 20 + 8: an ICMP error quoting a datagram
static mut STATS: [u64; 128] = [0; 128];

/// Safety: the runner runs one test at a time, so the rooms are this test's.
fn frame() -> *mut u8 => unsafe { borrow mut FRAME as *mut [u8; 256] as *mut u8 };

/// Safety: as frame.
fn l4() -> *mut u8 => unsafe { borrow mut L4 as *mut [u8; 128] as *mut u8 };

/// The IPv4 header's and the transport header's offsets in HDR.
const IP: usize = 14;
const L4AT: usize = 34;

/// NAT's counters the test reads.
struct Nat {
    outNew: u64;
    dropShare: u64;
    dropTable: u64;
    expired: u64;
    entries: u32;
}

/// Safety: as frame.
unsafe fn natNow() -> Nat {
    if (layoutOf<nat_stats>().size > 512 || layoutOf<ip_stats>().size > 512) {
        var buffer: [u8; 64] = [0; 64];
        var line = TextWriter.create(mut buffer[..]);
        line.text("nettest: a scratch is too small");
        KernelLog.panic(line);
    }
    let p = borrow mut STATS as *mut [u64; 128] as *mut nat_stats;
    nat_get_stats(p);
    let s = Ptr.toBorrow(p as *nat_stats);
    return Nat {
        outNew: s.out_new,
        dropShare: s.out_drop_share,
        dropTable: s.out_drop_table,
        expired: s.expired,
        entries: s.entries,
    };
}

/// Safety: as natNow.
unsafe fn spoofedNow() -> u64 {
    let p = (borrow mut STATS as *mut [u64; 128] as *mut u8).add(512) as *mut ip_stats;
    ipv4_get_stats(p);
    return Ptr.toBorrow(p as *ip_stats).fwd_spoofed;
}

/// Wrap L4's `len` bytes (`proto`) from `sip` to `dip`, `smac` to `dmac`, and inject them into `t`.
/// Safety: as frame; `t` is the test's tap.
unsafe fn send(
    t: *mut tap,
    dmac: borrow [u8; 6],
    smac: borrow [u8; 6],
    sip: u32,
    dip: u32,
    proto: u8,
    from: *u8,
    len: u16,
) -> bool {
    let flen = nettest_wrap(frame(), macAt(dmac), macAt(smac), sip, dip, 64, proto, from as *void, len);
    return tap_inject(t, frame() as *void, flen) == 0;
}

/// The next IPv4 frame out of `t`, its first `n` bytes in HDR; false when none came or it was shorter.
/// Safety: as frame; `t` is the test's tap.
unsafe fn receive(t: *mut tap, n: u32) -> bool {
    let m = nettest_recv_ip(t);
    if (m.isNull()) {
        return false;
    }
    let ok = m_copydata(m as *mbuf, 0, n, borrow mut HDR as *mut [u8; 80] as *mut void);
    m_freem(m);
    return ok;
}

/// Whether any IPv4 frame came out of `t` (freed).
/// Safety: `t` is the test's tap.
unsafe fn arrives(t: *mut tap) -> bool {
    let m = nettest_recv_ip(t);
    if (m.isNull()) {
        return false;
    }
    m_freem(m);
    return true;
}

/// Free whatever `t` has queued.
/// Safety: `t` is the test's tap.
unsafe fn drain(t: *mut tap) {
    var d = tap_recv(t);
    while (!d.isNull()) {
        m_freem(d);
        d = tap_recv(t);
    }
}

/// HDR's transport header, as a pointer for the checksum checks.
/// Safety: as frame.
unsafe fn l4Read() -> *void => (borrow HDR as *[u8; 80] as *u8).add(L4AT) as *void;

/// net-nat: UDP, TCP and ICMP masqueraded and restored, an ICMP error translated back, anti-spoof, the guest's share
/// and expiry.
/// Safety: the runner's `reason`.
@export("selftest_net_nat")
unsafe fn nat(reason: *mut *CChar) -> bool {
    let gMac: [u8; 6] = [0x52, 0x54, 0x00, 0x03, 0x00, 0x01];
    let uMac: [u8; 6] = [0x52, 0x54, 0x00, 0x04, 0x00, 0x01];
    let guestMac: [u8; 6] = [0x52, 0x54, 0x00, 0x03, 0x00, 0x0f];
    let peerMac: [u8; 6] = [0x52, 0x54, 0x00, 0x04, 0x00, 0x63];
    let gIp = ip4(10, 77, 3, 1);
    let guest = ip4(10, 77, 3, 15);
    let uIp = ip4(10, 77, 4, 1);
    let peer = ip4(10, 77, 4, 99);

    let g = nettest_tap_create("natg\0".ptr as *CChar, gIp, MASK24_N, macAt(borrow gMac));
    if (g.isNull()) {
        return failed(reason, "check failed: g != NULL\0");
    }
    let u = nettest_tap_create("natu\0".ptr as *CChar, uIp, MASK24_N, macAt(borrow uMac));
    if (u.isNull()) {
        return failed(reason, "check failed: u != NULL\0");
    }
    netif_set_forward(tap_netif(g), true);
    netif_set_masquerade(tap_netif(g), true); // masquerade flows forwarded from the guest tap
    nettest_seed_arp(tap_netif(u), peer, macAt(borrow peerMac));
    nettest_seed_arp(tap_netif(g), guest, macAt(borrow guestMac));
    nat_flush();

    var payload: [u8; 12] = [0; 12];
    for (i in 0..12) {
        payload[truncate<usize>(i)] = truncate<u8>(0x40 + i);
    }
    let pl = borrow payload as *[u8; 12] as *u8;
    let udpRead = ETH_HLEN_U32 + 20 + (PL as u32) + 8;

    // (1) UDP round trip: out masqueraded, reply un-masqueraded.
    var len = nettest_mk_udp(l4(), guest, peer, 6001, 7001, pl, PL);
    if (!send(g, borrow gMac, borrow guestMac, guest, peer, IPPROTO_UDP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (UDP out)\0");
    }
    if (!receive(u, udpRead)) {
        return failed(reason, "check failed: out != NULL && m_copydata(out, ...) (UDP out)\0");
    }
    var h: [u8; 80] = HDR;
    if (wordOf(h[..], IP + 12) != uIp || wordOf(h[..], IP + 16) != peer || h[IP + 8] != 63) { // source masqueraded
        return failed(reason, "check failed: oi->src == u_ip && oi->dst == peer && oi->ttl == 63\0");
    }
    let natPort = be16(h[..], L4AT); // the lent source port
    if (natPort < NAT_PORT_MIN || natPort > NAT_PORT_MAX) {
        return failed(reason, "check failed: nat_port >= NAT_PORT_MIN && nat_port <= NAT_PORT_MAX\0");
    }
    if (be16(h[..], L4AT + 2) != 7001) { // dest port unchanged
        return failed(reason, "check failed: dport == 7001\0");
    }
    if (!nettest_l4_ok(uIp, peer, IPPROTO_UDP, l4Read(), UDP_HDR + PL)) {
        return failed(reason, "check failed: nettest_l4_ok(u_ip, peer, IPPROTO_UDP, ol4, ...)\0");
    }

    len = nettest_mk_udp(l4(), peer, uIp, 7001, natPort, pl, PL);
    if (!send(u, borrow uMac, borrow peerMac, peer, uIp, IPPROTO_UDP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(u, frame, flen) == 0 (UDP back)\0");
    }
    if (!receive(g, udpRead)) {
        return failed(reason, "check failed: back != NULL && m_copydata(back, ...) (UDP back)\0");
    }
    h = HDR;
    if (wordOf(h[..], IP + 12) != peer || wordOf(h[..], IP + 16) != guest || h[IP + 8] != 63) { // delivered to the guest
        return failed(reason, "check failed: bi->src == peer && bi->dst == guest && bi->ttl == 63\0");
    }
    if (be16(h[..], L4AT + 2) != 6001) { // original guest port restored
        return failed(reason, "check failed: dport == 6001\0");
    }
    if (!nettest_l4_ok(peer, guest, IPPROTO_UDP, l4Read(), UDP_HDR + PL)) {
        return failed(reason, "check failed: nettest_l4_ok(peer, guest, IPPROTO_UDP, bl4, ...)\0");
    }
    for (i in 0..12) {
        let k = truncate<usize>(i);
        if (h[L4AT + 8 + k] != payload[k]) {
            return failed(
                reason,
                "check failed: memcmp(bl4 + sizeof(struct udp_hdr), payload, sizeof(payload)) == 0\0",
            );
        }
    }

    // (2) TCP SYN out, SYN-ACK back.
    len = nettest_mk_tcp(l4(), guest, peer, 6002, 80, TH_SYN);
    if (!send(g, borrow gMac, borrow guestMac, guest, peer, IPPROTO_TCP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (SYN)\0");
    }
    if (!receive(u, ETH_HLEN_U32 + 40)) {
        return failed(reason, "check failed: out != NULL && m_copydata(out, ...) (SYN)\0");
    }
    h = HDR;
    let tcpNat = be16(h[..], L4AT);
    if (wordOf(h[..], IP + 12) != uIp) {
        return failed(reason, "check failed: src == u_ip (SYN)\0");
    }
    if (!nettest_l4_ok(uIp, peer, IPPROTO_TCP, l4Read(), TCP_HDR)) {
        return failed(reason, "check failed: nettest_l4_ok(u_ip, peer, IPPROTO_TCP, ol4, sizeof(struct tcp_hdr))\0");
    }

    len = nettest_mk_tcp(l4(), peer, uIp, 80, tcpNat, TH_SYN | TH_ACK);
    if (!send(u, borrow uMac, borrow peerMac, peer, uIp, IPPROTO_TCP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(u, frame, flen) == 0 (SYN-ACK)\0");
    }
    if (!receive(g, ETH_HLEN_U32 + 40)) {
        return failed(reason, "check failed: back != NULL && m_copydata(back, ...) (SYN-ACK)\0");
    }
    h = HDR;
    if (wordOf(h[..], IP + 16) != guest) {
        return failed(reason, "check failed: dst == guest (SYN-ACK)\0");
    }
    if (be16(h[..], L4AT + 2) != 6002) {
        return failed(reason, "check failed: dport == 6002\0");
    }
    if (!nettest_l4_ok(peer, guest, IPPROTO_TCP, l4Read(), TCP_HDR)) {
        return failed(reason, "check failed: nettest_l4_ok(peer, guest, IPPROTO_TCP, bl4, sizeof(struct tcp_hdr))\0");
    }

    // (3) ICMP echo out, echo reply back (the id is the NAT identifier).
    len = nettest_mk_icmp(l4(), ICMP_ECHO, 0x4321, 1, pl, PL);
    if (!send(g, borrow gMac, borrow guestMac, guest, peer, IPPROTO_ICMP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (echo)\0");
    }
    if (!receive(u, udpRead)) {
        return failed(reason, "check failed: out != NULL && m_copydata(out, ...) (echo)\0");
    }
    h = HDR;
    let icmpNat = be16(h[..], L4AT + 4);
    if (wordOf(h[..], IP + 12) != uIp || h[L4AT] != ICMP_ECHO) {
        return failed(reason, "check failed: src == u_ip && ol4[0] == ICMP_ECHO\0");
    }
    if (in_cksum(l4Read(), (ICMP_HDR + PL) as usize) != 0) {
        return failed(reason, "check failed: in_cksum(ol4, ...) == 0 (echo)\0");
    }

    len = nettest_mk_icmp(l4(), ICMP_ECHO_REPLY, icmpNat, 1, pl, PL);
    if (!send(u, borrow uMac, borrow peerMac, peer, uIp, IPPROTO_ICMP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(u, frame, flen) == 0 (echo reply)\0");
    }
    if (!receive(g, udpRead)) {
        return failed(reason, "check failed: back != NULL && m_copydata(back, ...) (echo reply)\0");
    }
    h = HDR;
    if (wordOf(h[..], IP + 16) != guest || h[L4AT] != ICMP_ECHO_REPLY) {
        return failed(reason, "check failed: dst == guest && bl4[0] == ICMP_ECHO_REPLY\0");
    }
    if (be16(h[..], L4AT + 4) != 0x4321) { // original id restored
        return failed(reason, "check failed: id == 0x4321\0");
    }
    if (in_cksum(l4Read(), (ICMP_HDR + PL) as usize) != 0) {
        return failed(reason, "check failed: in_cksum(bl4, ...) == 0 (echo reply)\0");
    }

    // (4) ICMP error quoting a NAT'd packet is translated back to the guest. First open a UDP flow, then deliver a
    // dest-unreach whose quote is the packet we sent out.
    nat_flush();
    len = nettest_mk_udp(l4(), guest, peer, 6100, 53, pl, PL);
    if (!send(g, borrow gMac, borrow guestMac, guest, peer, IPPROTO_UDP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (the quoted datagram)\0");
    }
    if (!receive(u, ETH_HLEN_U32 + 28)) {
        return failed(reason, "check failed: out != NULL && m_copydata(out, ...) (the quoted datagram)\0");
    }
    let errNat = be16(HDR[..], L4AT);
    // The ICMP error: [icmp hdr][quoted IP: u_ip->peer UDP][8 bytes of that UDP: sport=err_nat, dport=53].
    let e = SliceMut.fromRaw(borrow mut ICMPERR as *mut [u8; 36] as *mut u8, 36);
    for (i in 0..e.length) {
        e[i] = 0;
    }
    e[0] = ICMP_DEST_UNREACH;
    e[1] = ICMP_UNREACH_PORT;
    e[8] = 0x45; // vhl
    e[11] = 28;  // len: htons(20 + 8)
    e[16] = 63;  // ttl
    e[17] = IPPROTO_UDP;
    putWord(e, 20, uIp);
    putWord(e, 24, peer);
    putHalf(e, 18, in_cksum((borrow ICMPERR as *[u8; 36] as *u8).add(8) as *void, 20));
    e[28] = truncate<u8>(errNat >> 8); // sport = the lent port
    e[29] = truncate<u8>(errNat);
    e[31] = 53; // dport
    putHalf(e, 2, in_cksum(borrow ICMPERR as *[u8; 36] as *void, 36));
    let errAt = borrow ICMPERR as *[u8; 36] as *u8;
    if (!send(u, borrow uMac, borrow peerMac, peer, uIp, IPPROTO_ICMP, errAt, 36)) {
        return failed(reason, "check failed: tap_inject(u, frame, flen) == 0 (the error)\0");
    }
    if (!receive(g, ETH_HLEN_U32 + 56)) {
        return failed(reason, "check failed: back != NULL && m_copydata(back, ...) (the error)\0");
    }
    h = HDR;
    if (wordOf(h[..], IP + 16) != guest || h[IP + 9] != IPPROTO_ICMP) {
        return failed(reason, "check failed: bi->dst == guest && bi->proto == IPPROTO_ICMP\0");
    }
    if (wordOf(h[..], L4AT + 8 + 12) != guest) { // inner src un-NAT'd
        return failed(reason, "check failed: iq->src == guest\0");
    }
    if (be16(h[..], L4AT + 8 + 20) != 6100) { // inner source port restored
        return failed(reason, "check failed: inner sport == 6100\0");
    }

    // (4b) Anti-spoof: a guest frame sourced from the uplink subnet (not the guest tap's own) is dropped on
    // forwarding, never masqueraded or emitted with the forged source.
    let s0 = spoofedNow();
    let forged = ip4(10, 77, 4, 5);
    len = nettest_mk_udp(l4(), forged, peer, 6200, 53, pl, PL);
    if (!send(g, borrow gMac, borrow guestMac, forged, peer, IPPROTO_UDP, l4() as *u8, len)) {
        return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (forged)\0");
    }
    if (arrives(u)) { // forged source never leaves
        return failed(reason, "check failed: nettest_recv_ip(u) == NULL\0");
    }
    if (spoofedNow() <= s0) {
        return failed(reason, "check failed: is1.fwd_spoofed > is0.fwd_spoofed\0");
    }

    // (4c) An ICMP error with a bad checksum is not translated (the normal receive path would drop it; nat_in must not
    // launder it). Reuse the error frame but corrupt the ICMP checksum.
    e[3] = e[3] ^ 1; // *ecs ^= htons(1)
    if (!send(u, borrow uMac, borrow peerMac, peer, uIp, IPPROTO_ICMP, errAt, 36)) {
        return failed(reason, "check failed: tap_inject(u, frame, flen) == 0 (corrupt error)\0");
    }
    if (arrives(g)) { // corrupt error not forwarded
        return failed(reason, "check failed: nettest_recv_ip(g) == NULL\0");
    }

    // (5) Share exhaustion: distinct flows fill this guest's quota; further ones are dropped without consuming another
    // guest's slots.
    nat_flush();
    var n0 = natNow();
    let injected = NAT_TABLE_SIZE + 8;
    for (i in 0..injected) {
        len = nettest_mk_udp(l4(), guest, peer, truncate<u16>(10000 + i), 9, pl, 4);
        if (!send(g, borrow gMac, borrow guestMac, guest, peer, IPPROTO_UDP, l4() as *u8, len)) {
            return failed(reason, "check failed: tap_inject(g, frame, flen) == 0 (the flood)\0");
        }
        if ((i & 31) == 31) { // keep the uplink queue drained
            drain(u);
        }
    }
    // nat_flush clears entries, not lifetime counters. Count only this flood's outcomes: earlier round trips must not
    // let us age the table while tail packets can still create entries behind that sweep.
    for (i in 0..200) {
        drain(u);
        let n = natNow();
        if ((n.outNew - n0.outNew) + (n.dropShare - n0.dropShare) >= (injected as u64)) {
            break;
        }
        sleepMs(10);
    }
    var n1 = natNow();
    if ((n1.outNew - n0.outNew) + (n1.dropShare - n0.dropShare) != (injected as u64)) {
        return failed(reason, "check failed: new + dropped by the share == injected\0");
    }
    if (n1.entries != NAT_QUOTA_PER_GUEST) { // one guest is capped at its quota
        return failed(reason, "check failed: ns1.entries == NAT_QUOTA_PER_GUEST\0");
    }
    if (n1.dropShare <= n0.dropShare) { // new flows dropped once the share is full
        return failed(reason, "check failed: ns1.out_drop_share > ns0.out_drop_share\0");
    }
    if (n1.dropTable != n0.dropTable) { // the share, not the table: 32 of 256 in use
        return failed(reason, "check failed: ns1.out_drop_table == ns0.out_drop_table\0");
    }

    // (6) Expiry: aging past the timeout reclaims the entries.
    n0 = natNow();
    if (n0.entries == 0) {
        return failed(reason, "check failed: ns0.entries > 0\0");
    }
    nat_age(clock_now_ns() + 2 * NAT_TIMEOUT_UDP_NS);
    n1 = natNow();
    if (n1.entries != 0 || n1.expired <= n0.expired) {
        return failed(reason, "check failed: ns1.entries == 0 && ns1.expired > ns0.expired\0");
    }

    nat_flush();
    nettest_tap_destroy(u);
    nettest_tap_destroy(g);
    var buffer: [u8; 224] = [0; 224];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: net-nat: UDP/TCP/ICMP round trips masqueraded and restored (checksums valid), ");
    line.text("an ICMP error translated back, the guest capped at ");
    line.decimal(NAT_QUOTA_PER_GUEST as u64);
    line.text(" entries and the flood accounted for before expiry");
    KernelLog.send(LogLevel.Info, line);
    return true;
}

// ---- net-second-nic (docs/drivers/e1000e/testing.md) ----
//
// The half of the two-interface question a driver can be checked on: when the default interface goes down, the other
// becomes the default and carries traffic through its own rings. Written against no driver in particular -- it finds
// whatever second non-loopback interface the machine has -- because that is the claim being tested.

/// The first of eth0..eth15 that is not `notThis` and not a loopback, referenced; null for none.
/// Safety: thread context.
unsafe fn otherInterface(notThis: *mut netif) -> *mut netif {
    for (i in 0..16) {
        var name: [u8; 8] = [0x65, 0x74, 0x68, 0, 0, 0, 0, 0]; // "eth" and the number
        let k = truncate<u8>(i);
        if (k < 10) {
            name[3] = 0x30 + k;
        } else {
            name[3] = 0x31;
            name[4] = 0x30 + (k - 10);
        }
        let n = netif_find(borrow name as *[u8; 8] as *CChar);
        if (n.isNull()) {
            continue;
        }
        if (n != notThis && (Ptr.toBorrow(n as *netif).flags & NETIF_LOOPBACK) == 0) {
            return n;
        }
        netif_put(n);
    }
    return 0 as *mut netif;
}

/// With the first interface down: the second is the default and resolves the gateway through its own rings.
/// Safety: the runner's `reason`; `second` is referenced.
unsafe fn secondBody(reason: *mut *CChar, second: *mut netif) -> bool {
    // The other takes over as soon as the first is down.
    let now = netif_default();
    if (now != second) {
        return failed(reason, "check failed: now == second\0");
    }
    netif_put(now);

    // The table is keyed by (interface, address) since N25, so the first interface's entry for the shared gateway
    // address cannot satisfy this; only the second's own could, if an earlier test resolved it. Remove that one, so a
    // frame must cross the second interface.
    var mac: [u8; 6] = [0; 6];
    let macP = borrow mut mac as *mut [u8; 6] as *mut u8;
    let s = Ptr.toBorrow(second as *netif);
    let gw = s.ip4.gateway;
    if (gw == 0) {
        return failed(reason, "check failed: gw != 0\0");
    }
    arp_delete(second as *netif, gw);
    if (arp_lookup(second as *netif, gw, macP)) {
        return failed(reason, "check failed: !arp_lookup(second, gw, mac)\0");
    }

    let rx0 = s.stats.rx_packets;
    let tx0 = s.stats.tx_packets;
    let m = m_getcl();
    if (m.isNull()) {
        return failed(reason, "check failed: m != NULL\0");
    }
    let r = Ptr.toBorrowMut(m);
    r.len = 20;
    r.pkt.len = 20;
    let rc = arp_resolve(second, gw, macP, m); // the request leaves through `second`
    if (rc != -EINPROGRESS && rc != 0) {
        return failed(reason, "check failed: rc == -EINPROGRESS || rc == 0\0");
    }
    var resolved = rc == 0;
    var waited: u32 = 0;
    while (waited < 2000 && !resolved) {
        sleepMs(10);
        resolved = arp_lookup(second as *netif, gw, macP);
        waited += 10;
    }
    if (!resolved) { // the reply came back: a frame out and a frame in through its rings
        return failed(reason, "check failed: resolved\0");
    }
    let s2 = Ptr.toBorrow(second as *netif);
    if (s2.stats.tx_packets <= tx0) {
        return failed(reason, "check failed: second->stats.tx_packets > tx0\0");
    }
    if (s2.stats.rx_packets <= rx0) {
        return failed(reason, "check failed: second->stats.rx_packets > rx0\0");
    }
    return true;
}

/// The length of an interface's name, up to its terminator.
fn nameLen(name: borrow [u8; 8]) -> usize {
    var len: usize = 0;
    while (len < 8 && name[len] != 0) {
        len += 1;
    }
    return len;
}

/// net-second-nic: the other interface takes over when the default goes down.
/// Safety: the runner's `reason`.
@export("selftest_net_second_nic")
unsafe fn secondNic(reason: *mut *CChar) -> bool {
    let first = netif_default();
    if (first.isNull()) {
        var buffer: [u8; 96] = [0; 96];
        var line = TextWriter.create(mut buffer[..]);
        line.text("selftest: net-second-nic: no ethernet interface; skipping");
        KernelLog.send(LogLevel.Info, line);
        return true;
    }
    let second = otherInterface(first);
    if (second.isNull()) {
        netif_put(first);
        var buffer: [u8; 96] = [0; 96];
        var line = TextWriter.create(mut buffer[..]);
        line.text("selftest: net-second-nic: one interface; skipping");
        KernelLog.send(LogLevel.Info, line);
        return true;
    }
    netif_set_up(first, false);
    var ok = secondBody(reason, second);
    // Whatever happened, the machine leaves with its default interface back: a later test that finds it down would
    // fail for this test's reason and say nothing about its own.
    netif_set_up(first, true);
    let again = netif_default();
    if (ok) {
        ok = again == first;
        if (!ok) {
            failed(reason, "the first interface did not become the default again\0");
        }
    }
    if (!again.isNull()) {
        netif_put(again);
    }
    if (ok) {
        var buffer: [u8; 160] = [0; 160];
        var line = TextWriter.create(mut buffer[..]);
        line.text("selftest: net-second-nic: ");
        let n2 = Ptr.toBorrow(second as *netif).name;
        line.bytes(n2[..nameLen(borrow n2)]);
        line.text(" took over from ");
        let n1 = Ptr.toBorrow(first as *netif).name;
        line.bytes(n1[..nameLen(borrow n1)]);
        line.text(" and resolved the gateway through its own rings");
        KernelLog.send(LogLevel.Info, line);
    }
    netif_put(second);
    netif_put(first);
    return ok;
}
