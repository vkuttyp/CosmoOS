// vfs_mount.cee - The VFS's mounts, in CeeSafe: roadmap 2.0 SA7. tests/host/test_vfs.c holds vfs.c, which this part of
// it was, to the digest of the C it replaced.
//
// The filesystem registry; mounts made, attached to the directory they cover in the namespace that made them, and
// unmounted -- by a namespace that only forgets one another still sees, or by the last one out, after the maintenance
// passes have drained and only if nothing is still referenced; the root switched to a mount on one of its
// directories, with the top-level mounts moving onto the new root; every mount synced without the table lock held
// across a commit; the block devices mounts claim (invariant V38: one device, its disk or one of its partitions, is
// one mount's); the VFS's initialisation, the root mount, the internal and detached mounts; formats; and the passes
// that name a mount by its id.
//
// The mounts, the filesystem types and the namespaces stay C (vfs.h, mountns.h). What C names as data is this file's
// (ADR 0080 §3.2): the mount table, its lock, the leaf lock of the namespaces' lists and the root mount, exported as
// vfs_internal.h declares them (mountns.cee and fsctl.cee import them), the registry's and the claims' lists and the
// claims' lock, the orphans, and the mount's kobject type; the drain and the reaper wait through wait.h's
// wait_floor_until, and the values this file writes as its own constants are the headers', which C checks.

@header("kernel/blk.h", "kernel/errno.h", "kernel/kmalloc.h", "kernel/list.h", "kernel/log.h", "kernel/mountns.h",
    "kernel/mutex.h", "kernel/object.h", "kernel/pagecache.h", "kernel/part.h", "kernel/printf.h", "kernel/string.h",
    "kernel/vfs.h", "kernel/cred.h", "kernel/lockdep.h", "kernel/pmm.h", "kernel/process.h", "kernel/sched.h",
    "kernel/spinlock.h", "kernel/thread.h", "kernel/timer.h", "kernel/wait.h", "vfs_internal.h")
extern "C" {
    struct cosmo_keyslot;
    struct waitqueue;
    struct thread;
    struct blkdev {
        obj: kobject;
        name: [u8; 16];
    }
    struct fs_type {
        name: *CChar;
        mount: extern "C" fn(*mut fs_type, *mut blkdev, u32, *mut mount) -> i32;
        unmount: extern "C" fn(*mut mount) -> i32;
        sync: extern "C" fn(*mut mount) -> i32;
        format: extern "C" fn(*mut blkdev, *CChar) -> i32;
        format_mirror: extern "C" fn(*mut *mut blkdev, u32, *CChar) -> i32;
        format_keyed: extern "C" fn(*mut *mut blkdev, u32, *CChar, *u8, *u8, *cosmo_keyslot) -> i32;
        link: list_node;
    }
    struct vnode {
        obj: kobject;
        mnt: *mut mount;
        ino: u64;
        @cname("type") kind: u32;
        lock: mutex;
        covers: list_node;
        hash_link: list_node;
        flags: u32;
    }
    struct mount {
        obj: kobject;
        id: u64;
        fs: *mut fs_type;
        root: *mut vnode;
        mountpoint: *mut vnode;
        parent: *mut mount;
        bdev: *mut blkdev;
        flags: u32;
        vnodes: [list_node; 64];
        lock: spinlock_t;
        rename_lock: mutex;
        sync_lock: mutex;
        link: list_node;
        cover_link: list_node;
        claim_link: list_node;
        nheld: u32;
        ns_refs: list_node;
        nr_vnodes: u32;
        next_ino: u64;
        passes_running: u64;
        /// The passes' wait queue, which an unmount's drain sleeps on.
        passes_quiet: waitqueue;
        /// The devices a mount holds beyond its own (MOUNT_HELD_MAX).
        held: [*mut blkdev; 12];
        unmounting: bool;
        unmounted: bool;
    }
    struct mount_ns {
        mounts: list_node;
    }
    struct mount_ns_ref {
        mnt: *mut mount;
        ns: *mut mount_ns;
        path: [u8; 1024];
        mnt_link: list_node;
        ns_link: list_node;
    }

    fn kzalloc(size: usize) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn strcmp(a: *CChar, b: *CChar) -> i32;
    fn strlen(s: *CChar) -> usize;
    fn strchr(s: *CChar, c: i32) -> *mut CChar;
    fn strlcpy(dst: *mut CChar, src: *CChar, size: usize) -> usize;
    fn kprintf(format: *CChar, ...);
    fn mutex_lock_nested(m: *mut mutex, subclass: u32);
    fn blkdev_get(bd: *mut blkdev);
    fn blkdev_put(bd: *mut blkdev);
    fn blk_part_disk(bd: *blkdev) -> *blkdev;
    fn mountns_current() -> *mut mount_ns;
    fn mountns_initial() -> *mut mount_ns;
    fn mountns_sees(ns: *mount_ns, mnt: *mount) -> bool;
    fn vnode_get(vn: *mut vnode);
    fn vnode_put(vn: *mut vnode);
    fn vfs_lookup(start: *mut vnode, path: *CChar, out: *mut *mut vnode) -> i32;
    fn vfs_lookup_named(start: *mut vnode, startname: *CChar, path: *CChar, out: *mut *mut vnode, name: *mut CChar,
        n: usize) -> i32;
    fn pagecache_set_limit(pages: u64);
    fn pagecache_dirty_init();
    fn waitqueue_init(wq: *mut waitqueue, name: *CChar);
    fn waitqueue_wake_all(wq: *mut waitqueue) -> u32;
    fn thread_create(entry: extern "C" fn(*mut void), arg: *mut void, name: *CChar, priority: i32) -> *mut thread;

    /// wait.h's wait_event, for a condition a callback tests.
    fn wait_floor_until(wq: *mut waitqueue, cond: extern "C" fn(*mut void) -> bool, arg: *mut void);
    /// pmm.h's figures: the pages the buddy manages, which the page cache takes a quarter of.
    struct pmm_stats {
        total_pages: u64;
    }
    fn pmm_get_stats(out: *mut pmm_stats);
    // The values and layout the C compiler checks (ADR 0080 §3.1), which the floor asserted.
    const VNODE_DIR: u32 = 2;
    const VNODE_HASH: u32 = 64;
    const SCHED_PRIO_DEFAULT: i32 = 32;
    const ENOENT: i32 = 2;
    const ENOMEM: i32 = 12;
    const EBUSY: i32 = 16;
    const EEXIST: i32 = 17;
    const ENODEV: i32 = 19;
    const ENOTDIR: i32 = 20;
    const EINVAL: i32 = 22;
    const ENOSPC: i32 = 28;
    const EOPNOTSUPP: i32 = 95;
    const KMEM_ZERO: u32 = 1;
    const VNODE_PINNED: u32 = 1;
    const VNODE_NESTED_CHILD: u32 = 2;
    const MOUNT_RDONLY: u32 = 1;
    const MOUNT_DETACHED: u32 = 8;
    const MOUNT_HELD_MAX: u32 = 12;
    const VFS_UMOUNT_FORCE: u32 = 1;
    const VFS_NAME_MAX: usize = 255;
    const VFS_PATH_MAX: usize = 1024;
    /// vfs_vnode.cee's errno.h values
    @cvalue("EINTR == 4 && ETIMEDOUT == 110")
    const VFS_MOUNT_FACT_0: bool = true;
    /// vfs_vnode.cee's vfs.h and process.h values
    @cvalue("VNODE_REG == 1 && VNODE_DEAD == 2 && PROCESS_NAME_MAX == 32")
    const VFS_MOUNT_FACT_1: bool = true;
    /// vfs_vnode.cee's field widths
    @cvalue("sizeof(((struct process *)0)->pid) == 4 && sizeof(((struct process *)0)->nr_threads) == 4 && sizeof(((struct mount *)0)->nr_vnodes) == 4 && sizeof(((struct vnode *)0)->flags) == 4")
    const VFS_MOUNT_FACT_2: bool = true;
    /// vfs_mount.cee's vfs.h, lockdep.h and blk.h values
    @cvalue("BLKDEV_NAME_MAX == 16 && sizeof(((struct mount_ns_ref *)0)->path) == VFS_PATH_MAX")
    const VFS_MOUNT_FACT_3: bool = true;
    /// vfs_mount.cee's field widths
    @cvalue("sizeof(((struct mount *)0)->nheld) == 4 && sizeof(((struct mount *)0)->flags) == 4 && sizeof(((struct mount *)0)->passes_running) == 8")
    const VFS_MOUNT_FACT_4: bool = true;
    /// vfs_walk.cee's errno.h values
    @cvalue("EPERM == 1 && EIO == 5 && ENXIO == 6 && EACCES == 13 && EISDIR == 21 && ETXTBSY == 26 && EROFS == 30 && ENAMETOOLONG == 36 && ELOOP == 40 && ENOTSUP == 95")
    const VFS_MOUNT_FACT_5: bool = true;
    /// vfs_walk.cee's vfs.h and cred.h values
    @cvalue("VNODE_SOCK == 5 && VNODE_LNK == 6 && VFS_MAX_COMPONENTS == 40 && VFS_MAX_SYMLINKS == 8 && VFS_MAY_EXEC == 1 && VFS_MAY_WRITE == 2 && VFS_MAY_READ == 4 && VFS_SET_MODE == 1 && VFS_SET_MTIME == 2 && VFS_SET_MTIME_NOW == 4 && VFS_ID_KEEP == 0xffffffffu && PRIV_SYS_ADMIN == 2 && CRED_ROOT_UID == 0")
    const VFS_MOUNT_FACT_6: bool = true;
    /// vfs_walk.cee's syscall.h values
    @cvalue("COSMO_O_RDONLY == 0 && COSMO_O_WRONLY == 1 && COSMO_O_ACCMODE == 3 && COSMO_O_CREAT == 0x40 && COSMO_O_EXCL == 0x80 && COSMO_O_TRUNC == 0x200 && COSMO_O_DIRECTORY == 0x10000 && COSMO_O_NOFOLLOW == 0x20000")
    const VFS_MOUNT_FACT_7: bool = true;
    /// vfs_file.cee's errno.h, vfs.h and syscall.h values
    @cvalue("EBADF == 9 && EFAULT == 14 && ESPIPE == 29 && VNODE_CHR == 3 && VNODE_FIFO == 4 && COSMO_O_APPEND == 0x400 && COSMO_O_NONBLOCK == 0x800 && COSMO_IO_READABLE == 1 && COSMO_IO_WRITABLE == 2 && COSMO_SEEK_SET == 0 && COSMO_SEEK_CUR == 1 && COSMO_SEEK_END == 2")
    const VFS_MOUNT_FACT_8: bool = true;
    /// vfs_file.cee's dirent layout and field widths
    @cvalue("sizeof(struct cosmo_dirent) == 16 && offsetof(struct cosmo_dirent, name) == 12 && sizeof(((struct file *)0)->flags) == 4")
    const VFS_MOUNT_FACT_9: bool = true;
    /// vfs_dir.cee's errno.h, lockdep.h, vfs.h and types.h values
    @cvalue("EXDEV == 18 && EMLINK == 31 && VNODE_NESTED_PARENT2 == 1 && MOUNT_CACHE_IS_STORE == 2 && VFS_LINK_MAX == 65000 && PAGE_SIZE == 4096")
    const VFS_MOUNT_FACT_10: bool = true;
}

// ---- The mount table (vfs_internal.h), the registry, the claims and the orphans (ADR 0080 §3.2) ----

/// The mount table, its lock (taken before any vnode lock), the lock of the mounts' list that /proc/mounts is
/// rendered under, and the root mount: vfs_internal.h's C data.
@export("g_mounts_lock")
static mut MOUNTS_LOCK: mutex = mutex {};
@export("g_mount_list_lock")
static mut MOUNT_LIST_LOCK: spinlock_t = SPINLOCK_INIT("mount-list\0".ptr as *CChar);
@export("g_mounts")
static mut MOUNTS: list_node = list_node {
    next: borrow mut MOUNTS as *mut list_node,
    prev: borrow mut MOUNTS as *mut list_node,
};
@export("g_root_mount")
static mut ROOT_MOUNT: *mut mount = 0 as *mut mount;

/// The registered filesystem types.
static mut FS_TYPES: list_node = list_node {
    next: borrow mut FS_TYPES as *mut list_node,
    prev: borrow mut FS_TYPES as *mut list_node,
};
/// The block devices mounts hold (invariant V38), under a leaf lock.
static mut CLAIM_LOCK: mutex = mutex {};
static mut CLAIMS: list_node = list_node { next: borrow mut CLAIMS as *mut list_node, prev: borrow mut CLAIMS as *mut list_node };
/// Orphans waiting for their last user (vfs_mount_orphaned), by `link`, under g_mounts_lock; the reaper sleeps on the
/// queue. test_vfs.c reads the list.
@export("vfs_orphans")
static mut ORPHAN_LIST: list_node = list_node {
    next: borrow mut ORPHAN_LIST as *mut list_node,
    prev: borrow mut ORPHAN_LIST as *mut list_node,
};
static mut ORPHAN_WQ: waitqueue = waitqueue {};
/// The mount's kobject type: the release is this file's.
static mut MOUNT_TYPE: kobject_type = kobject_type { name: "mount\0".ptr as *CChar, release: releaseObj };

/// Safety: the table is used under its lock.
unsafe fn mountsList() -> *mut list_node => borrow mut MOUNTS as *mut list_node;

/// Safety: as mountsList.
unsafe fn mountsLock() -> *mut mutex => borrow mut MOUNTS_LOCK as *mut mutex;

/// Safety: as mountsList.
unsafe fn mountListLock() -> *mut spinlock_t => borrow mut MOUNT_LIST_LOCK as *mut spinlock_t;

/// Safety: as mountsList.
unsafe fn rootSlot() -> *mut *mut mount => borrow mut ROOT_MOUNT as *mut *mut mount;

/// Safety: as mountsList.
unsafe fn fsTypes() -> *mut list_node => borrow mut FS_TYPES as *mut list_node;

/// Safety: the claims are used under their lock.
unsafe fn claims() -> *mut list_node => borrow mut CLAIMS as *mut list_node;

/// Safety: as claims.
unsafe fn claimLock() -> *mut mutex => borrow mut CLAIM_LOCK as *mut mutex;

/// Safety: as mountsList.
unsafe fn orphans() -> *mut list_node => borrow mut ORPHAN_LIST as *mut list_node;

/// Safety: the queue is set up at init.
unsafe fn orphanWq() -> *mut waitqueue => borrow mut ORPHAN_WQ as *mut waitqueue;

/// Safety: the type is never written.
unsafe fn mountType() -> *kobject_type => borrow mut MOUNT_TYPE as *mut kobject_type as *kobject_type;

/// Safety: `mnt` is a mount being made.
unsafe fn passesInit(mnt: *mut mount) {
    waitqueue_init(borrow mut Ptr.toBorrowMut(mnt).passes_quiet as *mut waitqueue, "mount-passes\0".ptr as *CChar);

}

/// No pass running: the drain's condition.
/// Safety: `arg` is a live mount.
@callback
unsafe fn passesQuiet(arg: *mut void) -> bool => passes(arg as *mut mount).loadWith(LoadOrdering.Acquire) == 0;

/// An unmount's drain sleeps until the last pass is released (wait.h's wait_event: the waiter is queued and BLOCKED
/// before the count is read, so no release is missed).
/// Safety: `mnt` is a live mount.
unsafe fn passesWait(mnt: *mut mount) {
    wait_floor_until(borrow mut Ptr.toBorrowMut(mnt).passes_quiet as *mut waitqueue, passesQuiet, mnt as *mut void);
}

/// Safety: as passesWait.
unsafe fn passesWake(mnt: *mut mount) {
    let _ = waitqueue_wake_all(borrow mut Ptr.toBorrowMut(mnt).passes_quiet as *mut waitqueue);
}

/// The pages the buddy manages.
/// Safety: the page allocator is up.
unsafe fn totalPages() -> u64 {
    var pst: pmm_stats;
    pmm_get_stats(borrow mut pst as *mut pmm_stats);
    return pst.total_pages;
}

// errno.h, vfs.h and lockdep.h's.

/// How many mounts are on the table. Under g_mounts_lock.
static mut NR_MOUNTS: u32 = 0;
static mut INITIALIZED: bool = false;
/// Mount ids, handed out in order and never reused. Atomic rather than under g_mounts_lock because a mount is built
/// before that lock is taken (do_mount runs, then vfs_mount publishes), so there is no lock here to put it under.
/// Starts at 1: zero names no mount.
static NEXT_MOUNT_ID: AtomicU64 = AtomicU64.constant(1);
/// Orphans waiting for their last user (vfs_mount_orphaned), and the nudges vnode_put gives the reaper while there are
/// any. Sequentially consistent: an orphan counted before its busy check, and a put that drops a reference before it
/// reads the count, cannot both miss each other.
static ORPHANS: AtomicU32 = AtomicU32.constant(0);
static KICKS: AtomicU32 = AtomicU32.constant(0);
/// The reaper is started at the first orphan that has to wait. Under g_mounts_lock.
static mut REAPER: bool = false;

/// The panic of a broken invariant (the C's KASSERT).
fn check(ok: bool, what: StringView) {
    if (!ok) {
        var buffer: [u8; 128] = [0; 128];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: assertion failed: ");
        line.text(what);
        KernelLog.panic(line);
    }
}

/// A NUL-terminated C string into the line.
/// Safety: `s` is NUL-terminated.
unsafe fn cString(line: borrow mut TextWriter, s: *CChar) {
    var p = s as *u8;
    while (*Ptr.toBorrow(p) != 0) {
        line.byte(*Ptr.toBorrow(p));
        p = p.add(1);
    }
}

/// A device's name, or "memory" for none.
/// Safety: `bd` is null or a live device.
unsafe fn deviceName(line: borrow mut TextWriter, bd: *mut blkdev) {
    if (bd.isNull()) {
        line.text("memory");
    } else {
        cString(mut line, borrow Ptr.toBorrow(bd as *blkdev).name as *[u8; 16] as *CChar);
    }
}

/// Safety: `vn` is live.
unsafe fn lockOf(vn: *mut vnode) -> *mut mutex => borrow mut Ptr.toBorrowMut(vn).lock as *mut mutex;

/// Safety: `mnt` is live.
unsafe fn objOf(mnt: *mut mount) -> *mut kobject => borrow mut Ptr.toBorrowMut(mnt).obj as *mut kobject;

/// Safety: `mnt` is live.
unsafe fn passes(mnt: *mut mount) -> borrow(static) AtomicU64 =>
    Ptr.toBorrow(borrow mut Ptr.toBorrowMut(mnt).passes_running as *mut u64 as *AtomicU64);

/// Safety: `node` is a mount's `link`.
unsafe fn mountOfLink(node: *mut list_node) -> *mut mount => containerOf(node, offsetOf<mount>(link)) as *mut mount;

/// Safety: `node` is a mount's `cover_link`.
unsafe fn mountOfCover(node: *mut list_node) -> *mut mount =>
    containerOf(node, offsetOf<mount>(cover_link)) as *mut mount;

/// Safety: `node` is a mount's `claim_link`.
unsafe fn mountOfClaim(node: *mut list_node) -> *mut mount =>
    containerOf(node, offsetOf<mount>(claim_link)) as *mut mount;

/// Safety: `node` is a filesystem type's `link`.
unsafe fn fsOfLink(node: *mut list_node) -> *mut fs_type => containerOf(node, offsetOf<fs_type>(link)) as *mut fs_type;

/// Safety: `node` is a ref's `mnt_link`.
unsafe fn refOfMntLink(node: *mut list_node) -> *mut mount_ns_ref =>
    containerOf(node, offsetOf<mount_ns_ref>(mnt_link)) as *mut mount_ns_ref;

/// Safety: `node` is a ref's `ns_link`.
unsafe fn refOfNsLink(node: *mut list_node) -> *mut mount_ns_ref =>
    containerOf(node, offsetOf<mount_ns_ref>(ns_link)) as *mut mount_ns_ref;

/// Safety: `r` is a live ref.
unsafe fn pathOf(r: *mut mount_ns_ref) -> *mut u8 => (r as *mut u8).add(offsetOf<mount_ns_ref>(path));

/// Device `i` of the ones `mnt` holds beyond its own.
/// Safety: `mnt` is live; i < MOUNT_HELD_MAX.
unsafe fn heldOf(mnt: *mut mount, i: u32) -> *mut *mut blkdev =>
    ((mnt as *mut u8).add(offsetOf<mount>(held)) as *mut *mut blkdev).add(i as usize);

/// Safety: `mnt` is live; b < VNODE_HASH.
unsafe fn bucket(mnt: *mut mount, b: u32) -> *mut list_node =>
    (borrow mut Ptr.toBorrowMut(mnt).vnodes as *mut [list_node; 64] as *mut list_node).add(b as usize);

/// Safety: `node` is a hashed vnode's link.
unsafe fn vnodeOfHash(node: *mut list_node) -> *mut vnode =>
    containerOf(node, offsetOf<vnode>(hash_link)) as *mut vnode;

// --- the devices mounts hold (invariant V38) ------------------------------------------------------------------------
//
// One device was mountable twice -- two filesystem instances writing one disk, each sure it was alone. A mount
// claims its device before fs->mount reads it and gives it back after fs->unmount is done, which is longer than it is
// on g_mounts: an unmount takes the mount off that list before the filesystem has finished. The claims' lock is a
// leaf: nothing is taken under it.

/// The disk objects, not their names: a removed device's name is free for the next one to take, so a mount still
/// holding a pulled vda2 does not hold the new disk called vda (roadmap 1.2 B3's test-mirror), and does hold the old
/// vda while its partitions are being unregistered before it (Codex on #442).
/// Safety: both are live devices.
unsafe fn related(a: *blkdev, b: *blkdev) -> bool =>
    a == b || blk_part_disk(a) == b || blk_part_disk(b) == a;

/// `bd` against everything mount `mnt` holds. Under the claims' lock.
/// Safety: `mnt` is a claimed mount; `bd` is live.
unsafe fn claimCovers(mnt: *mut mount, bd: *mut blkdev) -> bool {
    if (related(Ptr.toBorrow(mnt as *mount).bdev as *blkdev, bd as *blkdev)) {
        return true;
    }
    var i: u32 = 0;
    while (i < Ptr.toBorrow(mnt as *mount).nheld) {
        if (related(*Ptr.toBorrow(heldOf(mnt, i)) as *blkdev, bd as *blkdev)) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// Claim `mnt`'s device, or -EBUSY: it, its disk or one of its partitions is another mount's.
/// Safety: `mnt` is a mount with a device, not claimed.
unsafe fn claim(mnt: *mut mount) -> i32 {
    let lock = claimLock();
    mutex_lock(lock);
    let head = claims();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        if (claimCovers(mountOfClaim(node), Ptr.toBorrow(mnt as *mount).bdev)) {
            mutex_unlock(lock);
            return -EBUSY;
        }
        node = List.next(head as *list_node, node);
    }
    List.pushBack(head, borrow mut Ptr.toBorrowMut(mnt).claim_link as *mut list_node);
    mutex_unlock(lock);
    return 0;
}

/// Safety: `mnt` is a claimed mount.
unsafe fn unclaim(mnt: *mut mount) {
    let lock = claimLock();
    mutex_lock(lock);
    List.remove(borrow mut Ptr.toBorrowMut(mnt).claim_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).claim_link as *mut list_node);
    let n = Ptr.toBorrow(mnt as *mount).nheld;
    var held: [*mut blkdev; 12] = [0 as *mut blkdev; 12];
    let _ = memcpy(borrow mut held as *mut [*mut blkdev; 12] as *mut void, heldOf(mnt, 0) as *void,
        layoutOf<[*mut blkdev; 12]>().size);
    {
        let x1 = Ptr.toBorrowMut(mnt);
        x1.nheld = 0;
    }
    mutex_unlock(lock);
    var i: u32 = 0;
    while (i < n) {
        blkdev_put(held[i as usize]);
        i += 1;
    }
}

/// Safety: `mnt` is a mount the caller is setting up; `bd` holds `n` live devices.
@export("vfs_mount_set_held")
unsafe fn setHeld(mnt: *mut mount, bd: **mut blkdev, n: u32) -> i32 {
    if (n > MOUNT_HELD_MAX) {
        return -ENOSPC;
    }
    let lock = claimLock();
    mutex_lock(lock);
    let head = claims();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let other = mountOfClaim(node);
        if (other != mnt) {
            var i: u32 = 0;
            while (i < n) {
                if (claimCovers(other, *Ptr.toBorrow(bd.add(i as usize)))) {
                    mutex_unlock(lock);
                    return -EBUSY;
                }
                i += 1;
            }
        }
        node = List.next(head as *list_node, node);
    }
    var i: u32 = 0;
    while (i < n) {
        blkdev_get(*Ptr.toBorrow(bd.add(i as usize)));
        i += 1;
    }
    let was = Ptr.toBorrow(mnt as *mount).nheld;
    var old: [*mut blkdev; 12] = [0 as *mut blkdev; 12];
    let _ = memcpy(borrow mut old as *mut [*mut blkdev; 12] as *mut void, heldOf(mnt, 0) as *void,
        layoutOf<[*mut blkdev; 12]>().size);
    i = 0;
    while (i < n) {
        {
            let slot1 = Ptr.toBorrowMut(heldOf(mnt, i));
            *slot1 = *Ptr.toBorrow(bd.add(i as usize));
        }
        i += 1;
    }
    {
        let x2 = Ptr.toBorrowMut(mnt);
        x2.nheld = n;
    }
    mutex_unlock(lock);
    i = 0;
    while (i < was) {
        blkdev_put(old[i as usize]);
        i += 1;
    }
    return 0;
}

/// A mount is done with its device: the claim, then its reference.
/// Safety: `mnt` is live.
unsafe fn putDevice(mnt: *mut mount) {
    let bd = Ptr.toBorrow(mnt as *mount).bdev;
    if (bd.isNull()) {
        return;
    }
    unclaim(mnt);
    blkdev_put(bd);
}

/// The device claims, not g_mounts: a mount still being set up or still being torn down holds its device too (V38).
/// Safety: `bd` is live.
@export("vfs_bdev_mounted")
unsafe fn deviceMounted(bd: *blkdev) -> bool => deviceMountedExcept(bd, 0 as *mount);

/// Safety: `bd` is live; `self` is null or a mount.
@export("vfs_bdev_mounted_except")
unsafe fn deviceMountedExcept(bd: *blkdev, self: *mount) -> bool {
    var found = false;
    let lock = claimLock();
    mutex_lock(lock);
    let head = claims();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let mnt = mountOfClaim(node);
        if (self.isNull() || mnt as *mount != self) {
            if (claimCovers(mnt, bd as *mut blkdev)) {
                found = true;
                break;
            }
        }
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(lock);
    return found;
}

// --- the registry ---------------------------------------------------------------------------------------------------

/// The kobject type's release.
/// Safety: `obj` is a mount's object, at count zero.
@export("vfs_mount_release_obj")
unsafe fn releaseObj(obj: *mut kobject) {
    kfree(obj as *mut void);
}

/// Safety: `fs` outlives the kernel; its name is NUL-terminated.
@export("vfs_register_fs")
unsafe fn registerFs(fs: *mut fs_type) -> i32 {
    let f = Ptr.toBorrow(fs as *fs_type);
    if (f.name.isNull() || f.mount.isNull() || f.unmount.isNull()) {
        return -EINVAL;
    }
    let lock = mountsLock();
    mutex_lock(lock);
    let head = fsTypes();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        if (strcmp(Ptr.toBorrow(fsOfLink(node) as *fs_type).name, f.name) == 0) {
            mutex_unlock(lock);
            return -EEXIST;
        }
        node = List.next(head as *list_node, node);
    }
    let link = borrow mut Ptr.toBorrowMut(fs).link as *mut list_node;
    List.init(link);
    List.pushBack(head, link);
    mutex_unlock(lock);
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("vfs: filesystem ");
    cString(mut line, Ptr.toBorrow(fs as *fs_type).name);
    line.text(" registered");
    KernelLog.send(LogLevel.Debug, line);
    return 0;
}

/// Safety: `name` is NUL-terminated.
@export("vfs_find_fs")
unsafe fn findFs(name: *CChar) -> *mut fs_type {
    let lock = mountsLock();
    mutex_lock(lock);
    var found = 0 as *mut fs_type;
    let head = fsTypes();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let f = fsOfLink(node);
        if (strcmp(Ptr.toBorrow(f as *fs_type).name, name) == 0) {
            found = f;
            break;
        }
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(lock);
    return found;
}

// --- mounts ---------------------------------------------------------------------------------------------------------

/// Safety: `fs` is a registered type; `bdev` is null or a device the caller holds.
unsafe fn mountAlloc(fs: *mut fs_type, bdev: *mut blkdev, flags: u32) -> *mut mount {
    let mnt = kzalloc(layoutOf<mount>().size) as *mut mount;
    if (mnt.isNull()) {
        return mnt;
    }
    kobject_init(objOf(mnt), mountType());
    {
        let x = Ptr.toBorrowMut(mnt);
        x.id = NEXT_MOUNT_ID.fetchAddWith(1, Ordering.Relaxed);
        x.fs = fs;
        x.bdev = bdev;
        x.flags = flags;
        x.next_ino = 1;
    }
    var i: u32 = 0;
    while (i < VNODE_HASH) {
        List.init(bucket(mnt, i));
        i += 1;
    }
    spinlock_init(borrow mut Ptr.toBorrowMut(mnt).lock as *mut spinlock_t, "mount-hash\0".ptr as *CChar);
    mutex_init(borrow mut Ptr.toBorrowMut(mnt).rename_lock as *mut mutex, "rename\0".ptr as *CChar);
    mutex_init(borrow mut Ptr.toBorrowMut(mnt).sync_lock as *mut mutex, "mount-sync\0".ptr as *CChar);
    passesInit(mnt);
    List.init(borrow mut Ptr.toBorrowMut(mnt).link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).claim_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).ns_refs as *mut list_node);
    return mnt;
}

/// Safety: a root is mounted.
@export("vfs_root")
unsafe fn root() -> *mut vnode {
    let r = *Ptr.toBorrow(rootSlot());
    if (r.isNull()) {
        check(false, "g_root_mount != NULL"); // panics: the return is for the analyzer, which cannot see that
        return 0 as *mut vnode;
    }
    vnode_get(Ptr.toBorrow(r as *mount).root);
    return Ptr.toBorrow(r as *mount).root;
}

/// Instantiate the filesystem. On success the mount holds its root.
/// Safety: `fs` is a registered type; `bdev` is null or a device the caller holds; `out` is writable.
unsafe fn doMount(fs: *mut fs_type, bdev: *mut blkdev, flags: u32, out: *mut *mut mount) -> i32 {
    let mnt = mountAlloc(fs, bdev, flags);
    if (mnt.isNull()) {
        return -ENOMEM;
    }
    var rc = if (bdev.isNull()) 0 else claim(mnt);
    if (rc != 0) {
        kobject_put(objOf(mnt));
        return rc;
    }
    rc = Ptr.toBorrow(fs as *fs_type).mount(fs, bdev, flags, mnt);
    if (rc != 0) {
        if (!bdev.isNull()) {
            unclaim(mnt);
        }
        kobject_put(objOf(mnt));
        return rc;
    }
    let r = Ptr.toBorrow(mnt as *mount).root;
    check(!r.isNull() && Ptr.toBorrow(r as *vnode).kind == VNODE_DIR,
        "mnt->root != NULL && mnt->root->type == VNODE_DIR");
    if (!bdev.isNull()) {
        blkdev_get(bdev);
    }
    {
        let slot2 = Ptr.toBorrowMut(out);
        *slot2 = mnt;
    }
    return 0;
}

/// The mount covering `dir`, or NULL. The caller holds dir->lock, which is what made the old single pointer safe
/// against a concurrent umount and is what makes this list safe: umount removes its entry under the same lock. With
/// one namespace the list holds at most one entry.
/// Safety: `dir` is live and its lock held.
@export("vfs_covering_mount")
unsafe fn covering(dir: *vnode) -> *mut mount {
    let node = List.first(borrow Ptr.toBorrow(dir).covers as *list_node);
    return if (node.isNull()) 0 as *mut mount else mountOfCover(node);
}

/// The mount covering this directory *in a namespace*: what a walker follows and what refuses a second mount on the
/// same directory. The weaker question above -- covered in any namespace at all -- is what unlink and rename ask,
/// because a mount is attached to the vnode and not to the path, so a namespace that cannot see one is exactly the
/// one with no basis to decide its fate.
/// Safety: `dir` is live and its lock held; `ns` is live.
@export("vfs_covering_mount_ns")
unsafe fn coveringNs(dir: *vnode, ns: *mount_ns) -> *mut mount {
    let head = borrow Ptr.toBorrow(dir).covers as *list_node;
    var node = List.first(head);
    while (!node.isNull()) {
        let mnt = mountOfCover(node);
        if (mountns_sees(ns, mnt as *mount)) {
            return mnt;
        }
        node = List.next(head, node);
    }
    return 0 as *mut mount;
}

/// The same question asked of a child whose parent the caller already holds: rename and unlink check whether the
/// entry they are about to move or remove is a mountpoint. The lock is taken as a child, which is the order the rest
/// of the VFS uses (V7) and what keeps lockdep satisfied; a caller that already holds the vnode's own lock calls
/// covering_mount directly instead.
/// Safety: `vn` is live; its parent's lock is held and its own is not.
unsafe fn isMountpointChild(vn: *mut vnode) -> bool {
    mutex_lock_nested(lockOf(vn), VNODE_NESTED_CHILD);
    let covered = !covering(vn as *vnode).isNull();
    mutex_unlock(lockOf(vn));
    return covered;
}

/// And the same question for rename, which holds *both* parents: an entry it looks up can be one of them -- renaming
/// a directory onto its own parent, "/a/b" -> "/a", makes the destination lookup return the already-locked "/a" --
/// and taking that lock again panics. Compare against what is held rather than asking the mutex who owns it: the two
/// vnodes are right here, and a lock the code can name is better than one it has to interrogate.
/// Safety: `vn` is live; `held1` and `held2` are the directories whose locks the caller holds.
@export("vfs_entry_is_mountpoint")
unsafe fn entryIsMountpoint(vn: *mut vnode, held1: *mut vnode, held2: *mut vnode) -> bool {
    if (vn == held1 || vn == held2) {
        return !covering(vn as *vnode).isNull();
    }
    return isMountpointChild(vn);
}

/// A mount that was built but never attached: give it back to the filesystem and release everything it took. It is
/// on no list and no namespace can see it, so there is nothing to detach first.
/// Safety: `mnt` is a mount do_mount returned, not attached.
unsafe fn undoMount(mnt: *mut mount) {
    let _ = Ptr.toBorrow(Ptr.toBorrow(mnt as *mount).fs as *fs_type).unmount(mnt);
    vnode_put(Ptr.toBorrow(mnt as *mount).root);
    putDevice(mnt);
    kobject_put(objOf(mnt));
}

/// "vfs: mounted <fs> on <path> from <device>", and the like: the line's text and a C string.
/// Safety: `s` is NUL-terminated.
unsafe fn sayPath(level: LogLevel, before: StringView, path: *CChar, after: StringView) {
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text(before);
    cString(mut line, path);
    line.text(after);
    KernelLog.send(level, line);
}

/// Safety: `path` and `fsname` are NUL-terminated; `bdev` is null or a device the caller holds.
@export("vfs_mount")
unsafe fn mountPath(path: *CChar, fsname: *CChar, bdev: *mut blkdev, flags: u32) -> i32 =>
    mountAt(0 as *mut vnode, 0 as *CChar, path, fsname, bdev, flags);

/// `path` resolves from `start` as at every other entry point: a relative target names what the caller's own
/// directory names (docs/audit/next-subsystem-mount-rel.md).
/// Safety: `start` is null or a directory the caller holds; `startname` null or NUL-terminated; `path` and `fsname`
/// NUL-terminated; `bdev` null or a device the caller holds.
@export("vfs_mount_at")
unsafe fn mountAt(start: *mut vnode, startname: *CChar, path: *CChar, fsname: *CChar, bdev: *mut blkdev, flags: u32)
    -> i32 {
    check(INITIALIZED, "g_initialized");
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }

    // The namespace's record first: the walk writes the name it reached into ref->path (P32), so a relative target
    // is recorded as the directory it named, not as typed.
    let ns = mountns_current();
    let r = kmalloc(layoutOf<mount_ns_ref>().size, KMEM_ZERO) as *mut mount_ns_ref;
    if (r.isNull()) {
        return -ENOMEM;
    }
    var dir = 0 as *mut vnode;
    var rc: i32 = 0;
    if (*Ptr.toBorrow(path as *u8) == 0x2F || !startname.isNull()) {
        rc = vfs_lookup_named(start, startname, path, borrow mut dir as *mut *mut vnode, pathOf(r) as *mut CChar,
            VFS_PATH_MAX);
    } else {
        rc = vfs_lookup(start, path, borrow mut dir as *mut *mut vnode); // a kernel caller's relative path
        let _ = strlcpy(pathOf(r) as *mut CChar, path, VFS_PATH_MAX);
    }
    if (rc != 0) {
        kfree(r as *mut void);
        return rc;
    }
    if (Ptr.toBorrow(dir as *vnode).kind != VNODE_DIR) {
        vnode_put(dir);
        kfree(r as *mut void);
        return -ENOTDIR;
    }

    var mnt = 0 as *mut mount;
    rc = doMount(fs, bdev, flags, borrow mut mnt as *mut *mut mount);
    if (rc != 0) {
        vnode_put(dir);
        kfree(r as *mut void);
        return rc;
    }

    let table = mountsLock();
    mutex_lock(table);
    mutex_lock(lockOf(dir));
    // No stacking *in this namespace*: a directory already covered here (the lookup followed it, so `dir` is that
    // mount's root) or the global root. A mount another namespace has on the same directory is not in the way --
    // that is what makes them namespaces.
    let dirMount = Ptr.toBorrow(dir as *vnode).mnt;
    if (!coveringNs(dir as *vnode, ns as *mount_ns).isNull() || Ptr.toBorrow(dirMount as *mount).root == dir) {
        mutex_unlock(lockOf(dir));
        mutex_unlock(table);
        kfree(r as *mut void);
        undoMount(mnt);
        vnode_put(dir);
        return -EBUSY;
    }
    {
        let x3 = Ptr.toBorrowMut(mnt);
        x3.mountpoint = dir; // keeps the lookup reference
    }
    {
        let x4 = Ptr.toBorrowMut(mnt);
        x4.parent = dirMount;
    }
    List.pushBack(borrow mut Ptr.toBorrowMut(dir).covers as *mut list_node, borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    // Visible in the namespace that made it, and in no other.
    {
        let x = Ptr.toBorrowMut(r);
        x.mnt = mnt;
        x.ns = ns;
    }
    List.pushBack(borrow mut Ptr.toBorrowMut(mnt).ns_refs as *mut list_node, borrow mut Ptr.toBorrowMut(r).mnt_link as *mut list_node);
    spin_lock(mountListLock());
    List.pushBack(borrow mut Ptr.toBorrowMut(ns).mounts as *mut list_node,
        borrow mut Ptr.toBorrowMut(r).ns_link as *mut list_node);
    spin_unlock(mountListLock());
    mutex_unlock(lockOf(dir));
    List.pushBack(mountsList(), borrow mut Ptr.toBorrowMut(mnt).link as *mut list_node);
    NR_MOUNTS += 1;
    mutex_unlock(table);
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("vfs: mounted ");
    cString(mut line, fsname);
    line.text(" on ");
    cString(mut line, path);
    line.text(" from ");
    deviceName(mut line, bdev);
    KernelLog.send(LogLevel.Info, line);
    return 0;
}

/// Take a mount off the directory it covers and out of the mount table. g_mounts_lock held; the count lives here, so
/// the removal does too -- a second place that unlinks a mount is a second place that can forget to say so.
/// Safety: g_mounts_lock held; `mnt` is attached.
@export("vfs_mount_detach")
unsafe fn detach(mnt: *mut mount) {
    let mp = Ptr.toBorrow(mnt as *mount).mountpoint;
    mutex_lock(lockOf(mp));
    List.remove(borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    mutex_unlock(lockOf(mp));
    List.remove(borrow mut Ptr.toBorrowMut(mnt).link as *mut list_node);
    NR_MOUNTS -= 1;
}

/// The filesystem gives the mount back, under sync_lock: a vfs_sync that took this mount either finishes its
/// fs->sync first or sees `unmounted`. Then the root, then the device. The filesystem's result.
/// Safety: `mnt` is off the table and its mountpoint.
unsafe fn teardown(mnt: *mut mount) -> i32 {
    let syncLock = borrow mut Ptr.toBorrowMut(mnt).sync_lock as *mut mutex;
    mutex_lock(syncLock);
    let urc = Ptr.toBorrow(Ptr.toBorrow(mnt as *mount).fs as *fs_type).unmount(mnt);
    {
        let x5 = Ptr.toBorrowMut(mnt);
        x5.unmounted = true;
    }
    mutex_unlock(syncLock);
    let rootVn = Ptr.toBorrow(mnt as *mount).root;
    {
        let x6 = Ptr.toBorrowMut(mnt);
        x6.root = 0 as *mut vnode;
    }
    vnode_put(rootVn);
    putDevice(mnt);
    return urc;
}

/// An orphan nothing uses any more, off the pending list: committed and torn down. There is nobody to hand a failure
/// back to -- which is the difference from vfs_umount2, where a failed commit leaves the mount in place for the caller
/// to retry. Here a failed commit is reported loudly and the transaction dropped: the alternative is a filesystem left
/// open that nothing will ever close again.
/// Safety: `mnt` is an orphan off the pending list with no vnode referenced beyond its own.
unsafe fn teardownOrphan(mnt: *mut mount) {
    let fs = Ptr.toBorrow(mnt as *mount).fs;
    let name = Ptr.toBorrow(fs as *fs_type).name;
    if (!Ptr.toBorrow(fs as *fs_type).sync.isNull()) {
        let rc = Ptr.toBorrow(fs as *fs_type).sync(mnt);
        if (rc != 0) {
            var buffer: [u8; 256] = [0; 256];
            var line = TextWriter.create(mut buffer[..]);
            line.text("vfs: ");
            cString(mut line, name);
            line.text(": commit failed (");
            line.signed(rc as i64);
            line.text(") as its last mount namespace went away; the transaction is dropped");
            KernelLog.send(LogLevel.Error, line);
        }
    }
    let urc = teardown(mnt);
    let mp = Ptr.toBorrow(mnt as *mount).mountpoint;
    if (!mp.isNull()) {
        vnode_put(mp);
    }
    if (urc != 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: ");
        cString(mut line, name);
        line.text(": the filesystem reported ");
        line.signed(urc as i64);
        line.text(" while its last mount namespace went away");
        KernelLog.send(LogLevel.Error, line);
    } else {
        sayPath(LogLevel.Info, "vfs: unmounted ", name, ": no mount namespace can see it");
    }
    kobject_put(objOf(mnt));
}

/// A mount the last namespace that could see it has let go. It is already off `g_mounts` and off its mountpoint, so
/// nothing can reach it by a path. What still uses it -- a file open on it, a process's directory in it, another
/// namespace's mount nested on one of its directories (whose mountpoint is a vnode of this mount) -- keeps it: the
/// mount waits on the orphans' list, whole, and is torn down when its last such reference goes, as Linux's lazy
/// unmount is. Before this the mount was torn down at once whatever used it, and the first of those to touch it again
/// used freed memory (found by tests/host/test_vfs.c, 2026-11-08). A namespace's last holder cannot be refused, which
/// is why waiting, not -EBUSY, is the answer.
/// Safety: `mnt` is detached and no namespace can see it; no lock held.
@export("vfs_mount_orphaned")
unsafe fn orphaned(mnt: *mut mount) {
    let table = mountsLock();
    mutex_lock(table);
    List.pushBack(orphans(), borrow mut Ptr.toBorrowMut(mnt).link as *mut list_node);
    let _ = ORPHANS.fetchAddWith(1, Ordering.SequentiallyConsistent);
    mutex_unlock(table);
    let _ = reapOrphans();

    // Still waiting: something uses it. Said once, and the reaper is there to finish it.
    mutex_lock(table);
    let head = orphans();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        if (mountOfLink(node) == mnt) {
            sayPath(LogLevel.Info, "vfs: ", Ptr.toBorrow(Ptr.toBorrow(mnt as *mount).fs as *fs_type).name,
                ": no mount namespace can see it; unmounted when nothing uses it");
            if (!REAPER) {
                let t = thread_create(reaper, 0 as *mut void, "vfs-orphans\0".ptr as *CChar, SCHED_PRIO_DEFAULT);
                REAPER = !t.isNull();
                if (t.isNull()) {
                    KernelLog.write(LogLevel.Warn,
                        "vfs: no orphan reaper thread; a waiting orphan is unmounted at the next one's turn");
                }
            }
            break;
        }
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(table);
}

/// Tear down every orphan nothing uses any more: the first one found idle, then look again, since tearing one down
/// puts its mountpoint, which can be what kept another (a mount nested in an orphan). How many.
/// Safety: no lock held.
@export("vfs_mount_reap_orphans")
unsafe fn reapOrphans() -> u32 {
    var reaped: u32 = 0;
    let table = mountsLock();
    loop {
        mutex_lock(table);
        var idle = 0 as *mut mount;
        let head = orphans();
        var node = List.first(head as *list_node);
        while (!node.isNull()) {
            let cand = mountOfLink(node);
            if (busyVnodes(cand, false, 0 as *mut u32) == 0) {
                idle = cand;
                break;
            }
            node = List.next(head as *list_node, node);
        }
        if (!idle.isNull()) {
            List.remove(borrow mut Ptr.toBorrowMut(idle).link as *mut list_node);
            List.init(borrow mut Ptr.toBorrowMut(idle).link as *mut list_node);
            let _ = ORPHANS.fetchSubWith(1, Ordering.SequentiallyConsistent); // its teardown's own puts nudge nobody
        }
        mutex_unlock(table);
        if (idle.isNull()) {
            break;
        }
        teardownOrphan(idle);
        reaped += 1;
    }
    return reaped;
}

/// vnode_put's nudge: while an orphan waits, every put may be its last user's.
/// Safety: none; it reads two counters and wakes a queue.
@export("vfs_mount_orphan_kick")
fn orphanKick() {
    if (ORPHANS.loadWith(LoadOrdering.SequentiallyConsistent) != 0) {
        let _ = KICKS.fetchAddWith(1, Ordering.SequentiallyConsistent);
        unsafe { let _ = waitqueue_wake_all(orphanWq()); }
    }
}

/// The reaper's sleep ends at a nudge it has not acted on.
/// Safety: `arg` is the address of the u32 nudge count the reaper last acted on.
@callback
unsafe fn kicked(arg: *mut void) -> bool => KICKS.loadWith(LoadOrdering.SequentiallyConsistent) != *Ptr.toBorrow(arg as *u32);

/// The orphan reaper: a kernel thread, at the first orphan that has to wait. A nudge is counted before the reap reads
/// the orphans, so one that lands during a reap wakes the next round at once.
/// Safety: started once, by vfs_mount_orphaned.
@callback
unsafe fn reaper(arg: *mut void) {
    loop {
        var seen = KICKS.loadWith(LoadOrdering.SequentiallyConsistent);
        let _ = reapOrphans();
        wait_floor_until(orphanWq(), kicked, borrow mut seen as *mut u32 as *mut void);
    }
}

/// Safety: `path` is NUL-terminated.
@export("vfs_umount2")
unsafe fn umount2(path: *CChar, flags: u32) -> i32 => umountAt(0 as *mut vnode, path, flags);

/// The namespace's refs to `mnt`: how many there are, and this namespace's own (null: none). Under the mountpoint's
/// lock.
/// Safety: `mnt` is live and its mountpoint's lock held.
unsafe fn countRefs(mnt: *mut mount, ns: *mut mount_ns, mine: *mut *mut mount_ns_ref) -> u32 {
    var seen: u32 = 0;
    {
        let slot3 = Ptr.toBorrowMut(mine);
        *slot3 = 0 as *mut mount_ns_ref;
    }
    let head = borrow mut Ptr.toBorrowMut(mnt).ns_refs as *mut list_node;
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let r = refOfMntLink(node);
        seen += 1;
        if (Ptr.toBorrow(r as *mount_ns_ref).ns == ns) {
            {
                let slot4 = Ptr.toBorrowMut(mine);
                *slot4 = r;
            }
        }
        node = List.next(head as *list_node, node);
    }
    return seen;
}

/// "vfs: <path>: dropped from this mount namespace; <n> still see it<why>".
/// Safety: `path` is NUL-terminated.
unsafe fn sayDropped(path: *CChar, others: u32, why: StringView) {
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("vfs: ");
    cString(mut line, path);
    line.text(": dropped from this mount namespace; ");
    line.decimal(others as u64);
    line.text(" still see it");
    line.text(why);
    KernelLog.send(LogLevel.Info, line);
}

/// Whether any vnode of `mnt` is referenced beyond what the filesystem itself holds: a pinned vnode's own pin, the
/// mount's reference on the root. How many (all of them, or only whether there is one), and with `files` not null how
/// many vnodes the mount has, under the same hold.
/// Safety: `mnt` is live; `files` null or writable.
unsafe fn busyVnodes(mnt: *mut mount, all: bool, files: *mut u32) -> u32 {
    let lock = borrow mut Ptr.toBorrowMut(mnt).lock as *mut spinlock_t;
    let hs = spin_lock_irqsave(lock);
    var busy: u32 = 0;
    var b: u32 = 0;
    while (b < VNODE_HASH && (all || busy == 0)) {
        let head = bucket(mnt, b);
        var node = List.first(head as *list_node);
        while (!node.isNull()) {
            let vn = vnodeOfHash(node);
            var mine: u32 = 0; // the filesystem's own: a pinned vnode's pin, the mount's reference on the root
            if ((Ptr.toBorrow(vn as *vnode).flags & VNODE_PINNED) != 0) {
                mine += 1;
            }
            if (vn == Ptr.toBorrow(mnt as *mount).root) {
                mine += 1;
            }
            if (kobject_refcount(borrow mut Ptr.toBorrowMut(vn).obj as *mut kobject as *kobject) > mine) {
                busy += 1;
                if (!all) {
                    break;
                }
            }
            node = List.next(head as *list_node, node);
        }
        b += 1;
    }
    if (!files.isNull()) {
        {
            let slot5 = Ptr.toBorrowMut(files);
            *slot5 = Ptr.toBorrow(mnt as *mount).nr_vnodes;
        }
    }
    spin_unlock_irqrestore(lock, hs);
    return busy;
}

/// The drain's condition: no pass is running.
/// Safety: `arg` is a live mount.
@callback
unsafe fn passesDone(arg: *mut void) -> bool => passes(arg as *mut mount).loadWith(LoadOrdering.Acquire) == 0;

/// As vfs_mount_at: a relative target from `start`. From inside a mount, "." reaches its root without crossing the
/// mountpoint -- the one way a second unmount can find a mount the first has set `unmounting` on, which is what the
/// guard below is for.
/// Safety: `start` is null or a directory the caller holds; `path` is NUL-terminated.
@export("vfs_umount_at")
unsafe fn umountAt(start: *mut vnode, path: *CChar, flags: u32) -> i32 {
    var rootVn = 0 as *mut vnode;
    var rc = vfs_lookup(start, path, borrow mut rootVn as *mut *mut vnode);
    if (rc != 0) {
        return rc;
    }
    let mnt = Ptr.toBorrow(rootVn as *vnode).mnt;
    if (Ptr.toBorrow(mnt as *mount).root != rootVn) {
        vnode_put(rootVn);
        return -EINVAL; // not a mount root
    }
    if (mnt == *Ptr.toBorrow(rootSlot())) {
        vnode_put(rootVn);
        return -EBUSY; // the root filesystem stays
    }
    if (Ptr.toBorrow(mnt as *mount).mountpoint.isNull()) {
        // The old root after vfs_switch_root, reached from a directory still inside it: on no directory and in no
        // namespace, so not a namespace's to unmount (vfs_release_old_root releases it). The checks below lock the
        // mountpoint first, which this mount does not have: that was a NULL dereference (found by
        // tests/host/test_vfs.c, 2026-11-08).
        vnode_put(rootVn);
        return -EINVAL;
    }
    vnode_put(rootVn); // the lookup reference; the mount still holds one

    let table = mountsLock();
    mutex_lock(table);
    // If another namespace can still see this mount, unmounting is only this namespace forgetting it: the filesystem
    // stays, so there is nothing to commit, nothing to tear down, and no reason to care whether anyone else has a
    // file open on it. The last namespace out does the unmount below.
    let ns = mountns_current();
    var mine = 0 as *mut mount_ns_ref;
    let mp = Ptr.toBorrow(mnt as *mount).mountpoint;
    mutex_lock(lockOf(mp));
    var seen = countRefs(mnt, ns, borrow mut mine as *mut *mut mount_ns_ref);
    if (mine.isNull()) {
        mutex_unlock(lockOf(mp));
        mutex_unlock(table);
        return -EINVAL; // not this namespace's mount to unmount
    }
    // One unmount at a time. This used to be free: g_mounts_lock was held unbroken from here to the teardown, so two
    // unmounts of one mount serialised on it and nobody had to ask. The drain below drops that lock, so a second
    // caller could enter the gap, find the mount still listed, and remove the namespace links the first is removing.
    // `restore` clears the flag when an unmount is refused, so a mount that survives one is claimable again.
    if (Ptr.toBorrow(mnt as *mount).unmounting) {
        mutex_unlock(lockOf(mp));
        mutex_unlock(table);
        return -EBUSY;
    }
    if (seen > 1) {
        List.remove(borrow mut Ptr.toBorrowMut(mine).mnt_link as *mut list_node);
        mutex_unlock(lockOf(mp));
        spin_lock(mountListLock());
        List.remove(borrow mut Ptr.toBorrowMut(mine).ns_link as *mut list_node);
        spin_unlock(mountListLock());
        mutex_unlock(table);
        kfree(mine as *mut void);
        sayDropped(path, seen - 1, "");
        return 0;
    }
    mutex_unlock(lockOf(mp));

    // Turn new walkers away first: follow_mount refuses (-EBUSY) while `unmounting` is set and takes the root
    // reference under the same lock, so the reference scan below is final and nothing falls through to the covered
    // directory while the decision is pending.
    mutex_lock(lockOf(mp));
    {
        let x7 = Ptr.toBorrowMut(mnt);
        x7.unmounting = true;
    }
    mutex_unlock(lockOf(mp));

    // Wait for the maintenance passes to finish. `unmounting` is set, so vfs_mount_acquire refuses from here on and
    // the count can only fall; that is what makes this terminate. g_mounts_lock is dropped across the wait because
    // vfs_mount_release needs it to decrement -- waiting with it held would be waiting for a thread that cannot run.
    // No wakeup is lost: the wait queues the waiter and marks it BLOCKED before it evaluates the condition, so a
    // release landing in the gap wakes a waiter that is already there.
    while (passes(mnt).loadWith(LoadOrdering.Acquire) != 0) {
        mutex_unlock(table);
        passesWait(mnt);
        mutex_lock(table);
    }

    // The drain dropped g_mounts_lock, so every decision taken before it is a decision about a filesystem that may
    // have changed. This one matters: `seen == 1` said this was the last namespace out, and a namespace created
    // during the window copies its parent's view and takes a reference to this mount. Tearing it down now would leave
    // that namespace holding freed memory.
    //
    // So count again. If somebody else can see the mount, this unmount is only this namespace forgetting it, which is
    // the `seen > 1` path above -- taken here rather than there because only now is the count final.
    mutex_lock(lockOf(mp));
    seen = countRefs(mnt, ns, borrow mut mine as *mut *mut mount_ns_ref);
    if (mine.isNull() || seen > 1) {
        {
            let x8 = Ptr.toBorrowMut(mnt);
            x8.unmounting = false;
        }
        if (!mine.isNull()) {
            List.remove(borrow mut Ptr.toBorrowMut(mine).mnt_link as *mut list_node);
        }
        mutex_unlock(lockOf(mp));
        if (mine.isNull()) {
            mutex_unlock(table);
            return -EINVAL; // someone else dropped this namespace's view
        }
        spin_lock(mountListLock());
        List.remove(borrow mut Ptr.toBorrowMut(mine).ns_link as *mut list_node);
        spin_unlock(mountListLock());
        mutex_unlock(table);
        kfree(mine as *mut void);
        sayDropped(path, seen - 1, " (gained during the drain)");
        return 0;
    }
    mutex_unlock(lockOf(mp));

    // Busy if any vnode is referenced beyond what the filesystem itself holds.
    let fs = Ptr.toBorrow(mnt as *mount).fs;
    if (busyVnodes(mnt, false, 0 as *mut u32) != 0) {
        rc = -EBUSY;
    } else if (!Ptr.toBorrow(fs as *fs_type).sync.isNull() && (flags & VFS_UMOUNT_FORCE) == 0) {
        // Commit while the mount is still whole: if that fails the mount stays and the caller can retry (or fix the
        // device); nothing is lost.
        rc = Ptr.toBorrow(fs as *fs_type).sync(mnt);
        if (rc != 0) {
            var buffer: [u8; 256] = [0; 256];
            var line = TextWriter.create(mut buffer[..]);
            line.text("vfs: ");
            cString(mut line, path);
            line.text(": commit failed (");
            line.signed(rc as i64);
            line.text("); mount kept (VFS_UMOUNT_FORCE drops the transaction)");
            KernelLog.send(LogLevel.Error, line);
        }
    }
    if (rc != 0) {
        // Refused or failed: the mount is whole again and reachable.
        mutex_lock(lockOf(mp));
        {
            let x9 = Ptr.toBorrowMut(mnt);
            x9.unmounting = false;
        }
        mutex_unlock(lockOf(mp));
        mutex_unlock(table);
        return rc;
    }
    if ((flags & VFS_UMOUNT_FORCE) != 0) {
        sayPath(LogLevel.Warn, "vfs: ", path, ": forced unmount, open transaction dropped");
    }
    mutex_lock(lockOf(mp));
    List.remove(borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(mnt).cover_link as *mut list_node);
    List.remove(borrow mut Ptr.toBorrowMut(mine).mnt_link as *mut list_node);
    mutex_unlock(lockOf(mp));
    spin_lock(mountListLock());
    List.remove(borrow mut Ptr.toBorrowMut(mine).ns_link as *mut list_node);
    spin_unlock(mountListLock());
    kfree(mine as *mut void);
    List.remove(borrow mut Ptr.toBorrowMut(mnt).link as *mut list_node);
    NR_MOUNTS -= 1;
    mutex_unlock(table);

    // The filesystem releases its pins and private state while the root is still alive; the root's eviction follows
    // and must tolerate mnt->fs_priv being gone.
    let urc = teardown(mnt);
    vnode_put(mp);
    if (urc != 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: ");
        cString(mut line, path);
        line.text(": the filesystem reported ");
        line.signed(urc as i64);
        line.text(" while unmounting; uncommitted changes may be lost");
        KernelLog.send(LogLevel.Error, line);
    } else {
        sayPath(LogLevel.Info, "vfs: unmounted ", path, "");
    }
    kobject_put(objOf(mnt));
    return urc;
}

// --- switching the root (roadmap M2) --------------------------------------------------------------------------------

/// A mount attached at the top level of `root`'s filesystem: its one namespace reference names it "/<name>" in the
/// initial namespace. The name, or NULL.
/// Safety: `n` is live and its mountpoint's lock held.
unsafe fn topLevelName(n: *mut mount) -> *u8 {
    var name = 0 as *u8;
    var refs: u32 = 0;
    let head = borrow mut Ptr.toBorrowMut(n).ns_refs as *mut list_node;
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let r = refOfMntLink(node);
        refs += 1;
        let p = pathOf(r) as *u8;
        if (Ptr.toBorrow(r as *mount_ns_ref).ns == mountns_initial() && *Ptr.toBorrow(p) == 0x2F &&
            *Ptr.toBorrow(p.add(1)) != 0 && strchr(p.add(1) as *CChar, 0x2F).isNull()) {
            name = p.add(1);
        }
        node = List.next(head as *list_node, node);
    }
    return if (refs == 1) name else 0 as *u8;
}

/// Safety: the chain of parents from `n` is live.
unsafe fn underMount(n: *mut mount, top: *mut mount) -> bool {
    var x = n;
    while (!x.isNull()) {
        if (x == top) {
            return true;
        }
        x = Ptr.toBorrow(x as *mount).parent;
    }
    return false;
}

/// The mount at the top level of `r` that `n` is under, or NULL.
/// Safety: the chain of parents from `n` is live.
unsafe fn topLevelAncestor(n: *mut mount, r: *mut mount) -> *mut mount {
    var a = n;
    while (!a.isNull()) {
        if (Ptr.toBorrow(a as *mount).parent == r) {
            return a;
        }
        a = Ptr.toBorrow(a as *mount).parent;
    }
    return 0 as *mut mount;
}

const SWITCH_MAX_MOVES: u32 = 16;

/// A top-level mount moving onto the new root: by the name its namespace reference gives it.
struct Move {
    mnt: *mut mount;
    dir: *mut vnode;
    oldMp: *mut vnode;
    name: [u8; 256];
}

/// Safety: `start` is null or a directory the caller holds; `path` is NUL-terminated; `oldOut` is writable.
@export("vfs_switch_root")
unsafe fn switchRoot(start: *mut vnode, path: *CChar, oldOut: *mut *mut mount) -> i32 {
    var v = 0 as *mut vnode;
    var rc = vfs_lookup(start, path, borrow mut v as *mut *mut vnode);
    if (rc != 0) {
        return rc;
    }
    let target = Ptr.toBorrow(v as *vnode).mnt;
    let moves = kmalloc(SWITCH_MAX_MOVES as usize * layoutOf<Move>().size, KMEM_ZERO) as *mut Move;
    if (moves.isNull()) {
        vnode_put(v);
        return -ENOMEM;
    }
    var nmoves: u32 = 0;
    var nrMounts: u32 = 0;

    // Pass 1, under the table lock: what moves where, by name. Every other mount is under the new root (it comes
    // along), at the top level of the old root (it moves to the same name in the new one), or under such a mount --
    // /dev/pts under /dev (roadmap M4) -- whose mountpoint is a directory of that mount, so it comes along with it.
    // Anything else would be left hanging off a filesystem that is about to be released.
    let table = mountsLock();
    mutex_lock(table);
    let r = *Ptr.toBorrow(rootSlot());
    let t = Ptr.toBorrow(target as *mount);
    if (r.isNull() || t.root != v || target == r || t.parent != r || t.mountpoint.isNull() || t.unmounting) {
        rc = -EINVAL; // not a mount root, the root already, or not on a directory of the root
    }
    let head = mountsList();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let n = mountOfLink(node);
        nrMounts += 1;
        let parent = Ptr.toBorrow(n as *mount).parent;
        if (rc == 0 && n != r && n != target && !underMount(n, target)) {
            let top = if (parent != r) topLevelAncestor(n, r) else 0 as *mut mount;
            // Nested in a top-level mount: moves with it, which its own turn checks.
            if (top.isNull() || top == target || Ptr.toBorrow(top as *mount).unmounting) {
                var name = 0 as *u8;
                if (parent == r && !Ptr.toBorrow(n as *mount).unmounting) {
                    let nmp = Ptr.toBorrow(n as *mount).mountpoint;
                    mutex_lock(lockOf(nmp));
                    name = topLevelName(n);
                    if (!name.isNull() && nmoves < SWITCH_MAX_MOVES && strlen(name as *CChar) <= VFS_NAME_MAX) {
                        let mv = Ptr.toBorrowMut(moves.add(nmoves as usize));
                        let _ = strlcpy(borrow mut mv.name as *mut [u8; 256] as *mut CChar, name as *CChar, 256);
                        mv.dir = 0 as *mut vnode; // looked up in pass 2
                        mv.mnt = n;
                        mv.oldMp = nmp;
                        nmoves += 1;
                    } else {
                        name = 0 as *u8;
                    }
                    mutex_unlock(lockOf(nmp));
                }
                if (name.isNull()) {
                    KernelLog.write(LogLevel.Warn,
                        "vfs: switch root: a mount on the old root is not at its top level; unmount it first");
                    rc = -EBUSY;
                }
            }
        }
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(table);

    // Pass 2, without it: the directories in the new root. A lookup is filesystem I/O, and the table lock is not held
    // across that.
    var i: u32 = 0;
    while (rc == 0 && i < nmoves) {
        var d = 0 as *mut vnode;
        let mv = Ptr.toBorrowMut(moves.add(i as usize));
        rc = vfs_lookup(v, borrow mv.name as *[u8; 256] as *CChar, borrow mut d as *mut *mut vnode);
        if (rc == 0 && (Ptr.toBorrow(d as *vnode).kind != VNODE_DIR || Ptr.toBorrow(d as *vnode).mnt != target)) {
            rc = -ENOTDIR; // not a directory, or covered already: the lookup crossed into another mount
        }
        if (rc != 0) {
            var buffer: [u8; 256] = [0; 256];
            var line = TextWriter.create(mut buffer[..]);
            line.text("vfs: switch root: the new root has no free directory /");
            cString(mut line, borrow Ptr.toBorrowMut(moves.add(i as usize)).name as *[u8; 256] as *CChar);
            line.text(" for the mount there (");
            line.signed(rc as i64);
            line.text(")");
            KernelLog.send(LogLevel.Warn, line);
            if (!d.isNull()) {
                vnode_put(d);
            }
        } else {
            {
                let mvx = Ptr.toBorrowMut(moves.add(i as usize));
                mvx.dir = d;
            }
        }
        i += 1;
    }

    // Pass 3: nothing may have changed in between. The caller is the only process; this is the check that it really
    // was.
    mutex_lock(table);
    if (rc == 0) {
        var now: u32 = 0;
        node = List.first(head as *list_node);
        while (!node.isNull()) {
            now += 1;
            node = List.next(head as *list_node, node);
        }
        let t2 = Ptr.toBorrow(target as *mount);
        if (now != nrMounts || *Ptr.toBorrow(rootSlot()) != r || t2.parent != r || t2.mountpoint.isNull()) {
            rc = -EBUSY;
        }
        i = 0;
        while (rc == 0 && i < nmoves) {
            let mv = Ptr.toBorrowMut(moves.add(i as usize));
            if (Ptr.toBorrow(mv.mnt as *mount).mountpoint != mv.oldMp || Ptr.toBorrow(mv.mnt as *mount).unmounting) {
                rc = -EBUSY;
            }
            i += 1;
        }
    }
    if (rc != 0) {
        mutex_unlock(table);
        i = 0;
        while (i < nmoves) {
            let d = Ptr.toBorrowMut(moves.add(i as usize)).dir;
            if (!d.isNull()) {
                vnode_put(d);
            }
            i += 1;
        }
        kfree(moves as *mut void);
        vnode_put(v);
        return rc;
    }

    // Commit: nothing below can fail.
    i = 0;
    while (i < nmoves) {
        let mv = Ptr.toBorrowMut(moves.add(i as usize));
        let x = mv.mnt;
        let xmp = Ptr.toBorrow(x as *mount).mountpoint;
        mutex_lock(lockOf(xmp));
        List.remove(borrow mut Ptr.toBorrowMut(x).cover_link as *mut list_node);
        List.init(borrow mut Ptr.toBorrowMut(x).cover_link as *mut list_node);
        mutex_unlock(lockOf(xmp));
        let d = mv.dir;
        mutex_lock(lockOf(d));
        List.pushBack(borrow mut Ptr.toBorrowMut(d).covers as *mut list_node, borrow mut Ptr.toBorrowMut(x).cover_link as *mut list_node);
        {
            let x10 = Ptr.toBorrowMut(x);
            x10.mountpoint = d; // keeps the lookup's reference
        }
        {
            let x11 = Ptr.toBorrowMut(x);
            x11.parent = target;
        }
        mutex_unlock(lockOf(d));
        i += 1;
    }
    // The new root: off its mountpoint, and out of the namespaces' lists, because the root mount is visible in every
    // namespace without one.
    let oldMp = Ptr.toBorrow(target as *mount).mountpoint;
    mutex_lock(lockOf(oldMp));
    List.remove(borrow mut Ptr.toBorrowMut(target).cover_link as *mut list_node);
    List.init(borrow mut Ptr.toBorrowMut(target).cover_link as *mut list_node);
    var dead: [u64; 2] = [0; 2]; // a struct list_node: next, prev
    let deadHead = borrow mut dead as *mut [u64; 2] as *mut list_node;
    List.init(deadHead);
    spin_lock(mountListLock());
    let refs = borrow mut Ptr.toBorrowMut(target).ns_refs as *mut list_node;
    node = List.first(refs as *list_node);
    while (!node.isNull()) {
        let nextNode = List.next(refs as *list_node, node);
        let ref = refOfMntLink(node);
        let nsLink = borrow mut Ptr.toBorrowMut(ref).ns_link as *mut list_node;
        List.remove(nsLink);
        List.pushBack(deadHead, nsLink); // freed below, outside the leaf lock
        node = nextNode;
    }
    {
        let slot6 = Ptr.toBorrowMut(rootSlot());
        *slot6 = target;
    }
    spin_unlock(mountListLock());
    node = List.first(deadHead as *list_node);
    while (!node.isNull()) {
        let nextNode = List.next(deadHead as *list_node, node);
        let ref = refOfNsLink(node);
        List.remove(borrow mut Ptr.toBorrowMut(ref).mnt_link as *mut list_node);
        kfree(ref as *mut void);
        node = nextNode;
    }
    mutex_unlock(lockOf(oldMp));
    {
        let x12 = Ptr.toBorrowMut(target);
        x12.mountpoint = 0 as *mut vnode;
    }
    {
        let x13 = Ptr.toBorrowMut(target);
        x13.parent = 0 as *mut mount;
    }
    // The old root is reachable from nowhere now: no mountpoint, no namespace. It stays on g_mounts until
    // vfs_release_old_root.
    {
        let x14 = Ptr.toBorrowMut(r);
        x14.unmounting = true;
    }
    mutex_unlock(table);

    i = 0;
    while (i < nmoves) {
        vnode_put(Ptr.toBorrowMut(moves.add(i as usize)).oldMp);
        i += 1;
    }
    kfree(moves as *mut void);
    vnode_put(oldMp);
    vnode_put(v);
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("vfs: root switched to ");
    cString(mut line, Ptr.toBorrow(Ptr.toBorrow(target as *mount).fs as *fs_type).name);
    line.text(" on ");
    deviceName(mut line, Ptr.toBorrow(target as *mount).bdev);
    line.text("; ");
    line.decimal(nmoves as u64);
    line.text(" mount(s) moved onto it");
    KernelLog.send(LogLevel.Info, line);
    {
        let slot7 = Ptr.toBorrowMut(oldOut);
        *slot7 = r;
    }
    return 0;
}

/// Busy if any vnode is referenced beyond what the filesystem itself holds, as in vfs_umount_at. A process still in
/// the old tree keeps it, which is not an error: the memory stays until it leaves.
/// Safety: `r` is the old root vfs_switch_root returned.
@export("vfs_release_old_root")
unsafe fn releaseOldRoot(r: *mut mount) -> i32 {
    var files: u32 = 0;
    let busy = busyVnodes(r, true, borrow mut files as *mut u32);
    if (busy != 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: the old root is kept: ");
        line.decimal(busy as u64);
        line.text(" of its vnodes are still referenced");
        KernelLog.send(LogLevel.Warn, line);
        return -EBUSY;
    }
    let table = mountsLock();
    mutex_lock(table);
    List.remove(borrow mut Ptr.toBorrowMut(r).link as *mut list_node);
    NR_MOUNTS -= 1;
    mutex_unlock(table);
    let urc = teardown(r);
    var buffer: [u8; 256] = [0; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("vfs: the old root (");
    cString(mut line, Ptr.toBorrow(Ptr.toBorrow(r as *mount).fs as *fs_type).name);
    line.text(") is released: ");
    line.decimal(files as u64);
    line.text(" vnodes");
    KernelLog.send(LogLevel.Info, line);
    kobject_put(objOf(r));
    return urc;
}

/// Sync every mount without holding the mount list across a commit (a cosmofs commit is block I/O; mount and unmount
/// must not wait behind it). The k-th mount is taken by position under the list lock with a reference, synced under
/// its own sync_lock (which unmount also takes around fs->unmount, so a mount that went away is seen as `unmounted`
/// and skipped), and put. A mount unmounted meanwhile shifts the positions: the one that moved into its place is
/// synced again, which is harmless, and the unmounted one was committed by vfs_umount itself.
/// Safety: called from a thread, no lock held.
@export("vfs_sync")
unsafe fn sync() -> i32 {
    var rc: i32 = 0;
    let table = mountsLock();
    let head = mountsList();
    var k: u32 = 0;
    loop {
        mutex_lock(table);
        var mnt = 0 as *mut mount;
        var i: u32 = 0;
        var node = List.first(head as *list_node);
        while (!node.isNull()) {
            if (i == k) {
                mnt = mountOfLink(node);
                kobject_get(objOf(mnt));
                break;
            }
            i += 1;
            node = List.next(head as *list_node, node);
        }
        mutex_unlock(table);
        if (mnt.isNull()) {
            break;
        }
        let syncLock = borrow mut Ptr.toBorrowMut(mnt).sync_lock as *mut mutex;
        mutex_lock(syncLock);
        let fs = Ptr.toBorrow(mnt as *mount).fs;
        if (!Ptr.toBorrow(fs as *fs_type).sync.isNull() && !Ptr.toBorrow(mnt as *mount).unmounted) {
            let r = Ptr.toBorrow(fs as *fs_type).sync(mnt);
            if (r != 0 && rc == 0) {
                rc = r;
            }
        }
        mutex_unlock(syncLock);
        kobject_put(objOf(mnt));
        k += 1;
    }
    return rc;
}

// --- init, the root, the internal and detached mounts ---------------------------------------------------------------

/// The VFS itself and nothing else: which filesystems exist and which one is the root are boot composition's choice
/// (kernel/core/bootfs.c), so this file names none of them (roadmap M2).
/// Safety: called once, at boot.
@export("vfs_init")
unsafe fn init() {
    check(!INITIALIZED, "!g_initialized");
    mutex_init(mountsLock(), "mounts\0".ptr as *CChar);
    mutex_init(claimLock(), "mount-claims\0".ptr as *CChar);
    waitqueue_init(orphanWq(), "vfs-orphans\0".ptr as *CChar);
    INITIALIZED = true;
    // The page cache may hold a quarter of RAM before clean pages are reclaimed (docs/kernel/security/design.md §3).
    pagecache_set_limit(totalPages() / 4);
    pagecache_dirty_init();
}

/// Safety: `fsname` is NUL-terminated; `out` is writable.
@export("vfs_mount_internal")
unsafe fn mountInternal(fsname: *CChar, out: *mut *mut mount) -> i32 {
    check(INITIALIZED, "g_initialized");
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }
    return doMount(fs, 0 as *mut blkdev, 0, out);
}

/// Safety: `fs` null or registered; `bdev` null or a device the caller holds; `out` is writable.
@export("vfs_mount_detached")
unsafe fn mountDetached(fs: *mut fs_type, bdev: *mut blkdev, flags: u32, out: *mut *mut mount) -> i32 {
    check(INITIALIZED, "g_initialized");
    if (fs.isNull() || bdev.isNull()) {
        return -EINVAL;
    }
    // The filesystem commits only when the release says so: no committer of its own may run first (Codex on #434).
    return doMount(fs, bdev, flags | MOUNT_DETACHED, out);
}

/// Safety: `mnt` is a mount vfs_mount_detached or vfs_mount_internal returned.
@export("vfs_mount_detached_release")
unsafe fn mountDetachedRelease(mnt: *mut mount, commit: bool) -> i32 {
    var rc: i32 = 0;
    let fs = Ptr.toBorrow(mnt as *mount).fs;
    if (commit && (Ptr.toBorrow(mnt as *mount).flags & MOUNT_RDONLY) == 0 && !Ptr.toBorrow(fs as *fs_type).sync.isNull()) {
        rc = Ptr.toBorrow(fs as *fs_type).sync(mnt);
    }
    undoMount(mnt); // the filesystem's unmount stops its own committer first
    return rc;
}

/// Safety: `fsname` is NUL-terminated; `bdev` null or a device the caller holds.
@export("vfs_mount_root")
unsafe fn mountRoot(fsname: *CChar, bdev: *mut blkdev, flags: u32) -> i32 {
    check(INITIALIZED, "g_initialized");
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }
    let table = mountsLock();
    mutex_lock(table);
    let have = !(*Ptr.toBorrow(rootSlot())).isNull();
    mutex_unlock(table);
    if (have) {
        return -EBUSY; // once; switching it later is another operation
    }
    var r = 0 as *mut mount;
    let rc = doMount(fs, bdev, flags, borrow mut r as *mut *mut mount);
    if (rc != 0) {
        return rc;
    }
    mutex_lock(table);
    spin_lock(mountListLock());
    {
        let slot8 = Ptr.toBorrowMut(rootSlot());
        *slot8 = r;
    }
    spin_unlock(mountListLock());
    List.pushBack(mountsList(), borrow mut Ptr.toBorrowMut(r).link as *mut list_node);
    NR_MOUNTS = 1;
    mutex_unlock(table);
    sayPath(LogLevel.Info, "vfs: root mounted (", fsname, ")");
    return 0;
}

// --- formats --------------------------------------------------------------------------------------------------------

/// Safety: `fsname` is NUL-terminated; `bd` is a device the caller holds; `label` null or NUL-terminated.
@export("vfs_format")
unsafe fn format(fsname: *CChar, bd: *mut blkdev, label: *CChar) -> i32 {
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }
    if (Ptr.toBorrow(fs as *fs_type).format.isNull()) {
        return -EOPNOTSUPP;
    }
    if (deviceMounted(bd as *blkdev)) {
        return -EBUSY;
    }
    let rc = Ptr.toBorrow(fs as *fs_type).format(bd, label);
    if (rc == 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: made an empty ");
        cString(mut line, fsname);
        line.text(" on ");
        deviceName(mut line, bd);
        if (!label.isNull() && *Ptr.toBorrow(label as *u8) != 0) {
            line.text(", named ");
            cString(mut line, label);
        }
        KernelLog.send(LogLevel.Info, line);
    }
    return rc;
}

/// Safety: `fsname` is NUL-terminated; `bd` holds `n` devices the caller holds; `label` null or NUL-terminated.
@export("vfs_format_mirror")
unsafe fn formatMirror(fsname: *CChar, bd: *mut *mut blkdev, n: u32, label: *CChar) -> i32 {
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }
    if (Ptr.toBorrow(fs as *fs_type).format_mirror.isNull()) {
        return -EOPNOTSUPP;
    }
    var i: u32 = 0;
    while (i < n) {
        var j: u32 = 0;
        while (j < i) {
            if (*Ptr.toBorrow(bd.add(i as usize)) == *Ptr.toBorrow(bd.add(j as usize))) {
                return -EINVAL; // a mirror of a device with itself is one copy
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < n) {
        if (deviceMounted(*Ptr.toBorrow(bd.add(i as usize)) as *blkdev)) {
            return -EBUSY;
        }
        i += 1;
    }
    let rc = Ptr.toBorrow(fs as *fs_type).format_mirror(bd, n, label);
    if (rc == 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: made an empty ");
        cString(mut line, fsname);
        line.text(" mirrored over ");
        line.decimal(n as u64);
        line.text(" devices, ");
        deviceName(mut line, *Ptr.toBorrow(bd));
        line.text(" first");
        KernelLog.send(LogLevel.Info, line);
    }
    return rc;
}

/// An encrypted pool on `n` devices (roadmap 1.2 B5): as vfs_format_mirror, with the master key and the slots it is
/// sealed in.
/// Safety: as vfs_format_mirror; `uuid` 16 bytes, `master` 32, `slots` the filesystem's.
@export("vfs_format_keyed")
unsafe fn formatKeyed(fsname: *CChar, bd: *mut *mut blkdev, n: u32, label: *CChar, uuid: *u8, master: *u8,
    slots: *cosmo_keyslot) -> i32 {
    let fs = findFs(fsname);
    if (fs.isNull()) {
        return -ENODEV;
    }
    if (Ptr.toBorrow(fs as *fs_type).format_keyed.isNull()) {
        return -EOPNOTSUPP;
    }
    if (n == 2 && *Ptr.toBorrow(bd) == *Ptr.toBorrow(bd.add(1))) {
        return -EINVAL;
    }
    var i: u32 = 0;
    while (i < n) {
        if (deviceMounted(*Ptr.toBorrow(bd.add(i as usize)) as *blkdev)) {
            return -EBUSY;
        }
        i += 1;
    }
    let rc = Ptr.toBorrow(fs as *fs_type).format_keyed(bd, n, label, uuid, master, slots);
    if (rc == 0) {
        var buffer: [u8; 256] = [0; 256];
        var line = TextWriter.create(mut buffer[..]);
        line.text("vfs: made an empty encrypted ");
        cString(mut line, fsname);
        line.text(" on ");
        deviceName(mut line, *Ptr.toBorrow(bd));
        if (n > 1) {
            line.text(" and its mirror");
        }
        KernelLog.send(LogLevel.Info, line);
    }
    return rc;
}

// --- passes, counts -------------------------------------------------------------------------------------------------

/// Name a mount for an operation on one filesystem. The id is looked up in the caller's own mount namespace: an id
/// another namespace holds is -ENOENT here, because a mount that is not this caller's is not hidden from it for
/// safety -- it is not theirs.
///
/// The root mount is visible in every namespace and holds no ns_ref (mountns.cee, "the root mount carries none"), so
/// it is matched first rather than searched for in a list it is deliberately absent from.
/// Safety: `out` is null or writable.
@export("vfs_mount_acquire")
unsafe fn acquire(id: u64, out: *mut *mut mount) -> i32 {
    if (id == 0 || out.isNull()) {
        return -EINVAL;
    }
    let table = mountsLock();
    mutex_lock(table);
    var found = 0 as *mut mount;
    let r = *Ptr.toBorrow(rootSlot());
    if (!r.isNull() && Ptr.toBorrow(r as *mount).id == id) {
        found = r;
    } else {
        let ns = mountns_current();
        let head = borrow mut Ptr.toBorrowMut(ns).mounts as *mut list_node;
        var node = List.first(head as *list_node);
        while (!node.isNull()) {
            let mnt = Ptr.toBorrow(refOfNsLink(node) as *mount_ns_ref).mnt;
            if (Ptr.toBorrow(mnt as *mount).id == id) {
                found = mnt;
                break;
            }
            node = List.next(head as *list_node, node);
        }
    }
    if (found.isNull()) {
        mutex_unlock(table);
        return -ENOENT;
    }
    if (Ptr.toBorrow(found as *mount).unmounting) {
        mutex_unlock(table);
        return -EBUSY;
    }
    kobject_get(objOf(found));
    let p = passes(found);
    p.storeWith(p.loadWith(LoadOrdering.Relaxed) + 1, StoreOrdering.Release);
    mutex_unlock(table);
    {
        let slot9 = Ptr.toBorrowMut(out);
        *slot9 = found;
    }
    return 0;
}

/// Safety: `mnt` is null or a mount vfs_mount_acquire returned.
@export("vfs_mount_release")
unsafe fn releasePass(mnt: *mut mount) {
    if (mnt.isNull()) {
        return;
    }
    let table = mountsLock();
    mutex_lock(table);
    let p = passes(mnt);
    let running = p.loadWith(LoadOrdering.Relaxed);
    check(running > 0, "mnt->passes_running > 0");
    let left = running - 1;
    p.storeWith(left, StoreOrdering.Release);
    mutex_unlock(table);
    // The falling edge is the only one a drain is waiting for.
    if (left == 0) {
        passesWake(mnt);
    }
    kobject_put(objOf(mnt));
}

/// Safety: the VFS is initialised.
@export("vfs_mount_count")
unsafe fn mountCount() -> u32 {
    let table = mountsLock();
    mutex_lock(table);
    let n = NR_MOUNTS;
    mutex_unlock(table);
    return n;
}

/// Safety: the VFS is initialised.
@export("vfs_vnode_count")
unsafe fn vnodeCount() -> u32 {
    var n: u32 = 0;
    let table = mountsLock();
    mutex_lock(table);
    let head = mountsList();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        n += Ptr.toBorrow(mountOfLink(node) as *mount).nr_vnodes;
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(table);
    return n;
}

/// Safety: the VFS is initialised.
@export("vfs_dump")
unsafe fn dump() {
    let table = mountsLock();
    mutex_lock(table);
    kprintf("mounts (%u):\n\0".ptr as *CChar, NR_MOUNTS);
    let head = mountsList();
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let mnt = Ptr.toBorrow(mountOfLink(node) as *mount);
        let device = if (mnt.bdev.isNull()) "no device\0".ptr as *CChar
            else borrow Ptr.toBorrow(mnt.bdev as *blkdev).name as *[u8; 16] as *CChar;
        let ro = if ((mnt.flags & MOUNT_RDONLY) != 0) ", ro\0".ptr as *CChar else "\0".ptr as *CChar;
        kprintf("  %-8s root ino %llu, %u vnodes, %s%s\n\0".ptr as *CChar, Ptr.toBorrow(mnt.fs as *fs_type).name,
            Ptr.toBorrow(mnt.root as *vnode).ino, mnt.nr_vnodes, device, ro);
        node = List.next(head as *list_node, node);
    }
    mutex_unlock(table);
}
