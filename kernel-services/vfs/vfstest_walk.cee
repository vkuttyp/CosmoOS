// vfstest_walk.cee - The VFS's self-tests of walks from a start, in CeeSafe: roadmap 2.0 SA7. vfs-rename2,
// vfs-lookup-named and vfs-umount-once. Each is an exported function the selftest table names, failing with the
// condition that did not hold and its line here. The C compiler checks the values this file shares with the C
// headers (ADR 0080 §3.1).

@header(
    "kernel/kmalloc.h", "kernel/log.h", "kernel/mutex.h", "kernel/string.h", "kernel/thread.h", "kernel/timer.h",
    "kernel/vfs.h", "kernel/wait.h", "kernel/completion.h", "kernel/errno.h", "kernel/faultinject.h", "kernel/handle.h",
    "kernel/pagecache.h", "kernel/syscall.h", "kernel/types.h", "kernel/utsns.h", "kernel/page.h", "uapi/cosmo/fsctl.h",
)
extern "C" {
    struct vnode {
        obj: kobject;
        mnt: *mut mount;
        lock: mutex;
    }
    struct mount {
        id: u64;
        root: *mut vnode;
        mountpoint: *mut vnode;
        unmounting: bool;
    }
    struct file;
    struct thread;
    struct blkdev;
    struct cosmo_stat {
        ino: u64;
    }

    fn strcmp(a: *CChar, b: *CChar) -> i32;
    fn vfs_open(start: *mut vnode, path: *CChar, flags: u32, mode: u32, out: *mut *mut file) -> i32;
    fn vfs_lookup(start: *mut vnode, path: *CChar, out: *mut *mut vnode) -> i32;
    fn vfs_lookup_named(
        start: *mut vnode, startname: *CChar, path: *CChar, out: *mut *mut vnode, name: *mut CChar,
        n: usize,
    ) -> i32;
    fn vfs_mkdir(start: *mut vnode, path: *CChar, mode: u32) -> i32;
    fn vfs_symlink(start: *mut vnode, path: *CChar, target: *CChar) -> i32;
    fn vfs_unlink(start: *mut vnode, path: *CChar) -> i32;
    fn vfs_rmdir(start: *mut vnode, path: *CChar) -> i32;
    fn vfs_rename2(ostart: *mut vnode, oldpath: *CChar, nstart: *mut vnode, newpath: *CChar) -> i32;
    fn vfs_stat(start: *mut vnode, path: *CChar, st: *mut cosmo_stat) -> i32;
    fn vfs_mount(path: *CChar, fsname: *CChar, bdev: *mut blkdev, flags: u32) -> i32;
    fn vfs_umount2(path: *CChar, flags: u32) -> i32;
    fn vfs_umount_at(start: *mut vnode, path: *CChar, flags: u32) -> i32;
    fn vfs_mount_count() -> u32;
    fn vfs_mount_acquire(id: u64, out: *mut *mut mount) -> i32;
    fn vfs_mount_release(mnt: *mut mount);
    fn vnode_put(vn: *mut vnode);
    fn clock_now_ns() -> u64;
    fn thread_create(entry: extern "C" fn(*mut void), arg: *mut void, name: *CChar, priority: i32) -> *mut thread;
    fn thread_join(t: *mut thread) -> i32;
    fn thread_sleep_ns(ns: u64);

    // The values and layout the C compiler checks (ADR 0080 §3.1), which the floor asserted.
    const ENOENT: i32 = 2;
    const EBUSY: i32 = 16;
    const ENAMETOOLONG: i32 = 36;
    const VFS_PATH_MAX: usize = 1024;
    const SCHED_PRIO_DEFAULT: i32 = 32;
    @cvalue("COSMO_O_WRONLY")
    const O_WRONLY: u32 = 0x0001;
    @cvalue("COSMO_O_CREAT")
    const O_CREAT: u32 = 0x0040;
}

// errno.h, syscall.h, vfs.h and thread.h, which the C compiler checks.
const MODE_DIR: u32 = 0x1ED;  // 0755
const MODE_FILE: u32 = 0x1A4; // 0644
const MS: u64 = 1000000;

/// Safety: `reason` is writable; `why` ends in a zero byte.
unsafe fn failed(reason: *mut *CChar, why: StringView) -> bool {
    reason.write(why.ptr as *CChar);
    return false;
}

/// A reason too long for one line, in two pieces, the second ending in a zero byte.
/// Safety: `reason` is writable; the text stays valid until the next failure.
unsafe fn failed2(reason: *mut *CChar, a: StringView, b: StringView) -> bool {
    let buf = SliceMut.fromRaw(borrow mut REASON as *mut [u8; 256] as *mut u8, 256);
    var line = TextWriter.create(buf);
    line.text(a);
    line.text(b);
    reason.write(line.cText());
    return false;
}

static mut REASON: [u8; 256] = [0; 256];

/// A literal's C string: the literal ends in a zero byte.
fn c(s: StringView) -> *CChar => s.ptr as *CChar;

/// Safety: `p` ends in a zero byte.
unsafe fn mkdir(p: StringView) -> i32 => vfs_mkdir(0 as *mut vnode, c(p), MODE_DIR);

/// Safety: `p` ends in a zero byte.
unsafe fn rmdir(p: StringView) -> i32 => vfs_rmdir(0 as *mut vnode, c(p));

/// Safety: `p` ends in a zero byte.
unsafe fn unlink(p: StringView) -> i32 => vfs_unlink(0 as *mut vnode, c(p));

/// Safety: `p` and `t` end in a zero byte.
unsafe fn symlink(p: StringView, t: StringView) -> i32 => vfs_symlink(0 as *mut vnode, c(p), c(t));

/// Safety: `p` ends in a zero byte; `out` is writable.
unsafe fn lookup(p: StringView, out: *mut *mut vnode) -> i32 => vfs_lookup(0 as *mut vnode, c(p), out);

/// renameat's two starts (docs/audit/next-subsystem-dirfd.md): a rename whose two paths resolve from two different
/// directories, each given as a relative name. The result is checked by absolute path, because a rename that used the
/// first start for both names would also succeed -- into the wrong directory.
/// Safety: `reason` is writable; runs at boot, alone.
@export("selftest_vfs_rename2")
unsafe fn selftestVfsRename2(reason: *mut *CChar) -> bool {
    var stBytes: [u64; 7] = [0; 7];
    let s = borrow mut stBytes as *mut [u64; 7] as *mut cosmo_stat;
    var f = 0 as *mut file;
    if (!(mkdir("/tmp/rn2a\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/rn2a\", 0755) == 0 at line 110\0");
    }
    if (!(mkdir("/tmp/rn2b\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/rn2b\", 0755) == 0 at line 113\0");
    }
    if (!(vfs_open(
        0 as *mut vnode,
        c("/tmp/rn2a/f\0"),
        O_WRONLY | O_CREAT,
        MODE_FILE,
        borrow mut f as *mut *mut file,
    ) ==
        0)) {
        return failed(reason, "check failed: vfs_open(NULL, \"/tmp/rn2a/f\", ..., 0644, &f) == 0 at line 117\0");
    }
    kobject_put(f as *mut kobject);
    var a = 0 as *mut vnode;
    var b = 0 as *mut vnode;
    if (!(lookup("/tmp/rn2a\0", borrow mut a as *mut *mut vnode) == 0)) {
        return failed(reason, "check failed: vfs_lookup(NULL, \"/tmp/rn2a\", &a) == 0 at line 123\0");
    }
    if (!(lookup("/tmp/rn2b\0", borrow mut b as *mut *mut vnode) == 0)) {
        return failed(reason, "check failed: vfs_lookup(NULL, \"/tmp/rn2b\", &b) == 0 at line 126\0");
    }
    let rc = vfs_rename2(a, c("f\0"), b, c("g\0"));
    let rcBack = if (rc == 0) vfs_stat(0 as *mut vnode, c("/tmp/rn2b/g\0"), s) else rc;
    let rcGone = vfs_stat(0 as *mut vnode, c("/tmp/rn2a/f\0"), s);
    let rcWrong = vfs_stat(0 as *mut vnode, c("/tmp/rn2a/g\0"), s);
    vnode_put(a);
    vnode_put(b);
    let _ = unlink("/tmp/rn2b/g\0");
    let _ = unlink("/tmp/rn2a/g\0");
    let _ = unlink("/tmp/rn2a/f\0");
    if (!(rmdir("/tmp/rn2a\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/rn2a\") == 0 at line 138\0");
    }
    if (!(rmdir("/tmp/rn2b\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/rn2b\") == 0 at line 141\0");
    }
    if (!(rc == 0)) {
        return failed(reason, "check failed: rc == 0 at line 144\0");
    }
    if (!(rcBack == 0)) { // it is where the second start named it
        return failed(reason, "check failed: rc_back == 0 at line 147\0");
    }
    if (!(rcGone == -ENOENT)) {
        return failed(reason, "check failed: rc_gone == -ENOENT at line 150\0");
    }
    if (!(rcWrong == -ENOENT)) { // and not beside the first
        return failed(reason, "check failed: rc_wrong == -ENOENT at line 153\0");
    }
    KernelLog.write(
        LogLevel.Info,
        "selftest: vfs-rename2: a rename between two directories reached from two starts lands in the second",
    );
    return true;
}

/// One walk of vfs-lookup-named's table: from /tmp/ln or the root, the path, and the name it must come back with.
fn caseFromLn(i: u32) -> bool => i != 0 && i != 3;

fn casePath(i: u32) -> StringView => match (i) {
    0 => "/tmp/ln/a/b\0",
    1 => "a/./b\0",
    2 => "a/b/..\0",
    3 => "/..\0",
    4 => "../../..\0",
    5 => "abs\0",    // an absolute link, last
    6 => "abs/..\0", // ... mid-path: the target's parent, not /tmp/ln
    7 => "rel\0",    // a relative link, last: its name must not stay in
    8 => "rel/..\0", // ... mid-path
    9 => "chain\0",  // two links
    10 => "a/up\0",  // a relative link into a mount
    11 => "m/in/..\0",
    12 => "m/..\0",  // `..` from a mount root leaves through the mountpoint
    13 => "m/out\0", // a link inside the mount, out through its root
    _ => "a/b/\0",
};

fn caseWant(i: u32) -> StringView => match (i) {
    0 => "/tmp/ln/a/b\0",
    1 => "/tmp/ln/a/b\0",
    2 => "/tmp/ln/a\0",
    3 => "/\0",
    4 => "/\0",
    5 => "/tmp/ln/a/b\0",
    6 => "/tmp/ln/a\0",
    7 => "/tmp/ln/a/b\0",
    8 => "/tmp/ln/a\0",
    9 => "/tmp/ln/a/b\0",
    10 => "/tmp/ln/m/in\0",
    11 => "/tmp/ln/m\0",
    12 => "/tmp/ln\0",
    13 => "/tmp/ln/a\0",
    _ => "/tmp/ln/a/b\0",
};

const CASES: u32 = 15;
const NONE: u32 = 0xFFFFFFFF;

/// The text of a C string, for the log.
/// Safety: `s` is NUL-terminated within `max` bytes.
unsafe fn cText(line: borrow mut TextWriter, s: *u8, max: usize) {
    var i: usize = 0;
    while (i < max && *Ptr.toBorrow(s.add(i)) != 0) {
        line.byte(*Ptr.toBorrow(s.add(i)));
        i += 1;
    }
}

static mut LN_NAME: [u8; 1024] = [0; 1024];

/// The traversed name (P32, docs/audit/next-subsystem-cwd-name.md): a table of walks, each name checked for its text
/// and then walked again from the root to the same vnode. The tree has an absolute link, a relative one, a chain, a
/// relative link into a mount, and one inside the mount that leaves it through `..` -- the shapes where a lexical name
/// and the walk part company.
/// Safety: `reason` is writable; runs at boot, alone.
@export("selftest_vfs_lookup_named")
unsafe fn selftestVfsLookupNamed(reason: *mut *CChar) -> bool {
    if (!(mkdir("/tmp/ln\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/ln\", 0755) == 0 at line 222\0");
    }
    if (!(mkdir("/tmp/ln/a\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/ln/a\", 0755) == 0 at line 225\0");
    }
    if (!(mkdir("/tmp/ln/a/b\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/ln/a/b\", 0755) == 0 at line 228\0");
    }
    if (!(mkdir("/tmp/ln/m\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/ln/m\", 0755) == 0 at line 231\0");
    }
    if (!(vfs_mount(c("/tmp/ln/m\0"), c("ramfs\0"), 0 as *mut blkdev, 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(\"/tmp/ln/m\", \"ramfs\", NULL, 0) == 0 at line 234\0");
    }
    if (!(mkdir("/tmp/ln/m/in\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/ln/m/in\", 0755) == 0 at line 237\0");
    }
    if (!(symlink("/tmp/ln/abs\0", "/tmp/ln/a/b\0") == 0)) {
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/abs\", \"/tmp/ln/a/b\") == 0 at line 240\0");
    }
    if (!(symlink("/tmp/ln/rel\0", "a/b\0") == 0)) {
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/rel\", \"a/b\") == 0 at line 243\0");
    }
    if (!(symlink("/tmp/ln/chain\0", "abs\0") == 0)) {
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/chain\", \"abs\") == 0 at line 246\0");
    }
    if (!(symlink("/tmp/ln/a/up\0", "../m/in\0") == 0)) { // relative, into the mount
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/a/up\", \"../m/in\") == 0 at line 249\0");
    }
    if (!(symlink("/tmp/ln/m/out\0", "../a\0") == 0)) { // relative, out of it through its root
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/m/out\", \"../a\") == 0 at line 252\0");
    }
    if (!(symlink("/tmp/ln/a/b/toroot\0", "/tmp\0") == 0)) { // absolute, to a short name
        return failed(reason, "check failed: vfs_symlink(NULL, \"/tmp/ln/a/b/toroot\", \"/tmp\") == 0 at line 255\0");
    }
    var ln = 0 as *mut vnode;
    if (!(lookup("/tmp/ln\0", borrow mut ln as *mut *mut vnode) == 0)) {
        return failed(reason, "check failed: vfs_lookup(NULL, \"/tmp/ln\", &ln) == 0 at line 259\0");
    }

    let name = borrow mut LN_NAME as *mut [u8; 1024] as *mut CChar;
    var bad = NONE;
    var mismatch = NONE;
    for (i in 0..CASES) {
        var vn = 0 as *mut vnode;
        var again = 0 as *mut vnode;
        let start = if (caseFromLn(i)) ln else 0 as *mut vnode;
        let rc = vfs_lookup_named(
            start, c("/tmp/ln\0"), c(casePath(i)), borrow mut vn as *mut *mut vnode, name,
            VFS_PATH_MAX,
        );
        if (rc != 0 || strcmp(name as *CChar, c(caseWant(i))) != 0) {
            var buffer: [u8; 256] = [0; 256];
            var line = TextWriter.create(mut buffer[..]);
            line.text("selftest: vfs-lookup-named: case ");
            line.decimal(i as u64);
            line.text(" (");
            cText(mut line, c(casePath(i)) as *u8, 64);
            line.text("): rc ");
            line.signed(rc as i64);
            line.text(", name '");
            if (rc == 0) {
                cText(mut line, name as *u8, VFS_PATH_MAX);
            }
            line.text("', want '");
            cText(mut line, c(caseWant(i)) as *u8, 64);
            line.text("'");
            KernelLog.send(LogLevel.Info, line);
            if (bad == NONE) {
                bad = i;
            }
        } else if (vfs_lookup(0 as *mut vnode, name as *CChar, borrow mut again as *mut *mut vnode) != 0 ||
            again != vn) {
            if (mismatch == NONE) {
                mismatch = i; // the name does not reach what the walk reached
            }
        }
        if (!again.isNull()) {
            vnode_put(again);
        }
        if (!vn.isNull()) {
            vnode_put(vn);
        }
    }
    // A relative walk from a start with no name; a name that does not fit.
    var vn = 0 as *mut vnode;
    let rcNoname = vfs_lookup_named(ln, 0 as *CChar, c("a\0"), borrow mut vn as *mut *mut vnode, name, VFS_PATH_MAX);
    if (!vn.isNull()) {
        vnode_put(vn);
    }
    vn = 0 as *mut vnode;
    let rcLong = vfs_lookup_named(
        0 as *mut vnode, 0 as *CChar, c("/tmp/ln/a/b\0"), borrow mut vn as *mut *mut vnode,
        name, 8,
    );
    if (!vn.isNull()) {
        vnode_put(vn);
    }
    // An overflow before an absolute link is no part of the name after it: "/tmp/ln/a/b" does not fit ten bytes, the
    // link restarts at `/`, and "/tmp" does (found in review: the flag outlived the reset).
    vn = 0 as *mut vnode;
    var small: [u8; 10] = [0; 10];
    let sp = borrow mut small as *mut [u8; 10] as *mut CChar;
    let rcReset = vfs_lookup_named(ln, c("/tmp/ln\0"), c("a/b/toroot\0"), borrow mut vn as *mut *mut vnode, sp, 10);
    let resetNamed = rcReset == 0 && strcmp(sp as *CChar, c("/tmp\0")) == 0;
    if (!vn.isNull()) {
        vnode_put(vn);
    }
    vnode_put(ln);

    let _ = unlink("/tmp/ln/m/out\0");
    let _ = rmdir("/tmp/ln/m/in\0");
    if (!(vfs_umount2(c("/tmp/ln/m\0"), 0) == 0)) {
        return failed(reason, "check failed: vfs_umount(\"/tmp/ln/m\") == 0 at line 331\0");
    }
    let _ = unlink("/tmp/ln/a/up\0");
    let _ = unlink("/tmp/ln/a/b/toroot\0");
    let _ = unlink("/tmp/ln/chain\0");
    let _ = unlink("/tmp/ln/rel\0");
    let _ = unlink("/tmp/ln/abs\0");
    if (!(rmdir("/tmp/ln/m\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/ln/m\") == 0 at line 339\0");
    }
    if (!(rmdir("/tmp/ln/a/b\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/ln/a/b\") == 0 at line 342\0");
    }
    if (!(rmdir("/tmp/ln/a\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/ln/a\") == 0 at line 345\0");
    }
    if (!(rmdir("/tmp/ln\0") == 0)) {
        return failed(reason, "check failed: vfs_rmdir(NULL, \"/tmp/ln\") == 0 at line 348\0");
    }

    if (!(bad == NONE)) { // every name is the path the walk took
        return failed(reason, "check failed: bad == ~0u at line 352\0");
    }
    if (!(mismatch == NONE)) { // and walked again, it reaches the same vnode
        return failed(reason, "check failed: mismatch == ~0u at line 355\0");
    }
    if (!(rcNoname == -ENOENT)) {
        return failed(reason, "check failed: rc_noname == -ENOENT at line 358\0");
    }
    if (!(rcLong == -ENAMETOOLONG)) {
        return failed(reason, "check failed: rc_long == -ENAMETOOLONG at line 361\0");
    }
    if (!(resetNamed)) {
        return failed(reason, "check failed: reset_named at line 364\0");
    }
    var buffer: [u8; 128] = [0; 128];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: vfs-lookup-named: ");
    line.decimal(CASES as u64);
    line.text(" walks named by the path they took, through links and a mount");
    KernelLog.send(LogLevel.Info, line);
    return true;
}

// One unmount at a time (docs/audit/next-subsystem-mount-rel.md): the guard in vfs_umount_at that refuses a second
// unmount while the first is in its drain. It was unreachable until unmount honoured a start: by absolute path a second
// unmount cannot even resolve the target (follow_mount refuses a mount that is unmounting), and only a path from inside
// the mount -- "." from its root -- reaches it without crossing the mountpoint.
//
// The order is made, not waited for: a held maintenance pass keeps the first unmount in its drain, and the second
// starts only once `unmounting` is seen set. The second runs in a thread with a bound, because without the guard it
// would block in the same drain.

/// One unmount's start, path, answer and end.
struct UmountOnce {
    start: *mut vnode;
    path: *CChar;
    rc: i32;
    done: AtomicU32;
}

/// Safety: `arg` is an UmountOnce that outlives the thread, holding its own reference on `start`.
@callback
unsafe fn umountOnceMain(arg: *mut void) {
    let u = Ptr.toBorrowMut(arg as *mut UmountOnce);
    u.rc = vfs_umount_at(u.start, u.path, 0);
    // A start is the thread's own reference, dropped only when its walk is over: a thread that starts late must not
    // walk from a vnode the test has already let go of (found in review).
    if (!u.start.isNull()) {
        vnode_put(u.start);
    }
    u.done.storeWith(1, StoreOrdering.Release);
}

/// Safety: the clock and the sleep need nothing.
unsafe fn umountOnceWait(u: borrow UmountOnce, ms: u64) -> bool {
    let deadline = clock_now_ns() + ms * MS;
    while (u.done.loadWith(LoadOrdering.Acquire) == 0) {
        if (clock_now_ns() > deadline) {
            return false;
        }
        thread_sleep_ns(MS);
    }
    return true;
}

/// Safety: `reason` is writable; runs at boot, alone.
@export("selftest_vfs_umount_once")
unsafe fn selftestVfsUmountOnce(reason: *mut *CChar) -> bool {
    let mounts0 = vfs_mount_count();
    if (!(mkdir("/tmp/um\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/um\", 0755) == 0 at line 422\0");
    }
    if (!(vfs_mount(c("/tmp/um\0"), c("ramfs\0"), 0 as *mut blkdev, 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(\"/tmp/um\", \"ramfs\", NULL, 0) == 0 at line 425\0");
    }
    if (!(mkdir("/tmp/um/d\0") == 0)) {
        return failed(reason, "check failed: vfs_mkdir(NULL, \"/tmp/um/d\", 0755) == 0 at line 428\0");
    }
    var root = 0 as *mut vnode;
    if (!(lookup("/tmp/um\0", borrow mut root as *mut *mut vnode) == 0)) {
        return failed(reason, "check failed: vfs_lookup(NULL, \"/tmp/um\", &root) == 0 at line 432\0");
    }
    let mnt = Ptr.toBorrow(root as *vnode).mnt;
    var held = 0 as *mut mount;
    if (!(Ptr.toBorrow(mnt as *mount).root == root)) {
        return failed(reason, "check failed: mnt->root == root at line 437\0");
    }
    if (!(vfs_mount_acquire(Ptr.toBorrow(mnt as *mount).id, borrow mut held as *mut *mut mount) == 0)) {
        return failed(reason, "check failed: vfs_mount_acquire(mnt->id, &held) == 0 at line 440\0"); // the first waits
    }

    // The first unmount, by absolute path: it sets `unmounting` and drains.
    var first = UmountOnce { start: 0 as *mut vnode, path: c("/tmp/um\0"), rc: 0, done: AtomicU32.create(0) };
    let ta = thread_create(
        umountOnceMain, borrow mut first as *mut UmountOnce as *mut void, c("umount-first\0"),
        SCHED_PRIO_DEFAULT,
    );
    if (!(!ta.isNull())) {
        return failed(reason, "check failed: ta != NULL at line 448\0");
    }
    let deadline = clock_now_ns() + 2000 * MS;
    var seen = false;
    let mp = Ptr.toBorrow(mnt as *mount).mountpoint;
    let mpLock = borrow mut Ptr.toBorrowMut(mp).lock as *mut mutex;
    while (!seen && clock_now_ns() < deadline) {
        mutex_lock(mpLock);
        seen = Ptr.toBorrow(mnt as *mount).unmounting;
        mutex_unlock(mpLock);
        if (!seen) {
            thread_sleep_ns(MS);
        }
    }

    // The second, from inside: "d/.." from the mount's root, a path that names that root only from there -- resolved
    // from anywhere else it is -ENOENT (there is no `d`), not the -EBUSY the root filesystem gives "." (found by a
    // mutation that ignored the start and passed).
    var second = UmountOnce { start: root, path: c("d/..\0"), rc: 0, done: AtomicU32.create(0) };
    var tb = 0 as *mut thread;
    if (seen) {
        kobject_get(borrow mut Ptr.toBorrowMut(root).obj as *mut kobject); // the thread's own, put when it returns
        tb = thread_create(
            umountOnceMain, borrow mut second as *mut UmountOnce as *mut void, c("umount-second\0"),
            SCHED_PRIO_DEFAULT,
        );
        if (tb.isNull()) {
            vnode_put(root);
        }
    }
    let secondAnswered = !tb.isNull() && umountOnceWait(second, 2000);
    let firstWaiting = first.done.loadWith(LoadOrdering.Acquire) == 0; // still in its drain

    // Let everything go on every path: the root reference first, so the first unmount's reference scan finds none,
    // then the pass. A second unmount that has not answered still holds its own reference, so the first cannot free the
    // root under it: it finds that reference and refuses, and the checks below say which step failed.
    vnode_put(root);
    vfs_mount_release(held);
    let _ = thread_join(ta);
    if (!tb.isNull()) {
        let _ = thread_join(tb);
    }
    let _ = rmdir("/tmp/um/d\0");           // only if the first failed: its mount is gone otherwise
    let _ = vfs_umount2(c("/tmp/um\0"), 0); // likewise
    let _ = rmdir("/tmp/um\0");

    if (!(seen)) { // the first unmount reached its drain
        return failed(reason, "check failed: seen at line 493\0");
    }
    if (!(secondAnswered)) { // the second did not wait in it
        return failed(reason, "check failed: second_answered at line 496\0");
    }
    if (!(firstWaiting)) { // ... and answered while the pass was still held
        return failed(reason, "check failed: first_waiting at line 499\0");
    }
    if (!(second.rc == -EBUSY)) { // the guard's answer
        return failed(reason, "check failed: second.rc == -EBUSY at line 502\0");
    }
    if (!(first.rc == 0)) { // the first then finished
        return failed(reason, "check failed: first.rc == 0 at line 505\0");
    }
    if (!(vfs_mount_count() == mounts0)) {
        return failed(reason, "check failed: vfs_mount_count() == mounts0 at line 508\0");
    }
    KernelLog.write(
        LogLevel.Info,
        "selftest: vfs-umount-once: a second unmount from inside the mount was refused while the first drained",
    );
    return true;
}
