// pagecache.cee - The per-vnode page cache (pagecache.h; docs/kernel-services/vfs/design.md), in CeeSafe: roadmap 2.0
// SA7. tests/host/test_pagecache.c holds it to the digest of the C it replaced.
//
// A regular file's 4 KiB page indices map to page frames through a small hash. Reads miss through the filesystem's
// readpage; writes dirty pages that reach its writepage or writepages only on pagecache_sync. Clean pages of mounts
// whose cache is not their store sit on a global LRU, from whose tail a global limit evicts; dirty pages of such
// mounts are counted against a bound at which a writer writes its own file back and then sleeps.
//
// The caches, their entries and the mounts stay C (pagecache.h, vfs.h). The LRU is a static whose list head points
// into itself, beside its lock and the dirty bound's waitqueue and lockdep class; the injected readpage failure is
// faultinject.h's, and the lockdep assertion a `cfg` block (ADR 0080 §3.3).

@header("kernel/errno.h", "kernel/kmalloc.h", "kernel/list.h", "kernel/mutex.h", "kernel/object.h", "kernel/page.h",
    "kernel/pagecache.h", "kernel/pmm.h", "kernel/spinlock.h", "kernel/string.h", "kernel/vfs.h", "kernel/vmm.h",
    "kernel/wait.h", "arch/mmu.h", "kernel/faultinject.h", "kernel/lockdep.h")
extern "C" {
    struct page {
        flags: u32;
        refcount: u32;
    }
    struct pc_entry {
        index: u64;
        page: *mut page;
        dirty: bool;
        on_lru: bool;
        next: *mut pc_entry;
        vn: *mut vnode;
        lru: list_node;
    }
    struct pagecache {
        // buckets, struct pc_entry *[PC_HASH] at offset 0 (which C checks): reached through bucket()
        nr_pages: u32;
        nr_dirty: u32;
        lock: mutex;
        mappings: list_node;
        trim_bound: u64;
        wb_err: i32;
        wb_seq: u32;
    }
    struct vnode_ops {
        readpage: extern "C" fn(*mut vnode, u64, *mut void) -> i32;
        writepage: extern "C" fn(*mut vnode, u64, *void) -> i32;
        writepages: extern "C" fn(*mut vnode, u64, **mut void, u32, *mut u32) -> i32;
        dirty_check: extern "C" fn(*mut vnode, u64, u32) -> i32;
    }
    struct mount {
        flags: u32;
        cache_pages: AtomicU64;
        cache_dirty: AtomicU64;
        cache_limit_pages: u64;
    }
    struct vnode {
        obj: kobject;
        mnt: *mut mount;
        @cname("type") kind: u32;
        size: u64;
        ops: *vnode_ops;
        pc: pagecache;
        lock: mutex;
    }
    struct vm_file_map {
        text: bool;
        link: list_node;
    }
    struct pagecache_stats {
        hits: u64;
        misses: u64;
        writebacks: u64;
        pages: u64;
        reclaimed: u64;
        budget_refusals: u64;
        wb_errors: u64;
        dropped_dirty: u64;
        pinned_skips: u64;
        exec_syncs: u64;
        throttled: u64;
    }
    struct waitqueue;

    fn kzalloc(size: usize) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    fn mutex_trylock(m: *mut mutex) -> bool;
    fn kobject_tryget(obj: *mut kobject) -> bool;
    fn vnode_put(vn: *mut vnode);
    fn pmm_alloc_pages(order: u32, flags: u32) -> *mut page;
    fn pmm_free_pages(p: *mut page, order: u32);
    fn pmm_page_get(p: *mut page);
    fn vm_file_map_truncate(m: *mut vm_file_map, keep: u64);
    fn vm_file_map_writeprotect(m: *mut vm_file_map, index: u64, n: u32);
    fn vm_file_map_exec_at(m: *mut vm_file_map, index: u64) -> bool;
    fn arch_mmu_sync_icache_kernel(va: usize, len: usize);
    fn waitqueue_wake_all(wq: *mut waitqueue) -> u32;
    fn wait_floor_until_timeout(
        wq: *mut waitqueue,
        cond: extern "C" fn(*mut void) -> bool,
        arg: *mut void,
        ns: u64,
    ) -> bool;

    fn waitqueue_init(wq: *mut waitqueue, name: *CChar);
    fn lockdep_completion_init(slot: *mut u16, name: *CChar, ip: usize);
    fn lockdep_completion_wait(c: *void, slot: *mut u16, name: *CChar, ip: usize);
    fn lockdep_completion_signal(c: *void, slot: *mut u16, name: *CChar, ip: usize);
    /// lockdep.h: whether this thread holds `lock`, in a lockdep build only.
    @cfg("CONFIG_LOCKDEP")
    fn lockdep_is_held(lock: *void, kind: u32) -> bool;
    const LOCKDEP_KIND_MUTEX: u32 = 1;
    /// faultinject.h's readpage failure, for any miss (a hole on ramfs included), so the SIGBUS proof needs no disk.
    enum fi_kind: u32;
    const FI_FILE_READPAGE: fi_kind = 11;
    fn faultinject_should_fail(kind: fi_kind) -> bool;
    /// page.h's direct map (an inline function).
    fn page_to_virt(p: *page) -> *mut void;

    // The values and layout the C compiler checks (ADR 0080 §3.1), which the floor asserted.
    const EIO: i32 = 5;
    const ENOMEM: i32 = 12;
    const EFBIG: i32 = 27;
    const ENOSPC: i32 = 28;
    const PAGE_SIZE: u64 = 4096;
    const PC_HASH: u64 = 32;
    const MOUNT_CACHE_IS_STORE: u32 = 2;
    const PG_PAGECACHE: u32 = 128;
    const PMM_FLAGS_ZERO: u32 = 4;
    const VNODE_REG: u32 = 1;
    /// pagecache.cee's errno.h, page.h, pagecache.h, pmm.h and vfs.h values
    @cvalue("PAGECACHE_WRITE_RUN == 8 && sizeof(struct pagecache_stats) == 11 * 8")
    const PAGECACHE_FACT_0: bool = true;
    /// pagecache.cee's buckets: the cache's first field, an array of pointers
    @cvalue("offsetof(struct pagecache, buckets) == 0 && sizeof(((struct pagecache *)0)->buckets[0]) == sizeof(size_t)")
    const PAGECACHE_FACT_1: bool = true;
}

// ---- The LRU, the dirty bound's wait, and the seams ----

/// The global LRU of clean, reclaimable pages: head = most recent.
static mut LRU: list_node = list_node { next: borrow mut LRU as *mut list_node, prev: borrow mut LRU as *mut list_node };
static mut LRU_LOCK: spinlock_t = SPINLOCK_INIT("pagecache-lru\0".ptr as *CChar);
/// The dirty bound's waitqueue, set up at boot, and the lockdep completion class of its sleep.
static mut DIRTY_WQ: waitqueue = waitqueue {};
static mut DIRTY_CLASS: u16 = 0;
/// Where pagecache_dirty_init was called from, which names the class in lockdep's reports.
static DIRTY_IP: AtomicUSize = AtomicUSize.constant(0);

/// Safety: the LRU is used under its lock.
unsafe fn lru() -> *mut list_node => borrow mut LRU as *mut list_node;

/// Safety: as lru.
unsafe fn lruLock() -> *mut spinlock_t => borrow mut LRU_LOCK as *mut spinlock_t;

/// Safety: the waitqueue is set up at boot, before a writer is throttled.
unsafe fn dirtyWq() -> *mut waitqueue => borrow mut DIRTY_WQ as *mut waitqueue;

/// lockdep's record of the dirty bound's sleep and its wake.
/// Safety: after pagecache_dirty_init.
unsafe fn dirtyWait() {
    lockdep_completion_wait(dirtyWq() as *void, borrow mut DIRTY_CLASS as *mut u16, "pagecache-dirty\0".ptr as *CChar,
        DIRTY_IP.load());
}

/// Safety: as dirtyWait.
unsafe fn dirtySignal() {
    lockdep_completion_signal(dirtyWq() as *void, borrow mut DIRTY_CLASS as *mut u16, "pagecache-dirty\0".ptr as *CChar,
        DIRTY_IP.load());
}

/// lockdep_assert_held(m, LOCKDEP_KIND_MUTEX), which only a lockdep build makes.
/// Safety: `m` is a live mutex.
unsafe fn assertHeld(m: *mut mutex) {
    if (cfg("CONFIG_LOCKDEP")) {
        if (!lockdep_is_held(m as *void, LOCKDEP_KIND_MUTEX)) {
            var buffer: [u8; 96] = [0; 96];
            var line = TextWriter.create(mut buffer[..]);
            line.text("assertion failed: lockdep_is_held(m) (pagecache.cee, assertHeld)");
            KernelLog.panic(line);
        }
    }
}

// errno.h, page.h, pagecache.h, pmm.h and vfs.h's.
const PAGE_BYTES: usize = 4096;
const WRITE_RUN: u32 = 8;
const U64_MAX: u64 = 0xffffffffffffffff;

// Dirty pages, bounded (MEM-9; design.md, "Dirty pages, bounded"). Every dirty page of a reclaimable mount is counted
// here as well as in its cache and its mount; a writer that finds the count at the bound writes its own file back and
// then sleeps, holding nothing, until pages are cleaned below it (pagecache_throttle). The bound is DIRTY_DIVISOR's
// share of the cache limit: half of it, an eighth of RAM. A ramfs page is its store and cannot be cleaned, so it is
// not counted.
const DIRTY_DIVISOR: u64 = 2;
const THROTTLE_NS: u64 = 100000000; // one sleep, then the count is looked at again
const THROTTLE_WAITS: u32 = 50; // at most 5 s behind other files' dirty pages

/// The global cap on cached pages; 0: no limit.
static LIMIT: AtomicU64 = AtomicU64.constant(0);
/// Dirty pages of reclaimable mounts.
static DIRTY: AtomicU64 = AtomicU64.constant(0);
/// Writers asleep in pagecache_throttle.
static THROTTLED: AtomicU32 = AtomicU32.constant(0);
static DIRTY_READY: AtomicBool = AtomicBool.constant(false);

/// pagecache_stats, under its lock.
struct Stats {
    hits: u64;
    misses: u64;
    writebacks: u64;
    pages: u64;
    reclaimed: u64;
    budgetRefusals: u64;
    wbErrors: u64;
    droppedDirty: u64;
    pinnedSkips: u64;
    execSyncs: u64;
    throttled: u64;
}

static STATS: IrqSpinLock<Stats> = IrqSpinLock<Stats>.constant(
    "pagecache-stats\0".ptr as *CChar,
    Stats {
        hits: 0,
        misses: 0,
        writebacks: 0,
        pages: 0,
        reclaimed: 0,
        budgetRefusals: 0,
        wbErrors: 0,
        droppedDirty: 0,
        pinnedSkips: 0,
        execSyncs: 0,
        throttled: 0,
    },
);

/// The counters statAdd raises.
enum Stat {
    Hits,
    Misses,
    Writebacks,
    Pages,
    Reclaimed,
    BudgetRefusals,
    WbErrors,
    DroppedDirty,
    PinnedSkips,
    ExecSyncs,
    Throttled,
}

fn statAdd(which: Stat, n: u64) {
    var guard = STATS.lock();
    let s = guard.data();
    match (which) {
        Stat.Hits => { s.hits = s.hits.wrappingAdd(n); }
        Stat.Misses => { s.misses = s.misses.wrappingAdd(n); }
        Stat.Writebacks => { s.writebacks = s.writebacks.wrappingAdd(n); }
        Stat.Pages => { s.pages = s.pages.wrappingAdd(n); }
        Stat.Reclaimed => { s.reclaimed = s.reclaimed.wrappingAdd(n); }
        Stat.BudgetRefusals => { s.budgetRefusals = s.budgetRefusals.wrappingAdd(n); }
        Stat.WbErrors => { s.wbErrors = s.wbErrors.wrappingAdd(n); }
        Stat.DroppedDirty => { s.droppedDirty = s.droppedDirty.wrappingAdd(n); }
        Stat.PinnedSkips => { s.pinnedSkips = s.pinnedSkips.wrappingAdd(n); }
        Stat.ExecSyncs => { s.execSyncs = s.execSyncs.wrappingAdd(n); }
        Stat.Throttled => { s.throttled = s.throttled.wrappingAdd(n); }
    }
}

/// A page gone from the count.
fn pageGone() {
    var guard = STATS.lock();
    let s = guard.data();
    s.pages = s.pages.wrappingSub(1);
}

fn cachedPages() -> u64 {
    var guard = STATS.lock();
    return guard.data().pages;
}

/// The panic of a broken invariant (the C's KASSERT).
fn check(ok: bool, what: StringView) {
    if (!ok) {
        var buffer: [u8; 128] = [0; 128];
        var line = TextWriter.create(mut buffer[..]);
        line.text("pagecache: assertion failed: ");
        line.text(what);
        KernelLog.panic(line);
    }
}

/// Pages, rounded up: what `bytes` reaches into. Wraps as the C did for a size within a page of the top.
fn pagesOf(bytes: u64) -> u64 => bytes.wrappingAdd(PAGE_SIZE - 1) / PAGE_SIZE;

/// Safety: `vn` is a live vnode.
unsafe fn pcOf(vn: *mut vnode) -> *mut pagecache => borrow mut Ptr.toBorrowMut(vn).pc as *mut pagecache;

/// Safety: `pc` is a live cache.
unsafe fn lockOf(pc: *mut pagecache) -> *mut mutex => borrow mut Ptr.toBorrowMut(pc).lock as *mut mutex;

/// Safety: `pc` is a live cache.
unsafe fn mappingsOf(pc: *mut pagecache) -> *mut list_node =>
    borrow mut Ptr.toBorrowMut(pc).mappings as *mut list_node;

/// Where an entry's LRU link is: an address only, so it may be asked of an entry that is gone.
/// Safety: none beyond `e` being an entry's address, live or not; nothing is read.
unsafe fn lruOf(e: *mut pc_entry) -> *mut list_node => (e as *mut u8).add(offsetOf<pc_entry>(lru)) as *mut list_node;

/// Safety: `node` is an entry's `lru`.
unsafe fn entryOfLru(node: *mut list_node) -> *mut pc_entry =>
    containerOf(node, offsetOf<pc_entry>(lru)) as *mut pc_entry;

/// Safety: `node` is a mapping's `link`.
unsafe fn mapOfLink(node: *mut list_node) -> *mut vm_file_map =>
    containerOf(node, offsetOf<vm_file_map>(link)) as *mut vm_file_map;

/// Safety: `e` is a live entry.
unsafe fn mountOf(e: *mut pc_entry) -> borrow(static) mount =>
    Ptr.toBorrow(Ptr.toBorrow(Ptr.toBorrow(e as *pc_entry).vn as *vnode).mnt as *mount);

/// Safety: `e` is a live entry.
unsafe fn reclaimable(e: *mut pc_entry) -> bool => (mountOf(e).flags & MOUNT_CACHE_IS_STORE) == 0;

/// Safety: `e` is a live entry.
unsafe fn frameOf(e: *mut pc_entry) -> *mut u8 => page_to_virt(Ptr.toBorrow(e as *pc_entry).page as *page) as *mut u8;

fn dirtyLimit() -> u64 => limit() / DIRTY_DIVISOR;

fn dirtyOver() -> bool {
    let bound = dirtyLimit();
    return bound != 0 && DIRTY.loadWith(LoadOrdering.Relaxed) >= bound;
}

/// The throttle's sleep ends here.
/// Safety: no argument is read.
@callback
unsafe fn dirtyUnder(arg: *mut void) -> bool => !dirtyOver();

/// Safety: `e` is a live entry.
unsafe fn dirtyInc(e: *mut pc_entry) {
    let _ = mountOf(e).cache_dirty.fetchAddWith(1, Ordering.Relaxed);
    if (reclaimable(e)) {
        let _ = DIRTY.fetchAddWith(1, Ordering.Relaxed);
    }
}

/// A page cleaned or dropped, under its cache's lock: a writer asleep behind the bound is woken once the count is
/// under it.
/// Safety: `e` is a live entry.
unsafe fn dirtyDec(e: *mut pc_entry) {
    let _ = mountOf(e).cache_dirty.fetchSubWith(1, Ordering.Relaxed);
    if (!reclaimable(e)) {
        return;
    }
    let _ = DIRTY.fetchSubWith(1, Ordering.Relaxed);
    if (THROTTLED.loadWith(LoadOrdering.Acquire) != 0 && !dirtyOver()) {
        dirtySignal();
        let _ = waitqueue_wake_all(dirtyWq());
    }
}

/// Both take the LRU lock; the caller holds the owning cache's mutex.
/// Safety: `e` is a live entry.
unsafe fn lruAdd(e: *mut pc_entry) {
    if (!reclaimable(e) || Ptr.toBorrow(e as *pc_entry).on_lru) {
        return;
    }
    let s = spin_lock_irqsave(lruLock());
    List.pushFront(lru(), lruOf(e));
    let fields = Ptr.toBorrowMut(e);
    fields.on_lru = true;
    spin_unlock_irqrestore(lruLock(), s);
}

/// Safety: `e` is a live entry.
unsafe fn lruRemove(e: *mut pc_entry) {
    if (!Ptr.toBorrow(e as *pc_entry).on_lru) {
        return;
    }
    let s = spin_lock_irqsave(lruLock());
    if (Ptr.toBorrow(e as *pc_entry).on_lru) {
        List.remove(lruOf(e));
        let fields = Ptr.toBorrowMut(e);
        fields.on_lru = false;
    }
    spin_unlock_irqrestore(lruLock(), s);
}

/// Back to the head of the LRU, so the next candidate differs. Under the LRU lock.
/// Safety: `e` is on the LRU.
unsafe fn lruToHead(e: *mut pc_entry) {
    List.remove(lruOf(e));
    List.pushFront(lru(), lruOf(e));
}

@export("pagecache_set_limit")
fn setLimit(pages: u64) {
    LIMIT.storeWith(pages, StoreOrdering.Relaxed);
}

@export("pagecache_limit")
fn limit() -> u64 => LIMIT.loadWith(LoadOrdering.Relaxed);

/// Evict from the LRU tail. Runs with no cache mutex held: the victim's vnode is pinned with a tryget (one already on
/// its way out is skipped) and its cache locked with a trylock (a busy one is skipped), so no thread ever waits on a
/// cache lock while holding another of the same class. Under the victim's lock the entry is re-checked: still clean,
/// still on the LRU, still this vnode's.
/// Safety: no cache lock held.
@export("pagecache_reclaim")
unsafe fn reclaim(max: u32) -> u32 {
    var done: u32 = 0;
    var skipped: u32 = 0;
    let lru = lru();
    let lruLock = lruLock();
    while (done < max && skipped < 16) {
        var s = spin_lock_irqsave(lruLock);
        if (List.isEmpty(lru as *list_node)) {
            spin_unlock_irqrestore(lruLock, s);
            break;
        }
        let e = entryOfLru(Ptr.toBorrow(lru as *list_node).prev);
        let vn = Ptr.toBorrow(e as *pc_entry).vn;
        if (!kobject_tryget(borrow mut Ptr.toBorrowMut(vn).obj as *mut kobject)) {
            // Being released: its pagecache_drop will take the entry off.
            lruToHead(e);
            spin_unlock_irqrestore(lruLock, s);
            skipped += 1;
            continue;
        }
        spin_unlock_irqrestore(lruLock, s);

        let pc = pcOf(vn);
        if (!mutex_trylock(lockOf(pc))) {
            // Busy: move it to the head so the next candidate differs.
            s = spin_lock_irqsave(lruLock);
            if (Ptr.toBorrow(e as *pc_entry).on_lru && Ptr.toBorrow(e as *pc_entry).vn == vn) {
                lruToHead(e);
            }
            spin_unlock_irqrestore(lruLock, s);
            vnode_put(vn);
            skipped += 1;
            continue;
        }
        // The entry may have been dirtied, freed or reused since: it is looked for on the LRU before it is read.
        var valid = false;
        var pinned = false;
        s = spin_lock_irqsave(lruLock);
        var node = List.first(lru as *list_node);
        while (!node.isNull()) {
            if (node == lruOf(e)) {
                let entry = Ptr.toBorrow(e as *pc_entry);
                valid = entry.vn == vn && !entry.dirty;
                // A mapping holds the frame (a reference per PTE, taken under the mutex this holds): left alone, and
                // moved to the head so the next candidate differs.
                let refs = Ptr.toBorrow(borrow mut Ptr.toBorrowMut(entry.page).refcount as *mut u32 as *AtomicU32);
                if (valid && refs.loadWith(LoadOrdering.Acquire) != 1) {
                    valid = false;
                    pinned = true;
                    lruToHead(e);
                }
                break;
            }
            node = List.next(lru as *list_node, node);
        }
        spin_unlock_irqrestore(lruLock, s);
        if (pinned) {
            statAdd(Stat.PinnedSkips, 1);
            skipped += 1;
        }
        if (valid) {
            removeEntry(pc, e);
            statAdd(Stat.Reclaimed, 1);
            done += 1;
        }
        mutex_unlock(lockOf(pc));
        vnode_put(vn);
    }
    return done;
}

/// Called before a cache lock is taken: keep the total under the limit.
/// Safety: no cache lock held.
unsafe fn reclaimIfNeeded() {
    let bound = limit();
    if (bound == 0) {
        return;
    }
    var rounds = 0;
    while (rounds < 4 && cachedPages() >= bound) {
        if (reclaim(32) == 0) {
            break; // nothing clean to evict: a soft cap until writeback exists
        }
        rounds += 1;
    }
}

/// Safety: `pc` is writable.
@export("pagecache_init")
unsafe fn init(pc: *mut pagecache) {
    let _ = memset(pc as *mut void, 0, layoutOf<pagecache>().size);
    mutex_init(lockOf(pc), "pagecache\0".ptr as *CChar);
    List.init(mappingsOf(pc));
    let fields = Ptr.toBorrowMut(pc);
    fields.trim_bound = U64_MAX;
}

fn bucketOf(index: u64) -> usize => truncate<usize>(index % PC_HASH);

/// The head of bucket `b`, a struct pc_entry * in the array the cache starts with.
/// Safety: `pc` is a live cache; `b` < PC_HASH.
unsafe fn bucket(pc: *mut pagecache, b: usize) -> *mut *mut pc_entry =>
    (pc as *mut u8).add(b * layoutOf<usize>().size) as *mut *mut pc_entry;

/// Safety: as bucket.
unsafe fn headOf(pc: *mut pagecache, b: usize) -> *mut pc_entry => *Ptr.toBorrow(bucket(pc, b) as **mut pc_entry);

/// Safety: as bucket.
unsafe fn setHead(pc: *mut pagecache, b: usize, e: *mut pc_entry) {
    let slot = Ptr.toBorrowMut(bucket(pc, b));
    *slot = e;
}

/// Safety: the cache's lock held.
unsafe fn find(pc: *mut pagecache, index: u64) -> *mut pc_entry {
    var e = headOf(pc, bucketOf(index));
    while (!e.isNull()) {
        if (Ptr.toBorrow(e as *pc_entry).index == index) {
            return e;
        }
        e = Ptr.toBorrow(e as *pc_entry).next;
    }
    return e;
}

/// Lock held. The entry for `index`, read in on a miss (readpage for pages inside the file, zeros beyond); null with
/// `err` set when it cannot be had.
/// Safety: `vn` is live and its cache's lock held.
unsafe fn get(vn: *mut vnode, index: u64, err: borrow mut i32) -> *mut pc_entry {
    let pc = pcOf(vn);
    let hit = find(pc, index);
    if (!hit.isNull()) {
        statAdd(Stat.Hits, 1);
        return hit;
    }
    statAdd(Stat.Misses, 1);
    // Reserve the mount's page first: the increment is the admission, so concurrent misses on different vnodes of one
    // mount cannot both pass a stale read of the count. Every failure below gives it back.
    let mnt = Ptr.toBorrow(Ptr.toBorrow(vn as *vnode).mnt as *mount);
    while (true) {
        let cur = mnt.cache_pages.loadWith(LoadOrdering.Relaxed);
        if (mnt.cache_limit_pages != 0 && cur >= mnt.cache_limit_pages) {
            statAdd(Stat.BudgetRefusals, 1);
            err = -ENOSPC; // the mount's page budget (ramfs)
            return 0 as *mut pc_entry;
        }
        // The compare-and-swap is the admission: the count never exceeds the budget, not even transiently.
        if (mnt.cache_pages.compareExchangeWith(cur, cur + 1, Ordering.Relaxed).isOk()) {
            break;
        }
    }
    let e = kzalloc(layoutOf<pc_entry>().size) as *mut pc_entry;
    if (e.isNull()) {
        let _ = mnt.cache_pages.fetchSubWith(1, Ordering.Relaxed);
        err = -ENOMEM;
        return e;
    }
    let fields = Ptr.toBorrowMut(e);
    fields.vn = vn;
    List.init(lruOf(e));
    fields.page = pmm_alloc_pages(0, PMM_FLAGS_ZERO);
    if (fields.page.isNull()) {
        kfree(e as *mut void);
        let _ = mnt.cache_pages.fetchSubWith(1, Ordering.Relaxed);
        err = -ENOMEM;
        return 0 as *mut pc_entry;
    }
    fields.index = index;
    let frame = Ptr.toBorrowMut(fields.page);
    frame.flags = frame.flags | PG_PAGECACHE; // the frame is the cache's: a mapping references, never owns, it
    // The injected failure stands in for readpage on ANY miss, a hole on ramfs included, so the SIGBUS proof does not
    // need a disk.
    let injected = faultinject_should_fail(FI_FILE_READPAGE);
    let ops = Ptr.toBorrow(Ptr.toBorrow(vn as *vnode).ops);
    if (injected || (index.wrappingMul(PAGE_SIZE) < Ptr.toBorrow(vn as *vnode).size && !ops.readpage.isNull())) {
        let rc = if (injected) -EIO else ops.readpage(vn, index, frameOf(e) as *mut void);
        if (rc != 0) {
            frame.flags = frame.flags & (PG_PAGECACHE ^ 0xFFFFFFFF);
            pmm_free_pages(fields.page, 0);
            kfree(e as *mut void);
            let _ = mnt.cache_pages.fetchSubWith(1, Ordering.Relaxed);
            err = rc;
            return 0 as *mut pc_entry;
        }
    }
    let b = bucketOf(index);
    let cache = Ptr.toBorrowMut(pc);
    fields.next = headOf(pc, b);
    setHead(pc, b, e);
    cache.nr_pages += 1;
    statAdd(Stat.Pages, 1);
    lruAdd(e); // clean until written
    return e;
}

/// Safety: the cache's lock held; `e` is one of its entries.
unsafe fn removeEntry(pc: *mut pagecache, e: *mut pc_entry) {
    let entry = Ptr.toBorrow(e as *pc_entry);
    let cache = Ptr.toBorrowMut(pc);
    let b = bucketOf(entry.index);
    var at = headOf(pc, b);
    if (at == e) {
        setHead(pc, b, entry.next);
    } else {
        while (!at.isNull() && Ptr.toBorrow(at as *pc_entry).next != e) {
            at = Ptr.toBorrow(at as *pc_entry).next;
        }
        if (!at.isNull()) {
            let before = Ptr.toBorrowMut(at);
            before.next = entry.next;
        }
    }
    lruRemove(e);
    if (entry.dirty) {
        cache.nr_dirty -= 1;
        dirtyDec(e);
    }
    cache.nr_pages -= 1;
    let _ = mountOf(e).cache_pages.fetchSubWith(1, Ordering.Relaxed);
    pageGone();
    // The cache's reference is the last: truncate unmapped first, reclaim skipped a mapped frame, and a released vnode
    // has no mappings. pmm_free_page panics on any other count, which is the check.
    freeFrame(e);
}

/// The entry's frame back to the allocator, and the entry to the heap.
/// Safety: `e` is a live entry, unlinked.
unsafe fn freeFrame(e: *mut pc_entry) {
    let p = Ptr.toBorrow(e as *pc_entry).page;
    let frame = Ptr.toBorrowMut(p);
    frame.flags = frame.flags & (PG_PAGECACHE ^ 0xFFFFFFFF);
    pmm_free_pages(p, 0);
    kfree(e as *mut void);
}

/// Bytes written through the kernel into a page some process executes from (a shared PROT_EXEC mapping of the file):
/// the instruction stream must be synchronised (M41), and the writer need not be that process, so it is done by the
/// frame's kernel alias. Under pc->lock; the mapping list cannot change under it. A write through another mapping's
/// PTE never comes here and is the writer's own business, as on any system with shared mappings.
/// Safety: the cache's lock held; `e` is one of its entries.
unsafe fn syncExecMappings(pc: *mut pagecache, e: *mut pc_entry) {
    let head = mappingsOf(pc);
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        if (vm_file_map_exec_at(mapOfLink(node), Ptr.toBorrow(e as *pc_entry).index)) {
            arch_mmu_sync_icache_kernel(frameOf(e) as usize, PAGE_BYTES);
            statAdd(Stat.ExecSyncs, 1);
            return;
        }
        node = List.next(head as *list_node, node);
    }
}

/// Is any process executing this file? True while a text mapping of it is on this cache's list, which is the whole
/// definition: the record is linked here when the mapping is made and unlinked before its vnode reference goes, so
/// the answer cannot outlive the mappings it describes or lag behind their teardown. A counter kept beside them could
/// do both (docs/audit/next-subsystem-elf-shared-text.md).
///
/// Called with the cache lock held -- by a writer that already holds vn->lock, which the order vnode -> pagecache ->
/// vm_space permits -- so the answer and the write that follows it are atomic against a mapping being created.
/// Safety: `vn` is live and its cache's lock held.
@export("pagecache_text_busy")
unsafe fn textBusy(vn: *mut vnode) -> bool {
    let head = mappingsOf(pcOf(vn));
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        if (Ptr.toBorrow(mapOfLink(node) as *vm_file_map).text) {
            return true;
        }
        node = List.next(head as *list_node, node);
    }
    return false;
}

/// Asked before a clean page becomes dirty: the filesystem says now, not at write-back, whether it could ever write
/// the page back (CFS-32). A page already dirty was asked about when it became so.
/// Safety: `vn` is live and its cache's lock held; `e` is one of its entries.
unsafe fn mayDirty(vn: *mut vnode, e: *mut pc_entry) -> i32 {
    let entry = Ptr.toBorrow(e as *pc_entry);
    let opsPtr = Ptr.toBorrow(vn as *vnode).ops;
    if (entry.dirty || opsPtr.isNull()) {
        return 0;
    }
    let ops = Ptr.toBorrow(opsPtr);
    if (ops.dirty_check.isNull()) {
        return 0;
    }
    return ops.dirty_check(vn, entry.index, Ptr.toBorrow(pcOf(vn) as *pagecache).nr_dirty);
}

/// A write dirties the page: off the LRU until pagecache_sync cleans it.
/// Safety: the cache's lock held; `e` is one of its entries.
unsafe fn markDirty(pc: *mut pagecache, e: *mut pc_entry) {
    let entry = Ptr.toBorrowMut(e);
    if (!entry.dirty) {
        entry.dirty = true;
        let cache = Ptr.toBorrowMut(pc);
        cache.nr_dirty += 1;
        dirtyInc(e);
        lruRemove(e);
    }
}

/// The part of `len` bytes from `off + done` that lies in one page: where in the page, and how many.
fn inPage(pos: u64) -> usize => truncate<usize>(pos % PAGE_SIZE);

fn pieceOf(pos: u64, left: usize) -> usize {
    let n = PAGE_BYTES - inPage(pos);
    return if (n > left) left else n;
}

/// Bounded by vn->size; bytes read or a negative errno.
/// Safety: `vn` is live; `buf` holds `len` bytes; no cache lock held.
@export("pagecache_read")
unsafe fn read(vn: *mut vnode, off: u64, buf: *mut void, len: usize) -> i64 {
    let size = Ptr.toBorrow(vn as *vnode).size;
    if (off >= size) {
        return 0;
    }
    let want = if (len as u64 > size - off) truncate<usize>(size - off) else len;
    let out = buf as *mut u8;
    var done: usize = 0;
    reclaimIfNeeded();
    let lock = lockOf(pcOf(vn));
    mutex_lock(lock);
    while (done < want) {
        let pos = off + done as u64;
        let n = pieceOf(pos, want - done);
        var err = 0;
        let e = get(vn, pos / PAGE_SIZE, mut err);
        if (e.isNull()) {
            mutex_unlock(lock);
            return if (done != 0) truncate<i64>(done) else err as i64;
        }
        let _ = memcpy(out.add(done) as *mut void, frameOf(e).add(inPage(pos)) as *void, n);
        done += n;
    }
    mutex_unlock(lock);
    return truncate<i64>(done);
}

/// Grows vn->size; bytes written or a negative errno.
/// Safety: `vn` is live and its lock held; `buf` holds `len` bytes; no cache lock held.
@export("pagecache_write")
unsafe fn write(vn: *mut vnode, off: u64, buf: *void, len: usize) -> i64 {
    if (len == 0) {
        return 0;
    }
    if (off > U64_MAX - len as u64) {
        return -EFBIG as i64;
    }
    let input = buf as *u8;
    let pc = pcOf(vn);
    let lock = lockOf(pc);
    var done: usize = 0;
    var err = 0;
    var flushed = false;
    reclaimIfNeeded();
    mutex_lock(lock);
    while (done < len) {
        let pos = off + done as u64;
        let n = pieceOf(pos, len - done);
        let e = get(vn, pos / PAGE_SIZE, mut err);
        if (e.isNull()) {
            break;
        }
        // Refused before a byte is copied, so a refused write leaves the page as it was. The pages this vnode already
        // has dirty count against it until written, and writing them may be all the room the next one needs (a
        // filesystem charges a dirty page for the worst it can cost): write them once and ask again. The writer holds
        // the vnode lock, the order pagecache_sync runs in.
        err = mayDirty(vn, e);
        if ((err == -EFBIG || err == -ENOSPC) && Ptr.toBorrow(pc as *pagecache).nr_dirty != 0 && !flushed) {
            assertHeld(borrow mut Ptr.toBorrowMut(vn).lock as *mut mutex);
            mutex_unlock(lock);
            err = sync(vn);
            mutex_lock(lock);
            flushed = true;
            if (err != 0) {
                break;
            }
            continue; // the entry again: reclaim may have taken it while unlocked
        }
        if (err != 0) {
            break;
        }
        flushed = false;
        let _ = memcpy(frameOf(e).add(inPage(pos)) as *mut void, input.add(done) as *void, n);
        markDirty(pc, e);
        if (!List.isEmpty(mappingsOf(pc) as *list_node)) {
            syncExecMappings(pc, e);
        }
        done += n;
        let end = off + done as u64;
        let file = Ptr.toBorrowMut(vn);
        if (end > file.size) {
            file.size = end;
            let cache = Ptr.toBorrowMut(pc);
            cache.trim_bound = U64_MAX; // the file grew: the size governs again
        }
    }
    mutex_unlock(lock);
    return if (done != 0) truncate<i64>(done) else err as i64;
}

/// writepage() every dirty page, or writepages() for a run of them.
/// Safety: `vn` is live; its cache's lock is not held.
@export("pagecache_sync")
unsafe fn sync(vn: *mut vnode) -> i32 {
    let pc = pcOf(vn);
    var rc = 0;
    mutex_lock(lockOf(pc));
    if (Ptr.toBorrow(pc as *pagecache).nr_dirty != 0) {
        // In ascending page order, so a filesystem that allocates at a moving hint lays a sequentially written file
        // out contiguously (hash-bucket order scattered the blocks and hit cosmofs's extent cap on files of a few
        // hundred pages). Dirty pages lie below the size: writes grow it and truncate drops what is above.
        let npages = pagesOf(Ptr.toBorrow(vn as *vnode).size);
        var left = Ptr.toBorrow(pc as *pagecache).nr_dirty;
        var run: [*mut pc_entry; 8] = [0 as *mut pc_entry; 8];
        var bufs: [*mut void; 8] = [0 as *mut void; 8];
        let ops = Ptr.toBorrow(Ptr.toBorrow(vn as *vnode).ops);
        var idx: u64 = 0;
        while (idx < npages && left > 0 && rc == 0) {
            let e = find(pc, idx);
            if (e.isNull() || !Ptr.toBorrow(e as *pc_entry).dirty) {
                idx += 1;
                continue;
            }

            // Gather the consecutive dirty pages that follow, so a filesystem with writepages can write them as one
            // object. Every page of the run is dirty and below the size, which is what the filesystem is promised.
            var n: u32 = 0;
            run[0] = e;
            bufs[0] = frameOf(e) as *mut void;
            n = 1;
            if (!ops.writepages.isNull()) {
                var k = idx + 1;
                while (k < npages && n < WRITE_RUN) {
                    let after = find(pc, k);
                    if (after.isNull() || !Ptr.toBorrow(after as *pc_entry).dirty) {
                        break;
                    }
                    run[n as usize] = after;
                    bufs[n as usize] = frameOf(after) as *mut void;
                    n += 1;
                    k += 1;
                }
            }

            // Before the bytes are read for the disk, every writable PTE of these pages is lowered (and shot down), so
            // a write that lands after this faults, waits for this mutex, and dirties the page again; one that landed
            // before is in what is written. The other order -- write, then lower -- would mark clean a page written
            // between the two.
            let first = Ptr.toBorrow(e as *pc_entry).index;
            let maps = mappingsOf(pc);
            var node = List.first(maps as *list_node);
            while (!node.isNull()) {
                vm_file_map_writeprotect(mapOfLink(node), first, n);
                node = List.next(maps as *list_node, node);
            }

            var done: u32 = 0;
            if (n > 1 && !ops.writepages.isNull()) {
                rc = ops.writepages(vn, first, borrow mut bufs as *mut [*mut void; 8] as **mut void, n,
                    borrow mut done as *mut u32);
                if (rc == 0 && (done == 0 || done > n)) {
                    rc = -EIO; // a filesystem that reports nonsense
                }
            } else if (!ops.writepage.isNull()) {
                rc = ops.writepage(vn, first, bufs[0] as *void);
                done = 1;
            } else {
                done = 1;
            }
            if (rc == 0) {
                for (i in 0..done) {
                    let clean = run[i as usize];
                    let entry = Ptr.toBorrowMut(clean);
                    entry.dirty = false;
                    let cache = Ptr.toBorrowMut(pc);
                    cache.nr_dirty -= 1;
                    dirtyDec(clean);
                    statAdd(Stat.Writebacks, 1);
                    lruAdd(clean); // clean again: reclaimable
                }
                left -= if (done < left) done else left;
                idx += done as u64 - 1;
            }
            idx += 1;
        }
        if (rc != 0) {
            // Recorded where it is seen, under the lock every write-back passes through; the failed pages stay dirty
            // for the next attempt. Each open file is told once (file_sync, file_flush).
            let cache = Ptr.toBorrowMut(pc);
            cache.wb_err = rc;
            cache.wb_seq = cache.wb_seq.wrappingAdd(1);
            statAdd(Stat.WbErrors, 1);
        }
    }
    mutex_unlock(lockOf(pc));
    return rc;
}

/// Safety: called once, at boot, before a writer can be throttled.
@export("pagecache_dirty_init")
unsafe fn dirtyInit() {
    DIRTY_IP.store(callerAddress());
    waitqueue_init(dirtyWq(), "pagecache-dirty\0".ptr as *CChar);
    lockdep_completion_init(borrow mut DIRTY_CLASS as *mut u16, "pagecache-dirty\0".ptr as *CChar, DIRTY_IP.load());
    DIRTY_READY.storeWith(true, StoreOrdering.Release);
}

/// Before a write takes the vnode lock, and with no lock of the caller's that write-back takes: at the bound, the
/// writer writes back its own file (under the vnode lock, as file_sync does), and while the count is still at the
/// bound it sleeps until a page cleaned anywhere brings it under, or a while passes. Its own pages are what it can
/// always clean; the others are a write-back thread's (cosmofs's commits when a mount's dirty pages pass
/// CFS_WB_DIRTY_PAGES), so the sleep is bounded for a mount that has none. Returns at once under the bound: one load.
/// Safety: `vn` is live; the caller holds no lock write-back takes.
@export("pagecache_throttle")
unsafe fn throttle(vn: *mut vnode) {
    if (!dirtyOver() || !DIRTY_READY.loadWith(LoadOrdering.Acquire)) {
        return;
    }
    let file = Ptr.toBorrow(vn as *vnode);
    if (file.kind == VNODE_REG && file.pc.nr_dirty != 0) {
        let lock = borrow mut Ptr.toBorrowMut(vn).lock as *mut mutex;
        mutex_lock(lock);
        let _ = sync(vn); // a failure is the file's, reported by its next sync
        mutex_unlock(lock);
    }
    var i: u32 = 0;
    while (i < THROTTLE_WAITS && dirtyOver()) {
        let _ = THROTTLED.fetchAddWith(1, Ordering.AcquireRelease);
        dirtyWait();
        let _ = wait_floor_until_timeout(dirtyWq(), dirtyUnder, 0 as *mut void, THROTTLE_NS);
        let _ = THROTTLED.fetchSubWith(1, Ordering.AcquireRelease);
        statAdd(Stat.Throttled, 1);
        i += 1;
    }
}

/// Whether a writer would be throttled now: one load, no lock.
@export("pagecache_dirty_over")
fn dirtyOverNow() -> bool => dirtyOver();

@export("pagecache_dirty_pages")
fn dirtyPages() -> u64 => DIRTY.loadWith(LoadOrdering.Relaxed);

/// Under pc->lock: whether a write-back failure was recorded after sequence `seen`; its errno and the current
/// sequence come back either way.
/// Safety: `pc` is a live cache; `err` and `now` are writable.
@export("pagecache_error_since")
unsafe fn errorSince(pc: *mut pagecache, seen: u32, err: *mut i32, now: *mut u32) -> bool {
    mutex_lock(lockOf(pc));
    let cache = Ptr.toBorrow(pc as *pagecache);
    let errOut = Ptr.toBorrowMut(err);
    *errOut = cache.wb_err;
    let nowOut = Ptr.toBorrowMut(now);
    *nowOut = cache.wb_seq;
    let newer = cache.wb_seq != seen;
    mutex_unlock(lockOf(pc));
    return newer;
}

/// The current write-back sequence alone (an opener's starting point).
/// Safety: `pc` is a live cache.
@export("pagecache_wb_seq")
unsafe fn wbSeq(pc: *mut pagecache) -> u32 {
    mutex_lock(lockOf(pc));
    let seq = Ptr.toBorrow(pc as *pagecache).wb_seq;
    mutex_unlock(lockOf(pc));
    return seq;
}

/// Drop pages entirely past `size` and zero the tail of the last page.
/// Safety: `vn` is live; its cache's lock is not held.
@export("pagecache_truncate")
unsafe fn truncateTo(vn: *mut vnode, size: u64) {
    let pc = pcOf(vn);
    let keep = pagesOf(size);
    mutex_lock(lockOf(pc));
    // The bound first, then the mappings, then the frames: a fault that takes this mutex next sees the new end, and no
    // PTE names a frame the loop below frees.
    let cache = Ptr.toBorrowMut(pc);
    cache.trim_bound = size;
    let maps = mappingsOf(pc);
    var node = List.first(maps as *list_node);
    while (!node.isNull()) {
        vm_file_map_truncate(mapOfLink(node), keep);
        node = List.next(maps as *list_node, node);
    }
    for (b in 0..32) {
        var e = headOf(pc, truncate<usize>(b));
        while (!e.isNull()) {
            let after = Ptr.toBorrow(e as *pc_entry).next;
            if (Ptr.toBorrow(e as *pc_entry).index >= keep) {
                removeEntry(pc, e);
            }
            e = after;
        }
    }
    let tail = size % PAGE_SIZE;
    if (tail != 0) {
        let e = find(pc, size / PAGE_SIZE);
        if (!e.isNull()) {
            let _ = memset(frameOf(e).add(truncate<usize>(tail)) as *mut void, 0, PAGE_BYTES - truncate<usize>(tail));
        }
    }
    mutex_unlock(lockOf(pc));
}

/// Drop every page. Returns how many were dirty; with `countLost` they are data lost (a named file's) and counted in
/// pagecache_stats.dropped_dirty; without (an unlinked file's, with no reader left) they are not, and 0 comes back.
/// Safety: `vn` is live and being released; its cache's lock is not held.
@export("pagecache_drop")
unsafe fn dropAll(vn: *mut vnode, countLost: bool) -> u32 {
    let pc = pcOf(vn);
    var lost: u32 = 0;
    mutex_lock(lockOf(pc));
    // A mapping holds a reference to the vnode, so a vnode being dropped has none; a forced unmount reaches here only
    // through the same release. The frames below are therefore at reference 1.
    check(List.isEmpty(mappingsOf(pc) as *list_node), "list_empty(&pc->mappings)");
    for (b in 0..32) {
        var e = headOf(pc, truncate<usize>(b));
        setHead(pc, truncate<usize>(b), 0 as *mut pc_entry);
        let cache = Ptr.toBorrowMut(pc);
        while (!e.isNull()) {
            let after = Ptr.toBorrow(e as *pc_entry).next;
            lruRemove(e);
            if (Ptr.toBorrow(e as *pc_entry).dirty) {
                cache.nr_dirty -= 1;
                dirtyDec(e);
                lost += 1;
            }
            cache.nr_pages -= 1;
            let _ = mountOf(e).cache_pages.fetchSubWith(1, Ordering.Relaxed);
            pageGone();
            freeFrame(e);
            e = after;
        }
    }
    if (lost != 0 && countLost) {
        statAdd(Stat.DroppedDirty, lost as u64);
    }
    mutex_unlock(lockOf(pc));
    return if (countLost) lost else 0;
}

/// The cache mutex, after the reclaim every entry to a cache runs.
/// Safety: `vn` is live; no cache lock held.
@export("pagecache_lock")
unsafe fn lockCache(vn: *mut vnode) {
    reclaimIfNeeded();
    mutex_lock(lockOf(pcOf(vn)));
}

/// Safety: `vn` is live and its cache's lock held.
@export("pagecache_unlock")
unsafe fn unlockCache(vn: *mut vnode) {
    mutex_unlock(lockOf(pcOf(vn)));
}

/// The cache half of a FILE fault: the frame for `index` with one reference taken for the caller's mapping, marking
/// the entry dirty when `dirty` (a shared write); -EFBIG at or past the end a mapping sees.
/// Safety: `vn` is live and its cache's lock held; `out` is writable.
@export("pagecache_fault_page")
unsafe fn faultPage(vn: *mut vnode, index: u64, dirty: bool, out: *mut *mut page) -> i32 {
    let pc = pcOf(vn);
    assertHeld(lockOf(pc));
    // The end of the file as a mapping sees it: the size, and the trim bound for the window between a trim and the
    // size drop that follows it. Past it get() would make a zero page, which is right for a write() and wrong for a
    // mapping (POSIX: SIGBUS).
    let size = Ptr.toBorrow(borrow mut Ptr.toBorrowMut(vn).size as *mut u64 as *AtomicU64).loadWith(
        LoadOrdering.Relaxed,
    );
    let bound = Ptr.toBorrow(pc as *pagecache).trim_bound;
    let end = if (size < bound) size else bound;
    if (index >= pagesOf(end)) {
        return -EFBIG;
    }
    var err = 0;
    let e = get(vn, index, mut err);
    if (e.isNull()) {
        return err;
    }
    if (dirty) {
        // A page the file could never write back is a SIGBUS for the store, as a write() of it is an error: this path
        // holds the cache lock without the vnode's, so it cannot write the vnode's other dirty pages first as
        // pagecache_write does.
        err = mayDirty(vn, e);
        if (err != 0) {
            return err;
        }
        markDirty(pc, e);
    }
    let p = Ptr.toBorrow(e as *pc_entry).page;
    pmm_page_get(p); // the mapping's reference, taken under the mutex reclaim decides under
    let slot = Ptr.toBorrowMut(out);
    *slot = p;
    return 0;
}

/// Fill `buf` (4 KiB) with page `index` through the cache (used by filesystems that keep directories in file data).
/// Safety: `vn` is live; `buf` holds a page; no cache lock held.
@export("pagecache_get_page")
unsafe fn getPage(vn: *mut vnode, index: u64, buf: *mut void) -> i32 {
    reclaimIfNeeded();
    let lock = lockOf(pcOf(vn));
    mutex_lock(lock);
    var err = 0;
    let e = get(vn, index, mut err);
    if (!e.isNull()) {
        let _ = memcpy(buf, frameOf(e) as *void, PAGE_BYTES);
    }
    mutex_unlock(lock);
    return if (e.isNull()) err else 0;
}

/// A whole page, dirty.
/// Safety: `vn` is live; `buf` holds a page; no cache lock held.
@export("pagecache_put_page")
unsafe fn putPage(vn: *mut vnode, index: u64, buf: *void) -> i32 {
    reclaimIfNeeded();
    let pc = pcOf(vn);
    let lock = lockOf(pc);
    mutex_lock(lock);
    var err = 0;
    let e = get(vn, index, mut err);
    if (!e.isNull()) {
        err = mayDirty(vn, e);
        if (err != 0) {
            mutex_unlock(lock);
            return err;
        }
        let _ = memcpy(frameOf(e) as *mut void, buf, PAGE_BYTES);
        markDirty(pc, e);
        if (!List.isEmpty(mappingsOf(pc) as *list_node)) {
            syncExecMappings(pc, e);
        }
    }
    mutex_unlock(lock);
    return if (e.isNull()) err else 0;
}

/// Safety: `out` is writable.
@export("pagecache_get_stats")
unsafe fn getStats(out: *mut pagecache_stats) {
    var guard = STATS.lock();
    let s = guard.data();
    let o = Ptr.toBorrowMut(out);
    o.hits = s.hits;
    o.misses = s.misses;
    o.writebacks = s.writebacks;
    o.pages = s.pages;
    o.reclaimed = s.reclaimed;
    o.budget_refusals = s.budgetRefusals;
    o.wb_errors = s.wbErrors;
    o.dropped_dirty = s.droppedDirty;
    o.pinned_skips = s.pinnedSkips;
    o.exec_syncs = s.execSyncs;
    o.throttled = s.throttled;
}
