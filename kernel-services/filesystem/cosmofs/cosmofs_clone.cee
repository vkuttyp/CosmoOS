// cosmofs_clone.cee - Writable clones of a snapshot (docs/kernel-services/filesystem/cosmofs/design.md, "Clones"), in
// CeeSafe: roadmap 2.0 SA7. tests/host/test_cfsclone.c holds it to the digest of the C it replaced.
//
// A clone starts as its origin snapshot's tree and is written through the same copy-on-write paths as the live tree:
// an operation on a clone's vnode enters the clone, which swaps its roots into the in-memory superblock for the length
// of the operation (under fs->lock, which every such operation holds), and leaves it, keeping what moved. A commit
// publishes the roots into the clone's list entry.
//
// What a clone owns is exact. A block it frees is either its origin's -- the origin's tree reaches it, the origin
// keeps it -- or one the clone was born with, freed outright; nothing of the live tree's history applies, since the
// live tree never reaches a block a clone allocated. The test is the origin's tree itself, walked once into a set: the
// origin is a snapshot and does not change. An origin cannot be deleted while it has a clone, so the set stays true;
// deleting a clone frees exactly the blocks its tree reaches and the origin's does not.
//
// struct cfs, its clones and the snapshot entries stay C (cosmofs_internal.h, cosmofs_format.h). A snapshot entry the
// C kept on the stack is kept in a zeroed slot of words, checked against its C size (tests/host/test_cfsclone.c): a
// CeeSafe local cannot hold C state.

@header("cosmofs_internal.h")
extern "C" {
    struct cfs_super {
        version: u32;
        imap_root: u64;
        next_ino: u64;
        inode_count: u64;
    }
    struct cfs_clone {
        id: u64;
        origin_id: u64;
        imap_root: u64;
        next_ino: u64;
        inode_count: u64;
        dirty: bool;
        origin_reach: *mut u8;
    }
    struct cfs {
        sb: cfs_super;
        gen: u64;
        nblocks: u64;
        clones: *mut cfs_clone;
        nclones: u32;
        clone_cap: u32;
        cur_clone: *mut cfs_clone;
        live_imap_root: u64;
        live_next_ino: u64;
        live_inode_count: u64;
        failed: i32;
    }
    struct cfs_snapshot {
        generation: u64;
        imap_root: u64;
        next_ino: u64;
        inode_count: u64;
        id: u64;
        origin_id: u64;
        flags: u32;
        name: [u8; 32];
    }

    fn cfs_snapshot_list(fs: *mut cfs, out: *mut cfs_snapshot, max: u32, count: *mut u32) -> i32;
    fn cfs_snapshot_find(fs: *mut cfs, name: *CChar, out: *mut cfs_snapshot) -> bool;
    fn cfs_snapshot_add_clone(fs: *mut cfs, origin: *cfs_snapshot, name: *CChar, out: *mut cfs_snapshot) -> i32;
    fn cfs_snapshot_list_cow(fs: *mut cfs) -> i32;
    fn cfs_snapshot_walk_write(
        fs: *mut cfs,
        f: extern "C" fn(*mut cfs_snapshot, *mut void) -> bool,
        arg: *mut void,
    ) -> i32;
    fn cfs_tree_walk(
        fs: *mut cfs,
        imap_root: u64,
        next_ino: u64,
        mark: extern "C" fn(*mut void, u64),
        arg: *mut void,
    ) -> i32;
    fn cfs_commit(fs: *mut cfs) -> i32;
    fn cfs_free_block_exempt(fs: *mut cfs, blk: u64);
    fn cfs_dva_lin(fs: *cfs, dva: u64) -> u64;
    fn cfs_lin_dva(fs: *cfs, lin: u64) -> u64;
    fn kzalloc(size: usize) -> *mut void;
    fn krealloc(p: *mut void, size: usize, flags: u32) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memmove(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    fn strlen(s: *CChar) -> usize;
}

// ---- errno.h and cosmofs_format.h values (asserted in tests/host/test_cfsclone.c) ----

const EIO: i32 = 5;
const ENOENT: i32 = 2;
const EINVAL: i32 = 22;
const EEXIST: i32 = 17;
const ENOMEM: i32 = 12;
const EOPNOTSUPP: i32 = 95;
const CFS_SNAP_F_CLONE: u32 = 1;
const CFS_DVA_NONE: u64 = 0xFFFFFFFFFFFFFFFF;
/// The stack slot a snapshot entry is kept in, in words (checked against its C size).
const SNAP_WORDS: usize = 16;

// ---- The C state, through its addresses ----

/// Safety: `fs` is a mounted filesystem's state.
unsafe fn fsOf(fs: *mut cfs) -> borrow mut(static) cfs => Ptr.toBorrowMut(fs);

/// Clone `i` of the filesystem.
/// Safety: `fs` is a mounted filesystem's state and `i` below its nclones.
unsafe fn cloneAt(fs: *mut cfs, i: u32) -> *mut cfs_clone => Ptr.toBorrow(fs as *cfs).clones.add(i as usize);

/// Safety: `s` is a snapshot entry.
unsafe fn entry(s: *cfs_snapshot) -> borrow(static) cfs_snapshot => Ptr.toBorrow(s);

/// A clone, given its id.
/// Safety: `fs` is a mounted filesystem's state.
@export("cfs_clone_by_id")
unsafe fn byId(fs: *mut cfs, id: u64) -> *mut cfs_clone {
    for (i in 0u32..fsOf(fs).nclones) {
        if (Ptr.toBorrow(cloneAt(fs, i) as *cfs_clone).id == id) {
            return cloneAt(fs, i);
        }
    }
    return 0 as *mut cfs_clone;
}

/// cosmofs_internal.h's cfs_clone_enter: the clone's roots in the superblock, the live tree's kept aside.
/// Safety: `fs` is a mounted filesystem's state, its lock held; `c` one of its clones.
@export("cfs_clone_enter")
unsafe fn enter(fs: *mut cfs, c: *mut cfs_clone) {
    let f = fsOf(fs);
    if (!f.cur_clone.isNull()) {
        return; // one at a time: an operation stays inside one tree
    }
    let k = Ptr.toBorrow(c as *cfs_clone);
    f.live_imap_root = f.sb.imap_root;
    f.live_next_ino = f.sb.next_ino;
    f.live_inode_count = f.sb.inode_count;
    f.sb.imap_root = k.imap_root;
    f.sb.next_ino = k.next_ino;
    f.sb.inode_count = k.inode_count;
    f.cur_clone = c;
}

/// cosmofs_internal.h's cfs_clone_leave: the clone keeps what moved; the live tree's roots come back.
/// Safety: as enter.
@export("cfs_clone_leave")
unsafe fn leave(fs: *mut cfs) {
    let f = fsOf(fs);
    let cp = f.cur_clone;
    if (cp.isNull()) {
        return;
    }
    let c = Ptr.toBorrowMut(cp);
    if (c.imap_root != f.sb.imap_root || c.next_ino != f.sb.next_ino || c.inode_count != f.sb.inode_count) {
        c.dirty = true;
    }
    c.imap_root = f.sb.imap_root;
    c.next_ino = f.sb.next_ino;
    c.inode_count = f.sb.inode_count;
    f.sb.imap_root = f.live_imap_root;
    f.sb.next_ino = f.live_next_ino;
    f.sb.inode_count = f.live_inode_count;
    f.cur_clone = 0 as *mut cfs_clone;
}

// ---- The origin's set ----

/// Bit `lin` of a set of (nblocks + 7) / 8 bytes.
/// Safety: `bits` is a set, `lin` below its filesystem's nblocks.
unsafe fn reached(bits: *u8, lin: u64) -> bool =>
    ((bits.add(truncate<usize>(lin / 8)).read() as u32 >> truncate<u32>(lin % 8)) & 1) != 0;

/// The walk's mark: a block the origin's tree reaches.
/// Safety: `arg` is a set; the walk passes linear indexes below nblocks.
@callback
unsafe fn reachInto(arg: *mut void, lin: u64) {
    let q = (arg as *mut u8).add(truncate<usize>(lin / 8));
    q.write(q.read() | truncate<u8>(1u32 << truncate<u32>(lin % 8)));
}

/// The origin's set, built on first need. Null when it cannot be: every caller then keeps the block, which leaks at
/// worst and frees nothing a tree still reaches.
/// Safety: `fs` is a mounted filesystem's state, its lock held; `c` one of its clones.
unsafe fn originReach(fs: *mut cfs, c: *mut cfs_clone) -> *u8 {
    let known = Ptr.toBorrow(c as *cfs_clone).origin_reach;
    if (!known.isNull()) {
        return known as *u8;
    }
    let size = layoutOf<cfs_snapshot>().size;
    if (size > SNAP_WORDS * 8) {
        return 0 as *u8; // the test asserts that it fits
    }
    var slot = [0u64; 16];
    let o = borrow mut slot as *mut [u64; 16] as *mut cfs_snapshot;
    let origin = Ptr.toBorrow(c as *cfs_clone).origin_id;
    var found = false;
    var total: u32 = 0;
    if (cfs_snapshot_list(fs, 0 as *mut cfs_snapshot, 0, borrow mut total as *mut u32) == 0 && total > 0) {
        let all = kmalloc(total as usize * size, 0) as *mut cfs_snapshot;
        var n: u32 = 0;
        if (!all.isNull() && cfs_snapshot_list(fs, all, total, borrow mut n as *mut u32) == 0) {
            var i: u32 = 0;
            while (i < n && !found) {
                if (entry(all.add(i as usize) as *cfs_snapshot).id == origin) {
                    memcpy(o as *mut void, all.add(i as usize) as *void, size);
                    found = true;
                }
                i += 1;
            }
        }
        kfree(all as *mut void);
    }
    if (!found) {
        return 0 as *u8;
    }
    let bits = kzalloc(truncate<usize>((fsOf(fs).nblocks + 7) / 8)) as *mut u8;
    if (bits.isNull()) {
        return 0 as *u8;
    }
    let s = entry(o as *cfs_snapshot);
    if (cfs_tree_walk(fs, s.imap_root, s.next_ino, reachInto, bits as *mut void) != 0) {
        kfree(bits as *mut void);
        return 0 as *u8;
    }
    let k = Ptr.toBorrowMut(c);
    k.origin_reach = bits;
    return bits as *u8;
}

/// cosmofs_internal.h's cfs_clone_free: a block the clone frees, kept when its origin's tree reaches it.
/// Safety: as enter.
@export("cfs_clone_free")
unsafe fn free(fs: *mut cfs, dva: u64) {
    let c = fsOf(fs).cur_clone;
    let lin = cfs_dva_lin(fs as *cfs, dva);
    if (c.isNull() || lin == CFS_DVA_NONE) {
        return;
    }
    let bits = originReach(fs, c);
    if (bits.isNull()) {
        var buffer = [0u8; 128];
        var line = TextWriter.create(mut buffer[..]);
        line.text("cosmofs: clone ");
        line.decimal(Ptr.toBorrow(c as *cfs_clone).id);
        line.text(": its origin's tree could not be walked; block ");
        line.decimal(dva);
        line.text(" kept");
        KernelLog.send(LogLevel.Warn, line);
        return;
    }
    if (reached(bits, lin)) {
        return; // the origin's: it keeps it
    }
    // The clone's own. No snapshot's tree reaches it (snapshots are of the live tree, which never does), so no
    // snapshot is asked.
    cfs_free_block_exempt(fs, dva);
}

/// cosmofs_internal.h's cfs_clones_load: the clones the snapshot list names.
/// Safety: as enter.
@export("cfs_clones_load")
unsafe fn load(fs: *mut cfs) -> i32 {
    clonesFree(fs);
    var total: u32 = 0;
    var rc = cfs_snapshot_list(fs, 0 as *mut cfs_snapshot, 0, borrow mut total as *mut u32);
    if (rc != 0 || total == 0) {
        return rc;
    }
    let size = layoutOf<cfs_snapshot>().size;
    let all = kmalloc(total as usize * size, 0) as *mut cfs_snapshot;
    if (all.isNull()) {
        return -ENOMEM;
    }
    var n: u32 = 0;
    rc = cfs_snapshot_list(fs, all, total, borrow mut n as *mut u32);
    var k: u32 = 0;
    var i: u32 = 0;
    while (rc == 0 && i < n) {
        if ((entry(all.add(i as usize) as *cfs_snapshot).flags & CFS_SNAP_F_CLONE) != 0) {
            k += 1;
        }
        i += 1;
    }
    if (rc == 0 && k > 0) {
        let clones = kzalloc(k as usize * layoutOf<cfs_clone>().size) as *mut cfs_clone;
        let f = fsOf(fs);
        f.clones = clones;
        if (clones.isNull()) {
            rc = -ENOMEM;
        }
        i = 0;
        while (rc == 0 && i < n) {
            let s = entry(all.add(i as usize) as *cfs_snapshot);
            if ((s.flags & CFS_SNAP_F_CLONE) != 0) {
                let c = Ptr.toBorrowMut(clones.add(f.nclones as usize));
                f.nclones += 1;
                c.id = s.id;
                c.origin_id = s.origin_id;
                c.imap_root = s.imap_root;
                c.next_ino = s.next_ino;
                c.inode_count = s.inode_count;
            }
            i += 1;
        }
        f.clone_cap = k;
    }
    kfree(all as *mut void);
    return rc;
}

/// cosmofs_internal.h's cfs_clones_free.
/// Safety: as enter.
@export("cfs_clones_free")
unsafe fn clonesFree(fs: *mut cfs) {
    for (i in 0u32..fsOf(fs).nclones) {
        kfree(Ptr.toBorrow(cloneAt(fs, i) as *cfs_clone).origin_reach as *mut void);
    }
    let f = fsOf(fs);
    kfree(f.clones as *mut void);
    f.clones = 0 as *mut cfs_clone;
    f.nclones = 0;
    f.clone_cap = 0;
    f.cur_clone = 0 as *mut cfs_clone;
}

// ---- Publishing ----

/// The write walk's state: the filesystem, and the entries written back this pass.
struct Publish {
    fs: *mut cfs;
    written: u32;
}

/// One entry of the write walk: a dirty clone's roots, written back.
/// Safety: `s` is a list entry, `arg` a Publish.
@callback
unsafe fn publishOne(s: *mut cfs_snapshot, arg: *mut void) -> bool {
    let p = Ptr.toBorrowMut(arg as *mut Publish);
    let e = Ptr.toBorrowMut(s);
    let c = if ((e.flags & CFS_SNAP_F_CLONE) != 0) byId(p.fs, e.id) else 0 as *mut cfs_clone;
    if (c.isNull() || !Ptr.toBorrow(c as *cfs_clone).dirty) {
        return true;
    }
    let k = Ptr.toBorrowMut(c);
    e.imap_root = k.imap_root;
    e.next_ino = k.next_ino;
    e.inode_count = k.inode_count;
    e.generation = fsOf(p.fs).gen; // the commit that publishes these roots
    k.dirty = false;
    p.written += 1;
    return false; // written back by the walk; walked again for the next
}

/// cosmofs_internal.h's cfs_clones_publish: every dirty clone's roots into its list entry.
/// Safety: as enter.
@export("cfs_clones_publish")
unsafe fn publish(fs: *mut cfs) -> i32 {
    var any = false;
    for (i in 0u32..fsOf(fs).nclones) {
        any = any || Ptr.toBorrow(cloneAt(fs, i) as *cfs_clone).dirty;
    }
    if (!any) {
        return 0;
    }
    let rc = cfs_snapshot_list_cow(fs);
    if (rc != 0) {
        return rc;
    }
    loop {
        var p = Publish { fs: fs, written: 0 };
        let walked = cfs_snapshot_walk_write(fs, publishOne, borrow mut p as *mut Publish as *mut void);
        if (walked != 0 || p.written == 0) {
            return walked;
        }
    }
}

/// cosmofs_internal.h's cfs_snapshot_has_clones.
/// Safety: as byId.
@export("cfs_snapshot_has_clones")
unsafe fn hasClones(fs: *mut cfs, id: u64) -> bool {
    for (i in 0u32..fsOf(fs).nclones) {
        if (Ptr.toBorrow(cloneAt(fs, i) as *cfs_clone).origin_id == id) {
            return true;
        }
    }
    return false;
}

/// cosmofs_internal.h's cfs_tree_roots: a list entry's tree, a clone's as it stands in memory.
/// Safety: as byId; `s` is an entry, `imap_root` and `next_ino` writable.
@export("cfs_tree_roots")
unsafe fn treeRoots(fs: *mut cfs, s: *cfs_snapshot, imap_root: *mut u64, next_ino: *mut u64) {
    let e = entry(s);
    let c = if ((e.flags & CFS_SNAP_F_CLONE) != 0) byId(fs, e.id) else 0 as *mut cfs_clone;
    if (c.isNull()) {
        imap_root.write(e.imap_root);
        next_ino.write(e.next_ino);
    } else {
        imap_root.write(Ptr.toBorrow(c as *cfs_clone).imap_root);
        next_ino.write(Ptr.toBorrow(c as *cfs_clone).next_ino);
    }
}

/// A C string, appended.
/// Safety: `s` is a C string.
unsafe fn cText(line: borrow mut TextWriter, s: *CChar) { line.bytes(Slice.fromRaw(s as *u8, strlen(s))); }

/// An entry's name.
/// Safety: `s` is an entry, its name NUL-terminated within its array.
unsafe fn nameOf(s: *cfs_snapshot) -> *CChar => borrow Ptr.toBorrow(s).name as *[u8; 32] as *CChar;

/// cosmofs_internal.h's cfs_clone_create: a clone of the snapshot `origin` named `name`, committed.
/// Safety: as enter, outside every clone; `origin` and `name` C strings; `out` null or writable.
@export("cfs_clone_create")
unsafe fn create(fs: *mut cfs, origin: *CChar, name: *CChar, out: *mut cfs_snapshot) -> i32 {
    if (fsOf(fs).sb.version < 12) {
        return -EOPNOTSUPP; // a clone is an entry of the version-12 list
    }
    let size = layoutOf<cfs_snapshot>().size;
    if (size > SNAP_WORDS * 8) {
        return -ENOMEM; // the test asserts that it fits
    }
    var oslot = [0u64; 16];
    let o = borrow mut oslot as *mut [u64; 16] as *mut cfs_snapshot;
    if (!cfs_snapshot_find(fs, origin, o)) {
        return -ENOENT;
    }
    if ((entry(o as *cfs_snapshot).flags & CFS_SNAP_F_CLONE) != 0) {
        return -EINVAL; // a clone of a clone: not in B1
    }
    if (cfs_snapshot_find(fs, name, 0 as *mut cfs_snapshot)) {
        return -EEXIST;
    }
    let csize = layoutOf<cfs_clone>().size;
    let n = fsOf(fs).nclones;
    let grown = krealloc(fsOf(fs).clones as *mut void, (n + 1) as usize * csize, 0) as *mut cfs_clone;
    if (grown.isNull()) {
        return -ENOMEM;
    }
    let f = fsOf(fs);
    f.clones = grown;
    f.clone_cap = n + 1;
    var rc = cfs_commit(fs);
    if (rc != 0) {
        return rc;
    }
    var cslot = [0u64; 16];
    let c = borrow mut cslot as *mut [u64; 16] as *mut cfs_snapshot;
    rc = cfs_snapshot_add_clone(fs, o as *cfs_snapshot, name, c);
    if (rc != 0) {
        return rc;
    }
    let made = entry(c as *cfs_snapshot);
    let t = cloneAt(fs, fsOf(fs).nclones);
    let f2 = fsOf(fs);
    f2.nclones += 1;
    memset(t as *mut void, 0, csize);
    let k = Ptr.toBorrowMut(t);
    k.id = made.id;
    k.origin_id = entry(o as *cfs_snapshot).id;
    k.imap_root = made.imap_root;
    k.next_ino = made.next_ino;
    k.inode_count = made.inode_count;
    rc = cfs_commit(fs);
    if (rc != 0 && fsOf(fs).failed == 0) {
        let f3 = fsOf(fs);
        f3.failed = rc;
        var buffer = [0u8; 128];
        var line = TextWriter.create(mut buffer[..]);
        line.text("cosmofs: a clone could not be committed (");
        line.signed(rc as i64);
        line.text("); the mount is now read-only");
        KernelLog.send(LogLevel.Error, line);
    }
    if (rc == 0) {
        if (!out.isNull()) {
            memcpy(out as *mut void, c as *void, size);
        }
        var buffer = [0u8; 160];
        var line = TextWriter.create(mut buffer[..]);
        line.text("cosmofs: clone '");
        cText(mut line, nameOf(c as *cfs_snapshot));
        line.text("' of snapshot '");
        cText(mut line, nameOf(o as *cfs_snapshot));
        line.text("' made (id ");
        line.decimal(made.id);
        line.text(")");
        KernelLog.send(LogLevel.Info, line);
    }
    return rc;
}

/// cosmofs_internal.h's cfs_clone_ready: the origin's set, built before a deletion changes anything -- -ENOMEM or
/// -EIO from here leaves the transaction untouched.
/// Safety: as enter.
@export("cfs_clone_ready")
unsafe fn ready(fs: *mut cfs, id: u64) -> i32 {
    let c = byId(fs, id);
    if (c.isNull()) {
        return -EIO;
    }
    return if (!originReach(fs, c).isNull()) 0 else -ENOMEM;
}

/// The deletion's walk: the filesystem, the origin's set, the blocks freed.
struct Deletion {
    fs: *mut cfs;
    origin: *u8;
    freed: u64;
}

/// The walk's mark: a block of the clone's tree, freed unless the origin's reaches it.
/// Safety: `arg` is a Deletion.
@callback
unsafe fn freeUnlessOrigin(arg: *mut void, lin: u64) {
    let d = Ptr.toBorrowMut(arg as *mut Deletion);
    if (reached(d.origin, lin)) {
        return;
    }
    let dva = cfs_lin_dva(d.fs as *cfs, lin);
    if (dva == CFS_DVA_NONE) {
        return;
    }
    cfs_free_block_exempt(d.fs, dva);
    d.freed += 1;
}

/// cosmofs_internal.h's cfs_clone_delete: every block the clone's tree reaches and its origin's does not goes back,
/// exempt (no snapshot's tree reaches one), in the transaction that removes the entry.
/// Safety: as enter, outside every clone; `doomed` an entry, `freed` writable.
@export("cfs_clone_delete")
unsafe fn delete(fs: *mut cfs, doomed: *cfs_snapshot, freed: *mut u64) -> i32 {
    freed.write(0);
    let c = byId(fs, entry(doomed).id);
    if (c.isNull()) {
        return -EIO;
    }
    let bits = originReach(fs, c);
    if (bits.isNull()) {
        return -EIO; // refuse rather than guess what is the origin's
    }
    var d = Deletion { fs: fs, origin: bits, freed: 0 };
    let k = Ptr.toBorrow(c as *cfs_clone);
    let rc = cfs_tree_walk(fs, k.imap_root, k.next_ino, freeUnlessOrigin, borrow mut d as *mut Deletion as *mut void);
    freed.write(d.freed);
    if (rc != 0) {
        return rc; // the caller abandons: some frees are in the transaction
    }
    kfree(k.origin_reach as *mut void);
    let f = fsOf(fs);
    let last = cloneAt(fs, f.nclones - 1);
    memmove(c as *mut void, last as *void, layoutOf<cfs_clone>().size);
    f.nclones -= 1;
    return 0;
}
