// cosmofs_scrub.cee - Read everything, before somebody needs it (docs/kernel-services/filesystem/cosmofs/design.md,
// "Scrub"), in CeeSafe: roadmap 2.0 SA7. tests/host/test_cfsscrub.c holds it to the digest of the C it replaced.
//
// Repair on read only finds what somebody reads. A scrub reads the whole filesystem through exactly the same path --
// metadata by its own header, data by the checksum its inode records -- so a copy that has rotted is found and put
// right while there is still a good one to put it right from. Nothing here has its own idea of what a correct block
// is; that would be a second implementation to keep in step.
//
// Roadmap 1.2 B2 made three changes. Every tree is read -- the live one, each snapshot's and each clone's -- and each
// block once, however many trees share it (`done`). A bad copy is rewritten only when the caller asked for repair
// (COSMOFS_SCRUB_REPAIR); otherwise the scrub writes nothing and says what a repair would do. And it is paced: at most
// `g_cosmofs_scrub_rate` blocks a second, with the mount's lock let go between windows, so a scrub of a large pool
// leaves the writers room.
//
// struct cfs, the pacing state, the set of blocks seen, the snapshot entries, the inodes and the extents stay C
// (cosmofs_internal.h, cosmofs_format.h). What the C kept on the stack is kept in zeroed slots of words, checked
// against their C sizes (tests/host/test_cfsscrub.c): a CeeSafe local cannot hold C state. The sysctl's variable,
// g_cosmofs_scrub_rate, is cosmofs_scrub_floor.c's.

@header("kernel/vfs.h", "kernel/storage.h", "kernel/timer.h", "kernel/sched.h", "kernel/wait.h", "kernel/cosmofs.h",
    "cosmofs_internal.h")
extern "C" {
    struct mount {
        fs_priv: *mut void;
    }
    struct spool {
        nmembers: u32;
    }
    struct cfs_mac {
        on: bool;
    }
    struct cfs_super {
        version: u32;
        generation: u64;
        imap_root: u64;
        next_ino: u64;
        snap_root: u64;
        rollback_root: u64;
    }
    struct cfs_memstate {
        nchunks: u32;
        alloc_root: u64;
        state_root: u64;
    }
    struct cfs {
        pool: *mut spool;
        sb_slot: u32;
        sb: cfs_super;
        nblocks: u64;
        mem: *mut cfs_memstate;
        nmembers: u32;
        lock: mutex;
        failed: i32;
        rdonly: bool;
        commits: u64;
        repairs: u64;
        mac: cfs_mac;
    }
    struct cfs_buf {
        blkno: u64;
        data: *mut u8;
    }
    struct cfs_pace {
        quota: u32;
        window_ns: u64;
        used: u32;
        window: u64;
    }
    struct cfs_bits {
        nchunks: u32;
    }
    struct cfs_snapshot {
        imap_root: u64;
        next_ino: u64;
        deadlist: u64;
        id: u64;
    }
    struct cfs_inode {
        nlink: u32;
        size: u64;
        ino: u64;
        indirect: u64;
        csum_root: u64;
    }
    struct cfs_extent {
        start: u64;
        count: u32;
        lblk: u32;
    }
    struct cosmofs_scrub_stats {
        blocks_read: u64;
        inodes: u64;
        repaired: u64;
        unrecoverable: u64;
        bad_copies: u64;
        skipped: u64;
        elapsed_ns: u64;
        rate: u64;
    }

    fn cfs_buf_get(fs: *mut cfs, blkno: u64, kind: u32, out: *mut *mut cfs_buf) -> i32;
    fn cfs_buf_put(fs: *mut cfs, b: *mut cfs_buf);
    fn cfs_buf_is_dirty(fs: *mut cfs, blkno: u64) -> bool;
    fn cfs_dva_lin(fs: *cfs, dva: u64) -> u64;
    fn cfs_dva_valid(fs: *cfs, dva: u64) -> bool;
    fn cfs_bits_alloc(m: *mut cfs_bits, bits: u64) -> i32;
    fn cfs_bits_free(m: *mut cfs_bits);
    fn cfs_bits_set(m: *mut cfs_bits, bit: u64) -> bool;
    fn cfs_mhdr_ok(mac: *cfs_mac, block: *void, dva: u64, kind: u32) -> bool;
    fn cfs_verify_all(
        fs: *mut cfs,
        dva: u64,
        buf: *mut void,
        verify: extern "C" fn(*void, *mut void) -> bool,
        arg: *mut void,
        repair: bool,
        bad: *mut u32,
        fixed: *mut u32,
    ) -> i32;
    fn cfs_data_scrub_block(
        fs: *mut cfs,
        inode: *mut cfs_inode,
        lblk: u64,
        dva: u64,
        buf: *mut void,
        repair: bool,
        bad: *mut u32,
        fixed: *mut u32,
    ) -> i32;
    fn cfs_super_ok(block: *void) -> bool;
    fn cfs_snaplist_kind(fs: *cfs) -> u32;
    fn cfs_snaplist_slots(fs: *cfs) -> u32;
    fn cfs_snaplist_next(b: *cfs_buf) -> u64;
    fn cfs_snaplist_get(fs: *cfs, b: *cfs_buf, i: u32, out: *mut cfs_snapshot) -> bool;
    fn cfs_tree_roots(fs: *mut cfs, s: *cfs_snapshot, imap_root: *mut u64, next_ino: *mut u64);
    fn cfs_inode_read_at(fs: *mut cfs, imap_root: u64, next_ino: u64, ino: u64, out: *mut cfs_inode) -> i32;
    fn cfs_map_ext(fs: *mut cfs, inode: *cfs_inode, lblk: u64, out: *mut cfs_extent) -> i32;
    fn pool_copies(p: *spool, dva: u64) -> u32;
    fn pool_copy_readable(p: *spool, dva: u64, c: u32) -> bool;
    fn pool_read_copy(p: *mut spool, dva: u64, copy: u32, buf: *mut void) -> i32;
    fn pool_write_copy(p: *mut spool, dva: u64, copy: u32, buf: *void) -> i32;
    fn clock_now_ns() -> u64;
    fn clock_since_ns(stamp: u64) -> u64;
    fn thread_sleep_ns(ns: u64);
    fn sched_yield();
    /// cosmofs_scrub_floor.c: the address of g_cosmofs_scrub_rate, the sysctl's variable (fs.scrub_rate).
    fn cfs_scrub_floor_rate() -> *mut u32;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
}

// ---- errno.h, cosmofs.h, storage.h and cosmofs_format.h values (asserted in tests/host/test_cfsscrub.c) ----

const EIO: i32 = 5;
const EINVAL: i32 = 22;
const ENOMEM: i32 = 12;
const COSMOFS_SCRUB_REPAIR: u32 = 1;
const POOL_MAX_COPIES: usize = 4;
const CFS_DVA_NONE: u64 = 0xFFFFFFFFFFFFFFFF;
const CFS_BLOCK: usize = 4096;
const CFS_MHDR_SIZE: usize = 32;
const CFS_PTRS_PER_BLOCK: usize = 508;
const CFS_INODES_PER_BLOCK: u64 = 15;
const CFS_INODE_SIZE: usize = 256;
const CFS_EXTENTS_PER_BLOCK: u32 = 253;
const CFS_MAX_EXTENTS: u32 = 4096;
const CFS_SNAP_MAX_CHAIN: u32 = 4096;
const CFS_EXT_COMPRESSED: u32 = 0x80000000;
const CFS_EXT_PSIZE_SHIFT: u32 = 16;
const CFS_EXT_PSIZE_MASK: u32 = 0xFF;
const CFS_EXT_COUNT_MASK: u32 = 0xFFFF;
const CFS_KIND_IMAP1: u32 = 1;
const CFS_KIND_IMAP0: u32 = 2;
const CFS_KIND_INODES: u32 = 3;
const CFS_KIND_ALLOCIDX: u32 = 4;
const CFS_KIND_BITMAP: u32 = 5;
const CFS_KIND_EXTENTS: u32 = 6;
const CFS_KIND_CSUMIDX: u32 = 7;
const CFS_KIND_CSUM: u32 = 8;
const CFS_KIND_DEADLIST: u32 = 10;
const CFS_KIND_ROLLBACK: u32 = 16;
const CFS_KIND_COPYSTATE: u32 = 17;
const CFS_KIND_CSUMIDX2: u32 = 18;
/// Where a block's kind is in its header (struct cfs_mhdr), and where an extent block's and a deadlist block's chain
/// pointer is in its payload.
const MHDR_KIND: usize = 4;
const CHAIN_NEXT: usize = 0;

/// The pacing window: the budget is a rate, spent a tenth of a second at a time, so a pause is never long enough to be
/// a stall of its own -- and, below ten blocks a second, one block a window of 1/rate seconds (Codex on #434: a 100 ms
/// window's minimum of one block ran a rate of 1 at 10). The resilver paces itself the same way (roadmap 1.2 B3).
const SCRUB_WINDOW_NS: u64 = 100000000;
const SCRUB_WINDOWS_PER_S: u32 = 10;

/// The stack slots C state is kept in, in words (checked against the C sizes).
const PACE_WORDS: usize = 4;
const BITS_WORDS: usize = 2;
const SNAP_WORDS: usize = 16;
const INODE_WORDS: usize = 32;
const EXTENT_WORDS: usize = 2;

// ---- The C state, through its addresses ----

/// Safety: `fs` is a mounted filesystem's state.
unsafe fn fsOf(fs: *mut cfs) -> borrow mut(static) cfs => Ptr.toBorrowMut(fs);

/// Safety: `p` is a pacing state.
unsafe fn paceOf(p: *mut cfs_pace) -> borrow mut(static) cfs_pace => Ptr.toBorrowMut(p);

/// Safety: `s` is a snapshot entry.
unsafe fn snapOf(s: *cfs_snapshot) -> borrow(static) cfs_snapshot => Ptr.toBorrow(s);

/// Safety: `i` is an inode.
unsafe fn inodeOf(i: *cfs_inode) -> borrow(static) cfs_inode => Ptr.toBorrow(i);

/// Safety: `e` is an extent.
unsafe fn extentOf(e: *cfs_extent) -> borrow(static) cfs_extent => Ptr.toBorrow(e);

/// True when the C types fit the stack slots this file keeps them in (the test asserts it; a build where they do not
/// refuses to scrub rather than overrun a slot).
fn slotsFit() -> bool =>
    layoutOf<cfs_pace>().size <= PACE_WORDS * 8 && layoutOf<cfs_bits>().size <= BITS_WORDS * 8 &&
        layoutOf<cfs_snapshot>().size <= SNAP_WORDS * 8 && layoutOf<cfs_inode>().size <= INODE_WORDS * 8 &&
        layoutOf<cfs_extent>().size <= EXTENT_WORDS * 8;

/// A held buffer's block.
/// Safety: `b` is a buffer cfs_buf_get handed out and not yet put.
unsafe fn blockOf(b: *mut cfs_buf) -> Slice<static, u8> =>
    Slice.fromRaw(Ptr.toBorrow(b as *cfs_buf).data as *u8, CFS_BLOCK);

/// Pointer `i` of a block's payload.
/// Safety: as blockOf.
unsafe fn pointerAt(b: *mut cfs_buf, i: usize) -> u64 => ByteOrder.readU64LE(blockOf(b), CFS_MHDR_SIZE + i * 8);

/// Pointer `i` of a payload copied out.
/// Safety: `p` is CFS_PTRS_PER_BLOCK pointers.
unsafe fn copiedAt(p: *mut u8, i: usize) -> u64 =>
    ByteOrder.readU64LE(Slice.fromRaw(p as *u8, CFS_PTRS_PER_BLOCK * 8), i * 8);

/// The buffer of `dva` read as `kind`, or null.
/// Safety: `fs` is a mounted filesystem's state, its lock held.
unsafe fn get(fs: *mut cfs, dva: u64, kind: u32) -> *mut cfs_buf {
    var b = 0 as *mut cfs_buf;
    if (cfs_buf_get(fs, dva, kind, borrow mut b as *mut *mut cfs_buf) != 0) {
        return 0 as *mut cfs_buf;
    }
    return b;
}

/// Blocks of `size` bytes, rounded up (wrapping, as the C did).
fn blocksOf(size: u64) -> u64 => size.wrappingAdd((CFS_BLOCK - 1) as u64) / (CFS_BLOCK as u64);

// ---- Pacing ----

/// cosmofs_internal.h's cfs_pace_init: `rate` blocks a second, from now.
/// Safety: `p` is a pacing state.
@export("cfs_pace_init")
unsafe fn paceInit(p: *mut cfs_pace, rate: u32) {
    let k = paceOf(p);
    k.quota = if (rate == 0) 0 else if (rate >= SCRUB_WINDOWS_PER_S) rate / SCRUB_WINDOWS_PER_S else 1;
    k.window_ns = if (rate == 0 || rate >= SCRUB_WINDOWS_PER_S) SCRUB_WINDOW_NS else 1000000000 / (rate as u64);
    k.used = 0;
    k.window = clock_now_ns();
}

/// cosmofs_internal.h's cfs_pace. Called with fs->lock held, and returns with it held: when this window's share is
/// spent it lets the caller's lock go for the rest of the window and takes it again. True if it let go.
/// Safety: `fs` is a mounted filesystem's state, its lock held; `p` a pacing state.
@export("cfs_pace")
unsafe fn pace(fs: *mut cfs, p: *mut cfs_pace) -> bool {
    let quota = paceOf(p).quota;
    if (quota == 0 || paceOf(p).used < quota) {
        return false;
    }
    let spent = clock_since_ns(paceOf(p).window);
    let windowNs = paceOf(p).window_ns;
    let lock = borrow mut fsOf(fs).lock as *mut mutex;
    mutex_unlock(lock);
    if (spent < windowNs) {
        // thread_sleep_ms((unsigned)...): whole milliseconds, rounded up, in an unsigned int.
        let ms = truncate<u32>((windowNs - spent + 999999) / 1000000);
        thread_sleep_ns((ms as u64) * 1000000);
    } else {
        sched_yield();
    }
    mutex_lock(lock);
    let k = paceOf(p);
    k.used = 0;
    k.window = clock_now_ns();
    return true;
}

// ---- The walk ----

struct Scrub {
    fs: *mut cfs;
    page: *mut u8;
    inodes: *mut u8; // one inode block's slots, copied out of the cache
    slots: *mut u8; // an allocation index's chunk pointers, copied out
    blocksRead: u64;
    inodeCount: u64;
    repaired: u64;
    unrecoverable: u64;
    badCopies: u64;
    skipped: u64;
    repair: bool;
    pace: *mut cfs_pace; // fs.scrub_rate
    commits: u64; // fs->commits when the walk last looked
    done: *mut cfs_bits; // blocks verified (linear numbers)
    stop: bool; // stop walking: `err` says why
    err: i32; // -EIO: the transaction was abandoned during a pause; -ENOMEM
}

/// The one place the lock is let go. Called only where the walk holds no buffer, so nothing it holds can go stale;
/// what it has *copied* -- an inode, a snapshot's roots -- can, if a commit ran meanwhile, and the answer says so: the
/// caller reads it again. A block freed by that commit is not handed out again before the commit after it (design.md,
/// "Commit"), so a copy taken in this generation never leads to a block that has become something else.
/// Safety: `s.fs` is a mounted filesystem's state, its lock held.
unsafe fn paused(s: borrow mut Scrub) -> bool {
    if (!pace(s.fs, s.pace)) {
        return false;
    }
    let f = fsOf(s.fs);
    if (f.failed != 0) {
        s.stop = true;
        s.err = -EIO;
    }
    let moved = f.commits != s.commits;
    s.commits = f.commits;
    return moved;
}

/// True the first time this scrub meets `dva`.
/// Safety: as paused.
unsafe fn firstVisit(s: borrow mut Scrub, dva: u64) -> bool {
    let lin = cfs_dva_lin(s.fs as *cfs, dva);
    if (lin == CFS_DVA_NONE) {
        return true; // not a block of the pool: the verifier says so
    }
    return !cfs_bits_set(s.done, lin);
}

/// Safety: `s.pace` is a pacing state.
unsafe fn tally(s: borrow mut Scrub, rc: i32, bad: u32, fixed: u32) {
    if (rc == -ENOMEM) {
        // Not a finding about the disk: the scrub could not look. It stops and says so rather than call the block
        // unrecoverable (Codex on #433).
        s.err = -ENOMEM;
        s.stop = true;
        return;
    }
    s.blocksRead += 1;
    let p = paceOf(s.pace);
    p.used = p.used.wrappingAdd(1);
    if (rc != 0) {
        s.unrecoverable += 1;
    }
    s.badCopies += bad as u64;
    s.repaired += fixed as u64;
}

/// What a metadata block's copies must be.
struct MetaWant {
    mac: *cfs_mac;
    dva: u64;
    kind: u32;
    alt: u32; // a second kind the block may be, or 0
}

/// cfs_verify_all's test of one copy.
/// Safety: `arg` is a MetaWant, `block` a block.
@callback
unsafe fn metaOk(block: *void, arg: *mut void) -> bool {
    let w = Ptr.toBorrow(arg as *MetaWant);
    return cfs_mhdr_ok(w.mac, block, w.dva, w.kind) || (w.alt != 0 && cfs_mhdr_ok(w.mac, block, w.dva, w.alt));
}

/// One metadata block, every copy of it: of kind `kind` or `alt`.
/// Safety: as paused.
unsafe fn metaEither(s: borrow mut Scrub, dva: u64, kind: u32, alt: u32) {
    let fs = s.fs;
    if (dva == 0 || !cfs_dva_valid(fs as *cfs, dva)) {
        return;
    }
    // A block the open transaction wrote is in memory only: its device copies are whatever the block held before, and
    // checking them would call a sound block unrecoverable -- or pass it by the luck of a stale block with the same
    // address and kind. The commit writes it; the next scrub reads it.
    if (cfs_buf_is_dirty(fs, dva)) {
        s.skipped += 1;
        return;
    }
    if (!firstVisit(mut s, dva)) {
        return;
    }
    var want = MetaWant { mac: borrow fsOf(fs).mac as *cfs_mac, dva: dva, kind: kind, alt: alt };
    var bad: u32 = 0;
    var fixed: u32 = 0;
    let rc = cfs_verify_all(
        fs,
        dva,
        s.page as *mut void,
        metaOk,
        borrow mut want as *mut MetaWant as *mut void,
        s.repair,
        borrow mut bad as *mut u32,
        borrow mut fixed as *mut u32,
    );
    tally(mut s, rc, bad, fixed);
}

/// Safety: as paused.
unsafe fn meta(s: borrow mut Scrub, dva: u64, kind: u32) { metaEither(mut s, dva, kind, 0); }

/// A checksum tree, one level or (version 14) two: every block's copies. Each block's copies are verified before the
/// cached read that finds its children: on a writable mirror that read repairs a bad first copy, and the scrub would
/// neither count it nor say it was repaired (Codex on #447). The root may be either shape.
/// Safety: as paused.
unsafe fn csum(s: borrow mut Scrub, blk: u64, depth: u32) {
    let fs = s.fs;
    let version = fsOf(fs).sb.version;
    if (depth != 0) {
        meta(mut s, blk, CFS_KIND_CSUMIDX);
    } else {
        metaEither(mut s, blk, CFS_KIND_CSUMIDX, if (version >= 14) CFS_KIND_CSUMIDX2 else 0);
    }
    if (s.stop) {
        return;
    }
    let idx = get(fs, blk, if (depth != 0) CFS_KIND_CSUMIDX else 0);
    if (idx.isNull()) {
        return;
    }
    let kind = ByteOrder.readU32LE(blockOf(idx), MHDR_KIND);
    let two = depth == 0 && kind == CFS_KIND_CSUMIDX2 && version >= 14;
    if (!two && kind != CFS_KIND_CSUMIDX) {
        cfs_buf_put(fs, idx);
        return;
    }
    let bytes = CFS_PTRS_PER_BLOCK * 8;
    let slots = kmalloc(bytes, 0) as *mut u8;
    if (!slots.isNull()) {
        memcpy(slots as *mut void, Ptr.toBorrow(idx as *cfs_buf).data.add(CFS_MHDR_SIZE) as *void, bytes);
    }
    cfs_buf_put(fs, idx);
    if (slots.isNull()) {
        tally(mut s, -ENOMEM, 0, 0); // the tree's blocks unread: the scrub stops and says so (Codex on #447)
        return;
    }
    for (i in 0..CFS_PTRS_PER_BLOCK) {
        if (s.stop) {
            break;
        }
        let slot = copiedAt(slots, i);
        if (slot == 0) {
            continue;
        }
        if (two) {
            csum(mut s, slot, 1);
        } else {
            meta(mut s, slot, CFS_KIND_CSUM);
        }
    }
    kfree(slots as *mut void);
}

/// Safety: as paused; `inode` an inode.
unsafe fn data(s: borrow mut Scrub, inode: *mut cfs_inode, lblk: u64, dva: u64) {
    if (!firstVisit(mut s, dva)) {
        return;
    }
    var bad: u32 = 0;
    var fixed: u32 = 0;
    let rc = cfs_data_scrub_block(
        s.fs,
        inode,
        lblk,
        dva,
        s.page as *mut void,
        s.repair,
        borrow mut bad as *mut u32,
        borrow mut fixed as *mut u32,
    );
    tally(mut s, rc, bad, fixed);
}

/// Both superblock slots on every device of member 0. The root is the one block whose loss costs everything, and the
/// one block no mount can have checked across copies -- the copies are not known until it has been read. A slot no
/// copy holds a superblock in is the unused slot of a freshly formatted filesystem, not damage.
/// Safety: as paused.
unsafe fn supers(s: borrow mut Scrub) {
    let fs = s.fs;
    let pool = fsOf(fs).pool;
    let copies = pool_copies(pool as *spool, 0);
    let good = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (good.isNull()) {
        s.err = -ENOMEM;
        s.stop = true;
        return;
    }
    var buffer = [0u8; 128];
    for (slot in 0u32..2) {
        let dva = slot as u64;
        var bad = [false; 4];
        var nbad: u32 = 0;
        var best: i32 = -1;
        var newest: u64 = 0;
        for (c in 0u32..copies) {
            if (!pool_copy_readable(pool as *spool, dva, c)) {
                continue; // not ONLINE: holds nothing yet, good or bad (CF26)
            }
            if (pool_read_copy(pool, dva, c, s.page as *mut void) == 0 && cfs_super_ok(s.page as *void)) {
                let g = Ptr.toBorrow(s.page as *cfs_super).generation;
                if (best < 0 || g > newest) {
                    newest = g;
                    best = truncate<i32>(c);
                    memcpy(good as *mut void, s.page as *void, CFS_BLOCK);
                }
                continue;
            }
            bad[c as usize] = true;
            nbad += 1;
        }
        if (best < 0) {
            // No copy holds one. A never-written slot of a young pool; but the slot this mount's root came from was
            // written, and then it is lost, not unused (Codex on #434).
            if (slot == fsOf(fs).sb_slot) {
                var line = TextWriter.create(mut buffer[..]);
                line.text("cosmofs: superblock slot ");
                line.decimal(slot as u64);
                line.text(", the mounted root's, verifies on no copy");
                KernelLog.send(LogLevel.Error, line);
                tally(mut s, -EIO, 0, 0);
            }
            continue;
        }
        let _ = firstVisit(mut s, dva);
        var fixed: u32 = 0;
        if (nbad != 0 && s.repair) {
            for (c in 0u32..copies) {
                if (bad[c as usize] && pool_write_copy(pool, dva, c, good as *void) == 0) {
                    fixed += 1;
                }
            }
            let f = fsOf(fs);
            f.repairs += fixed as u64;
        }
        if (nbad != 0) {
            var line = TextWriter.create(mut buffer[..]);
            line.text("cosmofs: superblock slot ");
            line.decimal(slot as u64);
            line.text(": ");
            line.decimal(nbad as u64);
            line.text(" of ");
            line.decimal(copies as u64);
            line.text(" copies bad, ");
            line.decimal(fixed as u64);
            line.text(" rewritten from copy ");
            line.signed(best as i64);
            KernelLog.send(LogLevel.Warn, line);
        }
        tally(mut s, 0, nbad, fixed);
    }
    kfree(good as *mut void);
}

/// Every allocation index and bitmap block: the map of what is in use is the one thing whose loss costs the whole
/// filesystem.
/// Safety: as paused.
unsafe fn alloc(s: borrow mut Scrub) {
    let fs = s.fs;
    for (v in 0u32..fsOf(fs).nmembers) {
        if (s.stop) {
            break;
        }
        let member = fsOf(fs).mem.add(v as usize);
        // The chunk pointers copied out, so the lock can go between bitmap blocks (Codex on #434: a large member's
        // whole map was read in one hold); copied again after a commit, which moves the chunks it rewrote.
        var copied: u64 = 0;
        var c: u32 = 0;
        while (c < Ptr.toBorrow(member as *cfs_memstate).nchunks && !s.stop) {
            if (c == 0 || fsOf(fs).commits != copied) {
                let root = Ptr.toBorrow(member as *cfs_memstate).alloc_root;
                meta(mut s, root, CFS_KIND_ALLOCIDX);
                let idx = get(fs, root, CFS_KIND_ALLOCIDX);
                if (idx.isNull()) {
                    break;
                }
                memcpy(
                    s.slots as *mut void,
                    Ptr.toBorrow(idx as *cfs_buf).data.add(CFS_MHDR_SIZE) as *void,
                    CFS_PTRS_PER_BLOCK * 8,
                );
                cfs_buf_put(fs, idx);
                copied = fsOf(fs).commits;
            }
            meta(mut s, copiedAt(s.slots, c as usize), CFS_KIND_BITMAP);
            let _ = paused(mut s);
            c += 1;
        }
        // And the record of the member's copies (version 13), which a mount reads before anything else of the
        // member's.
        let stateRoot = Ptr.toBorrow(member as *cfs_memstate).state_root;
        if (!s.stop && stateRoot != 0) {
            meta(mut s, stateRoot, CFS_KIND_COPYSTATE);
        }
    }
}

/// The snapshot with the lowest id above `after` (`want`: that one id exactly), its blocks of the list scrubbed on the
/// way. Found again from the head every time, because the walk lets the lock go between snapshots and the list may
/// have changed -- and by id, not by place, because a deletion meanwhile moves every later entry up one and a walk by
/// place skips the next (Codex on #434). Ids are unique and never reused (CF18), so "the next id" is a stable cursor.
/// A list is a few blocks, so the walks cost little.
/// Safety: as paused; `out` a snapshot entry.
unsafe fn snapshotFind(s: borrow mut Scrub, after: u64, want: u64, out: *mut cfs_snapshot) -> bool {
    let fs = s.fs;
    var blk = fsOf(fs).sb.snap_root;
    var guard: u32 = 0;
    let slots = cfs_snaplist_slots(fs as *cfs);
    var found = false;
    var slot = [0u64; 16];
    let sn = borrow mut slot as *mut [u64; 16] as *mut cfs_snapshot;
    while (blk != 0 && guard < CFS_SNAP_MAX_CHAIN) {
        guard += 1;
        meta(mut s, blk, cfs_snaplist_kind(fs as *cfs));
        let b = get(fs, blk, cfs_snaplist_kind(fs as *cfs));
        if (b.isNull()) {
            return found;
        }
        let next = cfs_snaplist_next(b as *cfs_buf);
        for (i in 0u32..slots) {
            if (!cfs_snaplist_get(fs as *cfs, b as *cfs_buf, i, sn) || snapOf(sn as *cfs_snapshot).id == 0) {
                continue;
            }
            let id = snapOf(sn as *cfs_snapshot).id;
            let take = if (want != 0) id == want else id > after && (!found || id < snapOf(out as *cfs_snapshot).id);
            if (take) {
                memcpy(out as *mut void, sn as *void, layoutOf<cfs_snapshot>().size);
                found = true;
            }
        }
        cfs_buf_put(fs, b);
        blk = next;
    }
    return found;
}

/// The roots of a tree, now.
struct Roots {
    imapRoot: u64;
    nextIno: u64;
}

/// The roots of tree `id` (0: the live tree), now. False when the snapshot was deleted while the scrub paused.
/// Safety: as paused.
unsafe fn treeRoots(s: borrow mut Scrub, id: u64, roots: borrow mut Roots) -> bool {
    let fs = s.fs;
    if (id == 0) {
        roots.imapRoot = fsOf(fs).sb.imap_root;
        roots.nextIno = fsOf(fs).sb.next_ino;
        return true;
    }
    var slot = [0u64; 16];
    let sn = borrow mut slot as *mut [u64; 16] as *mut cfs_snapshot;
    if (!snapshotFind(mut s, 0, id, sn)) {
        return false; // deleted while the scrub paused
    }
    var root: u64 = 0;
    var nextIno: u64 = 0;
    cfs_tree_roots(fs, sn as *cfs_snapshot, borrow mut root as *mut u64, borrow mut nextIno as *mut u64); // a clone's
    // move with the open transaction
    roots.imapRoot = root;
    roots.nextIno = nextIno;
    return true;
}

/// Safety: as paused; `inode` an inode.
unsafe fn inodeAgain(s: borrow mut Scrub, id: u64, ino: u64, inode: *mut cfs_inode) -> bool {
    var roots = Roots { imapRoot: 0, nextIno: 0 };
    if (!treeRoots(mut s, id, mut roots)) {
        return false;
    }
    return cfs_inode_read_at(s.fs, roots.imapRoot, roots.nextIno, ino, inode) == 0;
}

/// One inode's own trees and its data blocks.
/// Safety: as paused; `from` an inode.
unsafe fn inode(s: borrow mut Scrub, id: u64, from: *cfs_inode) {
    let fs = s.fs;
    var slot = [0u64; 32];
    let inode = borrow mut slot as *mut [u64; 32] as *mut cfs_inode;
    memcpy(inode as *mut void, from as *void, layoutOf<cfs_inode>().size);
    s.inodeCount += 1;
    var next = inodeOf(inode as *cfs_inode).indirect;
    var guard: u32 = 0;
    while (next != 0 && guard < CFS_MAX_EXTENTS / CFS_EXTENTS_PER_BLOCK + 2) {
        guard += 1;
        meta(mut s, next, CFS_KIND_EXTENTS);
        let b = get(fs, next, CFS_KIND_EXTENTS);
        if (b.isNull()) {
            break;
        }
        next = ByteOrder.readU64LE(blockOf(b), CFS_MHDR_SIZE + CHAIN_NEXT);
        cfs_buf_put(fs, b);
    }
    let csumRoot = inodeOf(inode as *cfs_inode).csum_root;
    if (csumRoot != 0) {
        csum(mut s, csumRoot, 0);
    }
    var eslot = [0u64; 2];
    let e = borrow mut eslot as *mut [u64; 2] as *mut cfs_extent;
    var blocks = blocksOf(inodeOf(inode as *cfs_inode).size);
    var lblk: u64 = 0;
    while (lblk < blocks && !s.stop) {
        let rc = cfs_map_ext(fs, inode as *cfs_inode, lblk, e);
        if (rc != 1) {
            lblk += 1; // a hole, or a mapping that could not be read
            continue;
        }
        let x = extentOf(e as *cfs_extent);
        let compressed = (x.count & CFS_EXT_COMPRESSED) != 0;
        if (compressed) {
            // A record's checksums cover its physical blocks, so those are what is checked -- once for the record,
            // not once per logical block it holds.
            let count = x.count & CFS_EXT_COUNT_MASK;
            let psize = ((x.count >> CFS_EXT_PSIZE_SHIFT) & CFS_EXT_PSIZE_MASK) + 1;
            let first = x.lblk;
            let start = x.start;
            for (i in 0u32..psize) {
                data(mut s, inode, first.wrappingAdd(i) as u64, start.wrappingAdd(i as u64));
            }
            lblk = first.wrappingAdd(count) as u64;
        } else {
            data(mut s, inode, lblk, x.start.wrappingAdd(lblk.wrappingSub(x.lblk as u64)));
            lblk += 1;
        }
        if (paused(mut s) && !inodeAgain(mut s, id, inodeOf(inode as *cfs_inode).ino, inode)) {
            return; // gone, or no longer what it was: its blocks were someone else's to scrub
        }
        blocks = blocksOf(inodeOf(inode as *cfs_inode).size);
    }
}

/// Where the walk of a tree goes after inode block `bi`.
const TREE_DONE: u64 = 0xFFFFFFFFFFFFFFFF;

/// Inode block `bi` of tree `id`: its map's blocks and every inode in it. The next block's number, or TREE_DONE.
/// Safety: as paused.
unsafe fn treeBlock(s: borrow mut Scrub, id: u64, bi: u64) -> u64 {
    let fs = s.fs;
    var roots = Roots { imapRoot: 0, nextIno: 0 };
    if (!treeRoots(mut s, id, mut roots) || bi * CFS_INODES_PER_BLOCK >= roots.nextIno || roots.imapRoot == 0) {
        return TREE_DONE;
    }
    let root = roots.imapRoot;
    let perBlock = CFS_PTRS_PER_BLOCK as u64;
    if (bi / perBlock >= perBlock) {
        return TREE_DONE; // past the last inode a two-level map can name
    }
    meta(mut s, root, CFS_KIND_IMAP1);
    let b1 = get(fs, root, CFS_KIND_IMAP1);
    if (b1.isNull()) {
        return TREE_DONE;
    }
    let l0 = pointerAt(b1, truncate<usize>(bi / perBlock));
    cfs_buf_put(fs, b1);
    if (l0 == 0) {
        return (bi / perBlock + 1) * perBlock; // the next l0's first
    }
    meta(mut s, l0, CFS_KIND_IMAP0);
    let b0 = get(fs, l0, CFS_KIND_IMAP0);
    if (b0.isNull()) {
        return bi + 1;
    }
    let ib = pointerAt(b0, truncate<usize>(bi % perBlock));
    cfs_buf_put(fs, b0);
    if (ib == 0) {
        return bi + 1;
    }
    meta(mut s, ib, CFS_KIND_INODES);
    let bib = get(fs, ib, CFS_KIND_INODES);
    if (bib.isNull()) {
        return bi + 1;
    }
    let per = truncate<usize>(CFS_INODES_PER_BLOCK);
    memcpy(
        s.inodes as *mut void,
        Ptr.toBorrow(bib as *cfs_buf).data.add(CFS_MHDR_SIZE) as *void,
        per * CFS_INODE_SIZE,
    );
    cfs_buf_put(fs, bib);
    for (k in 0..per) {
        if (s.stop) {
            break;
        }
        let copied = fsOf(fs).commits;
        let one = s.inodes.add(k * CFS_INODE_SIZE) as *cfs_inode;
        if (inodeOf(one).nlink == 0 || inodeOf(one).ino == 0) {
            continue;
        }
        inode(mut s, id, one);
        // The lock went during that inode and a commit came: the rest of the block's copies may name what is now
        // another file's (Codex on #434). Each is read again by number.
        if (fsOf(fs).commits != copied && k + 1 < per) {
            var now = Roots { imapRoot: 0, nextIno: 0 };
            let have = treeRoots(mut s, id, mut now);
            for (j in (k + 1)..per) {
                let other = s.inodes.add(j * CFS_INODE_SIZE) as *mut cfs_inode;
                let ino = bi * CFS_INODES_PER_BLOCK + (j as u64);
                if (!have || cfs_inode_read_at(fs, now.imapRoot, now.nextIno, ino, other) != 0) {
                    memset(other as *mut void, 0, layoutOf<cfs_inode>().size); // gone, or not readable now: skipped
                }
            }
        }
    }
    let _ = paused(mut s);
    return bi + 1;
}

/// Every block of one tree's inode map and every inode in it, one inode block at a time: the lock may go between
/// them, and the next is found from the roots as they are then. Walking the map rather than reading inodes by number
/// is what lets each imap and inode block be checked on *every* copy: an ordinary read stops at the first copy that
/// verifies.
/// Safety: as paused.
unsafe fn tree(s: borrow mut Scrub, id: u64) {
    var bi: u64 = 0;
    while (!s.stop) {
        bi = treeBlock(mut s, id, bi);
        if (bi == TREE_DONE) {
            return;
        }
    }
}

/// The snapshot list, every deadlist, and every snapshot's and clone's tree. A snapshot shares most of its blocks with
/// the live tree; `done` reads each of those once.
/// Safety: as paused.
unsafe fn snapshots(s: borrow mut Scrub) {
    let fs = s.fs;
    var slot = [0u64; 16];
    let sn = borrow mut slot as *mut [u64; 16] as *mut cfs_snapshot;
    var last: u64 = 0;
    while (!s.stop && snapshotFind(mut s, last, 0, sn)) {
        var dead = snapOf(sn as *cfs_snapshot).deadlist;
        var guard: u32 = 0;
        while (dead != 0 && guard < CFS_SNAP_MAX_CHAIN) {
            guard += 1;
            meta(mut s, dead, CFS_KIND_DEADLIST);
            let db = get(fs, dead, CFS_KIND_DEADLIST);
            if (db.isNull()) {
                break;
            }
            dead = ByteOrder.readU64LE(blockOf(db), CFS_MHDR_SIZE + CHAIN_NEXT);
            cfs_buf_put(fs, db);
        }
        let _ = paused(mut s);
        let id = snapOf(sn as *cfs_snapshot).id;
        tree(mut s, id);
        last = id;
    }
}

/// kernel/cosmofs.h's cosmofs_scrub: the whole filesystem, in the order a mount would need it: the allocation maps,
/// the live tree, the snapshots and clones.
/// Safety: `mnt` is a mount; `out` null or a stats record.
@export("cosmofs_scrub")
unsafe fn scrub(mnt: *mut mount, out: *mut cosmofs_scrub_stats, flags: u32) -> i32 {
    let fs = Ptr.toBorrow(mnt as *mount).fs_priv as *mut cfs;
    if (fs.isNull() || !slotsFit()) {
        return -EINVAL;
    }
    var paceSlot = [0u64; 4];
    let p = borrow mut paceSlot as *mut [u64; 4] as *mut cfs_pace;
    var bitsSlot = [0u64; 2];
    let done = borrow mut bitsSlot as *mut [u64; 2] as *mut cfs_bits;
    let rate = Ptr.toBorrow(cfs_scrub_floor_rate() as *AtomicU32).loadWith(LoadOrdering.Relaxed);
    paceInit(p, rate);
    var s = Scrub {
        fs: fs,
        page: kmalloc(CFS_BLOCK, 0) as *mut u8,
        slots: kmalloc(CFS_PTRS_PER_BLOCK * 8, 0) as *mut u8,
        inodes: kmalloc(truncate<usize>(CFS_INODES_PER_BLOCK) * CFS_INODE_SIZE, 0) as *mut u8,
        blocksRead: 0,
        inodeCount: 0,
        repaired: 0,
        unrecoverable: 0,
        badCopies: 0,
        skipped: 0,
        repair: (flags & COSMOFS_SCRUB_REPAIR) != 0 && !fsOf(fs).rdonly,
        pace: p,
        commits: 0,
        done: done,
        stop: false,
        err: 0,
    };
    let t0 = clock_now_ns();

    let lock = borrow mut fsOf(fs).lock as *mut mutex;
    mutex_lock(lock);
    var rc = if (fsOf(fs).failed != 0) -EIO else 0;
    if (rc == 0 &&
        (s.page.isNull() || s.inodes.isNull() || s.slots.isNull() || cfs_bits_alloc(done, fsOf(fs).nblocks) != 0)) {
        rc = -ENOMEM; // before the walk, never half way through it
    }
    if (rc == 0) {
        let k = paceOf(p);
        k.window = clock_now_ns();
        s.commits = fsOf(fs).commits;
        supers(mut s);
        alloc(mut s);
        // Version 12's rollback record: metadata like the list.
        let rollbackRoot = fsOf(fs).sb.rollback_root;
        if (fsOf(fs).sb.version >= 12 && rollbackRoot != 0) {
            meta(mut s, rollbackRoot, CFS_KIND_ROLLBACK);
        }
        tree(mut s, 0);
        snapshots(mut s);
        if (s.stop) {
            rc = s.err; // abandoned during a pause, or no memory to look
        }
    }
    mutex_unlock(lock);
    cfs_bits_free(done);
    kfree(s.page as *mut void);
    kfree(s.inodes as *mut void);
    kfree(s.slots as *mut void);
    if (rc != 0) {
        return rc;
    }
    let elapsed = clock_since_ns(t0);
    var buffer = [0u8; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("cosmofs: scrub read ");
    line.decimal(s.blocksRead);
    line.text(" blocks over ");
    line.decimal(s.inodeCount);
    line.text(" inodes: ");
    line.decimal(s.badCopies);
    line.text(" bad copies, ");
    line.decimal(s.repaired);
    line.text(" repaired, ");
    line.decimal(s.unrecoverable);
    line.text(" unrecoverable, ");
    line.decimal(s.skipped);
    line.text(" skipped (");
    line.decimal(elapsed / 1000000);
    line.text(" ms, ");
    line.decimal(rate as u64);
    line.text(" blocks/s bound)");
    KernelLog.send(LogLevel.Info, line);
    if (!out.isNull()) {
        let o = Ptr.toBorrowMut(out);
        o.blocks_read = s.blocksRead;
        o.inodes = s.inodeCount;
        o.repaired = s.repaired;
        o.unrecoverable = s.unrecoverable;
        o.bad_copies = s.badCopies;
        o.skipped = s.skipped;
        o.elapsed_ns = elapsed;
        o.rate = rate as u64;
    }
    // A block no copy could satisfy is a finding, as a check's are: the pass ran and the counts say what it found
    // (CFS-11).
    return 0;
}
