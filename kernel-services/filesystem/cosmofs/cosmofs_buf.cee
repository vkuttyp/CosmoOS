// cosmofs_buf.cee - Checksums and headers, and the buffer cache, in CeeSafe: roadmap 2.0 SA7.
// tests/host/test_cfsbuf.c holds it to the digest of the C it replaced.
//
// Every metadata block's seal and its check, the superblock's, the cache that holds blocks between the reads and the
// commit that writes them, the copy-on-write of a block, the set-aside blocks a change that must not stop half way
// takes, and the reservation the commit hands out from.
//
// Rules (docs/kernel-services/vfs/design.md): a metadata block from a committed generation is never modified in place:
// it is copied first, and the copy is sealed with the open transaction's generation.
//
// struct cfs, the buffers and the set-aside stay C (cosmofs_internal.h). The metadata MAC is this file's too: its
// domain is a C char (ADR 0080 §3.5), and its BLAKE2b state a C local (§3.4).

@header("kernel/blake2b.h", "kernel/kmalloc.h", "kernel/string.h", "cosmofs_internal.h")
extern "C" {
    struct spool {
        nmembers: u32;
    }
    struct cfs_mac {
        on: bool;
        key: [u8; 32];
    }
    struct cfs_memstate {
        first_usable: u64;
        free_blocks: u64;
    }
    struct cfs_super {
        version: u32;
        uuid: [u8; 16];
        key_root: u64;
    }
    struct cfs {
        pool: *mut spool;
        gen: u64;
        bitmap: *mut u8;
        bitmap_dirty: *mut u8;
        free_blocks: u64;
        mem: *mut cfs_memstate;
        nmembers: u32;
        bufs: list_node;
        nr_bufs: u32;
        nr_dirty: u32;
        mac: cfs_mac;
    }
    struct cfs_buf {
        link: list_node;
        blkno: u64;
        data: *mut u8;
        dirty: bool;
        refs: u32;
    }
    struct cfs_mhdr {
        magic: u32;
    }
    struct cfs_res {
        blk: *mut u64;
        n: u32;
        used: u32;
    }
    struct cfs_prep {
        n: u32;
        used: u32;
        blk: [u64; 18];
    }

    fn cfs_dva_valid(fs: *cfs, dva: u64) -> bool;
    fn cfs_dva_lin(fs: *cfs, dva: u64) -> u64;
    fn cfs_mhdr_decode(block: *void, blkno: u64, kind: u32, macOn: bool) -> u32;
    fn cfs_block_crc(block: *u8, crcAt: usize) -> u32;
    fn cfs_super_ident_ok(sb: *cfs_super) -> bool;
    fn cfs_super_crc_ok(block: *void) -> bool;
    fn cfs_keytab_mac(uuid: *u8, mac: *mut cfs_mac) -> i32;
    fn cfs_read_repair(
        fs: *mut cfs,
        dva: u64,
        buf: *mut void,
        verify: extern "C" fn(*void, *mut void) -> bool,
        arg: *mut void,
        repaired: *mut bool,
        readOk: *mut bool,
    ) -> i32;
    fn pool_read(p: *mut spool, dva: u64, buf: *mut void) -> i32;
    fn pool_write(p: *mut spool, dva: u64, buf: *void) -> i32;
    fn cfs_alloc_block(fs: *mut cfs, out: *mut u64) -> i32;
    fn cfs_alloc_run(fs: *mut cfs, cls: u32, hint: u64, want: u32, start: *mut u64, got: *mut u64) -> i32;
    fn cfs_free_block_deferred(fs: *mut cfs, blk: u64);
    fn cfs_free_block_exempt(fs: *mut cfs, blk: u64);
    fn cfs_note_dirty(fs: *mut cfs);
    fn kzalloc(size: usize) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    /// kernel/blake2b.h: a keyed BLAKE2b, its state a C struct.
    struct blake2b;
    fn blake2b_init_key(s: *mut blake2b, outlen: usize, key: *void, keylen: usize);
    fn blake2b_update(s: *mut blake2b, input: *void, n: usize);
    fn blake2b_final(s: *mut blake2b, out: *mut u8);
    // cosmofs_format.h's MAC: its size, and the domains of a header, a superblock and a label.
    const CFS_MAC_SIZE: u32 = 8;
    const CFS_MAC_HDR: u8 = 72;
    const CFS_MAC_SUPER: u8 = 83;
    const CFS_MAC_LABEL: u8 = 76;
    /// Where the CRC is, which the MAC takes as zero.
    @cvalue("offsetof(struct cfs_mhdr, crc)")
    const MHDR_CRC_AT: usize = 24;
    @cvalue("offsetof(struct cfs_super, crc)")
    const SUPER_CRC_AT: usize = 160;
}

/// Eight zero bytes, which the MAC reads in place of the CRC and the word after it.
const ZERO8: [u8; 8] = [0; 8];

/// The version-14 tag (design.md, "The metadata MAC"): a 64-bit keyed BLAKE2b over the domain byte and the block, with
/// the eight bytes at `off` -- where the CRC and the word after it were -- taken as zero.
/// Safety: `m` is a MAC with its key; `block` holds CFS_BLOCK bytes; `tag` holds CFS_MAC_SIZE.
@export("cfs_mac_tag")
unsafe fn macTag(m: *cfs_mac, domain: CChar, block: *u8, off: usize, tag: *mut u8) {
    let size = CFS_MAC_SIZE as usize;
    let d = [domain as u8];
    let zero = ZERO8;
    var s: blake2b;
    let state = borrow mut s as *mut blake2b;
    let key = borrow Ptr.toBorrow(m).key;
    blake2b_init_key(state, size, borrow key[0] as *u8 as *void, 32);
    blake2b_update(state, borrow d[0] as *u8 as *void, 1);
    blake2b_update(state, block as *void, off);
    blake2b_update(state, borrow zero[0] as *u8 as *void, size);
    blake2b_update(state, block.add(off + size) as *void, CFS_BLOCK as usize - off - size);
    blake2b_final(state, tag);
}

/// The tag at `off` is the block's. Constant time: a comparison that stops early says how much of a forgery was right.
/// Safety: as macTag.
@export("cfs_mac_ok")
unsafe fn macOk(m: *cfs_mac, domain: CChar, block: *u8, off: usize) -> bool {
    var want = [0u8; 8];
    macTag(m, domain, block, off, borrow mut want[0] as *mut u8);
    var diff: u8 = 0;
    for (i in 0..want.length) {
        diff |= want[i] ^ block.add(off + i).read();
    }
    want = [0u8; 8];
    return diff == 0;
}

/// The block's tag, written at `off`.
/// Safety: as macTag; `block` writable.
@export("cfs_mac_seal")
unsafe fn macSeal(m: *cfs_mac, domain: CChar, block: *mut u8, off: usize) {
    var tag = [0u8; 8];
    macTag(m, domain, block as *u8, off, borrow mut tag[0] as *mut u8);
    for (i in 0..tag.length) {
        block.add(off + i).write(tag[i]);
    }
}

// ---- errno.h, cosmofs_internal.h and cosmofs_format.h values (asserted in tests/host/test_cfsbuf.c) ----

const EIO: i32 = 5;
const ENOMEM: i32 = 12;
const EFBIG: i32 = 27;
const ENOSPC: i32 = 28;
const ENOKEY: i32 = 126;
const KMEM_ZERO: u32 = 1;
const CFS_DVA_NONE: u64 = 0xFFFFFFFFFFFFFFFF;
const CFS_DVA_VDEV_SHIFT: u32 = 56;
const CFS_DVA_BLK_MASK: u64 = 0x00FFFFFFFFFFFFFF;
const CFS_BLOCK: usize = 4096;
const CFS_BUF_CACHE: u32 = 64;
const CFS_PREP_MAX: u32 = 18;
const CFS_BITS_PER_BITMAP: u64 = 32512;
const CFS_MHDR_MAGIC: u32 = 0x4d534643;
const CFS_CSUM_CRC32C: u32 = 1;
const CFS_ALLOC_META: u32 = 0;
/// enum mhdr_fault (cosmofs_internal.h).
const MHDR_OK: u32 = 0;
const MHDR_MAC: u32 = 6;
/// Where things are in a header (struct cfs_mhdr) and in a superblock (struct cfs_super): checked by the test.
const MHDR_KIND: usize = 4;
const MHDR_GENERATION: usize = 8;
const MHDR_BLKNO: usize = 16;
const MHDR_CRC: usize = 24;
const MHDR_ALGO: usize = 28;
const SUPER_CRC: usize = 160;
/// Where struct cfs_prep keeps its buffers: an array of pointers, which an imported struct's field cannot be.
const PREP_BUF: usize = 152;

/// The stack slot a struct cfs_mac is kept in, in words (checked against the C size).
const MAC_WORDS: usize = 5;

// ---- The C state, through its addresses ----

/// Safety: `fs` is a mounted filesystem's state.
unsafe fn fsOf(fs: *mut cfs) -> borrow mut(static) cfs => Ptr.toBorrowMut(fs);

/// Safety: `b` is a buffer.
unsafe fn bufOf(b: *mut cfs_buf) -> borrow mut(static) cfs_buf => Ptr.toBorrowMut(b);

/// The place of set-aside buffer `i`.
/// Safety: `p` is a set-aside, `i` below CFS_PREP_MAX.
unsafe fn prepBuf(p: *mut cfs_prep, i: u32) -> *mut *mut cfs_buf =>
    ((p as *mut u8).add(PREP_BUF) as *mut *mut cfs_buf).add(i as usize);

/// Safety: `node` is a buffer's link.
unsafe fn bufOfLink(node: *mut list_node) -> *mut cfs_buf => containerOf(node, offsetOf<cfs_buf>(link)) as *mut cfs_buf;

/// Safety: `fs` is a mounted filesystem's state.
unsafe fn bufsOf(fs: *mut cfs) -> *mut list_node => borrow mut fsOf(fs).bufs as *mut list_node;

/// Safety: `b` is a buffer.
unsafe fn linkOf(b: *mut cfs_buf) -> *mut list_node => borrow mut bufOf(b).link as *mut list_node;

/// A block's bytes.
/// Safety: `block` is CFS_BLOCK writable bytes.
unsafe fn blockMut(block: *mut u8) -> SliceMut<static, u8> => SliceMut.fromRaw(block, CFS_BLOCK);

fn dvaVdev(dva: u64) -> u32 => truncate<u32>(dva >> CFS_DVA_VDEV_SHIFT);

fn dva(vdev: u32, blk: u64) -> u64 => ((vdev as u64) << CFS_DVA_VDEV_SHIFT) | (blk & CFS_DVA_BLK_MASK);

fn macWordsFit() -> bool => layoutOf<cfs_mac>().size <= MAC_WORDS * 8;

/// A broken invariant (the C's KASSERT): the kernel stops.
fn assertFailed(what: StringView) {
    var buffer = [0u8; 160];
    var line = TextWriter.create(mut buffer[..]);
    line.text("assertion failed: ");
    line.text(what);
    line.text(" (kernel-services/filesystem/cosmofs/cosmofs_buf.cee)");
    KernelLog.panic(line);
}

// ---- Checksums and headers ----

/// Seal a header: the CRC32C and its algorithm, or on a version-14 encrypted pool the tag in their place.
/// Safety: `mac` is null or a key; `block` is CFS_BLOCK writable bytes.
unsafe fn mhdrSealMac(mac: *cfs_mac, block: *mut u8, kind: u32, blkno: u64, gen: u64) {
    let b = blockMut(block);
    ByteOrder.writeU32LE(b, 0, CFS_MHDR_MAGIC);
    ByteOrder.writeU32LE(b, MHDR_KIND, kind);
    ByteOrder.writeU64LE(b, MHDR_GENERATION, gen);
    ByteOrder.writeU64LE(b, MHDR_BLKNO, blkno);
    if (!mac.isNull() && Ptr.toBorrow(mac).on) {
        macSeal(mac, CFS_MAC_HDR as CChar, block, MHDR_CRC_AT);
        return;
    }
    ByteOrder.writeU32LE(b, MHDR_ALGO, CFS_CSUM_CRC32C); // the algorithm `crc` is computed with
    ByteOrder.writeU32LE(b, MHDR_CRC, 0);
    ByteOrder.writeU32LE(b, MHDR_CRC, cfs_block_crc(block as *u8, MHDR_CRC));
}

/// A header sealed with the open transaction's generation.
/// Safety: `fs` is a mounted filesystem's state; `block` is CFS_BLOCK writable bytes.
@export("cfs_mhdr_seal")
unsafe fn mhdrSeal(fs: *mut cfs, block: *mut u8, kind: u32, blkno: u64) {
    mhdrSealMac(borrow fsOf(fs).mac as *cfs_mac, block, kind, blkno, fsOf(fs).gen);
}

/// Why a metadata block did not verify, for the message cfs_buf_get logs.
///
/// The five are very different findings and the error said only "bad metadata header or checksum" for all of them: a
/// wrong magic is a block that was never sealed as metadata, a wrong `blkno` is one block's content sitting at
/// another's address, a wrong kind is the right block misused, an unsupported csum_algo is a block checksummed by an
/// algorithm this build does not have (a format or algorithm skew, not damage), and a bad CRC is content that changed
/// after it was sealed. Chasing the writeback thread that committed during a mount needed to know which; the message
/// is kept because the next one will too. The enum is in cosmofs_internal.h. Under a MAC (version 14) the last is
/// MHDR_MAC: a tag that does not verify, which is a forgery as readily as damage.
/// Safety: `mac` is null or a key; `block` is CFS_BLOCK readable bytes.
@export("cfs_mhdr_fault_of")
unsafe fn mhdrFaultOf(mac: *cfs_mac, block: *void, blkno: u64, kind: u32) -> u32 {
    // The header's own checks are cfsparse's; a MAC needs the pool's key.
    let macOn = !mac.isNull() && Ptr.toBorrow(mac).on;
    let f = cfs_mhdr_decode(block, blkno, kind, macOn);
    if (f == MHDR_OK && macOn) {
        return if (macOk(mac, CFS_MAC_HDR as CChar, block as *u8, MHDR_CRC_AT)) MHDR_OK else MHDR_MAC;
    }
    return f;
}

/// Safety: as mhdrFaultOf.
unsafe fn mhdrCheck(mac: *cfs_mac, block: *u8, blkno: u64, kind: u32) -> i32 =>
    if (mhdrFaultOf(mac, block as *void, blkno, kind) == MHDR_OK) 0 else -EIO;

/// What a metadata block's copies must be: the verifier's argument.
struct MhdrWant {
    mac: *cfs_mac;
    dva: u64;
    kind: u32;
}

/// Safety: `mac` is null or a key; `block` is CFS_BLOCK writable bytes.
@export("cfs_mhdr_seal_raw")
unsafe fn mhdrSealRaw(mac: *cfs_mac, block: *mut void, kind: u32, dvaOf: u64, generation: u64) {
    mhdrSealMac(mac, block as *mut u8, kind, dvaOf, generation);
}

/// Safety: as mhdrFaultOf.
@export("cfs_mhdr_ok")
unsafe fn mhdrOk(mac: *cfs_mac, block: *void, dvaOf: u64, kind: u32) -> bool =>
    mhdrCheck(mac, block as *u8, dvaOf, kind) == 0;

/// Whether a superblock is sealed with the MAC: a version-14 encrypted pool's (cosmofs_format.h's cfs_super_is_mac).
/// Safety: `block` is a superblock.
unsafe fn superIsMac(block: *u8) -> bool {
    let sb = Ptr.toBorrow(block as *cfs_super);
    return sb.version >= 14 && sb.key_root != 0;
}

/// A superblock's seal: CRC32C, or the tag when it says it is a version-14 encrypted pool's.
/// Safety: `mac` is a key; `block` is CFS_BLOCK writable bytes, a superblock.
@export("cfs_super_seal")
unsafe fn superSeal(mac: *cfs_mac, block: *mut u8) {
    if (superIsMac(block as *u8)) {
        macSeal(mac, CFS_MAC_SUPER as CChar, block, SUPER_CRC_AT);
        return;
    }
    let b = blockMut(block);
    ByteOrder.writeU32LE(b, SUPER_CRC, 0);
    ByteOrder.writeU32LE(b, SUPER_CRC, cfs_block_crc(block as *u8, SUPER_CRC));
}

/// A superblock's own check: magic, a version this kernel reads, and its seal. A MAC'd one needs its pool's key from
/// the key table (`mac` is filled from it): -ENOKEY when the pool is locked. A CRC'd one is refused when a key is
/// loaded for its uuid -- a pool whose key this kernel holds does not get to stop authenticating (design.md, "The
/// metadata MAC"). -EIO for anything else that does not verify.
/// Safety: `block` is CFS_BLOCK readable bytes; `mac` null or writable.
@export("cfs_super_verify")
unsafe fn superVerify(block: *void, mac: *mut cfs_mac) -> i32 {
    let sb = block as *cfs_super;
    if (!cfs_super_ident_ok(sb) || !macWordsFit()) {
        return -EIO;
    }
    var slot = [0u64; 5];
    let m = borrow mut slot as *mut [u64; 5] as *mut cfs_mac;
    var rc = cfs_keytab_mac(borrow Ptr.toBorrow(sb).uuid as *[u8; 16] as *u8, m);
    if (superIsMac(block as *u8)) {
        if (rc != 0) {
            return -ENOKEY;
        }
        rc = if (macOk(m as *cfs_mac, CFS_MAC_SUPER as CChar, block as *u8, SUPER_CRC_AT)) 0 else -EIO;
    } else {
        rc = if (rc == 0) -EIO else if (cfs_super_crc_ok(block)) 0 else -EIO;
        let k = Ptr.toBorrowMut(m);
        k.on = false;
    }
    if (rc == 0 && !mac.isNull()) {
        memcpy(mac as *mut void, m as *void, layoutOf<cfs_mac>().size);
    }
    memset(m as *mut void, 0, layoutOf<cfs_mac>().size);
    return rc;
}

/// Safety: as superVerify.
@export("cfs_super_ok")
unsafe fn superOk(block: *void) -> bool => superVerify(block, 0 as *mut cfs_mac) == 0;

/// The verifier cfs_read_repair calls for a metadata block.
/// Safety: `arg` is an MhdrWant; `block` CFS_BLOCK readable bytes.
@callback
unsafe fn mhdrVerify(block: *void, arg: *mut void) -> bool {
    let w = Ptr.toBorrow(arg as *MhdrWant);
    return mhdrCheck(w.mac, block as *u8, w.dva, w.kind) == 0;
}

/// Safety: `b` is a buffer.
@export("cfs_buf_hdr")
unsafe fn bufHdr(b: *mut cfs_buf) -> *mut cfs_mhdr => bufOf(b).data as *mut cfs_mhdr;

/// The kind a buffer's header says.
/// Safety: `b` is a buffer.
unsafe fn kindOf(b: *mut cfs_buf) -> u32 => ByteOrder.readU32LE(Slice.fromRaw(bufOf(b).data as *u8, 64), MHDR_KIND);

/// Safety: `fs` is a mounted filesystem's state; `buf` CFS_BLOCK writable bytes.
@export("cfs_data_read")
unsafe fn dataRead(fs: *mut cfs, blk: u64, buf: *mut void) -> i32 {
    if (!cfs_dva_valid(fs as *cfs, blk)) {
        return -EIO;
    }
    return pool_read(fsOf(fs).pool, blk, buf);
}

/// Safety: `fs` is a mounted filesystem's state; `buf` CFS_BLOCK readable bytes.
@export("cfs_data_write")
unsafe fn dataWrite(fs: *mut cfs, blk: u64, buf: *void) -> i32 {
    if (!cfs_dva_valid(fs as *cfs, blk)) {
        return -EIO;
    }
    return pool_write(fsOf(fs).pool, blk, buf);
}

// ---- The buffer cache ----

/// The cached buffer of `blkno`, or null.
/// Safety: `fs` is a mounted filesystem's state, its lock held.
@export("cfs_buf_find")
unsafe fn bufFind(fs: *mut cfs, blkno: u64) -> *mut cfs_buf {
    let head = bufsOf(fs);
    var node = List.first(head as *list_node);
    while (!node.isNull()) {
        let b = bufOfLink(node);
        if (bufOf(b).blkno == blkno) {
            return b;
        }
        node = List.next(head as *list_node, node);
    }
    return 0 as *mut cfs_buf;
}

/// The least recently used clean buffer nobody holds goes, once the cache is full.
/// Safety: as bufFind.
unsafe fn bufEvictClean(fs: *mut cfs) {
    if (fsOf(fs).nr_bufs < CFS_BUF_CACHE) {
        return;
    }
    let head = bufsOf(fs);
    var node = Ptr.toBorrow(head as *list_node).prev;
    while (node as *list_node != head as *list_node) {
        let b = bufOfLink(node);
        let k = bufOf(b);
        if (!k.dirty && k.refs == 0) {
            List.remove(node);
            let f = fsOf(fs);
            f.nr_bufs -= 1;
            kfree(k.data as *mut void);
            kfree(b as *mut void);
            return;
        }
        node = Ptr.toBorrow(node as *list_node).prev;
    }
}

/// A buffer not yet in the cache: the half of cfs_buf_alloc that can fail, so a set-aside (cfs_prep_meta) can do it
/// before anything changes.
/// Safety: as bufFind.
unsafe fn bufMake(fs: *mut cfs, blkno: u64) -> *mut cfs_buf {
    // A clean buffer goes back first: memory the cache holds for nobody is what a new buffer should be made from
    // (Codex on #433).
    bufEvictClean(fs);
    let b = kzalloc(layoutOf<cfs_buf>().size) as *mut cfs_buf;
    if (b.isNull()) {
        return b;
    }
    let data = kmalloc(CFS_BLOCK, KMEM_ZERO) as *mut u8;
    if (data.isNull()) {
        kfree(b as *mut void);
        return 0 as *mut cfs_buf;
    }
    List.init(linkOf(b));
    let k = bufOf(b);
    k.data = data;
    k.blkno = blkno;
    k.refs = 1;
    return b;
}

/// And the half that cannot.
/// Safety: as bufFind; `b` is on no list.
unsafe fn bufInsert(fs: *mut cfs, b: *mut cfs_buf) {
    List.pushFront(bufsOf(fs), linkOf(b));
    let f = fsOf(fs);
    f.nr_bufs += 1;
}

/// A new buffer for `blkno`, in the cache and held, its block zero; null without memory.
/// Safety: as bufFind.
@export("cfs_buf_alloc")
unsafe fn bufAlloc(fs: *mut cfs, blkno: u64) -> *mut cfs_buf {
    let b = bufMake(fs, blkno);
    if (!b.isNull()) {
        bufInsert(fs, b);
    }
    return b;
}

/// The `why` of a header fault (enum mhdr_fault).
fn faultName(f: u32) -> StringView => match (f) {
    0 => "ok",
    1 => "magic",
    2 => "blkno",
    3 => "kind",
    4 => "algo",
    5 => "crc",
    _ => "mac",
};

/// Safety: `data` is CFS_BLOCK readable bytes.
unsafe fn logFault(fs: *mut cfs, data: *u8, blkno: u64, kind: u32) {
    // Say which of the four checks failed and what it found: "bad header or checksum" covers four different faults
    // with four different causes.
    let h = Slice.fromRaw(data, CFS_BLOCK);
    let f = mhdrFaultOf(borrow fsOf(fs).mac as *cfs_mac, data as *void, blkno, kind);
    var buffer = [0u8; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("cosmofs: block ");
    line.decimal(blkno);
    line.text(": metadata ");
    line.text(faultName(f));
    line.text(" fault: magic 0x");
    line.hex(ByteOrder.readU32LE(h, 0) as u64, 8);
    line.text(" kind ");
    line.decimal(ByteOrder.readU32LE(h, MHDR_KIND) as u64);
    line.text(" gen ");
    line.decimal(ByteOrder.readU64LE(h, MHDR_GENERATION));
    line.text(" blkno ");
    line.decimal(ByteOrder.readU64LE(h, MHDR_BLKNO));
    if (fsOf(fs).mac.on) {
        // No computed value: printing the right tag beside a forged one would hand the forger the answer.
        line.text(" (wanted kind ");
        line.decimal(kind as u64);
        line.text(" at blkno ");
        line.decimal(blkno);
        line.text("): it does not authenticate");
    } else {
        line.text(" algo ");
        line.decimal(ByteOrder.readU32LE(h, MHDR_ALGO) as u64);
        line.text(" crc 0x");
        line.hex(ByteOrder.readU32LE(h, MHDR_CRC) as u64, 8);
        line.text(" (wanted kind ");
        line.decimal(kind as u64);
        line.text(" at blkno ");
        line.decimal(blkno);
        line.text(", computed crc 0x");
        line.hex(cfs_block_crc(data, MHDR_CRC) as u64, 8);
        line.text(")");
    }
    KernelLog.send(LogLevel.Error, line);
}

/// The buffer of `blkno` as `kind` (0: any), held: from the cache, or read and checked -- a metadata block checks
/// itself, so a mirrored member can answer from another copy and put the bad one right (design.md, "A mirror is only
/// as good as its verifier").
/// Safety: as bufFind; `out` writable.
@export("cfs_buf_get")
unsafe fn bufGet(fs: *mut cfs, blkno: u64, kind: u32, out: *mut *mut cfs_buf) -> i32 {
    if (!cfs_dva_valid(fs as *cfs, blkno)) {
        return -EIO;
    }
    var b = bufFind(fs, blkno);
    if (!b.isNull()) {
        let k = bufOf(b);
        k.refs += 1;
        List.remove(linkOf(b));
        List.pushFront(bufsOf(fs), linkOf(b));
        if (kind != 0 && kindOf(b) != kind) {
            bufPut(fs, b); // undo the ref taken above: a kind mismatch is not a hand-out
            return -EIO;
        }
        out.write(b);
        return 0;
    }
    b = bufAlloc(fs, blkno);
    if (b.isNull()) {
        return -ENOMEM;
    }
    var want = MhdrWant { mac: borrow fsOf(fs).mac as *cfs_mac, dva: blkno, kind: kind };
    var readOk = false;
    let data = bufOf(b).data;
    let rc = cfs_read_repair(
        fs, blkno, data as *mut void, mhdrVerify, borrow mut want as *mut MhdrWant as *mut void,
        0 as *mut bool, borrow mut readOk as *mut bool,
    );
    if (rc != 0) {
        if (rc == -EIO && readOk) {
            logFault(fs, data as *u8, blkno, kind);
        } else {
            // Nothing was read, so the buffer describes nothing: saying which header field is wrong would be inventing
            // one.
            var buffer = [0u8; 96];
            var line = TextWriter.create(mut buffer[..]);
            line.text("cosmofs: block ");
            line.decimal(blkno);
            line.text(": read error (");
            line.signed(rc as i64);
            line.text(")");
            KernelLog.send(LogLevel.Error, line);
        }
        List.remove(linkOf(b));
        let f = fsOf(fs);
        f.nr_bufs -= 1;
        kfree(data as *mut void);
        kfree(b as *mut void);
        return rc;
    }
    out.write(b);
    return 0;
}

/// Whether the open transaction holds `blkno` dirty: written in memory and not yet on any device, so a read of the
/// device says nothing about it (the scrub's question).
/// Safety: as bufFind.
@export("cfs_buf_is_dirty")
unsafe fn bufIsDirty(fs: *mut cfs, blkno: u64) -> bool {
    let b = bufFind(fs, blkno);
    return !b.isNull() && bufOf(b).dirty;
}

/// Safety: `b` is a held buffer.
@export("cfs_buf_put")
unsafe fn bufPut(fs: *mut cfs, b: *mut cfs_buf) {
    let k = bufOf(b);
    if (k.refs == 0) {
        assertFailed("b->refs > 0");
    }
    k.refs -= 1;
}

/// Safety: as bufFind; `b` is a buffer.
@export("cfs_buf_mark_dirty")
unsafe fn bufMarkDirty(fs: *mut cfs, b: *mut cfs_buf) {
    let k = bufOf(b);
    if (!k.dirty) {
        k.dirty = true;
        let f = fsOf(fs);
        f.nr_dirty += 1;
    }
    cfs_note_dirty(fs);
}

/// The inverse, for a rollback. A buffer whose block is being given back must not stay dirty: the commit that
/// eventually succeeds writes every dirty buffer, and by then that block may belong to something else -- two owners
/// writing one block, which is a corruption rather than a leak.
/// Safety: as bufMarkDirty.
@export("cfs_buf_mark_clean")
unsafe fn bufMarkClean(fs: *mut cfs, b: *mut cfs_buf) {
    let k = bufOf(b);
    if (k.dirty) {
        k.dirty = false;
        let f = fsOf(fs);
        if (f.nr_dirty == 0) {
            assertFailed("fs->nr_dirty > 0");
        }
        f.nr_dirty -= 1;
    }
}

/// A fresh zeroed metadata block of `kind`, sealed, dirty and held.
/// Safety: as bufFind; `out` writable.
@export("cfs_buf_new")
unsafe fn bufNew(fs: *mut cfs, kind: u32, out: *mut *mut cfs_buf) -> i32 {
    var blk: u64 = 0;
    let rc = cfs_alloc_block(fs, borrow mut blk as *mut u64);
    if (rc != 0) {
        return rc;
    }
    let b = bufAlloc(fs, blk);
    if (b.isNull()) {
        cfs_free_block_deferred(fs, blk);
        return -ENOMEM;
    }
    let data = bufOf(b).data;
    memset(data as *mut void, 0, CFS_BLOCK);
    mhdrSeal(fs, data, kind, blk);
    bufMarkDirty(fs, b);
    out.write(b);
    return 0;
}

/// The next reserved block, or 0 when the reservation is spent.
///
/// The reservation is where the commit's window takes blocks from (cfs_buf_cow_exempt below): `exempt` says how the
/// superseded block is given back -- deferred, the way every tree block is, or exempt, freed for the new root with no
/// snapshot filter. Exempt is for a block no snapshot's tree can reach, which is every block hanging off a superblock
/// field a snapshot does not copy: the free record, the snapshot list and its deadlists. Sending one of those through
/// the filter would have the snapshot hold it and append it to the deadlist it is a copy of
/// (docs/audit/next-subsystem-snap-deadlist.md, "The exemption, and the rule it rests on").
/// Safety: `r` is null or a reservation.
@export("cfs_res_take")
unsafe fn resTake(r: *mut cfs_res) -> u64 {
    if (r.isNull()) {
        return 0;
    }
    let k = Ptr.toBorrowMut(r);
    if (k.used >= k.n) {
        return 0;
    }
    let blk = k.blk.add(k.used as usize).read();
    k.used += 1;
    return blk;
}

/// Safety: as resTake.
@export("cfs_res_untake")
unsafe fn resUntake(r: *mut cfs_res) {
    if (!r.isNull()) {
        let k = Ptr.toBorrowMut(r);
        if (k.used > 0) {
            k.used -= 1;
        }
    }
}

/// Copy a held buffer of a committed generation to a new block in this one; a block already this generation's is only
/// marked dirty.
/// Safety: as bufFind; `bp` a held buffer's place, `parentSlot` where its address is kept; `res` null or the commit's
/// reservation.
unsafe fn bufCow(fs: *mut cfs, bp: *mut *mut cfs_buf, parentSlot: *mut u64, exempt: bool, res: *mut cfs_res) -> i32 {
    let b = bp.read();
    let data = bufOf(b).data;
    let h = Slice.fromRaw(data as *u8, 64);
    if (ByteOrder.readU64LE(h, MHDR_GENERATION) == fsOf(fs).gen) {
        bufMarkDirty(fs, b);
        return 0;
    }
    var nblk: u64 = 0;
    if (!res.isNull()) {
        // Inside the commit's window, where allocating is the defect this unit removes: the block comes from what was
        // set aside before the fixpoint. Nothing left means the bound was wrong, which fails the commit rather than
        // quietly allocating.
        nblk = resTake(res);
        if (nblk == 0) {
            KernelLog.write(
                LogLevel.Error,
                "cosmofs: the commit's reservation is short; refusing to allocate after the bitmap",
            );
            return -ENOSPC;
        }
    } else {
        // The copy stays on the member the block was on where that member has room. Otherwise a metadata tree drifts
        // onto whichever member is emptiest, and a member's own allocation index could end up on a different device
        // than the blocks it describes.
        let v = dvaVdev(bufOf(b).blkno);
        let f = fsOf(fs);
        let hint = if (v < f.nmembers) dva(v, Ptr.toBorrow(f.mem.add(v as usize) as *cfs_memstate).first_usable) else 0;
        var got: u64 = 0;
        let rc = cfs_alloc_run(fs, CFS_ALLOC_META, hint, 1, borrow mut nblk as *mut u64, borrow mut got as *mut u64);
        if (rc != 0) {
            return rc;
        }
    }
    let nb = bufAlloc(fs, nblk);
    if (nb.isNull()) {
        if (!res.isNull()) {
            resUntake(res);
        } else {
            cfs_free_block_deferred(fs, nblk);
        }
        return -ENOMEM;
    }
    let ndata = bufOf(nb).data;
    memcpy(ndata as *mut void, data as *void, CFS_BLOCK);
    mhdrSeal(fs, ndata, ByteOrder.readU32LE(h, MHDR_KIND), nblk);
    bufMarkDirty(fs, nb);
    if (exempt) {
        cfs_free_block_exempt(fs, bufOf(b).blkno);
    } else {
        cfs_free_block_deferred(fs, bufOf(b).blkno);
    }
    bufPut(fs, b);
    parentSlot.write(nblk);
    bp.write(nb);
    return 0;
}

/// Safety: as bufCow.
@export("cfs_buf_cow")
unsafe fn bufCowC(fs: *mut cfs, bp: *mut *mut cfs_buf, parentSlot: *mut u64) -> i32 =>
    bufCow(fs, bp, parentSlot, false, 0 as *mut cfs_res);

/// Safety: as bufCow.
@export("cfs_buf_cow_exempt")
unsafe fn bufCowExempt(fs: *mut cfs, bp: *mut *mut cfs_buf, parentSlot: *mut u64, res: *mut cfs_res) -> i32 =>
    bufCow(fs, bp, parentSlot, true, res);

/// Give back a block this transaction allocated and nothing has named or written: its bit is cleared now, not at the
/// next commit, so the retry a set-aside's failure invites finds the space it had (Codex on #433; a deferred free would
/// hold it allocated until a commit). The on-disk bitmap never had it.
/// Safety: as bufFind.
unsafe fn allocUndo(fs: *mut cfs, blk: u64) {
    let lin = cfs_dva_lin(fs as *cfs, blk);
    let f = fsOf(fs);
    if (lin == CFS_DVA_NONE) {
        return;
    }
    let at = f.bitmap.add((lin >> 3) as usize);
    let bit = 1u8 << truncate<u8>(lin & 7);
    if ((at.read() & bit) == 0) {
        return;
    }
    at.write(at.read() & (bit ^ 0xFF));
    f.bitmap_dirty.add((lin / CFS_BITS_PER_BITMAP) as usize).write(1);
    f.free_blocks += 1;
    let m = Ptr.toBorrowMut(f.mem.add(dvaVdev(blk) as usize));
    m.free_blocks += 1;
}

/// Metadata blocks set aside before a change that must not stop half way (CF17; CFS-6): each block is allocated and
/// its buffer made now, so the change itself only takes them and cannot fail. What it does not take goes back with
/// cfs_prep_release. All or nothing: a failure here gives back what it had set aside and changes nothing else.
/// Safety: as bufFind; `p` a set-aside.
@export("cfs_prep_meta")
unsafe fn prepMeta(fs: *mut cfs, p: *mut cfs_prep, n: u32) -> i32 {
    let s = Ptr.toBorrowMut(p);
    s.n = 0;
    s.used = 0;
    if (n > CFS_PREP_MAX) {
        return -EFBIG;
    }
    for (i in 0u32..n) {
        var got: u64 = 0;
        var rc = cfs_alloc_run(
            fs, CFS_ALLOC_META, 0, 1, borrow mut s.blk[i as usize] as *mut u64,
            borrow mut got as *mut u64,
        );
        let blk = s.blk[i as usize];
        if (rc == 0) {
            let b = bufMake(fs, blk);
            prepBuf(p, i).write(b);
            if (b.isNull()) {
                allocUndo(fs, blk);
                rc = -ENOMEM;
            }
        }
        if (rc != 0) {
            s.n = i;
            prepRelease(fs, p);
            return rc;
        }
    }
    s.n = n;
    return 0;
}

/// Safety: as prepMeta.
@export("cfs_prep_release")
unsafe fn prepRelease(fs: *mut cfs, p: *mut cfs_prep) {
    let s = Ptr.toBorrowMut(p);
    for (i in s.used..s.n) {
        let b = prepBuf(p, i).read();
        kfree(bufOf(b).data as *mut void);
        kfree(b as *mut void);
        allocUndo(fs, s.blk[i as usize]);
    }
    s.n = 0;
    s.used = 0;
}

/// The next set-aside block and its buffer, which the change cannot run out of.
/// Safety: `p` a set-aside.
unsafe fn prepTake(p: *mut cfs_prep, blk: borrow mut u64) -> *mut cfs_buf {
    let s = Ptr.toBorrowMut(p);
    if (s.used >= s.n) {
        assertFailed("p->used < p->n");
    }
    let b = prepBuf(p, s.used).read();
    blk = s.blk[s.used as usize];
    s.used += 1;
    return b;
}

/// Copy-on-write into a set-aside block: cfs_buf_cow that cannot fail.
/// Safety: as bufCow; `p` a set-aside.
@export("cfs_buf_cow_prep")
unsafe fn bufCowPrep(fs: *mut cfs, bp: *mut *mut cfs_buf, parentSlot: *mut u64, p: *mut cfs_prep) {
    let b = bp.read();
    let data = bufOf(b).data;
    let h = Slice.fromRaw(data as *u8, 64);
    if (ByteOrder.readU64LE(h, MHDR_GENERATION) == fsOf(fs).gen) {
        bufMarkDirty(fs, b);
        return;
    }
    var nblk: u64 = 0;
    let nb = prepTake(p, mut nblk);
    bufInsert(fs, nb);
    let ndata = bufOf(nb).data;
    memcpy(ndata as *mut void, data as *void, CFS_BLOCK);
    mhdrSeal(fs, ndata, ByteOrder.readU32LE(h, MHDR_KIND), nblk);
    bufMarkDirty(fs, nb);
    cfs_free_block_deferred(fs, bufOf(b).blkno);
    bufPut(fs, b);
    parentSlot.write(nblk);
    bp.write(nb);
}

/// A new block from the set-aside: cfs_buf_new that cannot fail.
/// Safety: as bufFind; `p` a set-aside.
@export("cfs_buf_new_prep")
unsafe fn bufNewPrep(fs: *mut cfs, kind: u32, p: *mut cfs_prep) -> *mut cfs_buf {
    var blk: u64 = 0;
    let b = prepTake(p, mut blk);
    bufInsert(fs, b);
    let data = bufOf(b).data;
    memset(data as *mut void, 0, CFS_BLOCK);
    mhdrSeal(fs, data, kind, blk);
    bufMarkDirty(fs, b);
    return b;
}

/// A new buffer at `blk`, a block the caller holds: through cfs_buf_alloc, not cfs_buf_get -- a block just handed out
/// may have a stale buffer from its previous life further down the list. The same reason cfs_buf_cow and freelog_fill
/// do it this way.
/// Safety: as bufFind; `out` writable.
@export("cfs_buf_new_at")
unsafe fn bufNewAt(fs: *mut cfs, kind: u32, blk: u64, out: *mut *mut cfs_buf) -> i32 {
    let b = bufAlloc(fs, blk);
    if (b.isNull()) {
        return -ENOMEM;
    }
    let data = bufOf(b).data;
    memset(data as *mut void, 0, CFS_BLOCK);
    mhdrSeal(fs, data, kind, blk);
    bufMarkDirty(fs, b);
    out.write(b);
    return 0;
}
