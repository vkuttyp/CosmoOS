// cosmofs_dir.cee - A directory's vnode operations, in CeeSafe: roadmap 2.0 SA7. tests/host/test_cfsdir.c holds it to
// the digest of the C it replaced.
//
// lookup (and the .snapshots directory's), create, symlink, readlink, mkdir, link, unlink, rmdir (a snapshot's,
// through .snapshots), rename and readdir. What they share -- the directory blocks, the .snapshots directory and the
// tree locks -- is cosmofs.cee's.
//
// struct cfs, the vnodes, the inodes, the entries and the snapshot entries stay C (cosmofs_internal.h,
// cosmofs_format.h, kernel/vfs.h). The inodes and snapshot entries the C kept on the stack are kept in zeroed slots
// of words, checked against their C sizes (tests/host/test_cfsdir.c): a CeeSafe local cannot hold C state. A vnode's
// type, a field whose name CeeSafe reserves, is read and written at its offset, which the test checks.
// cosmofs_dir_floor.c keeps readdir's entry point and the call through its callback, whose type takes an enum.

@header("kernel/vfs.h", "kernel/kmalloc.h", "kernel/mutex.h", "kernel/string.h", "kernel/cred.h", "cosmofs_internal.h")
extern "C" {
    enum vnode_type: u32;
    struct mount {
        fs_priv: *mut void;
        flags: u32;
    }
    struct vnode {
        obj: kobject;
        ino: u64;
        nlink: u32;
        size: u64;
        ctime_ns: u64;
        mnt: *mut mount;
        fs_priv: *mut void;
    }
    struct credentials {
        euid: u32;
        egid: u32;
    }
    struct cfs_super {
        version: u32;
    }
    struct cfs {
        sb: cfs_super;
        failed: i32;
        encrypted: bool;
        lock: mutex;
    }
    struct cfs_extent {
        start: u64;
        count: u32;
    }
    struct cfs_inode {
        mode: u32;
        nlink: u32;
        uid: u32;
        gid: u32;
        size: u64;
        mtime_ns: u64;
        ctime_ns: u64;
        ino: u64;
        direct: [cfs_extent; 10];
        parent: u64;
        csum_algo: u32;
        compress_algo: u32;
    }
    struct cfs_vnode {
        inode: cfs_inode;
        snap_imap_root: u64;
        snap_next_ino: u64;
    }
    struct cfs_snapshot {
        imap_root: u64;
        next_ino: u64;
        id: u64;
        flags: u32;
    }
    struct cfs_dirent {
        ino: u64;
    }
    struct cfs_clone {
        id: u64;
    }

    fn cred_current() -> *credentials;
    fn vfs_now_ns() -> u64;
    fn vnode_cache_any(mnt: *mut mount, pred: extern "C" fn(*vnode, *mut void) -> bool, arg: *mut void) -> bool;
    fn cfs_vnode_get(fs: *mut cfs, ino: u64, out: *mut *mut vnode) -> i32;
    fn cfs_vnode_get_tagged(fs: *mut cfs, ino: u64, tag: u32, snap: *cfs_snapshot, out: *mut *mut vnode) -> i32;
    fn cfs_vnode_inode_sync(fs: *mut cfs, vn: *mut vnode) -> i32;
    fn cfs_vnode_prepare(fs: *mut cfs, vn: *mut vnode) -> i32;
    fn cfs_dir_read_block(fs: *mut cfs, dir: *mut vnode, lblk: u64, buf: *mut u8) -> i32;
    fn cfs_dir_write_block(fs: *mut cfs, dir: *mut vnode, lblk: u64, buf: *u8) -> i32;
    fn cfs_dir_blocks(dir: *vnode) -> u64;
    fn cfs_dir_find(fs: *mut cfs, dir: *mut vnode, name: *CChar, len: usize, block: *mut u8, lblkOut: *mut u64,
        slotOut: *mut u32) -> i32;
    fn cfs_dir_add(fs: *mut cfs, dir: *mut vnode, name: *CChar, len: usize, ino: u64, kind: u32, block: *mut u8)
        -> i32;
    fn cfs_dir_remove_slot(fs: *mut cfs, dir: *mut vnode, lblk: u64, slot: u32, block: *mut u8) -> i32;
    fn cfs_dir_is_empty(fs: *mut cfs, dir: *mut vnode, block: *mut u8) -> bool;
    fn cfs_is_snapdir(vn: *mut vnode) -> bool;
    fn cfs_snap_tag_of(vn: *mut vnode) -> u32;
    fn cfs_snapdir_get(fs: *mut cfs, out: *mut *mut vnode) -> i32;
    fn cfs_snap_by_name(fs: *mut cfs, name: *CChar, len: usize, out: *mut cfs_snapshot, tag: *mut u32) -> i32;
    fn cfs_tree_readonly(fs: *mut cfs, vn: *mut vnode) -> bool;
    fn cfs_lock_tree_w(fs: *mut cfs, vn: *mut vnode) -> i32;
    fn cfs_unlock_tree(fs: *mut cfs);
    fn cfs_clone_by_id(fs: *mut cfs, id: u64) -> *mut cfs_clone;
    fn cfs_clone_enter(fs: *mut cfs, c: *mut cfs_clone);
    fn cfs_clone_leave(fs: *mut cfs);
    fn cfs_names_allow(fs: *mut cfs, len: usize) -> i32;
    fn cfs_inode_alloc(fs: *mut cfs, ino: *mut u64) -> i32;
    fn cfs_inode_write(fs: *mut cfs, ino: u64, inode: *cfs_inode) -> i32;
    fn cfs_inode_discard(fs: *mut cfs, ino: u64);
    fn cfs_data_write_block(fs: *mut cfs, inode: *mut cfs_inode, lblk: u64, buf: *void, cls: u32) -> i32;
    fn cfs_csum_free(fs: *mut cfs, inode: *mut cfs_inode);
    fn cfs_free_block_deferred(fs: *mut cfs, blk: u64);
    fn cfs_map(fs: *mut cfs, inode: *cfs_inode, lblk: u64, pblk: *mut u64) -> i32;
    fn cfs_data_read_verified(fs: *mut cfs, inode: *mut cfs_inode, lblk: u64, dva: u64, buf: *mut void) -> i32;
    fn cfs_orphan_reserve(fs: *mut cfs) -> bool;
    fn cfs_orphan_add(fs: *mut cfs, ino: u64);
    fn cfs_fail(fs: *mut cfs, rc: i32);
    fn cfs_snapshot_create(fs: *mut cfs, name: *CChar, identity: bool, out: *mut cfs_snapshot) -> i32;
    fn cfs_snapshot_delete(fs: *mut cfs, name: *CChar) -> i32;
    fn cfs_dirent_check(blk: *cfs_dirent, s: u32, version: u32) -> u32;
    fn cfs_dirent_name(blk: *cfs_dirent, s: u32, out: *mut CChar) -> u32;
    fn strnlen(s: *CChar, max: usize) -> usize;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    fn memcmp(a: *void, b: *void, n: usize) -> i32;
}

// ---- errno.h, vfs.h and cosmofs_format.h values (asserted in tests/host/test_cfsdir.c) ----

const ENOENT: i32 = 2;
const EIO: i32 = 5;
const ENOMEM: i32 = 12;
const EBUSY: i32 = 16;
const EEXIST: i32 = 17;
const EXDEV: i32 = 18;
const EROFS: i32 = 30;
const ENAMETOOLONG: i32 = 36;
const ENOTEMPTY: i32 = 39;
const EOPNOTSUPP: i32 = 95;
const EPERM: i32 = 1;
const MOUNT_RDONLY: u32 = 1;
const VNODE_REG: u32 = 1;
const VNODE_DIR: u32 = 2;
const VNODE_LNK: u32 = 6;
/// Where a struct vnode's `type` is.
const VN_TYPE: usize = 56;
const CFS_BLOCK: usize = 4096;
const CFS_ROOT_INO: u64 = 1;
const CFS_TYPE_REG: u32 = 1;
const CFS_TYPE_DIR: u32 = 2;
const CFS_TYPE_LNK: u32 = 3;
const CFS_CSUM_CRC32C: u32 = 1;
const CFS_CSUM_POLY1305: u32 = 2;
const CFS_COMPRESS_NONE: u32 = 0;
const CFS_COMPRESS_LZ4: u32 = 1;
const CFS_ALLOC_META: u32 = 0;
const CFS_NAME_MAX_LONG: usize = 255;
const CFS_SNAP_NAME_MAX: usize = 31;
const CFS_SNAP_F_CLONE: u32 = 1;
const CFS_SNAP_INO_SHIFT: u32 = 48;
const CFS_DIRENTS_PER_BLOCK: u64 = 64;
const CFS_DIRENT_SIZE: usize = 64;
const CFS_DIRENT_CONT: u64 = 0xFFFFFFFFFFFFFFFF;
const CFS_EXT_COMPRESSED: u32 = 0x80000000;
const CFS_EXT_COUNT_MASK: u32 = 0xFFFF;
/// The name of the .snapshots directory.
const SNAPDIR_NAME: StringView = ".snapshots";
/// Where an entry's type is.
const DIRENT_TYPE: usize = 8;

// ---- Helpers ----

fn inoOf(ino: u64) -> u64 => ino & ((1u64 << CFS_SNAP_INO_SHIFT) - 1);

/// Safety: `vn` is a vnode.
unsafe fn fsOf(vn: *mut vnode) -> *mut cfs =>
    Ptr.toBorrow(Ptr.toBorrow(vn as *vnode).mnt as *mount).fs_priv as *mut cfs;

/// Safety: `vn` is a vnode with this filesystem's state.
unsafe fn cvOf(vn: *mut vnode) -> *mut cfs_vnode => Ptr.toBorrow(vn as *vnode).fs_priv as *mut cfs_vnode;

/// Safety: as cvOf.
unsafe fn inodeOf(vn: *mut vnode) -> *mut cfs_inode => borrow mut Ptr.toBorrowMut(cvOf(vn)).inode as *mut cfs_inode;

/// Safety: `vn` is a vnode.
unsafe fn typeOf(vn: *mut vnode) -> u32 => ((vn as *u8).add(VN_TYPE) as *u32).read();

/// Safety: `vn` is a vnode.
unsafe fn ino(vn: *mut vnode) -> u64 => Ptr.toBorrow(vn as *vnode).ino;

/// Safety: `fs` null or a filesystem's state.
unsafe fn unusable(fs: *mut cfs) -> bool => fs.isNull() || Ptr.toBorrow(fs as *cfs).failed != 0;

/// Safety: `fs` is a filesystem's state.
unsafe fn lockOf(fs: *mut cfs) -> *mut mutex => borrow mut Ptr.toBorrowMut(fs).lock as *mut mutex;

/// Safety: `fs` is a filesystem's state.
unsafe fn version(fs: *mut cfs) -> u32 => Ptr.toBorrow(fs as *cfs).sb.version;

/// Whether `name` (`len` bytes) is "..".
/// Safety: `name` is `len` readable bytes.
unsafe fn isDotDot(name: *CChar, len: usize) -> bool =>
    len == 2 && (name as *u8).read() == 46 && (name as *u8).add(1).read() == 46;

/// The inode an entry names.
/// Safety: `block` is a directory block; `slot` below CFS_DIRENTS_PER_BLOCK.
unsafe fn entryIno(block: *mut u8, slot: u32) -> u64 =>
    ByteOrder.readU64LE(Slice.fromRaw(block as *u8, CFS_BLOCK), slot as usize * CFS_DIRENT_SIZE);

/// A name and a snapshot entry's worth of words, for one call.
/// Safety: `name` is `len` readable bytes, `len` at most CFS_SNAP_NAME_MAX.
unsafe fn snapName(buf: borrow mut [u8; 32], name: *CChar, len: usize) {
    for (i in 0usize..len) {
        buf[i] = (name as *u8).add(i).read();
    }
    buf[len] = 0;
}

/// "cosmofs: snapshot 'NAME' VERB", as information.
fn snapSaid(name: borrow [u8; 32], verb: StringView) {
    var n: usize = 0;
    while (n < 32 && name[n] != 0) {
        n += 1;
    }
    var buffer = [0u8; 96];
    var line = TextWriter.create(mut buffer[..]);
    line.text("cosmofs: snapshot '");
    line.bytes(name[0..n]);
    line.text("' ");
    line.text(verb);
    KernelLog.send(LogLevel.Info, line);
}

// ---- lookup ----

/// A snapshot's view, in a slot of words: the imap root and the inode bound of `vn`'s tree.
/// Safety: `vn` is a vnode of a snapshot; `slot` a zeroed struct cfs_snapshot.
unsafe fn snapOf(vn: *mut vnode, slot: *mut cfs_snapshot) {
    let s = Ptr.toBorrowMut(slot);
    let cv = Ptr.toBorrow(cvOf(vn) as *cfs_vnode);
    s.imap_root = cv.snap_imap_root;
    s.next_ino = cv.snap_next_ino;
}

/// The entry `name` of `dir` and the vnode it names: by `tag`'s map when `snap`, else the live (or entered) tree's.
/// Safety: `fs` is a mounted filesystem's state, its lock held; `dir` a directory vnode of it; `out` writable.
unsafe fn lookupEntry(fs: *mut cfs, dir: *mut vnode, name: *CChar, len: usize, tag: u32, out: *mut *mut vnode)
    -> i32 {
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    var lblk: u64 = 0;
    var slot: u32 = 0;
    var rc = cfs_dir_find(fs, dir, name, len, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
    if (rc == 0) {
        let e = entryIno(block, slot);
        if (tag != 0) {
            var sslot = [0u64; 16];
            let s = borrow mut sslot as *mut [u64; 16] as *mut cfs_snapshot;
            snapOf(dir, s);
            rc = cfs_vnode_get_tagged(fs, e, tag, s as *cfs_snapshot, out);
        } else {
            rc = cfs_vnode_get(fs, e, out);
        }
    }
    kfree(block as *mut void);
    return rc;
}

/// The VFS `lookup` operation.
/// Safety: `dir` is a directory vnode of this filesystem; `name` `len` bytes; `out` writable.
@export("cfs_lookup")
unsafe fn lookup(dir: *mut vnode, name: *CChar, len: usize, out: *mut *mut vnode) -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    mutex_lock(lockOf(fs));
    var rc: i32 = 0;
    if (cfs_is_snapdir(dir)) {
        // ".." leaves history the only way out: the live root.
        if (isDotDot(name, len)) {
            rc = cfs_vnode_get(fs, CFS_ROOT_INO, out);
            mutex_unlock(lockOf(fs));
            return rc;
        }
        // Inside .snapshots: each name is a snapshot's root directory.
        var sslot = [0u64; 16];
        let s = borrow mut sslot as *mut [u64; 16] as *mut cfs_snapshot;
        var tag: u32 = 0;
        rc = cfs_snap_by_name(fs, name, len, s, borrow mut tag as *mut u32);
        let snap = Ptr.toBorrow(s as *cfs_snapshot);
        if (rc == 0 && (snap.flags & CFS_SNAP_F_CLONE) != 0) {
            let c = cfs_clone_by_id(fs, snap.id);
            if (c.isNull()) {
                rc = -EIO;
            } else {
                cfs_clone_enter(fs, c);
                rc = cfs_vnode_get(fs, CFS_ROOT_INO, out);
                cfs_clone_leave(fs);
            }
        } else if (rc == 0) {
            rc = cfs_vnode_get_tagged(fs, CFS_ROOT_INO, tag, s as *cfs_snapshot, out);
        }
        mutex_unlock(lockOf(fs));
        return rc;
    }
    if (ino(dir) == CFS_ROOT_INO && len == SNAPDIR_NAME.length &&
        memcmp(name as *void, SNAPDIR_NAME.ptr as *void, len) == 0) {
        // Found by name only: readdir does not list it, so nothing walking the tree descends into history by
        // accident.
        rc = cfs_snapdir_get(fs, out);
        mutex_unlock(lockOf(fs));
        return rc;
    }
    let tag = cfs_snap_tag_of(dir);
    let clone = if (tag != 0) cfs_clone_by_id(fs, tag as u64) else 0 as *mut cfs_clone;
    if (!clone.isNull()) {
        // Inside a clone: the live tree's lookup, in the clone's tree. At the clone's root ".." is .snapshots, as at a
        // snapshot's.
        if (isDotDot(name, len) && inoOf(ino(dir)) == CFS_ROOT_INO) {
            rc = cfs_snapdir_get(fs, out);
            mutex_unlock(lockOf(fs));
            return rc;
        }
        cfs_clone_enter(fs, clone);
        if (isDotDot(name, len)) {
            rc = cfs_vnode_get(fs, Ptr.toBorrow(inodeOf(dir) as *cfs_inode).parent, out);
        } else {
            rc = lookupEntry(fs, dir, name, len, 0, out);
        }
        cfs_unlock_tree(fs);
        return rc;
    }
    if (isDotDot(name, len)) {
        if (tag != 0) {
            // ".." inside a snapshot stays inside it. An untagged parent would be the live tree's directory of that
            // inode number: writable, and holding today's contents under a path that says history. At the snapshot's
            // own root the way up is .snapshots, not the live root.
            if (inoOf(ino(dir)) == CFS_ROOT_INO) {
                rc = cfs_snapdir_get(fs, out);
            } else {
                var sslot = [0u64; 16];
                let s = borrow mut sslot as *mut [u64; 16] as *mut cfs_snapshot;
                snapOf(dir, s);
                rc = cfs_vnode_get_tagged(fs, Ptr.toBorrow(inodeOf(dir) as *cfs_inode).parent, tag,
                    s as *cfs_snapshot, out);
            }
        } else {
            rc = cfs_vnode_get(fs, Ptr.toBorrow(inodeOf(dir) as *cfs_inode).parent, out);
        }
    } else {
        // Inside a snapshot: an ordinary directory read, through that snapshot's inode map.
        rc = lookupEntry(fs, dir, name, len, tag, out);
    }
    mutex_unlock(lockOf(fs));
    return rc;
}

// ---- Creating ----

/// Zero the slot of an inode a failed creation wrote and no entry names, so the number the creation gives back is not
/// an orphan with a link to the checker. Best effort: the slot is at the number the next creation takes, and that
/// creation writes it whole.
/// Safety: `fs` is a mounted filesystem's state, its lock held.
unsafe fn inodeSlotClear(fs: *mut cfs, inum: u64) {
    var zero = [0u64; 32];
    let _ = cfs_inode_write(fs, inum, borrow zero as *[u64; 32] as *cfs_inode);
}

/// The tree locked for a change of `dir` and its inode made writable (CFS-6), or why not; `block` freed if not.
/// Safety: `fs` is a mounted filesystem's state; `dir` a vnode of it; `block` kmalloc'd.
unsafe fn changeBegin(fs: *mut cfs, dir: *mut vnode, block: *mut u8) -> i32 {
    var rc = cfs_lock_tree_w(fs, dir);
    if (rc != 0) {
        kfree(block as *mut void);
        return rc;
    }
    rc = cfs_vnode_prepare(fs, dir);
    if (rc != 0) {
        cfs_unlock_tree(fs);
        kfree(block as *mut void);
    }
    return rc;
}

/// The checks before a new name in `dir`: -EEXIST when it is there, else what cfs_names_allow says.
/// Safety: as lookupEntry; `block` CFS_BLOCK writable bytes.
unsafe fn nameFree(fs: *mut cfs, dir: *mut vnode, name: *CChar, len: usize, block: *mut u8) -> i32 {
    var lblk: u64 = 0;
    var slot: u32 = 0;
    let rc = cfs_dir_find(fs, dir, name, len, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
    if (rc == 0) {
        return -EEXIST;
    }
    if (rc != -ENOENT) {
        return rc;
    }
    return cfs_names_allow(fs, len);
}

/// A new inode, as a creation by the current process in `dir` writes it.
/// Safety: `fs` is a filesystem's state; `slot` a zeroed struct cfs_inode; `dir` a vnode.
unsafe fn newInode(fs: *mut cfs, slot: *mut cfs_inode, inum: u64, kind: u32, perm: u32, dir: *mut vnode) {
    let i = Ptr.toBorrowMut(slot);
    let cred = Ptr.toBorrow(cred_current());
    i.mode = (kind << 12) | (perm & 4095);
    i.uid = cred.euid; // owned by its creator
    i.gid = cred.egid;
    i.ino = inum;
    i.parent = inoOf(ino(dir)); // a clone's vnode carries its tag; the map does not
    // An encrypted filesystem authenticates every file it creates: a CRC would say a block is intact, not that it is
    // the one written.
    i.csum_algo = if (Ptr.toBorrow(fs as *cfs).encrypted) CFS_CSUM_POLY1305 else CFS_CSUM_CRC32C;
    i.mtime_ns = vfs_now_ns();
    i.ctime_ns = i.mtime_ns;
}

/// A file or a directory named `name` in `dir`.
/// Safety: `dir` is a directory vnode of this filesystem; `name` `len` bytes; `out` writable.
unsafe fn createCommon(dir: *mut vnode, name: *CChar, len: usize, mode: u32, kind: u32, out: *mut *mut vnode)
    -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    if (len > CFS_NAME_MAX_LONG) {
        return -ENAMETOOLONG;
    }
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    // Every inode this changes, made writable before anything changes (CFS-6).
    let lrc = changeBegin(fs, dir, block);
    if (lrc != 0) {
        return lrc;
    }
    var rc = nameFree(fs, dir, name, len, block);
    var inum: u64 = 0;
    if (rc == 0) {
        rc = cfs_inode_alloc(fs, borrow mut inum as *mut u64);
    }
    if (rc == 0) {
        var islot = [0u64; 32];
        let ip = borrow mut islot as *mut [u64; 32] as *mut cfs_inode;
        newInode(fs, ip, inum, kind, mode, dir);
        let i = Ptr.toBorrowMut(ip);
        i.nlink = if (kind == CFS_TYPE_DIR) 2 else 1;
        // Regular files compress; a directory's blocks are written one at a time and a record cannot be formed from
        // them. Not below format 6, which added records: a version-2..5 pool written here must stay readable by the
        // kernels of its version (CFS-2).
        i.compress_algo = if (kind == CFS_TYPE_REG && version(fs) >= 6) CFS_COMPRESS_LZ4 else CFS_COMPRESS_NONE;
        rc = cfs_inode_write(fs, inum, ip as *cfs_inode);
        if (rc == 0) {
            rc = cfs_dir_add(fs, dir, name, len, inum, kind, block);
            if (rc != 0) {
                inodeSlotClear(fs, inum);
            }
        }
        if (rc != 0) {
            // No entry names the inode: the number and the count go back (CF17), as they do for a symlink.
            cfs_inode_discard(fs, inum);
        }
    }
    if (rc == 0 && kind == CFS_TYPE_DIR) {
        let d = Ptr.toBorrowMut(dir);
        d.nlink = d.nlink.wrappingAdd(1);
        rc = cfs_vnode_inode_sync(fs, dir);
    }
    if (rc == 0) {
        rc = cfs_vnode_get(fs, inum, out);
    }
    cfs_unlock_tree(fs);
    kfree(block as *mut void);
    return rc;
}

/// A symbolic link's target is its own data block, written inside the transaction that writes the inode and adds the
/// entry -- not through the page cache, which reaches disk at write-back and could commit a zero-length link whose
/// target is not there yet (docs/audit/next-subsystem-symlink.md, "cosmofs"). Every failure after an allocation gives
/// the block and the inode number back, so a refused symlink leaves nothing unreachable behind.
/// Safety: `dir` is a directory vnode of this filesystem; `name` `len` bytes; `target` a terminated string; `out`
/// writable.
@export("cfs_symlink")
unsafe fn symlink(dir: *mut vnode, name: *CChar, len: usize, target: *CChar, out: *mut *mut vnode) -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO;
    }
    if (len == 0 || len > CFS_NAME_MAX_LONG) {
        return -ENAMETOOLONG;
    }
    let tlen = strnlen(target, CFS_BLOCK);
    if (tlen == 0 || tlen >= CFS_BLOCK) {
        return -ENAMETOOLONG; // a target is one block, as on any filesystem that stores it there
    }
    if (version(fs) < 8) {
        return -EOPNOTSUPP; // an older kernel would read this as a regular file
    }
    if (cfs_tree_readonly(fs, dir)) {
        return -EROFS; // in .snapshots or a snapshot: what the tree was
    }
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    // Every inode this changes, made writable before anything changes (CFS-6).
    let lrc = changeBegin(fs, dir, block);
    if (lrc != 0) {
        return lrc;
    }
    var inum: u64 = 0;
    var inoTaken = false;
    var islot = [0u64; 32];
    let ip = borrow mut islot as *mut [u64; 32] as *mut cfs_inode;
    var rc = nameFree(fs, dir, name, len, block);
    if (rc == 0) {
        rc = cfs_inode_alloc(fs, borrow mut inum as *mut u64);
    }
    if (rc == 0) {
        inoTaken = true;
        newInode(fs, ip, inum, CFS_TYPE_LNK, 511, dir); // a link's own mode is never consulted
        let i = Ptr.toBorrowMut(ip);
        i.nlink = 1;
        i.compress_algo = CFS_COMPRESS_NONE; // one short block: nothing to gain, and readlink stays a read
        i.size = tlen as u64;
        memset(block as *mut void, 0, CFS_BLOCK);
        memcpy(block as *mut void, target as *void, tlen);
        rc = cfs_data_write_block(fs, ip, 0, block as *void, CFS_ALLOC_META);
        if (rc != 0) {
            cfs_csum_free(fs, ip); // the entry may have been stored before the mapping failed
        } else {
            rc = cfs_inode_write(fs, inum, ip as *cfs_inode);
            var undo = rc != 0;
            if (rc == 0) {
                rc = cfs_dir_add(fs, dir, name, len, inum, CFS_TYPE_LNK, block);
                if (rc != 0) {
                    inodeSlotClear(fs, inum);
                    undo = true;
                }
            }
            if (undo) {
                // The block this call allocated, and the inode number, go back: the directory never named either, so
                // nothing else can find them.
                let d0 = borrow Ptr.toBorrow(ip as *cfs_inode).direct[0];
                let count = if ((d0.count & CFS_EXT_COMPRESSED) != 0) d0.count & CFS_EXT_COUNT_MASK else d0.count;
                if (count != 0) {
                    cfs_free_block_deferred(fs, d0.start);
                }
                cfs_csum_free(fs, ip);
                cfs_inode_discard(fs, inum);
                inoTaken = false;
            } else {
                // The entry names the inode from here on, so the number is not this call's to give back whatever
                // happens next: rolling it back would hand the next creation an inode a directory already points at.
                inoTaken = false;
                rc = cfs_vnode_get(fs, inum, out);
            }
        }
    }
    if (inoTaken) {
        cfs_inode_discard(fs, inum);
    }
    cfs_unlock_tree(fs);
    kfree(block as *mut void);
    return rc;
}

/// The VFS `readlink` operation: the target, up to `len` bytes; its length.
/// Safety: `vn` is a link vnode of this filesystem; `buf` `len` writable bytes.
@export("cfs_readlink")
unsafe fn readlink(vn: *mut vnode, buf: *mut CChar, len: usize) -> i32 {
    let fs = fsOf(vn);
    if (unusable(fs)) {
        return -EIO;
    }
    let tlen = Ptr.toBorrow(vn as *vnode).size;
    if (tlen == 0 || tlen >= CFS_BLOCK as u64) {
        return -EIO;
    }
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    mutex_lock(lockOf(fs));
    var pblk: u64 = 0;
    var rc = cfs_map(fs, inodeOf(vn) as *cfs_inode, 0, borrow mut pblk as *mut u64);
    if (rc > 0) {
        rc = cfs_data_read_verified(fs, inodeOf(vn), 0, pblk, block as *mut void);
    } else if (rc == 0) {
        rc = -EIO; // a link with no block is not a link
    }
    mutex_unlock(lockOf(fs));
    if (rc == 0) {
        let n = if (tlen < len as u64) tlen as usize else len;
        memcpy(buf as *mut void, block as *void, n);
        rc = truncate<i32>(n);
    }
    kfree(block as *mut void);
    return rc;
}

/// The VFS `create` operation.
/// Safety: as createCommon.
@export("cfs_create")
unsafe fn create(dir: *mut vnode, name: *CChar, len: usize, mode: u32, out: *mut *mut vnode) -> i32 {
    if (cfs_tree_readonly(fsOf(dir), dir)) {
        return -EROFS; // .snapshots holds snapshots, not files; a snapshot is what the tree was
    }
    return createCommon(dir, name, len, mode, CFS_TYPE_REG, out);
}

/// The VFS `mkdir` operation. Inside .snapshots it takes a snapshot: the surface is what mkdir already is (design.md,
/// "The interface").
/// Safety: as createCommon; `out` null only in .snapshots.
@export("cfs_mkdir")
unsafe fn mkdir(dir: *mut vnode, name: *CChar, len: usize, mode: u32, out: *mut *mut vnode) -> i32 {
    if (cfs_is_snapdir(dir)) {
        let fs = fsOf(dir);
        if (unusable(fs)) {
            return -EIO;
        }
        if ((Ptr.toBorrow(Ptr.toBorrow(dir as *vnode).mnt as *mount).flags & MOUNT_RDONLY) != 0) {
            return -EROFS;
        }
        if (len > CFS_SNAP_NAME_MAX) {
            return -ENAMETOOLONG;
        }
        var buf = [0u8; 32];
        snapName(mut buf, name, len);
        mutex_lock(lockOf(fs));
        var rc = cfs_snapshot_create(fs, borrow buf as *[u8; 32] as *CChar, false, 0 as *mut cfs_snapshot);
        if (rc == 0 && !out.isNull()) {
            var sslot = [0u64; 16];
            let s = borrow mut sslot as *mut [u64; 16] as *mut cfs_snapshot;
            var tag: u32 = 0;
            rc = if (cfs_snap_by_name(fs, name, len, s, borrow mut tag as *mut u32) == 0)
                cfs_vnode_get_tagged(fs, CFS_ROOT_INO, tag, s as *cfs_snapshot, out)
            else -EIO;
        }
        mutex_unlock(lockOf(fs));
        if (rc == 0) {
            snapSaid(buf, "taken");
        }
        return rc;
    }
    if (cfs_tree_readonly(fsOf(dir), dir)) {
        return -EROFS; // a snapshot is not writable (a clone is)
    }
    return createCommon(dir, name, len, mode, CFS_TYPE_DIR, out);
}

// ---- Links and removal ----

/// A second name for `target` (VFS-4; design.md, "Hard links"): an entry naming its inode and one more link, in one
/// transaction. The checker already counts every entry that names an inode (CF13), and unlink and rename's replace
/// already take one link of several, so this is the only operation hard links add. Within one tree: a snapshot's is
/// read-only, and a name in a clone for a file of the live tree would cross trees.
/// Safety: `dir` is a directory vnode of this filesystem, `target` a vnode of it; `name` `len` bytes.
@export("cfs_link")
unsafe fn link(dir: *mut vnode, name: *CChar, len: usize, target: *mut vnode) -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    if (len == 0 || len > CFS_NAME_MAX_LONG) {
        return -ENAMETOOLONG;
    }
    if (cfs_tree_readonly(fs, dir) || cfs_tree_readonly(fs, target)) {
        return -EROFS; // in .snapshots or a snapshot: what the tree was
    }
    if (cfs_snap_tag_of(dir) != cfs_snap_tag_of(target)) {
        return -EXDEV; // between the live tree and a clone, or two clones
    }
    let tt = typeOf(target);
    if (tt == VNODE_DIR) {
        return -EPERM;
    }
    let kind = if (tt == VNODE_LNK) CFS_TYPE_LNK else CFS_TYPE_REG;
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    var rc = cfs_lock_tree_w(fs, dir);
    if (rc != 0) {
        kfree(block as *mut void);
        return rc;
    }
    // Every inode this changes, made writable before anything changes (CFS-6).
    rc = cfs_vnode_prepare(fs, dir);
    if (rc == 0) {
        rc = cfs_vnode_prepare(fs, target);
    }
    if (rc == 0) {
        rc = nameFree(fs, dir, name, len, block);
    }
    if (rc == 0) {
        rc = cfs_dir_add(fs, dir, name, len, inoOf(ino(target)), kind, block);
    }
    if (rc == 0) {
        let t = Ptr.toBorrowMut(target);
        t.nlink = t.nlink.wrappingAdd(1);
        t.ctime_ns = vfs_now_ns();
        rc = cfs_vnode_inode_sync(fs, target);
        if (rc != 0) {
            // The count could not be written: take the name back, or, if even that fails, abandon the transaction (as
            // rename does).
            t.nlink = t.nlink.wrappingSub(1);
            var lblk: u64 = 0;
            var slot: u32 = 0;
            var rb = cfs_dir_find(fs, dir, name, len, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
            if (rb == 0) {
                rb = cfs_dir_remove_slot(fs, dir, lblk, slot, block);
            }
            if (rb != 0) {
                cfs_fail(fs, rb);
            }
        }
    }
    cfs_unlock_tree(fs);
    kfree(block as *mut void);
    return rc;
}

/// Whether directory `vn` is empty; -ENOMEM or -ENOTEMPTY when it is not known to be.
/// Safety: `fs` is a mounted filesystem's state, its lock held; `vn` a directory vnode of it.
unsafe fn emptyDir(fs: *mut cfs, vn: *mut vnode) -> i32 {
    let vb = kmalloc(CFS_BLOCK, 0) as *mut u8;
    let empty = !vb.isNull() && cfs_dir_is_empty(fs, vn, vb);
    kfree(vb as *mut void);
    return if (empty) 0 else if (vb.isNull()) -ENOMEM else -ENOTEMPTY;
}

/// Remove `name` from `dir`, naming `victim`: a file's name, or with `rmdir` an empty directory.
/// Safety: `dir` is a directory vnode of this filesystem, `victim` a vnode of it; `name` `len` bytes.
unsafe fn unlinkCommon(dir: *mut vnode, name: *CChar, len: usize, victim: *mut vnode, rmdir: bool) -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    var lrc = cfs_lock_tree_w(fs, dir);
    if (lrc != 0) {
        kfree(block as *mut void);
        return lrc;
    }
    // Every inode this changes, made writable before anything changes (CFS-6).
    lrc = cfs_vnode_prepare(fs, dir);
    if (lrc == 0) {
        lrc = cfs_vnode_prepare(fs, victim);
    }
    if (lrc != 0) {
        cfs_unlock_tree(fs);
        kfree(block as *mut void);
        return lrc;
    }
    var lblk: u64 = 0;
    var slot: u32 = 0;
    var rc = cfs_dir_find(fs, dir, name, len, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
    if (rc == 0 && entryIno(block, slot) != inoOf(ino(victim))) {
        rc = -ENOENT;
    }
    if (rc == 0 && rmdir) {
        rc = emptyDir(fs, victim);
    }
    let v = Ptr.toBorrowMut(victim);
    // Room for the orphan record's entry, taken while the name is still there. Past cfs_dir_remove_slot the removal is
    // in the transaction and "no memory to record it" would mean committing a deletion nothing records, which is this
    // unit's own defect on an allocation failure (docs/audit/next-subsystem-orphan.md).
    if (rc == 0 && (rmdir || v.nlink == 1) && !cfs_orphan_reserve(fs)) {
        rc = -ENOMEM;
    }
    if (rc == 0) {
        rc = cfs_dir_remove_slot(fs, dir, lblk, slot, block);
        if (rc == 0) {
            if (rmdir) {
                v.nlink = 0;
                let d = Ptr.toBorrowMut(dir);
                d.nlink = d.nlink.wrappingSub(1);
                rc = cfs_vnode_inode_sync(fs, dir);
            } else {
                v.nlink = v.nlink.wrappingSub(1);
            }
            // The name is gone from disk and the blocks are not free: something still holds this vnode, or will until
            // the VFS drops the last reference and cfs_evict runs. Record the intention, so that a crash or a forced
            // unmount before that eviction does not lose the inode and its blocks
            // (docs/audit/next-subsystem-orphan.md). A directory reaches this too: an empty one can be removed while a
            // process's working directory references it, which is a referenced vnode (`cwd_locked`).
            if (v.nlink == 0) {
                cfs_orphan_add(fs, v.ino);
            }
            v.ctime_ns = vfs_now_ns();
            if (rc == 0) {
                rc = cfs_vnode_inode_sync(fs, victim);
            }
        }
    }
    cfs_unlock_tree(fs);
    kfree(block as *mut void);
    return rc;
}

/// The VFS `unlink` operation.
/// Safety: as unlinkCommon.
@export("cfs_unlink")
unsafe fn unlink(dir: *mut vnode, name: *CChar, len: usize, victim: *mut vnode) -> i32 {
    if (cfs_tree_readonly(fsOf(dir), dir)) {
        return -EROFS;
    }
    return unlinkCommon(dir, name, len, victim, false);
}

/// Who a snapshot's deletion would take blocks from: its vnodes, beyond the one reference the deleting rmdir holds.
struct SnapUsers {
    tag: u32;
    victim: *vnode;
}

/// Whether `vn` is one of the snapshot's vnodes in use. A deletion frees the blocks only this snapshot reaches. An open
/// file inside it reads those blocks through extents it already holds, so a deletion under an open handle would hand
/// that reader whatever the allocator gave the blocks next. The snapshot is therefore busy while any of its vnodes is
/// in use, exactly as a mount is (V23). The victim is the snapshot's root directory, which rmdir itself holds one
/// reference on; anything beyond that, on it or on any other vnode of the snapshot, is somebody else's. Nothing new
/// can appear during the check: every path into the snapshot goes through .snapshots, whose lock this call holds, and
/// a walk already inside it holds a reference on the tagged vnode it is standing on.
/// Safety: `vn` is a cached vnode; `arg` a SnapUsers.
@callback
unsafe fn snapVnodeInUse(vn: *vnode, arg: *mut void) -> bool {
    let u = Ptr.toBorrow(arg as *SnapUsers);
    if (truncate<u32>(Ptr.toBorrow(vn).ino >> CFS_SNAP_INO_SHIFT) != u.tag) {
        return false;
    }
    let mine: u32 = if (vn == u.victim) 1 else 0;
    return kobject_refcount(borrow Ptr.toBorrow(vn).obj as *kobject) > mine;
}

/// Whether anything of the snapshot tagged `tag` is in use beyond `victim`'s one reference (`victim` null: none of it
/// the caller's).
/// Safety: `mnt` is a mount; `victim` null or a vnode.
@export("cfs_snap_in_use")
unsafe fn snapInUse(mnt: *mut mount, tag: u32, victim: *vnode) -> bool {
    var u = SnapUsers { tag: tag, victim: victim };
    return vnode_cache_any(mnt, snapVnodeInUse, borrow mut u as *mut SnapUsers as *mut void);
}

/// The VFS `rmdir` operation; in .snapshots, a snapshot deleted.
/// Safety: as unlinkCommon.
@export("cfs_rmdir")
unsafe fn rmdir(dir: *mut vnode, name: *CChar, len: usize, victim: *mut vnode) -> i32 {
    if (cfs_is_snapdir(dir)) {
        let fs = fsOf(dir);
        if (unusable(fs)) {
            return -EIO;
        }
        let mnt = Ptr.toBorrow(dir as *vnode).mnt;
        if ((Ptr.toBorrow(mnt as *mount).flags & MOUNT_RDONLY) != 0) {
            return -EROFS;
        }
        if (len > CFS_SNAP_NAME_MAX) {
            return -ENAMETOOLONG;
        }
        var buf = [0u8; 32];
        snapName(mut buf, name, len);
        mutex_lock(lockOf(fs));
        var sslot = [0u64; 16];
        let s = borrow mut sslot as *mut [u64; 16] as *mut cfs_snapshot;
        var tag: u32 = 0;
        var rc = cfs_snap_by_name(fs, name, len, s, borrow mut tag as *mut u32);
        if (rc == 0 && snapInUse(mnt, tag, victim as *vnode)) {
            rc = -EBUSY;
        }
        if (rc == 0) {
            rc = cfs_snapshot_delete(fs, borrow buf as *[u8; 32] as *CChar);
        }
        mutex_unlock(lockOf(fs));
        if (rc == 0) {
            snapSaid(buf, "deleted");
        }
        return rc;
    }
    if (cfs_tree_readonly(fsOf(dir), dir)) {
        return -EROFS;
    }
    return unlinkCommon(dir, name, len, victim, true);
}

// ---- rename ----

/// Point the entry at `slot` of `block` at `inum` of `kind`.
/// Safety: `block` is a directory block; `slot` below CFS_DIRENTS_PER_BLOCK.
unsafe fn repoint(block: *mut u8, slot: u32, inum: u64, kind: u32) {
    ByteOrder.writeU64LE(SliceMut.fromRaw(block, CFS_BLOCK), slot as usize * CFS_DIRENT_SIZE, inum);
    block.add(slot as usize * CFS_DIRENT_SIZE + DIRENT_TYPE).write(truncate<u8>(kind));
}

/// The VFS `rename` operation.
/// Safety: `odir` and `ndir` are directory vnodes of this filesystem, `victim` a vnode of it, `replaced` null or one;
/// the names their lengths in bytes.
@export("cfs_rename")
unsafe fn rename(odir: *mut vnode, oname: *CChar, olen: usize, victim: *mut vnode, ndir: *mut vnode, nname: *CChar,
    nlen: usize, replaced: *mut vnode) -> i32 {
    let fs = fsOf(odir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    if (nlen > CFS_NAME_MAX_LONG) {
        return -ENAMETOOLONG;
    }
    if (cfs_tree_readonly(fs, odir) || cfs_tree_readonly(fs, ndir)) {
        return -EROFS; // in .snapshots or a snapshot: what the tree was
    }
    if (cfs_snap_tag_of(odir) != cfs_snap_tag_of(ndir)) {
        return -EXDEV; // between the live tree and a clone, or two clones: two trees
    }
    let block = kmalloc(CFS_BLOCK, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    var lrc = cfs_lock_tree_w(fs, odir);
    if (lrc != 0) {
        kfree(block as *mut void);
        return lrc;
    }
    // Every inode this changes, made writable before anything changes (CFS-6).
    lrc = cfs_vnode_prepare(fs, odir);
    if (lrc == 0) {
        lrc = cfs_vnode_prepare(fs, ndir);
    }
    if (lrc == 0) {
        lrc = cfs_vnode_prepare(fs, victim);
    }
    if (lrc == 0 && !replaced.isNull()) {
        lrc = cfs_vnode_prepare(fs, replaced);
    }
    if (lrc != 0) {
        cfs_unlock_tree(fs);
        kfree(block as *mut void);
        return lrc;
    }
    let rc = renameLocked(fs, odir, oname, olen, victim, ndir, nname, nlen, replaced, block);
    cfs_unlock_tree(fs);
    kfree(block as *mut void);
    return rc;
}

/// rename's body, under the tree lock with every inode prepared.
/// Safety: as rename; `block` CFS_BLOCK writable bytes.
unsafe fn renameLocked(fs: *mut cfs, odir: *mut vnode, oname: *CChar, olen: usize, victim: *mut vnode,
    ndir: *mut vnode, nname: *CChar, nlen: usize, replaced: *mut vnode, block: *mut u8) -> i32 {
    var lblk: u64 = 0;
    var slot: u32 = 0;
    var rc = cfs_dir_find(fs, odir, oname, olen, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
    if (rc != 0) {
        return rc;
    }
    let vino = inoOf(ino(victim));
    if (entryIno(block, slot) != vino) {
        return -ENOENT;
    }
    let kind = block.add(slot as usize * CFS_DIRENT_SIZE + DIRENT_TYPE).read() as u32;

    // Order for failure safety: publish the destination first (the only step that can hit ENOSPC in a fresh block),
    // then retire the source; a failure before the source is removed leaves the namespace as it was, and a failure
    // after it is rolled back by removing the new entry again.
    var rl: u64 = 0;
    var rs: u32 = 0;
    if (!replaced.isNull()) {
        let rt = typeOf(replaced);
        if (rt == VNODE_DIR) {
            rc = emptyDir(fs, replaced);
            if (rc != 0) {
                return rc;
            }
        }
        // Room for the record's entry, while the namespace is still untouched: the replaced file loses its last name
        // below, and a rename that cannot record that must not happen at all.
        if ((rt == VNODE_DIR || Ptr.toBorrow(replaced as *vnode).nlink == 1) && !cfs_orphan_reserve(fs)) {
            return -ENOMEM;
        }
        // Overwrite the existing entry in place: same name, new inode.
        rc = cfs_dir_find(fs, ndir, nname, nlen, block, borrow mut rl as *mut u64, borrow mut rs as *mut u32);
        if (rc != 0) {
            return rc;
        }
        repoint(block, rs, vino, kind);
        rc = cfs_dir_write_block(fs, ndir, rl, block as *u8);
        if (rc != 0) {
            return rc;
        }
    } else {
        rc = cfs_names_allow(fs, nlen);
        if (rc == 0) {
            rc = cfs_dir_add(fs, ndir, nname, nlen, vino, kind, block);
        }
        if (rc != 0) {
            return rc;
        }
    }
    // The source block may have been the one just rewritten (same directory): locate the source entry again before
    // removing it.
    rc = cfs_dir_find(fs, odir, oname, olen, block, borrow mut lblk as *mut u64, borrow mut slot as *mut u32);
    if (rc == 0) {
        rc = cfs_dir_remove_slot(fs, odir, lblk, slot, block);
    }
    if (rc != 0) {
        // Roll the destination back so the source stays the only entry.
        var rb = cfs_dir_find(fs, ndir, nname, nlen, block, borrow mut rl as *mut u64, borrow mut rs as *mut u32);
        if (rb == 0) {
            if (!replaced.isNull()) {
                let rk = if (typeOf(replaced) == VNODE_DIR) CFS_TYPE_DIR else CFS_TYPE_REG;
                repoint(block, rs, inoOf(ino(replaced)), rk);
                rb = cfs_dir_write_block(fs, ndir, rl, block as *u8);
            } else {
                rb = cfs_dir_remove_slot(fs, ndir, rl, rs, block);
            }
        }
        if (rb != 0) {
            // Neither state can be reached: drop the whole transaction.
            cfs_fail(fs, rb);
        } else if (Ptr.toBorrow(fs as *cfs).failed == 0) { // a failed inode write abandoned it already
            var buffer = [0u8; 384];
            var line = TextWriter.create(mut buffer[..]);
            line.text("cosmofs: rename of ");
            line.bytes(Slice.fromRaw(oname as *u8, olen));
            line.text(" failed (");
            line.signed(rc as i64);
            line.text("); namespace restored");
            KernelLog.send(LogLevel.Error, line);
        }
        return rc;
    }
    // The namespace change is published. The metadata updates below are write-throughs into copy-on-write buffers; if
    // one of them fails the in-memory state can no longer be made consistent, so the whole open transaction is
    // abandoned: nothing of it reaches the disk and the last committed root remains the truth.
    if (!replaced.isNull()) {
        let r = Ptr.toBorrowMut(replaced);
        let rdir = typeOf(replaced) == VNODE_DIR;
        r.nlink = if (rdir) 0 else r.nlink.wrappingSub(1);
        // The same record, for the half of this that is easiest to miss: a file replaced by a rename while it is open.
        if (r.nlink == 0) {
            cfs_orphan_add(fs, r.ino);
        }
        if (rdir) {
            let n = Ptr.toBorrowMut(ndir);
            n.nlink = n.nlink.wrappingSub(1);
        }
        rc = cfs_vnode_inode_sync(fs, replaced);
    }
    if (rc == 0 && odir != ndir) {
        let vi = Ptr.toBorrowMut(inodeOf(victim));
        vi.parent = inoOf(ino(ndir));
        if (typeOf(victim) == VNODE_DIR) {
            let o = Ptr.toBorrowMut(odir);
            o.nlink = o.nlink.wrappingSub(1);
            let n = Ptr.toBorrowMut(ndir);
            n.nlink = n.nlink.wrappingAdd(1);
        }
        rc = cfs_vnode_inode_sync(fs, victim);
        if (rc == 0) {
            rc = cfs_vnode_inode_sync(fs, odir);
        }
        if (rc == 0) {
            rc = cfs_vnode_inode_sync(fs, ndir);
        }
    }
    if (rc != 0) {
        cfs_fail(fs, rc);
    }
    return rc;
}

// ---- readdir ----

/// One entry to readdir's reader: nonzero when it wants no more.
/// Safety: `arg` is `cb`'s argument; `name` holds `len` bytes.
unsafe fn emit(cb: extern "C" fn(*mut void, *CChar, usize, u64, vnode_type) -> i32, arg: *mut void, name: *CChar, len: usize, ino: u64, kind: u32) -> i32 =>
    cb(arg, name, len, ino, kind as vnode_type);

/// The walk of readdir from `*pos`: "." and ".." first, then every entry, a long name's continuations stepped over;
/// `*pos` left where the next call goes on, each entry given to `cb` with `arg`.
/// Safety: `dir` is a directory vnode of this filesystem; `pos` writable; `cb` a vfs_dirent_cb.
@export("cfs_readdir")
unsafe fn readdir(dir: *mut vnode, pos: *mut u64, cb: extern "C" fn(*mut void, *CChar, usize, u64, vnode_type) -> i32, arg: *mut void) -> i32 {
    let fs = fsOf(dir);
    if (unusable(fs)) {
        return -EIO; // unmounted, or the transaction was abandoned
    }
    if (pos.read() == 0) {
        if (emit(cb, arg, ".\0".ptr as *CChar, 1, ino(dir), VNODE_DIR) != 0) {
            return 0;
        }
        pos.write(1);
    }
    if (pos.read() == 1) {
        let parent = Ptr.toBorrow(inodeOf(dir) as *cfs_inode).parent;
        if (emit(cb, arg, "..\0".ptr as *CChar, 2, parent, VNODE_DIR) != 0) {
            return 0;
        }
        pos.write(2);
    }
    // The block, then room to assemble a long name (off the stack).
    let block = kmalloc(CFS_BLOCK + CFS_NAME_MAX_LONG, 0) as *mut u8;
    if (block.isNull()) {
        return -ENOMEM;
    }
    let name = block.add(CFS_BLOCK) as *mut CChar;
    mutex_lock(lockOf(fs));
    var rc: i32 = 0;
    let total = cfs_dir_blocks(dir as *vnode).wrappingMul(CFS_DIRENTS_PER_BLOCK);
    let d = block as *cfs_dirent;
    let ver = version(fs);
    var i = pos.read() - 2;
    while (i < total) {
        let lblk = i / CFS_DIRENTS_PER_BLOCK;
        let s = truncate<u32>(i % CFS_DIRENTS_PER_BLOCK);
        if (s == 0 || i == pos.read() - 2) {
            rc = cfs_dir_read_block(fs, dir, lblk, block);
            if (rc != 0) {
                break;
            }
        }
        let e = entryIno(block, s);
        if (e == CFS_DIRENT_CONT) {
            pos.write(i + 3); // the rest of a name: its head was returned, or changed under a resumed walk
            i += 1;
            continue;
        }
        if (e != 0) {
            let slots = cfs_dirent_check(d, s, ver);
            if (slots == 0) {
                rc = -EIO; // an on-disk length or shape must never size a copy
                break;
            }
            let nlen = cfs_dirent_name(d, s, name);
            let t = if (block.add(s as usize * CFS_DIRENT_SIZE + DIRENT_TYPE).read() as u32 == CFS_TYPE_DIR) VNODE_DIR
                else VNODE_REG;
            if (emit(cb, arg, name as *CChar, nlen as usize, e, t) != 0) {
                break;
            }
            i += (slots - 1) as u64; // past its continuations, which stay in this block
        }
        pos.write(i + 3);
        i += 1;
    }
    mutex_unlock(lockOf(fs));
    kfree(block as *mut void);
    return rc;
}
