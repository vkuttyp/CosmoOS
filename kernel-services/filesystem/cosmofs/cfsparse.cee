// cfsparse.cee - cosmofs's decoders of on-disk metadata (roadmap 2.0 SA5, the cosmofs family): metadata block headers
// and their CRC, directory entries, block addresses, and extents (batch 1); the records a mount reads first -- the
// superblock, a member label, the member table, the free and orphan records' counts, an inode slot (batch 2); the
// records snapshots, rollback and encryption keep -- a snapshot list's entries, the rollback record, a key slot
// (batch 3) -- every check made on bytes read from disk before they are trusted. They read the pool's geometry (fs->mem, fs->nmembers) and nothing else of its state; the
// version-14 MAC, which needs the pool's key, stays with its caller (cosmofs_core.c's cfs_mhdr_fault_of).
//
// A block is a slice of exactly CFS_BLOCK bytes, so no decoder can read past it. The on-disk integers are the
// structures' own, little-endian on both CosmoOS targets (cosmofs_format.h). tests/host/test_cfsparse.c holds these to
// the C they replaced: the same digests, over 20,000 rounds (batch 1) and 50,000 (batches 2 and 3). The copy-state check stays
// C: it compares a record with the live device's region size.

@header("kernel/crc32c.h", "cosmofs_internal.h")
extern "C" {
    @effects()
    fn crc32c(data: *void, len: usize) -> u32;
    @effects()
    fn crc32c_update(crc: u32, data: *void, len: usize) -> u32;
    struct cfs_memstate {
        nblocks: u64;
        first_usable: u64;
        base: u64;
    }

    struct cfs_extent {
        start: u64;
        count: u32;
        lblk: u32;
    }
    struct cfs_inode {
        nlink: u32;
        ino: u64;
        direct: [cfs_extent; 10];
    }
    struct cfs_member {
        nblocks: u64;
        first_usable: u64;
        alloc_root: u64;
        free_blocks: u64;
        copies: u32;
    }
    struct cfs_super {
        magic: [u8; 8];
        version: u32;
        block_size: u32;
        total_blocks: u64;
        generation: u64;
        imap_root: u64;
        alloc_root: u64;
        members: u64;
        key_root: u64;
        crc: u32;
    }
    struct cfs {
        sb: cfs_super;
        mem: *mut cfs_memstate;
        nmembers: u32;
    }
    struct cfs_buf {
        data: *mut u8;
    }
    struct cfs_rollback {
        magic: u32;
        version: u32;
        state: u32;
        flags: u32;
        crc: u32;
    }
    struct cfs_snapshot;
    struct cfs_keyslot {
        kind: u32;
        t_cost: u32;
        m_cost_kib: u32;
        lanes: u32;
    }
    struct cfs_label {
        magic: [u8; 8];
        index: u32;
        copy: u32;
        crc: u32;
    }
    struct cfs_dirent;
}

const BLOCK: usize = 4096;              // CFS_BLOCK
const CFS_MHDR_MAGIC: u32 = 0x4d534643; // "CFSM"
const MHDR_CRC_AT: usize = 24;          // offsetof(struct cfs_mhdr, crc)
const CSUM_NONE: u32 = 0;
const CSUM_CRC32C: u32 = 1;
// enum mhdr_fault (cosmofs_internal.h).
const MHDR_OK: u32 = 0;
const MHDR_MAGIC: u32 = 1;
const MHDR_BLKNO: u32 = 2;
const MHDR_KIND: u32 = 3;
const MHDR_ALGO: u32 = 4;
const MHDR_CRC: u32 = 5;

const DVA_VDEV_SHIFT: u64 = 56;
const DVA_BLK_MASK: u64 = 0x00ffffffffffffff;
const DVA_NONE: u64 = 0xffffffffffffffff;
const EXT_COMPRESSED: u32 = 0x80000000;
const EXT_ALGO_SHIFT: u32 = 24;
const EXT_ALGO_MASK: u32 = 0x7f;
const EXT_PSIZE_SHIFT: u32 = 16;
const EXT_PSIZE_MASK: u32 = 0xff;
const EXT_COUNT_MASK: u32 = 0xffff;
const RECORD_BLOCKS: u32 = 8; // CFS_RECORD_BLOCKS
const COMPRESS_LZ4: u32 = 1;
const DIRECT: usize = 10; // CFS_DIRECT

const DIRENT: usize = 64;  // sizeof(struct cfs_dirent)
const SLOTS: u32 = 64;     // CFS_BLOCK / sizeof(struct cfs_dirent)
const HEAD_NAME: u32 = 48; // CFS_DIRENT_HEAD_NAME
const CONT_NAME: u32 = 56; // CFS_DIRENT_CONT_NAME
const DIRENT_CONT: u64 = 0xffffffffffffffff;
const NAME_MAX: u32 = 47;       // CFS_NAME_MAX, below version 15
const NAME_MAX_LONG: u32 = 255; // CFS_NAME_MAX_LONG

fn le32(b: Slice<u8>, at: usize) -> u32 =>
    b[at] as u32 | (b[at + 1] as u32) << 8 | (b[at + 2] as u32) << 16 | (b[at + 3] as u32) << 24;

fn le64(b: Slice<u8>, at: usize) -> u64 => le32(b, at) as u64 | (le32(b, at + 4) as u64) << 32;

// --- metadata headers ------------------------------------------------------------------------------------------------

/// CRC32C over a block with the 4-byte crc field at `at` taken as zero.
/// Safety: crc32c and crc32c_update read the ranges given, all inside the block, and keep nothing.
fn blockCrc(b: Slice<u8>, at: usize) -> u32 {
    let zero: [u8; 4] = [0, 0, 0, 0];
    let head = b[..at];
    let tail = b[at + 4..];
    let z = zero[..];
    unsafe {
        let c = crc32c(head.ptr as *void, head.length);
        let d = crc32c_update(c, z.ptr as *void, 4);
        return crc32c_update(d, tail.ptr as *void, tail.length);
    }
}

/// A metadata block's header against its expected address and kind (0: any), then its CRC32C unless the caller checks
/// a MAC: an enum mhdr_fault.
fn mhdrDecode(b: Slice<u8>, blkno: u64, kind: u32, macOn: bool) -> u32 {
    if (le32(b, 0) != CFS_MHDR_MAGIC) {
        return MHDR_MAGIC;
    }
    if (le64(b, 16) != blkno) {
        return MHDR_BLKNO;
    }
    if (kind != 0 && le32(b, 4) != kind) {
        return MHDR_KIND;
    }
    if (macOn) {
        return MHDR_OK;
    }
    // CRC32C is the only algorithm the format computes; 0 is a pre-v11 image's zeroed pad and also CRC32C.
    let algo = le32(b, 28);
    if (algo != CSUM_NONE && algo != CSUM_CRC32C) {
        return MHDR_ALGO;
    }
    if (blockCrc(b, MHDR_CRC_AT) != le32(b, MHDR_CRC_AT)) {
        return MHDR_CRC;
    }
    return MHDR_OK;
}

// --- addresses -------------------------------------------------------------------------------------------------------

/// The geometry of member `v` (below fs->nmembers).
/// Safety: fs->mem holds fs->nmembers entries, and the caller checked `v` against it.
fn member(fs: borrow cfs, v: u32) -> borrow cfs_memstate =>
    unsafe { Ptr.toBorrow(fs.mem.add(v as usize) as *cfs_memstate) };

/// Whether `dva` names a usable block of one of the pool's members.
fn dvaValid(fs: borrow cfs, dva: u64) -> bool {
    let v = truncate<u32>(dva >> DVA_VDEV_SHIFT); // 8 bits
    if (v >= fs.nmembers) {
        return false;
    }
    let m = member(fs, v);
    let b = dva & DVA_BLK_MASK;
    return b >= m.first_usable && b < m.nblocks;
}

/// `dva` in the allocator's linear space, or DVA_NONE when it is not the pool's.
fn dvaLin(fs: borrow cfs, dva: u64) -> u64 {
    let v = truncate<u32>(dva >> DVA_VDEV_SHIFT);
    if (v >= fs.nmembers) {
        return DVA_NONE;
    }
    let m = member(fs, v);
    let b = dva & DVA_BLK_MASK;
    if (b >= m.nblocks) {
        return DVA_NONE;
    }
    return m.base + b;
}

// --- extents ---------------------------------------------------------------------------------------------------------

/// Logical blocks a run covers, from its count word.
fn extCount(count: u32) -> u32 => if ((count & EXT_COMPRESSED) != 0) count & EXT_COUNT_MASK else count;

/// A run read from disk: on one member, whole, of a size a record can hold if it is compressed (and then LZ4), and not
/// wrapping the 32-bit logical block.
fn extentValid(fs: borrow cfs, e: borrow cfs_extent) -> bool {
    let compressed = (e.count & EXT_COMPRESSED) != 0;
    let count = extCount(e.count);
    let psize = if (compressed) ((e.count >> EXT_PSIZE_SHIFT) & EXT_PSIZE_MASK) + 1 else count;
    if (count == 0 || psize == 0) {
        return false;
    }
    if (compressed) {
        if (count > RECORD_BLOCKS || psize > count) {
            return false;
        }
        if (((e.count >> EXT_ALGO_SHIFT) & EXT_ALGO_MASK) != COMPRESS_LZ4) {
            return false; // nothing else can be read back
        }
    }
    if (!dvaValid(fs, e.start)) {
        return false;
    }
    // e.start is valid, so its block is below 2^56 and the last block's address does not overflow.
    let last = e.start + psize as u64 - 1;
    return dvaValid(fs, last) && (e.start >> DVA_VDEV_SHIFT) == (last >> DVA_VDEV_SHIFT) &&
        e.lblk as u64 + count as u64 <= 0x100000000;
}

/// An inode's direct runs as read from disk: in range, sorted, no overlap, no run after the first empty slot.
fn directValid(fs: borrow cfs, inode: borrow cfs_inode) -> bool {
    var n: usize = 0;
    while (n < DIRECT && extCount(inode.direct[n].count) != 0) {
        n += 1;
    }
    for (i in n..DIRECT) {
        let e = borrow inode.direct[i];
        if (e.count != 0 || e.start != 0 || e.lblk != 0) {
            return false; // a run hiding behind an empty slot
        }
    }
    for (i in 0..n) {
        if (!extentValid(fs, borrow inode.direct[i])) {
            return false;
        }
        if (i > 0) {
            let p = borrow inode.direct[i - 1];
            if ((inode.direct[i].lblk as u64) < p.lblk as u64 + extCount(p.count) as u64) {
                return false;
            }
        }
    }
    return true;
}

// --- directory entries ------------------------------------------------------------------------------------------------

/// The continuations a name of `len` bytes needs.
fn direntExtra(len: u32) -> u32 => if (len <= HEAD_NAME) 0 else (len - HEAD_NAME + CONT_NAME - 1) / CONT_NAME;

/// The entry whose head is slot `s` of the block, checked before a byte of its name is read: the slots it takes
/// (1 + extra), or 0 when it is not a well-formed head for a pool of `version` -- free, a continuation, an impossible
/// length, a wrong `extra`, a run that leaves the block, or a continuation that is not marked.
fn direntCheck(b: Slice<u8>, s: u32, version: u32) -> u32 {
    if (s >= SLOTS) {
        return 0;
    }
    let at = s as usize * DIRENT;
    let ino = le64(b, at);
    let namelen = b[at + 9] as u32;
    let extra = b[at + 10] as u32;
    if (ino == 0 || ino == DIRENT_CONT || namelen == 0) {
        return 0;
    }
    let max = if (version >= 15) NAME_MAX_LONG else NAME_MAX;
    if (namelen > max || extra != direntExtra(namelen)) {
        return 0;
    }
    if (s + extra >= SLOTS) {
        return 0;
    }
    for (k in 1..extra + 1) {
        if (le64(b, (s + k) as usize * DIRENT) != DIRENT_CONT) {
            return 0;
        }
    }
    return 1 + extra;
}

/// Where the name's bytes from `n` on lie, as a range of the block: in the head's 48 bytes, then in each continuation's
/// 56, up to `len`.
fn segment(s: u32, n: u32, len: u32) -> Seg {
    if (n < HEAD_NAME) {
        let take = if (len < HEAD_NAME) len - n else HEAD_NAME - n;
        return Seg { at: s as usize * DIRENT + 16 + n as usize, count: take };
    }
    let k = (n - HEAD_NAME) / CONT_NAME + 1;
    let i = (n - HEAD_NAME) % CONT_NAME;
    let left = CONT_NAME - i;
    let take = if (len - n < left) len - n else left;
    return Seg { at: (s + k) as usize * DIRENT + 8 + i as usize, count: take };
}

/// A run of name bytes in a block.
struct Seg {
    at: usize;
    count: u32;
}

// --- the mount's first records (batch 2) -----------------------------------------------------------------------------

const SUPER: usize = 168;                    // sizeof(struct cfs_super)
const SUPER_CRC_AT: usize = 160;             // offsetof(struct cfs_super, crc)
const CFS_MAGIC: u64 = 0x3153464f4d534f43;   // "COSMOFS1"
const VERSION_MIN: u32 = 2;                  // CFS_VERSION_MIN
const VERSION: u32 = 15;                     // CFS_VERSION
const MAX_MEMBERS: u64 = 255;                // CFS_MAX_MEMBERS
const MAX_BLOCKS: u64 = 16516096;            // CFS_MAX_BLOCKS
const MIN_BLOCKS: u64 = 64;                  // CFS_MIN_BLOCKS
const BITS_PER_BITMAP: u64 = 32512;          // CFS_BITS_PER_BITMAP
const PTRS_PER_BLOCK: u64 = 508;             // CFS_PTRS_PER_BLOCK
const MAX_COPIES: u32 = 4;                   // CFS_MAX_COPIES
const MEMBERS_PER_BLOCK: u64 = 63;           // CFS_MEMBERS_PER_BLOCK
const DEAD_PER_BLOCK: u64 = 506;             // CFS_DEAD_PER_BLOCK, CFS_FREELOG_PER_BLOCK, CFS_ORPHANS_PER_BLOCK
const LABEL_MAGIC: u64 = 0x52424d4f4d534f43; // "COSMOMBR"
const LABEL_CRC_AT: usize = 72;              // offsetof(struct cfs_label, crc)

fn versionOk(v: u32) -> bool => v >= VERSION_MIN && v <= VERSION;

/// An 8-byte magic as the little-endian word it is compared as.
fn magic64(m: borrow [u8; 8]) -> u64 =>
    m[0] as u64 | (m[1] as u64) << 8 | (m[2] as u64) << 16 | (m[3] as u64) << 24 | (m[4] as u64) << 32 |
        (m[5] as u64) << 40 | (m[6] as u64) << 48 | (m[7] as u64) << 56;

/// Magic, and a version this kernel reads.
fn superIdentOk(sb: borrow cfs_super) -> bool => magic64(borrow sb.magic) == CFS_MAGIC && versionOk(sb.version);

/// Whether a version-4 pointer has a DVA's shape: a member the pool can have, a block a member can have.
fn dvaShapeOk(d: u64) -> bool => (d >> DVA_VDEV_SHIFT) < MAX_MEMBERS && (d & DVA_BLK_MASK) < MAX_BLOCKS;

/// The mount's own check of a superblock slot, before its seal: identity, block size, a size and a generation, and
/// its pointers' shape. The member table is not read yet -- this very block names it -- so a pointer can only be
/// checked for shape; before version 4 there is one member, `dev0` blocks, and the old exact checks hold.
fn superShapeOk(sb: borrow cfs_super, dev0: u64) -> bool {
    if (!superIdentOk(sb) || sb.block_size as usize != BLOCK || sb.total_blocks == 0 || sb.generation == 0) {
        return false;
    }
    if (sb.version >= 4) {
        return sb.total_blocks <= MAX_BLOCKS * MAX_MEMBERS && dvaShapeOk(sb.imap_root) && dvaShapeOk(sb.members);
    }
    return sb.total_blocks == dev0 && sb.imap_root < dev0 && sb.alloc_root < dev0;
}

/// cfs_super_peek's check: identity, a generation, and the CRC unless a MAC (which it does not verify) seals it.
fn superPeekOk(sb: borrow cfs_super, b: Slice<u8>) -> bool {
    if (!superIdentOk(sb) || sb.generation == 0) {
        return false;
    }
    let mac = sb.version >= 14 && sb.key_root != 0; // cfs_super_is_mac
    return mac || blockCrc(b, SUPER_CRC_AT) == sb.crc;
}

/// A label's identity: magic, and a member index and copy in range.
fn labelShapeOk(l: borrow cfs_label) -> bool =>
    magic64(borrow l.magic) == LABEL_MAGIC && (l.index as u64) < MAX_MEMBERS && l.copy < MAX_COPIES;

/// A member table entry, for member `v` of `nmembers`.
fn memberSane(m: borrow cfs_member, v: u32, nmembers: u32) -> bool {
    if (m.nblocks < MIN_BLOCKS || m.nblocks > MAX_BLOCKS) {
        return false;
    }
    // One allocation index holds PTRS_PER_BLOCK chunk pointers, so a member that claims more chunks than that would be
    // read past the end of its index block.
    if ((m.nblocks + BITS_PER_BITMAP - 1) / BITS_PER_BITMAP > PTRS_PER_BLOCK) {
        return false;
    }
    let first: u64 = if (v == 0) 2 else 1; // the superblocks, or the label
    if (m.first_usable < first || m.first_usable >= m.nblocks) {
        return false;
    }
    // A member's allocation index is normally on that member, but a member with no free block leaves its replacement
    // elsewhere rather than wedging the filesystem: only that the address could name a block of this pool is checked.
    if ((m.alloc_root >> DVA_VDEV_SHIFT) >= nmembers as u64) {
        return false;
    }
    return m.copies <= MAX_COPIES && m.free_blocks <= m.nblocks;
}

// --- snapshots, rollback and key slots (batch 3) ---------------------------------------------------------------------

const MHDR_SIZE: usize = 32;     // CFS_MHDR_SIZE
const SNAP: usize = 128;         // sizeof(struct cfs_snapshot)
const SNAP_NAME: usize = 96;     // offsetof(struct cfs_snapshot, name)
const SNAP11: usize = 96;        // sizeof(struct cfs_snapshot_v11)
const SNAP11_NAME: usize = 64;   // offsetof(struct cfs_snapshot_v11, name)
const SNAPS2: u32 = 31;          // CFS_SNAPS_PER_BLOCK2
const SNAPS: u32 = 42;           // CFS_SNAPS_PER_BLOCK
const SNAP_NAME_MAX: usize = 31; // CFS_SNAP_NAME_MAX

const ROLLBACK: usize = 120;            // sizeof(struct cfs_rollback)
const ROLLBACK_CRC_AT: usize = 112;     // offsetof(struct cfs_rollback, crc)
const ROLLBACK_MAGIC: u32 = 0x42524643; // "CFRB"
const ROLLBACK_PENDING: u32 = 1;
const ROLLBACK_HELD: u32 = 2;
const ROLLBACK_F_FROM_HELD: u32 = 1;
const TARGET_UUID: usize = 16; // offsetof(struct cfs_rollback, target_uuid)
const SAFETY_UUID: usize = 32; // offsetof(struct cfs_rollback, safety_uuid)
const EIO: i32 = 5;

const KEYSLOT_EMPTY: u32 = 0;
const KEYSLOT_PASSPHRASE: u32 = 1;
const KEYSLOT_KEYFILE: u32 = 2;
const ARGON2_LANES_MAX: u32 = 0xffffff; // RFC 9106: lanes below 2^24, so 8 * lanes stays below 2^27

/// Entry `i` of a snapshot list's payload into `out` (a struct cfs_snapshot's bytes), false when the slot is empty or
/// past the layout's end, and then `out` is untouched. From version 12 an entry is the in-memory one; before, the
/// version-11 entry is widened: its eight words, then its name, the fields it lacks zero.
fn snaplistGet(version: u32, data: Slice<u8>, i: u32, out: SliceMut<u8>) -> bool {
    if (version >= 12) {
        if (i >= SNAPS2) {
            return false;
        }
        let at = MHDR_SIZE + 16 + i as usize * SNAP;
        if (data[at + SNAP_NAME] == 0) {
            return false;
        }
        out.copyFrom(data[at..at + SNAP]);
    } else {
        if (i >= SNAPS) {
            return false;
        }
        let at = MHDR_SIZE + 8 + i as usize * SNAP11;
        if (data[at + SNAP11_NAME] == 0) {
            return false;
        }
        out.fill(0);
        out[0..SNAP11_NAME].copyFrom(data[at..at + SNAP11_NAME]);
        out[SNAP_NAME..SNAP].copyFrom(data[at + SNAP11_NAME..at + SNAP11]);
    }
    out[SNAP_NAME + SNAP_NAME_MAX] = 0;
    return true;
}

fn uuidZero(r: Slice<u8>, at: usize) -> bool => le64(r, at) == 0 && le64(r, at + 8) == 0;

/// The rollback record `r` (ROLLBACK bytes), whose fields `o` are: 0, or -EIO when it is damaged or means nothing --
/// a wrong magic, version or CRC, an unknown state or flag, a held record with a flag, no safety snapshot, or a pending
/// one with no target or whose target is its safety snapshot (it would keep nothing of the tree it replaces).
fn rollbackCheck(r: Slice<u8>, o: borrow cfs_rollback) -> i32 {
    if (o.magic != ROLLBACK_MAGIC || o.version != 1 || blockCrc(r, ROLLBACK_CRC_AT) != o.crc) {
        return -EIO;
    }
    if (o.state != ROLLBACK_PENDING && o.state != ROLLBACK_HELD) {
        return -EIO;
    }
    if ((o.flags & (ROLLBACK_F_FROM_HELD ^ 0xffffffff)) != 0 || (o.state == ROLLBACK_HELD && o.flags != 0)) {
        return -EIO;
    }
    if (uuidZero(r, SAFETY_UUID)) {
        return -EIO;
    }
    if (o.state == ROLLBACK_PENDING &&
        (uuidZero(r, TARGET_UUID) ||
            (le64(r, TARGET_UUID) == le64(r, SAFETY_UUID) && le64(r, TARGET_UUID + 8) == le64(r, SAFETY_UUID + 8)))) {
        return -EIO;
    }
    return 0;
}

/// A key slot's shape, as user space sealed it (the kernel cannot open one: that needs the passphrase): empty; a
/// passphrase's Argon2id parameters user space can derive with (userland/lib/argon2.c); or a key file, in slot 0 only.
fn keyslotValid(index: u32, s: borrow cfs_keyslot) -> bool {
    if (s.kind == KEYSLOT_EMPTY) {
        return true;
    }
    if (s.kind == KEYSLOT_PASSPHRASE) {
        return s.t_cost >= 1 && s.lanes >= 1 && s.lanes <= ARGON2_LANES_MAX && s.m_cost_kib >= 8 * s.lanes;
    }
    return s.kind == KEYSLOT_KEYFILE && index == 0;
}

// --- the exports -----------------------------------------------------------------------------------------------------

/// Safety: `block` points to CFS_BLOCK readable bytes.
@export("cfs_block_crc")
unsafe fn blockCrcC(block: *u8, crcOff: usize) -> u32 => blockCrc(Slice.fromRaw(block, BLOCK), crcOff);

/// Safety: `block` points to CFS_BLOCK readable bytes.
@export("cfs_mhdr_decode")
unsafe fn mhdrDecodeC(block: *void, blkno: u64, kind: u32, macOn: bool) -> u32 =>
    mhdrDecode(Slice.fromRaw(block as *u8, BLOCK), blkno, kind, macOn);

/// Safety: `fs` is a mounted pool's (or a test's), whose mem holds nmembers entries.
@export("cfs_dva_valid")
unsafe fn dvaValidC(fs: *cfs, dva: u64) -> bool => dvaValid(Ptr.toBorrow(fs), dva);

/// Safety: as cfs_dva_valid.
@export("cfs_dva_lin")
unsafe fn dvaLinC(fs: *cfs, dva: u64) -> u64 => dvaLin(Ptr.toBorrow(fs), dva);

/// Safety: as cfs_dva_valid; `e` is readable.
@export("cfs_extent_valid")
unsafe fn extentValidC(fs: *cfs, e: *cfs_extent) -> bool => extentValid(Ptr.toBorrow(fs), Ptr.toBorrow(e));

/// Safety: as cfs_dva_valid; `inode` is readable.
@export("cfs_direct_valid")
unsafe fn directValidC(fs: *cfs, inode: *cfs_inode) -> bool => directValid(Ptr.toBorrow(fs), Ptr.toBorrow(inode));

/// Runs read from disk, `n` of them: each in range, sorted, no overlap.
/// Safety: as cfs_dva_valid; `ext` points to `n` readable runs.
@export("cfs_extents_valid")
unsafe fn extentsValidC(fs: *cfs, ext: *cfs_extent, n: u32) -> bool {
    let f = Ptr.toBorrow(fs);
    for (i in 0..n) {
        let e = Ptr.toBorrow(ext.add(i as usize));
        if (!extentValid(f, e)) {
            return false;
        }
        if (i > 0) {
            let p = Ptr.toBorrow(ext.add(i as usize - 1));
            if ((e.lblk as u64) < p.lblk as u64 + extCount(p.count) as u64) {
                return false;
            }
        }
    }
    return true;
}

@export("cfs_dirent_extra")
fn direntExtraC(len: u32) -> u32 => direntExtra(len);

/// Safety: `blk` points to a CFS_BLOCK directory block.
@export("cfs_dirent_check")
unsafe fn direntCheckC(blk: *cfs_dirent, s: u32, version: u32) -> u32 =>
    direntCheck(Slice.fromRaw(blk as *u8, BLOCK), s, version);

/// The checked entry's name into `out` (CFS_NAME_MAX_LONG bytes at least, not terminated); its length.
/// Safety: `blk` points to a CFS_BLOCK directory block whose slot `s` cfs_dirent_check accepted; `out` is writable.
@export("cfs_dirent_name")
unsafe fn direntNameC(blk: *cfs_dirent, s: u32, out: *mut CChar) -> u32 {
    let b = Slice.fromRaw(blk as *u8, BLOCK);
    let len = b[s as usize * DIRENT + 9] as u32;
    let o = SliceMut.fromRaw(out as *mut u8, NAME_MAX_LONG as usize);
    // A segment at a time: the head's bytes, then each continuation's (one copy each, not one check per byte).
    var n: u32 = 0;
    while (n < len) {
        let g = segment(s, n, len);
        let c = g.count as usize;
        o[n as usize..n as usize + c].copyFrom(b[g.at..g.at + c]);
        n += g.count;
    }
    return len;
}

/// Whether the checked entry at slot `s` is `name` (`len` bytes): 1 or 0.
/// Safety: as cfs_dirent_name; `name` points to `len` readable bytes.
@export("cfs_dirent_name_eq")
unsafe fn direntNameEqC(blk: *cfs_dirent, s: u32, name: *CChar, len: u32) -> i32 {
    let b = Slice.fromRaw(blk as *u8, BLOCK);
    if (b[s as usize * DIRENT + 9] as u32 != len) {
        return 0;
    }
    let want = Slice.fromRaw(name as *u8, len as usize);
    var n: u32 = 0;
    while (n < len) {
        let g = segment(s, n, len);
        let c = g.count as usize;
        let have = b[g.at..g.at + c];
        let theirs = want[n as usize..n as usize + c];
        for (k in 0..c) {
            if (have[k] != theirs[k]) {
                return 0;
            }
        }
        n += g.count;
    }
    return 1;
}

/// Safety: `sb` points to a readable struct cfs_super.
@export("cfs_super_ident_ok")
unsafe fn superIdentOkC(sb: *cfs_super) -> bool => superIdentOk(Ptr.toBorrow(sb));

/// Safety: as cfs_super_ident_ok.
@export("cfs_super_shape_ok")
unsafe fn superShapeOkC(sb: *cfs_super, dev0: u64) -> bool => superShapeOk(Ptr.toBorrow(sb), dev0);

/// The superblock's CRC32C (a CRC'd one: not version 14's MAC).
/// Safety: `block` points to CFS_BLOCK readable bytes, a superblock.
@export("cfs_super_crc_ok")
unsafe fn superCrcOkC(block: *void) -> bool =>
    blockCrc(Slice.fromRaw(block as *u8, BLOCK), SUPER_CRC_AT) == Ptr.toBorrow(block as *cfs_super).crc;

/// Safety: as cfs_super_crc_ok.
@export("cfs_super_peek_ok")
unsafe fn superPeekOkC(block: *void) -> bool =>
    superPeekOk(Ptr.toBorrow(block as *cfs_super), Slice.fromRaw(block as *u8, BLOCK));

/// A label's CRC32C, its crc field taken as zero.
/// Safety: `block` points to CFS_BLOCK readable bytes.
@export("cfs_label_crc")
unsafe fn labelCrcC(block: *u8) -> u32 => blockCrc(Slice.fromRaw(block, BLOCK), LABEL_CRC_AT);

/// A label's CRC32C (a CRC'd one: the MAC is the caller's).
/// Safety: `block` points to CFS_BLOCK readable bytes, a label.
@export("cfs_label_crc_ok")
unsafe fn labelCrcOkC(block: *u8) -> bool =>
    blockCrc(Slice.fromRaw(block, BLOCK), LABEL_CRC_AT) == Ptr.toBorrow(block as *cfs_label).crc;

/// Safety: `block` points to CFS_BLOCK readable bytes, a label.
@export("cfs_label_shape_ok")
unsafe fn labelShapeOkC(block: *void) -> bool => labelShapeOk(Ptr.toBorrow(block as *cfs_label));

/// Safety: `m` is readable.
@export("cfs_member_sane")
unsafe fn memberSaneC(m: *cfs_member, v: u32, nmembers: u32) -> bool => memberSane(Ptr.toBorrow(m), v, nmembers);

/// The member table's count: at least one, no more than a block holds or the pool can address.
@export("cfs_members_count_ok")
fn membersCountOkC(count: u64) -> bool => count != 0 && count <= MEMBERS_PER_BLOCK && count <= MAX_MEMBERS;

/// A free record's count: no more than a block holds.
@export("cfs_freelog_count_ok")
fn freelogCountOkC(count: u64) -> bool => count <= DEAD_PER_BLOCK;

/// An orphan record's count: no more than a block holds.
@export("cfs_orphan_count_ok")
fn orphanCountOkC(count: u64) -> bool => count <= DEAD_PER_BLOCK;

/// An inode slot read for inode `ino`: that inode's, and in use.
/// Safety: `inode` is readable.
@export("cfs_inode_slot_ok")
unsafe fn inodeSlotOkC(inode: *cfs_inode, ino: u64) -> bool {
    let i = Ptr.toBorrow(inode);
    return i.ino == ino && i.nlink != 0;
}

/// The rollback record's CRC32C: over the record with its crc field zero.
/// Safety: `r` points to a readable struct cfs_rollback.
@export("cfs_rollback_crc")
unsafe fn rollbackCrcC(r: *cfs_rollback) -> u32 => blockCrc(Slice.fromRaw(r as *u8, ROLLBACK), ROLLBACK_CRC_AT);

/// The record at `payload` copied into `out`, and checked: 0 or -EIO.
/// Safety: `payload` points to ROLLBACK readable bytes, `out` to a writable struct cfs_rollback apart from them.
@export("cfs_rollback_parse")
unsafe fn rollbackParseC(payload: *void, out: *mut cfs_rollback) -> i32 {
    let o = SliceMut.fromRaw(out as *mut u8, ROLLBACK);
    o.copyFrom(Slice.fromRaw(payload as *u8, ROLLBACK));
    return rollbackCheck(Slice.fromRaw(out as *u8, ROLLBACK), Ptr.toBorrow(out as *cfs_rollback));
}

/// Entry `i` of a list block, false when the slot is empty; by the pool's version.
/// Safety: `fs` is a mounted pool's (or a test's); `b` holds a CFS_BLOCK block; `out` is a writable struct
/// cfs_snapshot.
@export("cfs_snaplist_get")
unsafe fn snaplistGetC(fs: *cfs, b: *cfs_buf, i: u32, out: *mut cfs_snapshot) -> bool =>
    snaplistGet(
        Ptr.toBorrow(fs).sb.version,
        Slice.fromRaw(Ptr.toBorrow(b).data as *u8, BLOCK),
        i,
        SliceMut.fromRaw(out as *mut u8, SNAP),
    );

/// Safety: `s` is readable.
@export("cfs_keyslot_valid")
unsafe fn keyslotValidC(index: u32, s: *cfs_keyslot) -> bool => keyslotValid(index, Ptr.toBorrow(s));
