// cosmofstest_copies.cee - cosmofs's self-tests of a pool's copies, in CeeSafe: roadmap 2.0 SA7.
//
// Copy state (roadmap 1.2 B3; design.md, "Format version 13"; invariants CF25, CF26, CF27): two-way mirrors on RAM
// devices; a device is "pulled" by making every request to it answer -ENODEV (ramblk_set_fail), the block layer's
// answer for an unregistered device, so it can come back with what it held. Resilvering (design.md, "Resilvering";
// invariants CF28, CF29): the resilver thread is held (cosmofs_test_resilver_hold) and the tests drive it with
// cosmofs_test_resilver_run, so where it stops is the test's choice. All of them are a debug build's.
//
// A C test that jumped to its cleanup is here a body that returns at its first failed check and a caller that cleans
// up after it, whatever it returned; what the cleanup releases is a `Rig` the two share. The pool, its copies, the
// statistics and the requests stay C (kernel/storage.h, kernel/cosmofs.h, cosmofs_internal.h).

@header("kernel/blk.h", "kernel/vfs.h", "kernel/kmalloc.h", "kernel/ramblk.h", "kernel/string.h", "kernel/storage.h",
    "kernel/cosmofs.h", "uapi/cosmo/syscall.h", "cosmofs_internal.h", "kernel/errno.h", "kernel/selftest.h",
    "cosmofs_format.h")
extern "C" {
    struct blkdev {
        name: [u8; 16];
    }
    struct mount {
        fs_priv: *mut void;
    }
    struct vnode {
        ino: u64;
    }
    struct file {
        vn: *mut vnode;
    }
    struct pool_copy {
        dev: *mut blkdev;
        state: u32; // enum pool_copy_state
        whole: bool;
        since: u64;
        cursor: u64;
        write_errors: u32;
        peer: u64;
    }
    struct spool_member {
        copy: [pool_copy; 4];
        ncopies: u32;
        nblocks: u64;
        region_blocks: u32;
    }
    struct spool {
        m: *mut spool_member;
        state_seq: u64;
        nspares: u32;
        spare: [*mut blkdev; 4];
    }
    struct cfs_memstate {
        nblocks: u64;
        first_usable: u64;
    }
    struct cfs {
        mem: *mut cfs_memstate;
    }
    struct ramblk_write {
        nsectors: u32;
    }
    struct ramblk_log {
        w: *mut ramblk_write;
        n: u32;
        dropped: u32;
    }
    struct cosmofs_stats {
        generation: u64;
        devices: u32;
        degraded: u64;
        version: u32;
    }
    struct cosmofs_scrub_stats {
        repaired: u64;
        unrecoverable: u64;
        bad_copies: u64;
    }
    struct cosmofs_pool_req {
        op: u32; // enum cosmofs_pool_op
        name: *CChar;
        name2: *CChar;
    }
    struct cfs_super {
        generation: u64;
    }

    fn ramblk_create(nblocks: u64) -> *mut blkdev;
    fn ramblk_destroy(bd: *mut blkdev);
    fn ramblk_set_fail(bd: *mut blkdev, err: i32);
    fn ramblk_set_fail_writes(bd: *mut blkdev, err: i32);
    fn ramblk_record_start(bd: *mut blkdev, max: u32);
    fn ramblk_record_stop(bd: *mut blkdev) -> *mut ramblk_log;
    fn ramblk_log_free(log: *mut ramblk_log);
    fn pool_open(bd: *mut blkdev, out: *mut *mut spool) -> i32;
    fn pool_close(p: *mut spool);
    fn pool_add_copy(p: *mut spool, vdev: u32, bd: *mut blkdev) -> i32;
    fn pool_degraded(p: *spool) -> bool;
    fn pool_commit_done(p: *mut spool, gen: u64);
    fn pool_read(p: *mut spool, dva: u64, buf: *mut void) -> i32;
    fn pool_write(p: *mut spool, dva: u64, buf: *void) -> i32;
    fn pool_flush(p: *mut spool) -> i32;
    fn pool_read_copy(p: *mut spool, dva: u64, copy: u32, buf: *mut void) -> i32;
    fn pool_copy_readable(p: *spool, dva: u64, c: u32) -> bool;
    fn pool_copy_online(p: *spool, vdev: u32, c: u32) -> bool;
    fn pool_copy_missed(p: *spool, dva: u64, c: u32) -> bool;
    fn pool_copy_any_missed(p: *spool, vdev: u32, c: u32) -> bool;
    fn pool_copy_set_state(p: *mut spool, vdev: u32, c: u32, state: u32, why: i32) -> i32;
    fn pool_find_dev(p: *spool, bd: *blkdev, vdev: *mut u32, c: *mut u32) -> bool;
    fn vfs_open(start: *mut vnode, path: *CChar, flags: u32, mode: u32, out: *mut *mut file) -> i32;
    fn vfs_mkdir(start: *mut vnode, path: *CChar, mode: u32) -> i32;
    fn vfs_rmdir(start: *mut vnode, path: *CChar) -> i32;
    fn vfs_mount(path: *CChar, fsname: *CChar, bd: *mut blkdev, flags: u32) -> i32;
    fn vfs_umount2(path: *CChar, flags: u32) -> i32;
    fn vfs_sync() -> i32;
    fn vfs_mounts_render(out: *mut CChar, n: usize) -> i32;
    fn vfs_bdev_mounted(bd: *blkdev) -> bool;
    fn vfs_format(fsname: *CChar, bd: *mut blkdev, label: *CChar) -> i32;
    fn file_read(f: *mut file, buf: *mut void, len: usize) -> i64;
    fn cosmofs_format_mirror(bd: *mut *mut blkdev, n: u32, copies: u32) -> i32;
    fn cosmofs_poolctl(mnt: *mut mount, req: *mut cosmofs_pool_req) -> i32;
    fn cosmofs_scrub(mnt: *mut mount, out: *mut cosmofs_scrub_stats, flags: u32) -> i32;
    fn cosmofs_test_pool(mnt: *mut mount) -> *mut spool;
    fn cosmofs_test_set_writeback(mnt: *mut mount, on: bool);
    fn cosmofs_test_resilver_hold(hold: bool);
    fn cosmofs_test_resilver_run(mnt: *mut mount, blocks: u64) -> i32;
    fn cosmofs_test_block_of(mnt: *mut mount, ino: u64, lblk: u64, dva: *mut u64) -> i32;
    fn cfs_super_slots(bd: *mut blkdev, a: *mut cfs_super, ra: *mut i32, b: *mut cfs_super, rb: *mut i32) -> i32;
    fn cfs_dva_lin(fs: *cfs, dva: u64) -> u64;
    fn cfs_bitmap_test(fs: *cfs, lin: u64) -> bool;
    fn kzalloc(size: usize) -> *mut void;
    fn memcmp(a: *void, b: *void, n: usize) -> i32;
    fn memset(p: *mut void, c: i32, n: usize) -> *mut void;
    fn strchr(s: *CChar, c: i32) -> *mut CChar;
    fn strstr(s: *CChar, needle: *CChar) -> *mut CChar;
    /// cosmofs.h's cosmofs_stats, whose name its struct has too (ADR 0080 §3.5).
    @cname("cosmofs_stats")
    fn cfst_stats(mnt: *mut mount, out: *mut cosmofs_stats) -> i32;
    /// pool.cee's sysctl fs.fault_errors (storage.h), which the tests lower and restore.
    static g_pool_fault_errors: AtomicU32;
    // cosmofstest_lib.cee's
    fn cfst_write_file(path: *CChar, data: *void, len: usize) -> bool;
    fn cfst_read_matches(path: *CChar, data: *void, len: usize) -> bool;
    fn cfst_mount_of(path: *CChar) -> *mut mount;
    fn cfst_rot_copy(bd: *mut blkdev, blk: u64, fill: u8) -> bool;

    // The values and layout the C compiler checks (ADR 0080 §3.1), which the floor asserted.
    const EIO: i32 = 5;
    const EAGAIN: i32 = 11;
    const EBUSY: i32 = 16;
    const EEXIST: i32 = 17;
    const ENODEV: i32 = 19;
    const VFS_UMOUNT_FORCE: u32 = 1;
    /// cosmofstest_copies.cee's errno.h, vfs.h and cosmofs_format.h values
    @cvalue("COSMO_O_RDONLY == 0 && CFS_BLOCK == 4096 && CFS_FORMAT_VERSION == 11 && CFS_DVA_VDEV_SHIFT == 56 && CFS_DVA(0, 12345) == 12345")
    const COSMOFSTEST_COPIES_FACT_0: bool = true;
    /// cosmofstest_copies.cee's storage.h and cosmofs.h values
    @cvalue("POOL_COPY_ONLINE == 0 && POOL_COPY_MISSING == 1 && POOL_COPY_OFFLINE == 2 && POOL_COPY_FAULTED == 3 && POOL_COPY_RESILVERING == 4 && COSMOFS_POOL_OFFLINE == 1 && COSMOFS_POOL_ONLINE == 2 && COSMOFS_POOL_REPLACE == 3 && COSMOFS_POOL_ATTACH == 4 && COSMOFS_POOL_DETACH == 5 && COSMOFS_POOL_SPARE_ADD == 6 && COSMOFS_SCRUB_REPAIR == 1")
    const COSMOFSTEST_COPIES_FACT_1: bool = true;
    /// cosmofstest_copies.cee's record sizes
    @cvalue("sizeof(struct ramblk_write) == 24 && offsetof(struct ramblk_write, sector) == 0 && offsetof(struct ramblk_write, nsectors) == 8 && sizeof(struct cosmofs_stats) <= 128 && sizeof(struct cosmofs_scrub_stats) <= 64 && sizeof(struct cosmofs_pool_req) <= 96 && sizeof(struct cfs_super) <= 21 * 8")
    const COSMOFSTEST_COPIES_FACT_2: bool = true;
}

// ---- Values ----

const O_RDONLY: u32 = 0;
const BLOCK: usize = 4096;
const FORMAT_VERSION: u32 = 11;
const DVA_BLK_MASK: u64 = (1u64 << 56) - 1;
const RAMBLK_WRITE: usize = 24;
const COPY_ONLINE: u32 = 0;
const COPY_MISSING: u32 = 1;
const COPY_OFFLINE: u32 = 2;
const COPY_FAULTED: u32 = 3;
const COPY_RESILVERING: u32 = 4;
const POOL_OFFLINE: u32 = 1;
const POOL_ONLINE: u32 = 2;
const POOL_REPLACE: u32 = 3;
const POOL_ATTACH: u32 = 4;
const POOL_DETACH: u32 = 5;
const POOL_SPARE_ADD: u32 = 6;
const SCRUB_REPAIR: u32 = 1;

/// A terminated string literal's C pointer.
fn c(s: StringView) -> *CChar => s.ptr as *CChar;

/// The tests' mount point.
fn eng() -> *CChar => c("/mnt/eng\0");

/// Safety: `reason` writable.
unsafe fn failed(reason: *mut *CChar, why: StringView) -> bool {
    reason.write(why.ptr as *CChar);
    return false;
}

/// Safety: `f` is an open file.
unsafe fn filePut(f: *mut file) { kobject_put(f as *mut kobject); }

/// Safety: `path` a terminated string.
unsafe fn umount(path: *CChar) -> i32 => vfs_umount2(path, 0);

/// Member 0 of `p`.
/// Safety: `p` a pool.
unsafe fn m0(p: *mut spool) -> borrow(static) spool_member =>
    Ptr.toBorrow(Ptr.toBorrow(p as *spool).m as *spool_member);

/// Copy `c` of member 0 of `p`.
/// Safety: `p` a pool with that copy.
unsafe fn cp(p: *mut spool, c: u32) -> borrow(static) pool_copy => borrow m0(p).copy[c as usize];

/// Safety: `p` a pool.
unsafe fn pv(p: *mut spool) -> borrow(static) spool => Ptr.toBorrow(p as *spool);

/// Statistics, read through the slot a test keeps them in.
/// Safety: `st` a slot cosmofs_stats filled.
unsafe fn sv(st: *mut cosmofs_stats) -> borrow(static) cosmofs_stats => Ptr.toBorrow(st as *cosmofs_stats);

/// Safety: `sc` a slot cosmofs_scrub filled.
unsafe fn scv(sc: *mut cosmofs_scrub_stats) -> borrow(static) cosmofs_scrub_stats =>
    Ptr.toBorrow(sc as *cosmofs_scrub_stats);

/// A device's name, terminated.
/// Safety: `bd` is a device.
unsafe fn devName(bd: *mut blkdev) -> *CChar => borrow Ptr.toBorrow(bd as *blkdev).name as *[u8; 16] as *CChar;

/// The statistics of the mount at /mnt/eng into `st`.
/// Safety: `st` a slot of the record's size.
unsafe fn stats(st: *mut cosmofs_stats) -> i32 => cfst_stats(cfst_mount_of(eng()), st as *mut cosmofs_stats);

/// The pool of the mount at /mnt/eng.
/// Safety: none beyond the VFS's own.
unsafe fn engPool() -> *mut spool => cosmofs_test_pool(cfst_mount_of(eng()));

/// What the tests hold, for the cleanup after them: devices, a pool, buffers, a file, a write log.
struct Rig {
    bd: [*mut blkdev; 3];
    extra: *mut blkdev; // a device the pool does not start with: a replacement or a spare
    p: *mut spool;
    w: *mut u8;
    r: *mut u8;
    f: *mut file;
    log: *mut ramblk_log;
    written: *mut u8;
}

fn rig() -> Rig => Rig {
    bd: [0 as *mut blkdev; 3],
    extra: 0 as *mut blkdev,
    p: 0 as *mut spool,
    w: 0 as *mut u8,
    r: 0 as *mut u8,
    f: 0 as *mut file,
    log: 0 as *mut ramblk_log,
    written: 0 as *mut u8,
};

// static: off the kernel stack; the runner runs one test at a time
static mut g_data: [u8; 163840] = [0; 163840];
static mut g_during: [u8; 4096] = [0; 4096];

/// The tests' data, `len` bytes of `fill`.
/// Safety: the self-tests run one at a time.
unsafe fn data(fill: u8, len: usize) -> *void {
    let d = borrow mut g_data as *mut [u8; 163840] as *mut u8;
    memset(d as *mut void, fill as i32, len);
    return d as *void;
}

/// The pool's copy states on a two-way mirror: a failing copy is written around and FAULTED past fs.fault_errors,
/// starting its record from what was written since the last root; the member's last ONLINE copy is never faulted and
/// may not be taken offline; a device that is gone is MISSING at once; a copy that missed nothing comes back ONLINE
/// and one that missed a write does not.
/// Safety: `reason` writable.
@export("selftest_pool_copy_states")
unsafe fn selftestCopyStates(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    s.bd[0] = ramblk_create(64);
    s.bd[1] = ramblk_create(64);
    s.w = kmalloc(BLOCK, 0) as *mut u8;
    s.r = kmalloc(BLOCK, 0) as *mut u8;
    let limit = g_pool_fault_errors.load();
    let ok = copyStates(mut s, reason);
    g_pool_fault_errors.store(limit);
    if (!s.p.isNull()) {
        pool_close(s.p);
    }
    kfree(s.w as *mut void);
    kfree(s.r as *mut void);
    for (i in 0usize..2) {
        if (!s.bd[i].isNull()) {
            ramblk_set_fail(s.bd[i], 0);
            ramblk_destroy(s.bd[i]);
        }
    }
    return ok;
}

/// Safety: `reason` writable; `s` holds the devices and buffers.
unsafe fn copyStates(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let b0 = s.bd[0];
    let b1 = s.bd[1];
    let w = s.w;
    let r = s.r;
    if (!(!b0.isNull() && !b1.isNull() && !w.isNull() && !r.isNull())) {
        return failed(reason, "check failed: bd[0] != NULL && bd[1] != NULL && w != NULL && r != NULL at line 295\0");
    }
    for (i in 0usize..BLOCK) {
        w.add(i).write(truncate<u8>(i.wrappingMul(7)));
    }
    let wv = w as *void;
    let rv = r as *mut void;

    if (!(pool_open(b0, borrow mut s.p as *mut *mut spool) == 0 && pool_add_copy(s.p, 0, b1) == 0)) {
        return failed(reason,
            "check failed: pool_open(bd[0], &p) == 0 && pool_add_copy(p, 0, bd[1]) == 0 at line 305\0");
    }
    var p = s.p;
    if (!(m0(p).ncopies == 2 && m0(p).region_blocks == 1 && !pool_degraded(p))) {
        return failed(reason,
            "check failed: p->m[0].ncopies == 2 && p->m[0].region_blocks == 1 && !pool_degraded(p) at line 310\0");
    }
    if (!(pool_write(p, 5, wv) == 0 && pool_flush(p) == 0)) {
        return failed(reason, "check failed: pool_write(p, 5, w) == 0 && pool_flush(p) == 0 at line 313\0");
    }
    pool_commit_done(p, 7);
    if (!(pool_read_copy(p, 5, 0, rv) == 0 && memcmp(rv, wv, BLOCK) == 0)) {
        return failed(reason,
            "check failed: pool_read_copy(p, 5, 0, r) == 0 && memcmp(r, w, CFS_BLOCK) == 0 at line 318\0");
    }
    if (!(pool_read_copy(p, 5, 1, rv) == 0 && memcmp(rv, wv, BLOCK) == 0)) {
        return failed(reason,
            "check failed: pool_read_copy(p, 5, 1, r) == 0 && memcmp(r, w, CFS_BLOCK) == 0 at line 322\0");
    }

    // A failing copy: written around, counted, FAULTED past the limit.
    g_pool_fault_errors.store(3);
    ramblk_set_fail(b1, -EIO);
    let seq = pv(p).state_seq;
    for (i in 0u64..3) {
        if (!(pool_write(p, 10 + i, wv) == 0)) {
            return failed(reason, "check failed: pool_write(p, 10 + i, w) == 0 at line 331\0");
        }
    }
    if (!(cp(p, 1).state == COPY_ONLINE && cp(p, 1).write_errors == 3)) {
        return failed(reason,
            "check failed: p->m[0].copy[1].state == POOL_COPY_ONLINE && p->...copy[1].write_errors == 3 at line 336\0");
    }
    // Still ONLINE, and what it failed is a hole: not read from it, the member not whole (Codex on #439).
    if (!(!pool_copy_readable(p, 10, 1) && !pool_copy_readable(p, 12, 1) && pool_copy_readable(p, 5, 1))) {
        return failed(reason,
            "check failed: !pool_copy_readable(p, 10, 1) && !pool_copy_read...ol_copy_readable(p, 5, 1) at line 341\0");
    }
    if (!(pool_copy_online(p, 0, 1) && pool_degraded(p))) {
        return failed(reason, "check failed: pool_copy_online(p, 0, 1) && pool_degraded(p) at line 344\0");
    }
    if (!(pool_write(p, 13, wv) == 0)) {
        return failed(reason, "check failed: pool_write(p, 13, w) == 0 at line 347\0");
    }
    if (!(cp(p, 1).state == COPY_FAULTED && pv(p).state_seq != seq && pool_degraded(p))) {
        return failed(reason,
            "check failed: p->m[0].copy[1].state == POOL_COPY_FAULTED && p-...= seq && pool_degraded(p) at line 351\0");
    }
    if (!(cp(p, 1).since == 7 && !cp(p, 1).whole)) {
        return failed(reason, "check failed: p->m[0].copy[1].since == 7 && !p->m[0].copy[1].whole at line 354\0");
    }
    // What it missed: exactly the writes since the last root.
    for (b in 0u64..64) {
        if (!(pool_copy_missed(p, b, 1) == (b >= 10 && b <= 13))) {
            return failed(reason, "check failed: pool_copy_missed(p, b, 1) == (b >= 10 && b <= 13) at line 359\0");
        }
    }
    // Not written from now on, not read, and what it misses is recorded.
    if (!(pool_write(p, 20, wv) == 0 && pool_copy_missed(p, 20, 1) && cp(p, 1).write_errors == 4)) {
        return failed(reason,
            "check failed: pool_write(p, 20, w) == 0 && pool_copy_missed(p,...copy[1].write_errors == 4 at line 365\0");
    }
    if (!(!pool_copy_readable(p, 20, 1) && pool_read_copy(p, 20, 1, rv) == -ENODEV)) {
        return failed(reason,
            "check failed: !pool_copy_readable(p, 20, 1) && pool_read_copy(p, 20, 1, r) == -ENODEV at line 369\0");
    }
    if (!(pool_read(p, 20, rv) == 0 && memcmp(rv, wv, BLOCK) == 0)) {
        return failed(reason, "check failed: pool_read(p, 20, r) == 0 && memcmp(r, w, CFS_BLOCK) == 0 at line 372\0");
    }

    // The last ONLINE copy: not offline, and not faulted by a count.
    if (!(pool_copy_set_state(p, 0, 0, COPY_OFFLINE, 0) == -EBUSY)) {
        return failed(reason,
            "check failed: pool_copy_set_state(p, 0, 0, POOL_COPY_OFFLINE, 0) == -EBUSY at line 378\0");
    }
    ramblk_set_fail(b0, -EIO);
    for (i in 0u32..5) {
        // no ONLINE copy took it
        if (!(pool_write(p, 30, wv) == -EIO)) {
            return failed(reason, "check failed: pool_write(p, 30, w) == -EIO at line 384\0");
        }
    }
    if (!(pool_read(p, 30, rv) == -EIO)) {
        return failed(reason, "check failed: pool_read(p, 30, r) == -EIO at line 388\0");
    }
    if (!(cp(p, 0).state == COPY_ONLINE && cp(p, 0).write_errors == 5)) {
        return failed(reason,
            "check failed: p->m[0].copy[0].state == POOL_COPY_ONLINE && p->...copy[0].write_errors == 5 at line 392\0");
    }
    // no other copy took block 30: no hole
    if (!(pool_copy_readable(p, 30, 0))) {
        return failed(reason, "check failed: pool_copy_readable(p, 30, 0) at line 396\0");
    }
    // the last copy failed its flush: not durable (Codex on #439)
    if (!(pool_flush(p) == -EIO)) {
        return failed(reason, "check failed: pool_flush(p) == -EIO at line 400\0");
    }
    if (!(cp(p, 0).state == COPY_ONLINE)) {
        return failed(reason, "check failed: p->m[0].copy[0].state == POOL_COPY_ONLINE at line 403\0");
    }
    ramblk_set_fail(b0, 0);
    ramblk_set_fail(b1, 0);
    // A copy that missed writes comes back only through a resilver.
    if (!(pool_copy_set_state(p, 0, 1, COPY_ONLINE, 0) == -EAGAIN)) {
        return failed(reason,
            "check failed: pool_copy_set_state(p, 0, 1, POOL_COPY_ONLINE, 0) == -EAGAIN at line 410\0");
    }
    pool_close(p);
    s.p = 0 as *mut spool;

    // A device that is gone is MISSING at once, whatever the limit, and what it may have held only in its cache is
    // missed too.
    if (!(pool_open(b0, borrow mut s.p as *mut *mut spool) == 0 && pool_add_copy(s.p, 0, b1) == 0)) {
        return failed(reason,
            "check failed: pool_open(bd[0], &p) == 0 && pool_add_copy(p, 0, bd[1]) == 0 at line 419\0");
    }
    p = s.p;
    pool_commit_done(p, 9);
    if (!(pool_write(p, 3, wv) == 0)) {
        return failed(reason, "check failed: pool_write(p, 3, w) == 0 at line 424\0");
    }
    ramblk_set_fail(b1, -ENODEV);
    if (!(pool_write(p, 4, wv) == 0)) {
        return failed(reason, "check failed: pool_write(p, 4, w) == 0 at line 428\0");
    }
    if (!(cp(p, 1).state == COPY_MISSING && cp(p, 1).write_errors == 1)) {
        return failed(reason,
            "check failed: p->m[0].copy[1].state == POOL_COPY_MISSING && p-...copy[1].write_errors == 1 at line 432\0");
    }
    if (!(cp(p, 1).since == 9 && pool_copy_missed(p, 3, 1) && pool_copy_missed(p, 4, 1))) {
        return failed(reason,
            "check failed: p->m[0].copy[1].since == 9 && pool_copy_missed(p...pool_copy_missed(p, 4, 1) at line 436\0");
    }
    if (!(!pool_copy_missed(p, 2, 1) && !pool_copy_missed(p, 5, 1))) {
        return failed(reason, "check failed: !pool_copy_missed(p, 2, 1) && !pool_copy_missed(p, 5, 1) at line 439\0");
    }
    // A flush that cannot reach it is no error while a copy took the root.
    if (!(pool_flush(p) == 0)) {
        return failed(reason, "check failed: pool_flush(p) == 0 at line 443\0");
    }
    ramblk_set_fail(b1, 0);
    pool_close(p);
    s.p = 0 as *mut spool;

    // OFFLINE and back: with nothing written meanwhile it is ONLINE again; then the other copy goes, reads come from
    // this one, and the one that missed a write stays out.
    if (!(pool_open(b0, borrow mut s.p as *mut *mut spool) == 0 && pool_add_copy(s.p, 0, b1) == 0)) {
        return failed(reason,
            "check failed: pool_open(bd[0], &p) == 0 && pool_add_copy(p, 0, bd[1]) == 0 at line 453\0");
    }
    p = s.p;
    pool_commit_done(p, 11);
    if (!(pool_copy_set_state(p, 0, 1, COPY_OFFLINE, 0) == 0 && !pool_copy_readable(p, 0, 1))) {
        return failed(reason,
            "check failed: pool_copy_set_state(p, 0, 1, POOL_COPY_OFFLINE, ...ol_copy_readable(p, 0, 1) at line 459\0");
    }
    if (!(pool_copy_set_state(p, 0, 1, COPY_ONLINE, 0) == 0 && !pool_degraded(p))) {
        return failed(reason,
            "check failed: pool_copy_set_state(p, 0, 1, POOL_COPY_ONLINE, 0) == 0 && !pool_degraded(p) at line 463\0");
    }
    if (!(pool_copy_set_state(p, 0, 0, COPY_OFFLINE, 0) == 0)) {
        return failed(reason, "check failed: pool_copy_set_state(p, 0, 0, POOL_COPY_OFFLINE, 0) == 0 at line 466\0");
    }
    if (!(pool_read(p, 5, rv) == 0 && memcmp(rv, wv, BLOCK) == 0)) {
        return failed(reason, "check failed: pool_read(p, 5, r) == 0 && memcmp(r, w, CFS_BLOCK) == 0 at line 469\0");
    }
    if (!(pool_write(p, 6, wv) == 0 && pool_copy_missed(p, 6, 0) && !pool_copy_missed(p, 7, 0))) {
        return failed(reason,
            "check failed: pool_write(p, 6, w) == 0 && pool_copy_missed(p, ...pool_copy_missed(p, 7, 0) at line 473\0");
    }
    if (!(pool_copy_set_state(p, 0, 0, COPY_ONLINE, 0) == -EAGAIN)) {
        return failed(reason,
            "check failed: pool_copy_set_state(p, 0, 0, POOL_COPY_ONLINE, 0) == -EAGAIN at line 477\0");
    }
    var buffer = [0u8; 120];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: pool-copy-states: FAULTED after ");
    line.decimal(3);
    line.text(" errors, MISSING at -ENODEV, the last copy kept");
    KernelLog.send(LogLevel.Info, line);
    return true;
}

/// Whether the /proc/mounts line of the mount at `path` has `opt` in it.
/// Safety: `path` and `opt` terminated strings.
unsafe fn mountsLineHas(path: StringView, opt: *CChar) -> bool {
    let buf = kmalloc(4096, 0) as *mut u8;
    if (buf.isNull()) {
        return false;
    }
    let n = vfs_mounts_render(buf as *mut CChar, 4096);
    var found = false;
    var keyBuf = [0u8; 64];
    var key = TextWriter.create(mut keyBuf[..]);
    key.text(" ");
    key.text(path);
    key.text(" cosmofs ");
    var line = buf;
    while (n > 0 && !line.isNull() && line.read() != 0) {
        let nl = strchr(line as *CChar, 10) as *mut u8;
        if (!nl.isNull()) {
            nl.write(0);
        }
        if (!strstr(line as *CChar, key.cText()).isNull() && !strstr(line as *CChar, opt).isNull()) {
            found = true;
        }
        line = if (nl.isNull()) 0 as *mut u8 else nl.add(1);
    }
    kfree(buf as *mut void);
    return found;
}

/// A two-way mirror of `nblocks` RAM blocks a device, into `s.bd[0]` and `s.bd[1]`, mounted at /mnt/eng through
/// the first with writeback off.
/// Safety: none beyond the VFS's own.
unsafe fn mirrorUp(s: borrow mut Rig, nblocks: u64) -> bool {
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    s.bd[0] = ramblk_create(nblocks);
    s.bd[1] = ramblk_create(nblocks);
    if (s.bd[0].isNull() || s.bd[1].isNull() ||
        cosmofs_format_mirror(borrow mut s.bd as *mut [*mut blkdev; 3] as *mut *mut blkdev, 1, 2) != 0) {
        return false;
    }
    let mk = vfs_mkdir(0 as *mut vnode, eng(), 493);
    if ((mk != 0 && mk != -EEXIST) || vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) != 0) {
        return false;
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    return true;
}

/// The mirror unmounted, its directory removed and its devices destroyed.
/// Safety: `s.bd` null or devices.
unsafe fn mirrorDown(s: borrow mut Rig) {
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    let _ = vfs_rmdir(0 as *mut vnode, eng());
    for (i in 0usize..2) {
        if (!s.bd[i].isNull()) {
            ramblk_set_fail(s.bd[i], 0);
            ramblk_destroy(s.bd[i]);
            s.bd[i] = 0 as *mut blkdev;
        }
    }
}

/// CF26: a mirror with one copy pulled keeps working and says so -- the stats, /proc/mounts, the format raised to
/// record it -- and a copy that keeps failing is FAULTED and stays so across a remount. With both copies gone, a read
/// and a commit fail with -EIO, and nothing panics.
/// Safety: `reason` writable.
@export("selftest_cosmofs_degraded")
unsafe fn selftestDegraded(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    let limit = g_pool_fault_errors.load();
    let ok = degraded(mut s, reason);
    g_pool_fault_errors.store(limit);
    if (!s.f.isNull()) {
        filePut(s.f);
    }
    mirrorDown(mut s);
    return ok;
}

/// Safety: `reason` writable.
unsafe fn degraded(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 3 * 4096;
    let d = data(0x64, len); // 'd'
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 573\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(cfst_write_file(c("/mnt/eng/a\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/a\", data, sizeof(data)) && vfs_sync() == 0 at line 579\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 2 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev... == 2 && st.degraded == 0 at line 583\0");
    }
    let v0 = sv(st).version;
    // a healthy mirror's commits do not raise it
    if (!(v0 == FORMAT_VERSION)) {
        return failed(reason, "check failed: v0 == CFS_FORMAT_VERSION at line 588\0");
    }
    if (!(mountsLineHas("/mnt/eng", c(" rw 0 0\0")) && !mountsLineHas("/mnt/eng", c("degraded\0")))) {
        return failed(reason,
            "check failed: mounts_line_has(ENG, \" rw 0 0\") && !mounts_line_has(ENG, \"degraded\") at line 592\0");
    }

    // Pull copy 1: the writes go on, the pool says it is degraded.
    ramblk_set_fail(s.bd[1], -ENODEV);
    if (!(cfst_write_file(c("/mnt/eng/b\0"), d, len))) {
        return failed(reason, "check failed: write_file(ENG \"/b\", data, sizeof(data)) at line 598\0");
    }
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 601\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).degraded == 1)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev... == 1 && st.degraded == 1 at line 605\0");
    }
    // recorded, so raised
    if (!(sv(st).version == 13)) {
        return failed(reason, "check failed: st.version == 13 at line 609\0");
    }
    if (!(mountsLineHas("/mnt/eng", c(" rw,degraded 0 0\0")))) {
        return failed(reason, "check failed: mounts_line_has(ENG, \" rw,degraded 0 0\") at line 612\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/a\0"), d, len) && cfst_read_matches(c("/mnt/eng/b\0"), d, len))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/a\", data, sizeof(data)) && .../b\", data, sizeof(data)) at line 616\0");
    }

    // Both copies gone: the read of a block no copy holds is -EIO, a commit that reaches no copy is -EIO, and the
    // system is still here. The change the commit carries is made first, while copy 0 serves.
    if (!(cfst_write_file(c("/mnt/eng/c\0"), "c".ptr as *void, 1))) {
        return failed(reason, "check failed: write_file(ENG \"/c\", \"c\", 1) at line 622\0");
    }
    ramblk_set_fail(s.bd[0], -ENODEV);
    // -EIO wherever the first block no copy holds is met: the directory lookup, or the file's data if its inode is
    // still cached.
    let got = borrow mut g_during as *mut [u8; 4096] as *mut void;
    let orc = vfs_open(0 as *mut vnode, c("/mnt/eng/a\0"), O_RDONLY, 0, borrow mut s.f as *mut *mut file);
    if (!(orc == 0 || orc == -EIO)) {
        return failed(reason, "check failed: orc == 0 || orc == -EIO at line 630\0");
    }
    if (orc == 0) {
        if (!(file_read(s.f, got, 4096) == -EIO as i64)) {
            return failed(reason, "check failed: file_read(f, got, sizeof(got)) == -EIO at line 634\0");
        }
        filePut(s.f);
        s.f = 0 as *mut file;
    }
    if (!(vfs_sync() == -EIO)) {
        return failed(reason, "check failed: vfs_sync() == -EIO at line 640\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 0 && sv(st).degraded == 2)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev... == 0 && st.degraded == 2 at line 644\0");
    }
    mirrorDown(s);

    // A copy that keeps failing is FAULTED, and the record keeps it out after a remount even though its device answers
    // again.
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 651\0");
    }
    g_pool_fault_errors.store(4);
    ramblk_set_fail(s.bd[1], -EIO);
    var pool = engPool();
    if (!(!pool.isNull())) {
        return failed(reason, "check failed: pool != NULL at line 657\0");
    }
    var i: u32 = 0;
    while (i < 8 && cp(pool, 1).state == COPY_ONLINE) {
        var nameBuf = [0u8; 32];
        var name = TextWriter.create(mut nameBuf[..]);
        name.text("/mnt/eng/f");
        name.decimal(i as u64);
        if (!(cfst_write_file(name.cText(), d, len) && vfs_sync() == 0)) {
            return failed(reason,
                "check failed: write_file(name, data, sizeof(data)) && vfs_sync() == 0 at line 667\0");
        }
        i += 1;
    }
    if (!(cp(pool, 1).state == COPY_FAULTED)) {
        return failed(reason, "check failed: pool->m[0].copy[1].state == POOL_COPY_FAULTED at line 672\0");
    }
    // Faulted inside a commit, on a member with no record yet: the next commit records it, and is due with nothing
    // else to write.
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 677\0");
    }
    if (!(stats(st) == 0 && sv(st).degraded == 1 && sv(st).version == 13)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.deg... == 1 && st.version == 13 at line 681\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/after\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/after\", data, sizeof(data)) && vfs_sync() == 0 at line 685\0");
    }
    ramblk_set_fail(s.bd[1], 0);
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 689\0");
    }
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 692\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    pool = engPool();
    if (!(!pool.isNull() && cp(pool, 1).state == COPY_FAULTED && cp(pool, 1).dev.isNull())) {
        return failed(reason,
            "check failed: pool != NULL && pool->m[0].copy[1].state == POOL...>m[0].copy[1].dev == NULL at line 698\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).degraded == 1)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev... == 1 && st.degraded == 1 at line 702\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/after\0"), d, len))) {
        return failed(reason, "check failed: read_matches(ENG \"/after\", data, sizeof(data)) at line 705\0");
    }
    if (!(mountsLineHas("/mnt/eng", c("rw,degraded\0")))) {
        return failed(reason, "check failed: mounts_line_has(ENG, \"rw,degraded\") at line 708\0");
    }
    KernelLog.write(LogLevel.Info,
        "selftest: cosmofs-degraded: writes go on with a copy pulled; FAULTED is kept across a remount");
    return true;
}

/// The blocks of member 0 a recorded write log names, set in `set` (`nblocks` bytes).
/// Safety: `log` null or a log; `set` `nblocks` writable bytes.
unsafe fn logBlocks(log: *mut ramblk_log, set: *mut u8, nblocks: u64) {
    if (log.isNull()) {
        return;
    }
    let lg = Ptr.toBorrow(log as *ramblk_log);
    let spb: u64 = (BLOCK / 512) as u64;
    for (i in 0u32..lg.n) {
        let e = (lg.w as *mut u8).add(i as usize * RAMBLK_WRITE);
        let sector = (e as *u64).read();
        let nsectors = Ptr.toBorrow(e as *ramblk_write).nsectors;
        if (nsectors == 0) {
            continue; // a flush
        }
        var sct = sector;
        while (sct < sector + nsectors as u64) {
            if (sct / spb < nblocks) {
                set.add((sct / spb) as usize).write(1);
            }
            sct += spb;
        }
    }
}

/// CF25: the copy that was pulled is recorded as having missed exactly what was written after it went -- every block
/// the other copy took since, and nothing else but the superblock slots -- and the record a remount reads says the
/// same, with the generation it last held whole, which is the generation the device itself still carries.
/// Safety: `reason` writable.
@export("selftest_cosmofs_copy_bitmap")
unsafe fn selftestCopyBitmap(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    s.written = kzalloc(512) as *mut u8;
    let ok = copyBitmap(mut s, reason);
    cosmofs_test_resilver_hold(false);
    if (!s.log.isNull()) {
        ramblk_log_free(s.log);
    }
    kfree(s.written as *mut void);
    mirrorDown(mut s);
    return ok;
}

/// Safety: `reason` writable.
unsafe fn copyBitmap(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 5 * 4096;
    let d = data(0x78, len); // 'x'
    if (!(!s.written.isNull())) {
        return failed(reason, "check failed: written != NULL at line 764\0");
    }
    cosmofs_test_resilver_hold(true); // the remount below would resilver the copy at once
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 768\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/before\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/before\", data, sizeof(data)) && vfs_sync() == 0 at line 772\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(stats(st) == 0)) {
        return failed(reason, "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 at line 777\0");
    }
    let wholeAt = sv(st).generation;
    var pool = engPool();
    // a block a region: the record is exact
    if (!(!pool.isNull() && m0(pool).region_blocks == 1)) {
        return failed(reason, "check failed: pool != NULL && pool->m[0].region_blocks == 1 at line 783\0");
    }

    // Pull copy 1, and record every write copy 0 takes from now on. One commit, then the unmount's: the unmount's
    // metadata lands on blocks the first freed, which were written before the pull -- so only the commit marking its
    // own writes puts them in the record (CF25; a second commit here would reuse blocks already marked, and the test
    // would pass without the rule).
    ramblk_set_fail(s.bd[1], -ENODEV);
    ramblk_record_start(s.bd[0], 4096);
    if (!(cfst_write_file(c("/mnt/eng/after\0"), d, len))) {
        return failed(reason, "check failed: write_file(ENG \"/after\", data, sizeof(data)) at line 793\0");
    }
    if (!(vfs_mkdir(0 as *mut vnode, c("/mnt/eng/dir\0"), 493) == 0
            && cfst_write_file(c("/mnt/eng/dir/inner\0"), d, 4096))) {
        return failed(reason,
            "check failed: vfs_mkdir(NULL, ENG \"/dir\", 0755) == 0 && writ.../dir/inner\", data, 4096) at line 798\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/later\0"), d, 3 * 4096))) {
        return failed(reason, "check failed: write_file(ENG \"/later\", data, 3 * 4096) at line 801\0");
    }
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 804\0");
    }
    if (!(cp(pool, 1).state == COPY_MISSING && cp(pool, 1).since == wholeAt)) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].state == POOL_COPY_MISSING &&...copy[1].since == whole_at at line 808\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 811\0");
    }
    s.log = ramblk_record_stop(s.bd[0]);
    if (!(!s.log.isNull() && Ptr.toBorrow(s.log as *ramblk_log).dropped == 0
            && Ptr.toBorrow(s.log as *ramblk_log).n > 0)) {
        return failed(reason, "check failed: log != NULL && log->dropped == 0 && log->n > 0 at line 816\0");
    }
    logBlocks(s.log, s.written, 512);

    // The device comes back holding what it held: the root it last took.
    ramblk_set_fail(s.bd[1], 0);
    var aSlot = [0u64; 21];
    var bSlot = [0u64; 21];
    let a = borrow mut aSlot as *mut [u64; 21] as *mut cfs_super;
    let b = borrow mut bSlot as *mut [u64; 21] as *mut cfs_super;
    var ra: i32 = -EIO;
    var rb: i32 = -EIO;
    if (!(cfs_super_slots(s.bd[1], a, borrow mut ra as *mut i32, b, borrow mut rb as *mut i32) == 0)) {
        return failed(reason, "check failed: cfs_super_slots(bd[1], &a, &ra, &b, &rb) == 0 at line 829\0");
    }
    var devGen: u64 = 0;
    if (ra == 0) {
        devGen = Ptr.toBorrow(a as *cfs_super).generation;
    }
    if (rb == 0 && Ptr.toBorrow(b as *cfs_super).generation > devGen) {
        devGen = Ptr.toBorrow(b as *cfs_super).generation;
    }
    if (!(devGen == wholeAt)) {
        return failed(reason, "check failed: dev_gen == whole_at at line 839\0");
    }

    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 843\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    pool = engPool();
    if (!(!pool.isNull() && m0(pool).ncopies == 2)) {
        return failed(reason, "check failed: pool != NULL && pool->m[0].ncopies == 2 at line 848\0");
    }
    let cp1 = cp(pool, 1);
    // Back, and recognised by the record: resilvering what it missed.
    if (!(cp1.state == COPY_RESILVERING && cp1.dev == s.bd[1] && !cp1.whole && cp1.since == wholeAt)) {
        return failed(reason,
            "check failed: cp->state == POOL_COPY_RESILVERING && cp->dev ==... && cp->since == whole_at at line 854\0");
    }
    // Every block written after the pull is in the record; nothing else is, but the superblock slots the record marks
    // for the root.
    var marked: u32 = 0;
    var nwritten: u32 = 0;
    for (blk in 0u64..512) {
        let m = pool_copy_missed(pool, blk, 1);
        let wr = s.written.add(blk as usize).read();
        nwritten += wr as u32;
        if (m) {
            marked += 1;
        }
        if (wr != 0) {
            if (!(m)) {
                return failed(reason, "check failed: m at line 869\0");
            }
        } else if (m) {
            if (!(blk < 2)) {
                return failed(reason, "check failed: blk < 2 at line 873\0");
            }
        }
    }
    if (!(nwritten > 8)) {
        return failed(reason, "check failed: nwritten > 8 at line 878\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/later\0"), d, 3 * 4096)
            && cfst_read_matches(c("/mnt/eng/dir/inner\0"), d, 4096))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/later\", data, 3 * 4096) && .../dir/inner\", data, 4096) at line 883\0");
    }
    var buffer = [0u8; 128];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-copy-bitmap: ");
    line.decimal(nwritten as u64);
    line.text(" blocks written after the pull, ");
    line.decimal(marked as u64);
    line.text(" recorded, since generation ");
    line.decimal(wholeAt);
    KernelLog.send(LogLevel.Info, line);
    return true;
}

/// The second mount point of cosmofs-copy-import.
fn eng2() -> *CChar => c("/mnt/eng2\0");

/// CF27: a mount handed the copy that was away mounts the newest root from the other device, and leaves the lagging
/// one out; with that other device already mounted, it refuses rather than mount the pool twice.
/// Safety: `reason` writable.
@export("selftest_cosmofs_copy_import")
unsafe fn selftestCopyImport(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    cosmofs_test_resilver_hold(true);
    let ok = copyImport(mut s, reason);
    cosmofs_test_resilver_hold(false);
    let _ = vfs_umount2(eng2(), VFS_UMOUNT_FORCE);
    let _ = vfs_rmdir(0 as *mut vnode, eng2());
    mirrorDown(mut s);
    return ok;
}

/// Safety: `reason` writable.
unsafe fn copyImport(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 919\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/first\0"), "first".ptr as *void, 5) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/first\", \"first\", 5) && vfs_sync() == 0 at line 923\0");
    }
    ramblk_set_fail(s.bd[1], -ENODEV);
    if (!(cfst_write_file(c("/mnt/eng/second\0"), "second".ptr as *void, 6) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/second\", \"second\", 6) && vfs_sync() == 0 at line 928\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 931\0");
    }
    ramblk_set_fail(s.bd[1], 0);

    // Through the lagging device: the newest root, from bd[0].
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[1], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[1], 0) == 0 at line 937\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    let pool = engPool();
    if (!(!pool.isNull() && cp(pool, 0).dev == s.bd[0])) {
        return failed(reason, "check failed: pool != NULL && pool->m[0].copy[0].dev == bd[0] at line 942\0");
    }
    // The lagging device is not read; it is the copy being resilvered.
    if (!(cp(pool, 1).dev == s.bd[1] && cp(pool, 1).state == COPY_RESILVERING)) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].dev == bd[1] && pool->m[0].co... == POOL_COPY_RESILVERING at line 947\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/second\0"), "second".ptr as *void, 6)
            && cfst_read_matches(c("/mnt/eng/first\0"), "first".ptr as *void, 5))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/second\", \"second\", 6) &&... \"/first\", \"first\", 5) at line 952\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).degraded == 1)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev... == 1 && st.degraded == 1 at line 958\0");
    }
    // The device the mount moved to is held by it (Codex on #439).
    if (!(vfs_bdev_mounted(s.bd[0]))) {
        return failed(reason, "check failed: vfs_bdev_mounted(bd[0]) at line 962\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 965\0");
    }
    if (!(!vfs_bdev_mounted(s.bd[0]))) {
        return failed(reason, "check failed: !vfs_bdev_mounted(bd[0]) at line 968\0");
    }

    // The newer device mounted already: the lagging one does not mount.
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 973\0");
    }
    let mk = vfs_mkdir(0 as *mut vnode, eng2(), 493);
    if (!(mk == 0 || mk == -EEXIST)) {
        return failed(reason, "check failed: mk == 0 || mk == -EEXIST at line 977\0");
    }
    if (!(vfs_mount(eng2(), c("cosmofs\0"), s.bd[1], 0) == -EBUSY)) {
        return failed(reason, "check failed: vfs_mount(ENG2, \"cosmofs\", bd[1], 0) == -EBUSY at line 980\0");
    }
    KernelLog.write(LogLevel.Info,
        "selftest: cosmofs-copy-import: the lagging device mounts the newest root, and not twice");
    return true;
}

/// A copy on a bigger device than the first (Codex on #439): the member's size, and so its record's regions, are the
/// table's, so the pool mounts through the bigger copy with the record the smaller one's mount wrote.
/// Safety: `reason` writable.
@export("selftest_cosmofs_copy_geometry")
unsafe fn selftestCopyGeometry(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    let ok = copyGeometry(mut s, reason);
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    let _ = vfs_rmdir(0 as *mut vnode, eng());
    for (i in 0usize..2) {
        if (!s.bd[i].isNull()) {
            ramblk_set_fail(s.bd[i], 0);
            ramblk_destroy(s.bd[i]);
        }
    }
    return ok;
}

/// Safety: `reason` writable.
unsafe fn copyGeometry(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    s.bd[0] = ramblk_create(512);
    s.bd[1] = ramblk_create(8192); // 8192 blocks would be two a region; 512 are one
    if (!(!s.bd[0].isNull() && !s.bd[1].isNull()
            && cosmofs_format_mirror(borrow mut s.bd as *mut [*mut blkdev; 3] as *mut *mut blkdev, 1, 2) == 0)) {
        return failed(reason,
            "check failed: bd[0] != NULL && bd[1] != NULL && cosmofs_format_mirror(bd, 1, 2) == 0 at line 1014\0");
    }
    let mk = vfs_mkdir(0 as *mut vnode, eng(), 493);
    if (!(mk == 0 || mk == -EEXIST)) {
        return failed(reason, "check failed: mk == 0 || mk == -EEXIST at line 1018\0");
    }
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 1021\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    var pool = engPool();
    if (!(m0(pool).nblocks == 512 && m0(pool).region_blocks == 1)) {
        return failed(reason,
            "check failed: pool->m[0].nblocks == 512 && pool->m[0].region_blocks == 1 at line 1027\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/g\0"), "geometry".ptr as *void, 8) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/g\", \"geometry\", 8) && vfs_sync() == 0 at line 1031\0");
    }
    ramblk_set_fail(s.bd[0], -ENODEV); // the small one goes: the big one is the pool now
    if (!(cfst_write_file(c("/mnt/eng/h\0"), "after".ptr as *void, 5) && vfs_sync() == 0)) {
        return failed(reason, "check failed: write_file(ENG \"/h\", \"after\", 5) && vfs_sync() == 0 at line 1035\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1038\0");
    }
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[1], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[1], 0) == 0 at line 1041\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    pool = engPool();
    if (!(m0(pool).nblocks == 512 && m0(pool).region_blocks == 1)) {
        return failed(reason,
            "check failed: pool->m[0].nblocks == 512 && pool->m[0].region_blocks == 1 at line 1047\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/h\0"), "after".ptr as *void, 5)
            && cfst_read_matches(c("/mnt/eng/g\0"), "geometry".ptr as *void, 8))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/h\", \"after\", 5) && read...G \"/g\", \"geometry\", 8) at line 1052\0");
    }
    KernelLog.write(LogLevel.Info,
        "selftest: cosmofs-copy-geometry: a bigger copy mounts the pool at the table's size");
    return true;
}

// ---- Resilvering (roadmap 1.2 B3) ----

/// One pool operation on /mnt/eng.
/// Safety: `a` and `b` null or terminated strings.
unsafe fn poolOp(op: u32, a: *CChar, b: *CChar) -> i32 {
    var slot = [0u64; 12];
    let req = borrow mut slot as *mut [u64; 12] as *mut cosmofs_pool_req;
    let r = Ptr.toBorrowMut(req);
    r.op = op;
    r.name = a;
    r.name2 = b;
    return cosmofs_poolctl(cfst_mount_of(eng()), req);
}

/// One block of `bd`, read raw into `out`.
/// Safety: `bd` is a device; `out` BLOCK writable bytes.
unsafe fn rawBlock(bd: *mut blkdev, blk: u64, out: *mut u8) -> bool {
    var p = 0 as *mut spool;
    if (pool_open(bd, borrow mut p as *mut *mut spool) != 0) {
        return false;
    }
    let ok = pool_read_copy(p, blk, 0, out as *mut void) == 0; // CFS_DVA(0, blk) is blk
    pool_close(p);
    return ok;
}

/// A C string into a log line.
/// Safety: `s` a terminated string.
unsafe fn cstr(line: borrow mut TextWriter, s: *CChar) {
    var p = s as *u8;
    while (p.read() != 0) {
        line.byte(p.read());
        p = p.add(1);
    }
}

/// Every block of member 0 the mount's bitmap calls allocated, and the superblock slots, the same on both devices;
/// `compared`, when not null, gets how many were compared.
/// Safety: `a` and `b` are devices; /mnt/eng is mounted.
unsafe fn sameAllocated(a: *mut blkdev, b: *mut blkdev, compared: *mut u32) -> bool {
    let mnt = cfst_mount_of(eng());
    let fs = if (mnt.isNull()) 0 as *mut cfs else Ptr.toBorrow(mnt as *mount).fs_priv as *mut cfs; // cfs_of
    let x = kmalloc(BLOCK, 0) as *mut u8;
    let y = kmalloc(BLOCK, 0) as *mut u8;
    var ok = !fs.isNull() && !x.isNull() && !y.isNull();
    var n: u32 = 0;
    if (ok) {
        let mem0 = Ptr.toBorrow(Ptr.toBorrow(fs as *cfs).mem as *cfs_memstate);
        var blk: u64 = 0;
        while (ok && blk < mem0.nblocks) {
            if (blk >= mem0.first_usable && !cfs_bitmap_test(fs as *cfs, cfs_dva_lin(fs as *cfs, blk))) {
                blk += 1;
                continue;
            }
            ok = rawBlock(a, blk, x) && rawBlock(b, blk, y) && memcmp(x as *void, y as *void, BLOCK) == 0;
            if (!ok) {
                var buffer = [0u8; 96];
                var line = TextWriter.create(mut buffer[..]);
                line.text("selftest: block ");
                line.decimal(blk);
                line.text(" differs between ");
                cstr(mut line, devName(a));
                line.text(" and ");
                cstr(mut line, devName(b));
                KernelLog.send(LogLevel.Warn, line);
            }
            n += 1;
            blk += 1;
        }
    }
    kfree(x as *mut void);
    kfree(y as *mut void);
    if (!compared.isNull()) {
        compared.write(n);
    }
    return ok;
}

/// The data block holding logical block 0 of `path`, as a block of member 0.
/// Safety: `path` a terminated string; `out` writable.
unsafe fn firstBlock(path: *CChar, out: *mut u64) -> i32 {
    var f = 0 as *mut file;
    let rc = vfs_open(0 as *mut vnode, path, O_RDONLY, 0, borrow mut f as *mut *mut file);
    if (rc != 0) {
        return rc;
    }
    let ino = Ptr.toBorrow(Ptr.toBorrow(f as *file).vn as *vnode).ino;
    filePut(f);
    return cosmofs_test_block_of(cfst_mount_of(eng()), ino, 0, out);
}

/// CF28, CF29: a copy that was away is resilvered from the regions its record names; a write made during the resilver
/// reaches the copy being rebuilt (read raw from each device); at the end every allocated block is the same on both,
/// the copy is ONLINE, a scrub finds nothing, and the rebuilt device alone mounts the pool. While the pool is mounted
/// the device is held: /dev/blkctl's check sees it (CFS-5).
/// Safety: `reason` writable.
@export("selftest_cosmofs_resilver")
unsafe fn selftestResilver(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    s.w = kmalloc(BLOCK, 0) as *mut u8;
    s.r = kmalloc(BLOCK, 0) as *mut u8;
    let limit = g_pool_fault_errors.load();
    let ok = resilver(mut s, reason);
    g_pool_fault_errors.store(limit);
    cosmofs_test_resilver_hold(false);
    kfree(s.w as *mut void);
    kfree(s.r as *mut void);
    mirrorDown(mut s);
    return ok;
}

/// Safety: `reason` writable.
unsafe fn resilver(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 5 * 4096;
    let d = data(0x72, len); // 'r'
    let during = borrow mut g_during as *mut [u8; 4096] as *mut u8;
    memset(during as *mut void, 0x77, 4096); // 'w'
    let x = s.w;
    let y = s.r;
    cosmofs_test_resilver_hold(true);
    if (!(!x.isNull() && !y.isNull())) {
        return failed(reason, "check failed: x != NULL && y != NULL at line 1181\0");
    }
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 1184\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/a\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/a\", data, sizeof(data)) && vfs_sync() == 0 at line 1188\0");
    }
    ramblk_set_fail(s.bd[1], -ENODEV);
    if (!(cfst_write_file(c("/mnt/eng/b\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/b\", data, sizeof(data)) && vfs_sync() == 0 at line 1193\0");
    }
    ramblk_set_fail(s.bd[1], 0);
    let pool = engPool();
    if (!(!pool.isNull() && cp(pool, 1).state == COPY_MISSING)) {
        return failed(reason,
            "check failed: pool != NULL && pool->m[0].copy[1].state == POOL_COPY_MISSING at line 1199\0");
    }

    // CFS-5: the pool's other copy is not the operator's to format.
    if (!(vfs_bdev_mounted(s.bd[1]))) {
        return failed(reason, "check failed: vfs_bdev_mounted(bd[1]) at line 1204\0");
    }
    if (!(vfs_format(c("cosmofs\0"), s.bd[1], 0 as *CChar) == -EBUSY)) {
        return failed(reason, "check failed: vfs_format(\"cosmofs\", bd[1], NULL) == -EBUSY at line 1207\0");
    }

    // Back: online resilvers what it missed.
    if (!(poolOp(POOL_ONLINE, devName(s.bd[1]), 0 as *CChar) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_ONLINE, bd[1]->name, NULL) == 0 at line 1212\0");
    }
    let cp1 = cp(pool, 1);
    if (!(cp1.state == COPY_RESILVERING && !cp1.whole && cp1.cursor == 0)) {
        return failed(reason,
            "check failed: cp->state == POOL_COPY_RESILVERING && !cp->whole && cp->cursor == 0 at line 1217\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 2) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 2) == 0 at line 1220\0");
    }
    if (!(cp1.state == COPY_RESILVERING && cp1.cursor > 0)) {
        return failed(reason, "check failed: cp->state == POOL_COPY_RESILVERING && cp->cursor > 0 at line 1223\0");
    }

    // A write during the resilver: on both devices, read raw.
    if (!(cfst_write_file(c("/mnt/eng/during\0"), during as *void, 4096) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/during\", during, sizeof(during)) && vfs_sync() == 0 at line 1229\0");
    }
    var dblk: u64 = 0;
    if (!(firstBlock(c("/mnt/eng/during\0"), borrow mut dblk as *mut u64) == 0)) {
        return failed(reason, "check failed: cosmofs_test_block_of(mount_of(ENG), ino, 0, &dblk) == 0 at line 1233\0");
    }
    if (!(rawBlock(s.bd[0], dblk & DVA_BLK_MASK, x) && memcmp(x as *void, during as *void, BLOCK) == 0)) {
        return failed(reason,
            "check failed: raw_block(bd[0], CFS_DVA_BLK(dblk), x) && memcmp(x, during, CFS_BLOCK) == 0 at line 1237\0");
    }
    if (!(rawBlock(s.bd[1], dblk & DVA_BLK_MASK, y) && memcmp(y as *void, during as *void, BLOCK) == 0)) {
        return failed(reason,
            "check failed: raw_block(bd[1], CFS_DVA_BLK(dblk), y) && memcmp(y, during, CFS_BLOCK) == 0 at line 1241\0");
    }
    if (!(cp1.state == COPY_RESILVERING)) {
        return failed(reason, "check failed: cp->state == POOL_COPY_RESILVERING at line 1244\0");
    }

    // To the end.
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1249\0");
    }
    if (!(cp1.state == COPY_ONLINE && cp1.dev == s.bd[1])) {
        return failed(reason, "check failed: cp->state == POOL_COPY_ONLINE && cp->dev == bd[1] at line 1252\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(stats(st) == 0 && sv(st).devices == 2 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...== 2 && st.degraded == 0 at line 1258\0");
    }
    if (!(!mountsLineHas("/mnt/eng", c("degraded\0")))) {
        return failed(reason, "check failed: !mounts_line_has(ENG, \"degraded\") at line 1261\0");
    }
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1264\0");
    }
    var compared: u32 = 0;
    if (!(sameAllocated(s.bd[0], s.bd[1], borrow mut compared as *mut u32) && compared > 10)) {
        return failed(reason, "check failed: same_allocated(bd[0], bd[1], &compared) && compared > 10 at line 1268\0");
    }
    var scSlot = [0u64; 8];
    let sc = borrow mut scSlot as *mut [u64; 8] as *mut cosmofs_scrub_stats;
    if (!(cosmofs_scrub(cfst_mount_of(eng()), sc, 0) == 0 && scv(sc).bad_copies == 0 && scv(sc).unrecoverable == 0)) {
        return failed(reason,
            "check failed: cosmofs_scrub(mount_of(ENG), &sc, 0) == 0 && sc....&& sc.unrecoverable == 0 at line 1274\0");
    }

    // Holes: writes copy 1 fails while copy 0 takes them, below its fault count. It stays ONLINE with holes, the
    // member not whole; the resilver fills them and nothing else.
    let limit = g_pool_fault_errors.load();
    g_pool_fault_errors.store(1000);
    ramblk_set_fail_writes(s.bd[1], -EIO); // writes only: a failed flush faults a copy at once, by design
    if (!(cfst_write_file(c("/mnt/eng/holes\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/holes\", data, sizeof(data)) && vfs_sync() == 0 at line 1284\0");
    }
    ramblk_set_fail_writes(s.bd[1], 0);
    g_pool_fault_errors.store(limit);
    if (!(cp1.state == COPY_ONLINE && pool_copy_any_missed(pool, 0, 1) && pool_degraded(pool))) {
        return failed(reason,
            "check failed: cp->state == POOL_COPY_ONLINE && pool_copy_any_m...) && pool_degraded(pool) at line 1290\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/holes\0"), d, len))) {
        return failed(reason, "check failed: read_matches(ENG \"/holes\", data, sizeof(data)) at line 1293\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1296\0");
    }
    if (!(cp1.state == COPY_ONLINE && !pool_copy_any_missed(pool, 0, 1) && !pool_degraded(pool))) {
        return failed(reason,
            "check failed: cp->state == POOL_COPY_ONLINE && !pool_copy_any_... && !pool_degraded(pool) at line 1300\0");
    }
    if (!(vfs_sync() == 0 && sameAllocated(s.bd[0], s.bd[1], 0 as *mut u32))) {
        return failed(reason, "check failed: vfs_sync() == 0 && same_allocated(bd[0], bd[1], NULL) at line 1303\0");
    }

    // The rebuilt device alone holds the pool.
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1308\0");
    }
    ramblk_set_fail(s.bd[0], -ENODEV);
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[1], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[1], 0) == 0 at line 1312\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    if (!(cfst_read_matches(c("/mnt/eng/a\0"), d, len) && cfst_read_matches(c("/mnt/eng/b\0"), d, len))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/a\", data, sizeof(data)) && ...b\", data, sizeof(data)) at line 1317\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/during\0"), during as *void, 4096)
            && cfst_read_matches(c("/mnt/eng/holes\0"), d, len))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/during\", during, sizeof(dur...s\", data, sizeof(data)) at line 1322\0");
    }
    var buffer = [0u8; 120];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-resilver: ");
    line.decimal(compared as u64);
    line.text(" blocks the same on both copies; a write during it reached both");
    KernelLog.send(LogLevel.Info, line);
    return true;
}

/// CF29: a resilver stopped by an unmount goes on from the cursor the record holds -- its target found again by the
/// tag in its label -- and completes; replace put a blank device in the place of a missing one.
/// Safety: `reason` writable.
@export("selftest_cosmofs_resilver_resume")
unsafe fn selftestResilverResume(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    cosmofs_test_resilver_hold(true);
    let ok = resilverResume(mut s, reason);
    cosmofs_test_resilver_hold(false);
    mirrorDown(mut s);
    if (!s.extra.isNull()) {
        ramblk_set_fail(s.extra, 0);
        ramblk_destroy(s.extra);
    }
    return ok;
}

/// Safety: `reason` writable.
unsafe fn resilverResume(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 40 * 4096;
    let d = data(0x71, len); // 'q'
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 1356\0");
    }
    s.extra = ramblk_create(512);
    let nd = s.extra;
    if (!(!nd.isNull())) {
        return failed(reason, "check failed: nd != NULL at line 1361\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/a\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/a\", data, sizeof(data)) && vfs_sync() == 0 at line 1365\0");
    }
    ramblk_set_fail(s.bd[1], -ENODEV);
    if (!(cfst_write_file(c("/mnt/eng/b\0"), d, 4096) && vfs_sync() == 0)) {
        return failed(reason, "check failed: write_file(ENG \"/b\", data, 4096) && vfs_sync() == 0 at line 1369\0");
    }
    if (!(poolOp(POOL_REPLACE, devName(s.bd[1]), devName(nd)) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_REPLACE, bd[1]->name, nd->name) == 0 at line 1372\0");
    }
    var pool = engPool();
    if (!(m0(pool).ncopies == 2 && cp(pool, 1).dev == nd)) {
        return failed(reason, "check failed: pool->m[0].ncopies == 2 && pool->m[0].copy[1].dev == nd at line 1376\0");
    }
    if (!(cp(pool, 1).state == COPY_RESILVERING && cp(pool, 1).whole)) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].state == POOL_COPY_RESILVERIN...pool->m[0].copy[1].whole at line 1380\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 12) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 12) == 0 at line 1383\0");
    }
    // A commit records the cursor.
    if (!(cfst_write_file(c("/mnt/eng/mid\0"), "mid".ptr as *void, 3) && vfs_sync() == 0)) {
        return failed(reason, "check failed: write_file(ENG \"/mid\", \"mid\", 3) && vfs_sync() == 0 at line 1387\0");
    }
    let saved = cp(pool, 1).cursor;
    if (!(saved > 2)) {
        return failed(reason, "check failed: saved > 2 at line 1391\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1394\0");
    }

    // The "reboot": the target is found by its tag and goes on.
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 1399\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    pool = engPool();
    let cp1 = cp(pool, 1);
    if (!(cp1.dev == nd && cp1.state == COPY_RESILVERING && cp1.whole && cp1.cursor == saved)) {
        return failed(reason,
            "check failed: cp->dev == nd && cp->state == POOL_COPY_RESILVER...e && cp->cursor == saved at line 1406\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1409\0");
    }
    if (!(cp1.state == COPY_ONLINE && cp1.dev == nd)) {
        return failed(reason, "check failed: cp->state == POOL_COPY_ONLINE && cp->dev == nd at line 1412\0");
    }
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1415\0");
    }
    var compared: u32 = 0;
    if (!(sameAllocated(s.bd[0], nd, borrow mut compared as *mut u32))) {
        return failed(reason, "check failed: same_allocated(bd[0], nd, &compared) at line 1419\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1422\0");
    }
    ramblk_set_fail(s.bd[0], -ENODEV);
    if (!(vfs_mount(eng(), c("cosmofs\0"), nd, 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", nd, 0) == 0 at line 1426\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    if (!(cfst_read_matches(c("/mnt/eng/a\0"), d, len)
            && cfst_read_matches(c("/mnt/eng/mid\0"), "mid".ptr as *void, 3))) {
        return failed(reason,
            "check failed: read_matches(ENG \"/a\", data, sizeof(data)) &...(ENG \"/mid\", \"mid\", 3) at line 1432\0");
    }
    var buffer = [0u8; 120];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-resilver-resume: stopped at block ");
    line.decimal(saved);
    line.text(", resumed there, ");
    line.decimal(compared as u64);
    line.text(" blocks the same");
    KernelLog.send(LogLevel.Info, line);
    return true;
}

/// A spare takes over by itself: a copy pulled while the pool has a spare is replaced by it, the takeover resilvers it
/// whole, and the spare is then a member -- the pool whole again, the spare list empty. The spare is held while it
/// waits (CFS-5).
/// Safety: `reason` writable.
@export("selftest_cosmofs_spare")
unsafe fn selftestSpare(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    cosmofs_test_resilver_hold(true);
    let ok = spare(mut s, reason);
    cosmofs_test_resilver_hold(false);
    mirrorDown(mut s);
    if (!s.extra.isNull()) {
        ramblk_set_fail(s.extra, 0);
        ramblk_destroy(s.extra);
    }
    return ok;
}

/// Safety: `reason` writable.
unsafe fn spare(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 8 * 4096;
    let d = data(0x73, len); // 's'
    if (!(mirrorUp(s, 512))) {
        return failed(reason, "check failed: mirror_up(bd, 512) at line 1469\0");
    }
    s.extra = ramblk_create(512);
    let sp = s.extra;
    if (!(!sp.isNull())) {
        return failed(reason, "check failed: sp != NULL at line 1474\0");
    }
    if (!(cfst_write_file(c("/mnt/eng/a\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/a\", data, sizeof(data)) && vfs_sync() == 0 at line 1478\0");
    }
    if (!(poolOp(POOL_SPARE_ADD, devName(sp), 0 as *CChar) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_SPARE_ADD, sp->name, NULL) == 0 at line 1481\0");
    }
    var pool = engPool();
    if (!(pv(pool).nspares == 1 && pv(pool).spare[0] == sp && vfs_bdev_mounted(sp))) {
        return failed(reason,
            "check failed: pool->nspares == 1 && pool->spare[0] == sp && vfs_bdev_mounted(sp) at line 1486\0");
    }
    if (!(poolOp(POOL_SPARE_ADD, devName(sp), 0 as *CChar) == -EEXIST)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_SPARE_ADD, sp->name, NULL) == -EEXIST at line 1490\0");
    }

    ramblk_set_fail(s.bd[1], -ENODEV);
    if (!(cfst_write_file(c("/mnt/eng/b\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/b\", data, sizeof(data)) && vfs_sync() == 0 at line 1496\0");
    }
    if (!(cp(pool, 1).state == COPY_MISSING)) {
        return failed(reason, "check failed: pool->m[0].copy[1].state == POOL_COPY_MISSING at line 1499\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1502\0");
    }
    let cp1 = cp(pool, 1);
    if (!(cp1.dev == sp && cp1.state == COPY_ONLINE && pv(pool).nspares == 0)) {
        return failed(reason,
            "check failed: cp->dev == sp && cp->state == POOL_COPY_ONLINE && pool->nspares == 0 at line 1507\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(stats(st) == 0 && sv(st).devices == 2 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...== 2 && st.degraded == 0 at line 1513\0");
    }
    if (!(vfs_sync() == 0)) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1516\0");
    }
    if (!(sameAllocated(s.bd[0], sp, 0 as *mut u32))) {
        return failed(reason, "check failed: same_allocated(bd[0], sp, NULL) at line 1519\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1522\0");
    }
    // The pulled disk comes back; the pool has its two copies and leaves it.
    ramblk_set_fail(s.bd[1], 0);
    if (!(vfs_mount(eng(), c("cosmofs\0"), s.bd[0], 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 1527\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    if (!(stats(st) == 0 && sv(st).devices == 2 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...== 2 && st.degraded == 0 at line 1532\0");
    }
    pool = engPool();
    if (!(cp(pool, 1).dev == sp || cp(pool, 0).dev == sp)) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].dev == sp || pool->m[0].copy[0].dev == sp at line 1537\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/b\0"), d, len))) {
        return failed(reason, "check failed: read_matches(ENG \"/b\", data, sizeof(data)) at line 1540\0");
    }
    KernelLog.write(LogLevel.Info, "selftest: cosmofs-spare: the spare took the pulled copy's place and is a member");
    return true;
}

/// A single-device pool becomes a mirror (attach), a good copy is replaced with the old one serving until the new one
/// is done (replace), and the mirror goes back to one device (detach). Offline and online with nothing written
/// meanwhile need no resilver; the last good copy cannot be taken offline or detached.
/// Safety: `reason` writable.
@export("selftest_cosmofs_attach")
unsafe fn selftestAttach(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var s = rig();
    cosmofs_test_resilver_hold(true);
    let ok = attach(mut s, reason);
    cosmofs_test_resilver_hold(false);
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    let _ = vfs_rmdir(0 as *mut vnode, eng());
    for (i in 0usize..3) {
        if (!s.bd[i].isNull()) {
            ramblk_destroy(s.bd[i]);
        }
    }
    return ok;
}

/// Safety: `reason` writable.
unsafe fn attach(s: borrow mut Rig, reason: *mut *CChar) -> bool {
    let len: usize = 6 * 4096;
    let d = data(0x74, len); // 't'
    let _ = vfs_umount2(eng(), VFS_UMOUNT_FORCE);
    for (i in 0usize..3) {
        s.bd[i] = ramblk_create(512);
        if (!(!s.bd[i].isNull())) {
            return failed(reason, "check failed: bd[i] != NULL at line 1575\0");
        }
    }
    let b0 = s.bd[0];
    let b1 = s.bd[1];
    let b2 = s.bd[2];
    let none = 0 as *CChar;
    if (!(vfs_format(c("cosmofs\0"), b0, none) == 0)) {
        return failed(reason, "check failed: vfs_format(\"cosmofs\", bd[0], NULL) == 0 at line 1583\0");
    }
    let mk = vfs_mkdir(0 as *mut vnode, eng(), 493);
    if (!(mk == 0 || mk == -EEXIST)) {
        return failed(reason, "check failed: mk == 0 || mk == -EEXIST at line 1587\0");
    }
    if (!(vfs_mount(eng(), c("cosmofs\0"), b0, 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 1590\0");
    }
    cosmofs_test_set_writeback(cfst_mount_of(eng()), false);
    if (!(cfst_write_file(c("/mnt/eng/a\0"), d, len) && vfs_sync() == 0)) {
        return failed(reason,
            "check failed: write_file(ENG \"/a\", data, sizeof(data)) && vfs_sync() == 0 at line 1595\0");
    }
    var stSlot = [0u64; 16];
    let st = borrow mut stSlot as *mut [u64; 16] as *mut cosmofs_stats;
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).version == FORMAT_VERSION)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...on == CFS_FORMAT_VERSION at line 1601\0");
    }

    // attach: one disk becomes a mirror.
    if (!(poolOp(POOL_ATTACH, devName(b0), devName(b1)) == 0)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_ATTACH, bd[0]->name, bd[1]->name) == 0 at line 1607\0");
    }
    let pool = engPool();
    if (!(m0(pool).ncopies == 2 && cp(pool, 1).state == COPY_RESILVERING)) {
        return failed(reason,
            "check failed: pool->m[0].ncopies == 2 && pool->m[0].copy[1].st...== POOL_COPY_RESILVERING at line 1612\0");
    }
    if (!(stats(st) == 0 && sv(st).version == 13)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.version == 13 at line 1616\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1619\0");
    }
    if (!(cp(pool, 1).state == COPY_ONLINE)) {
        return failed(reason, "check failed: pool->m[0].copy[1].state == POOL_COPY_ONLINE at line 1622\0");
    }
    if (!(vfs_sync() == 0 && sameAllocated(b0, b1, 0 as *mut u32))) {
        return failed(reason, "check failed: vfs_sync() == 0 && same_allocated(bd[0], bd[1], NULL) at line 1625\0");
    }

    // offline and online: the commit that recorded the offline is one the copy missed, so online resilvers that much
    // and no more.
    if (!(poolOp(POOL_OFFLINE, devName(b1), none) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_OFFLINE, bd[1]->name, NULL) == 0 at line 1631\0");
    }
    if (!(cp(pool, 1).state == COPY_OFFLINE)) {
        return failed(reason, "check failed: pool->m[0].copy[1].state == POOL_COPY_OFFLINE at line 1634\0");
    }
    if (!(poolOp(POOL_OFFLINE, devName(b0), none) == -EBUSY)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_OFFLINE, bd[0]->name, NULL) == -EBUSY at line 1638\0");
    }
    if (!(poolOp(POOL_ONLINE, devName(b1), none) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_ONLINE, bd[1]->name, NULL) == 0 at line 1641\0");
    }
    if (!(cp(pool, 1).state == COPY_RESILVERING && !cp(pool, 1).whole)) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].state == POOL_COPY_RESILVERIN...pool->m[0].copy[1].whole at line 1645\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1648\0");
    }
    if (!(cp(pool, 1).state == COPY_ONLINE)) {
        return failed(reason, "check failed: pool->m[0].copy[1].state == POOL_COPY_ONLINE at line 1651\0");
    }

    // replace a good copy: bd[1] serves until bd[2] is done, then goes.
    if (!(poolOp(POOL_REPLACE, devName(b1), devName(b2)) == 0)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_REPLACE, bd[1]->name, bd[2]->name) == 0 at line 1657\0");
    }
    if (!(m0(pool).ncopies == 3 && cp(pool, 1).peer != 0)) {
        return failed(reason, "check failed: pool->m[0].ncopies == 3 && pool->m[0].copy[1].peer != 0 at line 1660\0");
    }
    if (!(cp(pool, 2).dev == b2 && cp(pool, 2).state == COPY_RESILVERING)) {
        return failed(reason,
            "check failed: pool->m[0].copy[2].dev == bd[2] && pool->m[0].co...== POOL_COPY_RESILVERING at line 1664\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1667\0");
    }
    if (!(m0(pool).ncopies == 2 && cp(pool, 1).dev == b2)) {
        return failed(reason,
            "check failed: pool->m[0].ncopies == 2 && pool->m[0].copy[1].dev == bd[2] at line 1671\0");
    }
    if (!(cp(pool, 1).state == COPY_ONLINE && !vfs_bdev_mounted(b1))) {
        return failed(reason,
            "check failed: pool->m[0].copy[1].state == POOL_COPY_ONLINE && !vfs_bdev_mounted(bd[1]) at line 1675\0");
    }
    var aSlot = [0u64; 21];
    var bSlot = [0u64; 21];
    let a = borrow mut aSlot as *mut [u64; 21] as *mut cfs_super;
    let b = borrow mut bSlot as *mut [u64; 21] as *mut cfs_super;
    var ra: i32 = 0;
    var rb: i32 = 0;
    let slots = cfs_super_slots(b1, a, borrow mut ra as *mut i32, b, borrow mut rb as *mut i32);
    // no longer the pool's
    if (!(slots == 0 && ra != 0 && rb != 0)) {
        return failed(reason,
            "check failed: cfs_super_slots(bd[1], &a, &ra, &b, &rb) == 0 && ra != 0 && rb != 0 at line 1687\0");
    }
    if (!(vfs_sync() == 0 && sameAllocated(b0, b2, 0 as *mut u32))) {
        return failed(reason, "check failed: vfs_sync() == 0 && same_allocated(bd[0], bd[2], NULL) at line 1690\0");
    }

    // A replace whose sources disagree keeps the copy it replaces (Codex on #440): copy 0's block of /a rots, the walk
    // copies the rot from it, bd[2] -- the good one -- is not detached, and after a scrub put the copies right the
    // operator detaches it.
    var ablk: u64 = 0;
    if (!(firstBlock(c("/mnt/eng/a\0"), borrow mut ablk as *mut u64) == 0)) {
        return failed(reason, "check failed: cosmofs_test_block_of(mount_of(ENG), aino, 0, &ablk) == 0 at line 1698\0");
    }
    if (!(cfst_rot_copy(b0, ablk & DVA_BLK_MASK, 0x5c))) {
        return failed(reason, "check failed: rot_copy(bd[0], CFS_DVA_BLK(ablk), 0x5c) at line 1701\0");
    }
    if (!(poolOp(POOL_REPLACE, devName(b2), devName(b1)) == 0)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_REPLACE, bd[2]->name, bd[1]->name) == 0 at line 1705\0");
    }
    if (!(cosmofs_test_resilver_run(cfst_mount_of(eng()), 0) == 0)) {
        return failed(reason, "check failed: cosmofs_test_resilver_run(mount_of(ENG), 0) == 0 at line 1708\0");
    }
    var kv: u32 = 0;
    var kc: u32 = 0;
    if (!(m0(pool).ncopies == 3 && pool_find_dev(pool, b2, borrow mut kv as *mut u32, borrow mut kc as *mut u32)
            && cp(pool, kc).peer == 0)) {
        return failed(reason,
            "check failed: pool->m[0].ncopies == 3 && pool_find_dev(pool, b...>m[0].copy[kc].peer == 0 at line 1715\0");
    }
    var scSlot = [0u64; 8];
    let sc = borrow mut scSlot as *mut [u64; 8] as *mut cosmofs_scrub_stats;
    if (!(cosmofs_scrub(cfst_mount_of(eng()), sc, SCRUB_REPAIR) == 0 && scv(sc).repaired >= 2
            && scv(sc).unrecoverable == 0)) {
        return failed(reason,
            "check failed: cosmofs_scrub(mount_of(ENG), &sc, COSMOFS_SCRUB_...&& sc.unrecoverable == 0 at line 1722\0");
    }
    if (!(poolOp(POOL_DETACH, devName(b2), none) == 0 && m0(pool).ncopies == 2)) {
        return failed(reason,
            "check failed: pool_op(COSMOFS_POOL_DETACH, bd[2]->name, NULL) ... pool->m[0].ncopies == 2 at line 1726\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/a\0"), d, len))) {
        return failed(reason, "check failed: read_matches(ENG \"/a\", data, sizeof(data)) at line 1729\0");
    }
    if (!(vfs_sync() == 0 && sameAllocated(b0, b1, 0 as *mut u32))) {
        return failed(reason, "check failed: vfs_sync() == 0 && same_allocated(bd[0], bd[1], NULL) at line 1732\0");
    }

    // detach: back to one device.
    if (!(poolOp(POOL_DETACH, devName(b1), none) == 0)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_DETACH, bd[1]->name, NULL) == 0 at line 1737\0");
    }
    if (!(m0(pool).ncopies == 1)) {
        return failed(reason, "check failed: pool->m[0].ncopies == 1 at line 1740\0");
    }
    if (!(poolOp(POOL_DETACH, devName(b0), none) == -EBUSY)) {
        return failed(reason, "check failed: pool_op(COSMOFS_POOL_DETACH, bd[0]->name, NULL) == -EBUSY at line 1743\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...== 1 && st.degraded == 0 at line 1747\0");
    }
    if (!(umount(eng()) == 0)) {
        return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 1750\0");
    }
    if (!(vfs_mount(eng(), c("cosmofs\0"), b0, 0) == 0)) {
        return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd[0], 0) == 0 at line 1753\0");
    }
    if (!(cfst_read_matches(c("/mnt/eng/a\0"), d, len))) {
        return failed(reason, "check failed: read_matches(ENG \"/a\", data, sizeof(data)) at line 1756\0");
    }
    if (!(stats(st) == 0 && sv(st).devices == 1 && sv(st).degraded == 0)) {
        return failed(reason,
            "check failed: cosmofs_stats(mount_of(ENG), &st) == 0 && st.dev...== 1 && st.degraded == 0 at line 1760\0");
    }
    KernelLog.write(LogLevel.Info, "selftest: cosmofs-attach: attach, offline/online, replace and detach");
    return true;
}
