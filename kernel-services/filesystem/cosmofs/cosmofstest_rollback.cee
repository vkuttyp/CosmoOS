// cosmofstest_rollback.cee - The cosmofs self-tests of rollbacks and clones (roadmap 1.2 B1; design.md, "Rollback"
// and "Clones"), in CeeSafe: roadmap 2.0 SA7.
//
// cosmofs-rollback, cosmofs-rollback-shared, cosmofs-rollback-atomic, cosmofs-rollback-record and cosmofs-clone, on
// the RAM device cosmofstest_lib.cee mounts at /mnt/eng. A check's reason keeps the C's form, "check failed: COND at
// line N", N its line here. What the C kept in statics (a snapshot record, a check report, the files' contents) is in
// statics here too: the runner runs one self-test at a time. The values and sizes
// written here as constants are the headers', which the C compiler checks, and a build without CONFIG_DEBUG runs none
// of these tests (a `cfg` block; ADR 0080).

@header("kernel/blk.h", "kernel/vfs.h", "kernel/kmalloc.h", "kernel/string.h", "kernel/crc32c.h", "kernel/cosmofs.h",
    "uapi/cosmo/syscall.h", "cosmofs_internal.h", "kernel/errno.h", "kernel/selftest.h", "cosmofs_format.h")
extern "C" {
    struct blkdev;
    struct mount;
    struct vnode;
    struct file;
    struct cfs_rollback;
    struct cosmo_stat;
    struct cosmofs_check_class {
        count: u64;
        repaired: u64;
        name: [u64; 8];
    }
    struct cosmofs_check_report {
        alloc_not_seen: cosmofs_check_class;
        seen_not_alloc: cosmofs_check_class;
        orphan: cosmofs_check_class;
        rollback_record: cosmofs_check_class;
        hold: cosmofs_check_class;
        clean: bool;
    }
    struct cosmofs_snap_info {
        flags: u32;
        name: [u8; 32];
    }
    struct cosmofs_snap_req {
        op: u32;
        name: *CChar;
        name2: *CChar;
        out: *mut cosmofs_snap_info;
        max: u32;
        no_sizes: bool;
        count: u32;
        total: u32;
        pool_flags: u32;
    }

    fn vfs_open(start: *mut vnode, path: *CChar, flags: u32, mode: u32, out: *mut *mut file) -> i32;
    fn file_write(f: *mut file, buf: *void, len: usize) -> i64;
    fn file_sync(f: *mut file) -> i32;
    fn vfs_mkdir(start: *mut vnode, path: *CChar, mode: u32) -> i32;
    fn vfs_unlink(start: *mut vnode, path: *CChar) -> i32;
    fn vfs_rename(start: *mut vnode, from: *CChar, to: *CChar) -> i32;
    fn vfs_symlink(start: *mut vnode, path: *CChar, target: *CChar) -> i32;
    fn vfs_stat(start: *mut vnode, path: *CChar, st: *mut cosmo_stat) -> i32;
    fn vfs_mount(path: *CChar, fsname: *CChar, bd: *mut blkdev, flags: u32) -> i32;
    fn vfs_umount2(path: *CChar, flags: u32) -> i32;
    fn vfs_sync() -> i32;
    /// cosmofstest_lib_floor.c: cosmofs_stats into `out`, a struct cosmofs_stats (a name a struct has too).
    fn cfst_stats(mnt: *mut mount, out: *mut void) -> i32;
    fn cosmofs_check(mnt: *mut mount, out: *mut cosmofs_check_report, flags: u32) -> i32;
    fn cosmofs_snapctl(mnt: *mut mount, req: *mut cosmofs_snap_req) -> i32;
    fn cosmofs_test_corrupt(mnt: *mut mount, kind: u32, ino: u64, what: *mut u64) -> i32;
    fn cosmofs_test_commit_budget(mnt: *mut mount, armed: bool, left: u32);
    fn cosmofs_test_discard_on_unmount(mnt: *mut mount, discard: bool);
    fn cosmofs_test_set_writeback(mnt: *mut mount, on: bool);
    fn cfs_rollback_seal(r: *mut cfs_rollback);
    fn cfs_rollback_parse(payload: *void, out: *mut cfs_rollback) -> i32;
    fn crc32c(data: *void, len: usize) -> u32;
    fn strcmp(a: *CChar, b: *CChar) -> i32;
    fn strncmp(a: *CChar, b: *CChar, n: usize) -> i32;
    fn memcmp(a: *void, b: *void, n: usize) -> i32;
    fn memcpy(dst: *mut void, src: *void, n: usize) -> *mut void;
    // cosmofstest_lib.cee's (cosmofstest.h).
    fn cfst_mount_of(path: *CChar) -> *mut mount;
    fn cfst_write_file(path: *CChar, data: *void, len: usize) -> bool;
    fn cfst_read_matches(path: *CChar, data: *void, len: usize) -> bool;
    fn cfst_engine_mount(bdp: *mut *mut blkdev, nblocks: u64, reason: *mut *CChar) -> bool;
    fn cfst_engine_unmount(bd: *mut blkdev, reason: *mut *CChar) -> bool;
    fn cfst_remount_eng(bd: *mut blkdev, reason: *mut *CChar) -> bool;
    fn cfst_snapctl(op: u32, name: *CChar, out: *mut cosmofs_snap_info, max: u32, count: *mut u32) -> i32;
    fn cfst_info_named(v: *cosmofs_snap_info, n: u32, name: *CChar) -> *cosmofs_snap_info;

    // The values and layout the C compiler checks (ADR 0080 §3.1), which the floor asserted.
    const ENOENT: i32 = 2;
    const EIO: i32 = 5;
    const EBUSY: i32 = 16;
    const EEXIST: i32 = 17;
    const EXDEV: i32 = 18;
    const EINVAL: i32 = 22;
    const EROFS: i32 = 30;
    /// cosmofstest_rollback.cee's errno.h and syscall.h values
    @cvalue("COSMO_O_RDONLY == 0 && COSMO_O_RDWR == 2")
    const COSMOFSTEST_ROLLBACK_FACT_0: bool = true;
    /// cosmofstest_rollback.cee's cosmofs.h values
    @cvalue("COSMOFS_SNAP_CREATE == 1 && COSMOFS_SNAP_LIST == 2 && COSMOFS_SNAP_DELETE == 3 && COSMOFS_SNAP_ROLLBACK == 4 && COSMOFS_SNAP_CANCEL == 5 && COSMOFS_SNAP_CLONE == 6 && COSMOFS_SNAP_BOOT_OK == 7 && COSMOFS_POOL_PENDING == 1 && COSMOFS_POOL_HELD == 2 && COSMOFS_SNAP_I_TARGET == 2 && COSMOFS_SNAP_I_SAFETY == 4 && COSMOFS_SNAP_I_HELD == 8 && COSMOFS_CORRUPT_ROLLBACK_CRC == 18 && COSMOFS_CHECK_REPAIR == 1")
    const COSMOFSTEST_ROLLBACK_FACT_1: bool = true;
    /// cosmofstest_rollback.cee's slots for cosmofs.h's and syscall.h's structs
    @cvalue("sizeof(struct cosmofs_snap_info) <= 13 * 8 && sizeof(struct cosmofs_snap_req) <= 12 * 8 && sizeof(struct cosmofs_check_report) <= 200 * 8 && sizeof(struct cosmo_stat) <= 8 * 8 && sizeof(struct cosmofs_stats) <= 32 * 8 && offsetof(struct cosmofs_stats, free_blocks) == 8")
    const COSMOFSTEST_ROLLBACK_FACT_2: bool = true;
    /// cosmofstest_rollback.cee's cosmofs_format.h values and offsets
    @cvalue("sizeof(struct cfs_rollback) == 120 && offsetof(struct cfs_rollback, magic) == 0 && offsetof(struct cfs_rollback, version) == 4 && offsetof(struct cfs_rollback, state) == 8 && offsetof(struct cfs_rollback, target_uuid) == 16 && offsetof(struct cfs_rollback, safety_uuid) == 32 && offsetof(struct cfs_rollback, target_id) == 48 && offsetof(struct cfs_rollback, safety_id) == 56 && offsetof(struct cfs_rollback, generation) == 64 && offsetof(struct cfs_rollback, requested_ns) == 72 && offsetof(struct cfs_rollback, crc) == 112 && CFS_ROLLBACK_MAGIC == 0x42524643u && CFS_ROLLBACK_PENDING == 1 && CFS_ROLLBACK_HELD == 2")
    const COSMOFSTEST_ROLLBACK_FACT_3: bool = true;
}

// ---- Values ----

const O_RDONLY: u32 = 0;
const O_RDWR: u32 = 2;
const SNAP_CREATE: u32 = 1;
const SNAP_LIST: u32 = 2;
const SNAP_DELETE: u32 = 3;
const SNAP_ROLLBACK: u32 = 4;
const SNAP_CANCEL: u32 = 5;
const SNAP_CLONE: u32 = 6;
const SNAP_BOOT_OK: u32 = 7;
const POOL_PENDING: u32 = 1;
const POOL_HELD: u32 = 2;
const SNAP_I_TARGET: u32 = 2;
const SNAP_I_SAFETY: u32 = 4;
const SNAP_I_HELD: u32 = 8;
const CORRUPT_ROLLBACK_CRC: u32 = 18;
const CHECK_REPAIR: u32 = 1;
/// struct cosmofs_stats: free_blocks is its second u64.
const STATS_FREE_BLOCKS: usize = 1;
/// struct cfs_rollback and the offsets of its fields.
const RB_SIZE: usize = 120;
const RB_MAGIC: usize = 0;
const RB_VERSION: usize = 4;
const RB_STATE: usize = 8;
const RB_TARGET_UUID: usize = 16;
const RB_SAFETY_UUID: usize = 32;
const RB_TARGET_ID: usize = 48;
const RB_SAFETY_ID: usize = 56;
const RB_GENERATION: usize = 64;
const RB_REQUESTED_NS: usize = 72;
const RB_CRC: usize = 112;
const ROLLBACK_MAGIC: u32 = 0x42524643;
const ROLLBACK_PENDING: u32 = 1;
const ROLLBACK_HELD: u32 = 2;

fn eng() -> *CChar => "/mnt/eng\0".ptr as *CChar;

fn path(s: StringView) -> *CChar => s.ptr as *CChar;

/// Safety: `reason` writable.
unsafe fn failed(reason: *mut *CChar, why: StringView) -> bool {
    reason.write(why.ptr as *CChar);
    return false;
}

/// Safety: `f` is an open file.
unsafe fn filePut(f: *mut file) { kobject_put(f as *mut kobject); }

/// Safety: none beyond the VFS's own.
unsafe fn mnt() -> *mut mount => cfst_mount_of(eng());

fn say(line: borrow TextWriter) { KernelLog.send(LogLevel.Info, line); }

// ---- What the C kept in statics: the runner runs one self-test at a time ----

static mut g_info: [u64; 13] = [0; 13];
static mut g_rep: [u64; 200] = [0; 200];
static mut g_big: [u8; 131072] = [0; 131072];
static mut g_other: [u8; 131072] = [0; 131072];
static mut g_list: [u64; 208] = [0; 208];

/// Safety: one self-test at a time uses it.
unsafe fn info() -> *mut cosmofs_snap_info => borrow mut g_info as *mut [u64; 13] as *mut cosmofs_snap_info;

/// Safety: one self-test at a time uses it.
unsafe fn rep() -> *mut cosmofs_check_report => borrow mut g_rep as *mut [u64; 200] as *mut cosmofs_check_report;

/// Safety: one self-test at a time uses it.
unsafe fn big() -> *mut u8 => borrow mut g_big as *mut [u8; 131072] as *mut u8;

/// Safety: one self-test at a time uses it.
unsafe fn other() -> *mut u8 => borrow mut g_other as *mut [u8; 131072] as *mut u8;

/// The first record's name.
/// Safety: `info()` holds a record.
unsafe fn infoName() -> *CChar => borrow Ptr.toBorrow(info() as *cosmofs_snap_info).name as *[u8; 32] as *CChar;

/// The report.
/// Safety: one self-test at a time uses it.
unsafe fn rr() -> *cosmofs_check_report => rep() as *cosmofs_check_report;

/// The check of /mnt/eng into `rep()` succeeded and found nothing.
/// Safety: none beyond the filesystem's own.
unsafe fn checkClean() -> bool => cosmofs_check(mnt(), rep(), 0) == 0 && Ptr.toBorrow(rr()).clean;

/// `len` bytes of xorshift64 from `seed` into `out`, and their complement into `inv` when it is not null.
/// Safety: `out` (and `inv`) `len` writable bytes.
unsafe fn xorshiftFill(out: *mut u8, inv: *mut u8, len: usize, seed: u64) {
    var x = seed;
    for (i in 0usize..len) {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        out.add(i).write(truncate<u8>(x));
        if (!inv.isNull()) {
            inv.add(i).write(truncate<u8>(x) ^ 0xFF);
        }
    }
}

/// A request with `op`, `name`, `name2`, `out` and `max`, answered; `total` and `pool_flags` get the request's.
/// Safety: the names null or terminated strings; `out` null or `max` records.
unsafe fn snapReq(op: u32, name: *CChar, name2: *CChar, out: *mut cosmofs_snap_info, max: u32, noSizes: bool,
    count: *mut u32, total: *mut u32, poolFlags: *mut u32) -> i32 {
    var slot = [0u64; 12];
    let req = borrow mut slot as *mut [u64; 12] as *mut cosmofs_snap_req;
    let r = Ptr.toBorrowMut(req);
    r.op = op;
    r.name = name;
    r.name2 = name2;
    r.out = out;
    r.max = max;
    r.no_sizes = noSizes;
    let rc = cosmofs_snapctl(mnt(), req);
    let done = Ptr.toBorrow(req as *cosmofs_snap_req);
    if (!count.isNull()) {
        count.write(done.count);
    }
    if (!total.isNull()) {
        total.write(done.total);
    }
    if (!poolFlags.isNull()) {
        poolFlags.write(done.pool_flags);
    }
    return rc;
}

/// The list's 16 records.
/// Safety: one self-test at a time uses it.
unsafe fn list() -> *mut cosmofs_snap_info => borrow mut g_list as *mut [u64; 208] as *mut cosmofs_snap_info;

/// The pool's rollback state, from a listing without sizes.
/// Safety: none beyond the filesystem's own.
unsafe fn poolFlagsNow() -> u32 {
    var flags: u32 = 0;
    let none = 0 as *mut u32;
    if (snapReq(SNAP_LIST, 0 as *CChar, 0 as *CChar, list(), 16, true, none, none, borrow mut flags as *mut u32) != 0) {
        return 0xFFFF;
    }
    return flags;
}

/// The flags of the snapshot named `name`, or 0xFFFFFFFF.
/// Safety: `name` a terminated string.
unsafe fn snapFlagsOf(name: *CChar) -> u32 {
    var n: u32 = 0;
    let none = 0 as *mut u32;
    if (snapReq(SNAP_LIST, 0 as *CChar, 0 as *CChar, list(), 16, true, borrow mut n as *mut u32, none, none) != 0) {
        return 0xFFFFFFFF;
    }
    let s = cfst_info_named(list() as *cosmofs_snap_info, n, name);
    return if (s.isNull()) 0xFFFFFFFF else Ptr.toBorrow(s).flags;
}

/// A rollback to `target`, the safety snapshot named `safety` (or by the filesystem when null), recorded in `out`.
/// Safety: `target` a terminated string; `safety` null or one; `out` null or a record.
unsafe fn rollbackReq(target: *CChar, safety: *CChar, out: *mut cosmofs_snap_info) -> i32 {
    let none = 0 as *mut u32;
    return snapReq(SNAP_ROLLBACK, target, safety, out, if (out.isNull()) 0 else 1, false, none, none, none);
}

/// A clone of `origin` named `clone`.
/// Safety: both terminated strings.
unsafe fn cloneReq(origin: *CChar, clone: *CChar) -> i32 {
    var out = [0u64; 13];
    let none = 0 as *mut u32;
    return snapReq(SNAP_CLONE, origin, clone, borrow mut out as *mut [u64; 13] as *mut cosmofs_snap_info, 1, false,
        none, none, none);
}

/// BOOT_OK; `total` gets how many holds it released.
/// Safety: `total` writable.
unsafe fn bootOk(total: *mut u32) -> i32 {
    let none = 0 as *mut u32;
    return snapReq(SNAP_BOOT_OK, 0 as *CChar, 0 as *CChar, 0 as *mut cosmofs_snap_info, 0, false, none, total, none);
}

/// Safety: `name` null or a terminated string.
unsafe fn snap(op: u32, name: *CChar) -> i32 => cfst_snapctl(op, name, 0 as *mut cosmofs_snap_info, 0, 0 as *mut u32);

/// Safety: `name` a terminated string; `n` writable.
unsafe fn create(name: *CChar, n: *mut u32) -> i32 => cfst_snapctl(SNAP_CREATE, name, info(), 1, n);

/// Whether `p` names nothing.
/// Safety: `p` a terminated string.
unsafe fn absent(p: *CChar) -> bool {
    var st = [0u64; 8];
    return vfs_stat(0 as *mut vnode, p, borrow mut st as *mut [u64; 8] as *mut cosmo_stat) == -ENOENT;
}

/// Safety: `out` writable.
unsafe fn freeBlocks(out: *mut u64) -> bool {
    var slot = [0u64; 32];
    if (cfst_stats(mnt(), borrow mut slot as *mut [u64; 32] as *mut void) != 0) {
        return false;
    }
    out.write(slot[STATS_FREE_BLOCKS]);
    return true;
}

/// "selftest: TEST: after WHEN: [N orphan(s), ]N leaked, N free-in-use".
/// Safety: `rep()` a report the check filled.
unsafe fn sayCounts(test: StringView, when: StringView, orphans: bool) {
    let r = Ptr.toBorrow(rr());
    var buffer = [0u8; 160];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: ");
    line.text(test);
    line.text(": after ");
    line.text(when);
    line.text(": ");
    if (orphans) {
        line.decimal(r.orphan.count);
        line.text(" orphan(s), ");
    }
    line.decimal(r.alloc_not_seen.count);
    line.text(" leaked, ");
    line.decimal(r.seen_not_alloc.count);
    line.text(" free-in-use");
    say(line);
}

// ---- cosmofs-rollback ----

/// Rollback to a snapshot (roadmap 1.2 B1; design.md, "Rollback"). Requested: the record is written and while it is
/// pending both snapshots are kept and a second request is refused; a cancel withdraws it. Applied at the mount: the
/// live tree is the target's, what the old tree held is in the safety snapshot, a file written after the request is
/// in neither and its blocks are free; the safety snapshot is held until BOOT_OK. The switch repaired the deadlists if
/// deleting every snapshot afterwards leaves a filesystem the checker calls clean -- a block freed while live is
/// `seen_not_alloc`, a block held for nobody is `alloc_not_seen` -- with the live files intact after a remount. A
/// record whose own checksum is wrong is refused at the mount, named by the checker and removed by its repair.
/// Safety: `reason` writable.
@export("selftest_cosmofs_rollback")
unsafe fn selftestRollback(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var bd = 0 as *mut blkdev;
    if (!cfst_engine_mount(borrow mut bd as *mut *mut blkdev, 2048, reason)) {
        return false;
    }
    let bigLen: usize = 32 * 4096;
    xorshiftFill(big(), 0 as *mut u8, bigLen, 0x2545F4914F6CDD1D);
    var n: u32 = 0;
    let np = borrow mut n as *mut u32;

    if (!cfst_write_file(path("/mnt/eng/a\0"), "one".ptr as *void, 3)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"one\", 3) at line 338\0");
    }
    if (vfs_mkdir(0 as *mut vnode, path("/mnt/eng/dir\0"), 493) != 0) {
        return failed(reason, "check failed: vfs_mkdir(NULL, ENG \"/dir\", 0755) == 0 at line 341\0");
    }
    if (!cfst_write_file(path("/mnt/eng/dir/x\0"), "ex".ptr as *void, 2)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/dir/x\", \"ex\", 2) at line 344\0");
    }
    if (create(path("base\0"), np) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"base\", info, 1, &n) == 0 at line 348\0");
    }
    if (!cfst_write_file(path("/mnt/eng/a\0"), "two".ptr as *void, 3)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"two\", 3) at line 351\0");
    }
    if (vfs_unlink(0 as *mut vnode, path("/mnt/eng/dir/x\0")) != 0) {
        return failed(reason, "check failed: vfs_unlink(NULL, ENG \"/dir/x\") == 0 at line 354\0");
    }
    if (!cfst_write_file(path("/mnt/eng/new\0"), big() as *void, bigLen)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/new\", big, sizeof(big)) at line 357\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 360\0");
    }

    // Requested: pending, both snapshots kept, a second one refused.
    if (rollbackReq(path("nope\0"), 0 as *CChar, info()) != -ENOENT) {
        return failed(reason, "check failed: rollback_req(\"nope\", NULL, info) == -ENOENT at line 365\0");
    }
    if (rollbackReq(path("base\0"), 0 as *CChar, info()) != 0) {
        return failed(reason, "check failed: rollback_req(\"base\", NULL, info) == 0 at line 368\0");
    }
    var safety1 = [0u8; 32];
    let src = infoName() as *u8;
    var k: usize = 0;
    while (k < 31 && src.add(k).read() != 0) {
        safety1[k] = src.add(k).read();
        k += 1;
    }
    let s1 = borrow safety1 as *[u8; 32] as *CChar;
    if (strncmp(s1, path("pre-rollback-\0"), 13) != 0) {
        return failed(reason, "check failed: strncmp(safety1, \"pre-rollback-\", 13) == 0 at line 379\0");
    }
    if (poolFlagsNow() != POOL_PENDING) {
        return failed(reason, "check failed: pool_flags_now() == COSMOFS_POOL_PENDING at line 382\0");
    }
    if (snapFlagsOf(path("base\0")) != SNAP_I_TARGET) {
        return failed(reason, "check failed: snap_flags_of(\"base\") == COSMOFS_SNAP_I_TARGET at line 385\0");
    }
    if (snapFlagsOf(s1) != SNAP_I_SAFETY) {
        return failed(reason, "check failed: snap_flags_of(safety1) == COSMOFS_SNAP_I_SAFETY at line 388\0");
    }
    if (snap(SNAP_DELETE, path("base\0")) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"base\", NULL, 0, NULL) == -EBUSY at line 392\0");
    }
    if (snap(SNAP_DELETE, s1) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, safety1, NULL, 0, NULL) == -EBUSY at line 396\0");
    }
    if (rollbackReq(path("base\0"), 0 as *CChar, info()) != -EBUSY) {
        return failed(reason, "check failed: rollback_req(\"base\", NULL, info) == -EBUSY at line 399\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 403\0");
    }

    // Withdrawn: the record goes, the safety snapshot stays and is an ordinary snapshot again.
    if (snap(SNAP_CANCEL, 0 as *CChar) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_CANCEL, NULL, NULL, 0, NULL) == 0 at line 409\0");
    }
    if (snap(SNAP_CANCEL, 0 as *CChar) != -ENOENT) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_CANCEL, NULL, NULL, 0, NULL) == -ENOENT at line 413\0");
    }
    if (!(poolFlagsNow() == 0 && snapFlagsOf(s1) == 0)) {
        return failed(reason, "check failed: pool_flags_now() == 0 && snap_flags_of(safety1) == 0 at line 416\0");
    }
    if (snap(SNAP_DELETE, s1) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, safety1, NULL, 0, NULL) == 0 at line 420\0");
    }

    // Requested again, with the safety snapshot named; then a file written after the request, which is in neither
    // snapshot.
    if (rollbackReq(path("base\0"), path("keep-me\0"), info()) != 0) {
        return failed(reason, "check failed: rollback_req(\"base\", \"keep-me\", info) == 0 at line 426\0");
    }
    if (strcmp(infoName(), path("keep-me\0")) != 0) {
        return failed(reason, "check failed: strcmp(info[0].name, \"keep-me\") == 0 at line 429\0");
    }
    if (!cfst_write_file(path("/mnt/eng/after\0"), big() as *void, bigLen)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/after\", big, sizeof(big)) at line 432\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 435\0");
    }

    // The mount applies it.
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 440\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "one".ptr as *void, 3)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"one\", 3) at line 443\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/dir/x\0"), "ex".ptr as *void, 2)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/dir/x\", \"ex\", 2) at line 446\0");
    }
    if (!absent(path("/mnt/eng/new\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/new\", &st) == -ENOENT at line 449\0");
    }
    if (!absent(path("/mnt/eng/after\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/after\", &st) == -ENOENT at line 452\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/keep-me/a\0"), "two".ptr as *void, 3)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/keep-me/a\", \"two\", 3) at line 456\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/keep-me/new\0"), big() as *void, bigLen)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/keep-me/new\", big, sizeof(big)) at line 460\0");
    }
    if (!absent(path("/mnt/eng/.snapshots/keep-me/after\0"))) {
        return failed(reason,
            "check failed: vfs_stat(NULL, ENG \"/.snapshots/keep-me/after\", &st) == -ENOENT at line 464\0");
    }
    if (poolFlagsNow() != POOL_HELD) {
        return failed(reason, "check failed: pool_flags_now() == COSMOFS_POOL_HELD at line 467\0");
    }
    if (snapFlagsOf(path("keep-me\0")) != SNAP_I_HELD) {
        return failed(reason, "check failed: snap_flags_of(\"keep-me\") == COSMOFS_SNAP_I_HELD at line 470\0");
    }
    if (snap(SNAP_DELETE, path("keep-me\0")) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"keep-me\", NULL, 0, NULL) == -EBUSY at line 474\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 478\0");
    }

    // The boot completed: the hold goes.
    var total: u32 = 0;
    let tp = borrow mut total as *mut u32;
    if (!(bootOk(tp) == 0 && total == 1)) {
        return failed(reason,
            "check failed: cosmofs_snapctl(cfst_mount_of(ENG), &ok) == 0 && ok.total == 1 at line 486\0");
    }
    if (!(bootOk(tp) == 0 && total == 0)) {
        return failed(reason,
            "check failed: cosmofs_snapctl(cfst_mount_of(ENG), &ok) == 0 && ok.total == 0 at line 490\0");
    }
    if (poolFlagsNow() != 0) {
        return failed(reason, "check failed: pool_flags_now() == 0 at line 493\0");
    }

    // Every snapshot gone: nothing live was freed, nothing is held for nobody.
    if (snap(SNAP_DELETE, path("keep-me\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"keep-me\", NULL, 0, NULL) == 0 at line 499\0");
    }
    if (snap(SNAP_DELETE, path("base\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"base\", NULL, 0, NULL) == 0 at line 503\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 506\0");
    }
    if (cosmofs_check(mnt(), rep(), 0) != 0) {
        return failed(reason, "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 at line 509\0");
    }
    if (!Ptr.toBorrow(rr()).clean) {
        sayCounts("cosmofs-rollback", "the deletions", false);
        return failed(reason, "check failed: rep.clean at line 513\0");
    }
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 516\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "one".ptr as *void, 3)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"one\", 3) at line 519\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/dir/x\0"), "ex".ptr as *void, 2)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/dir/x\", \"ex\", 2) at line 522\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 526\0");
    }

    // A record that does not check out: refused at the mount, named by the checker, removed by its repair.
    if (!cfst_write_file(path("/mnt/eng/a\0"), "three".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"three\", 5) at line 531\0");
    }
    if (create(path("c\0"), np) != 0) {
        return failed(reason, "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"c\", info, 1, &n) == 0 at line 534\0");
    }
    if (!cfst_write_file(path("/mnt/eng/a\0"), "four".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"four\", 4) at line 537\0");
    }
    if (rollbackReq(path("c\0"), 0 as *CChar, info()) != 0) {
        return failed(reason, "check failed: rollback_req(\"c\", NULL, info) == 0 at line 540\0");
    }
    var rec: u64 = 0;
    if (cosmofs_test_corrupt(mnt(), CORRUPT_ROLLBACK_CRC, 0, borrow mut rec as *mut u64) != 0) {
        return failed(reason,
            "check failed: cosmofs_test_corrupt(cfst_mount_of(ENG), COSMOFS_CORRUPT_ROLLBACK_CRC, 0... at line 545\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 548\0");
    }
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 551\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "four".ptr as *void, 4)) { // not applied
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"four\", 4) at line 554\0");
    }
    if (!(cosmofs_check(mnt(), rep(), 0) == 0 && !Ptr.toBorrow(rr()).clean)) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && !rep.clean at line 558\0");
    }
    if (!(Ptr.toBorrow(rr()).rollback_record.count == 1 && Ptr.toBorrow(rr()).rollback_record.name[0] == rec)) {
        return failed(reason,
            "check failed: rep.rollback_record.count == 1 && rep.rollback_record.name[0] == rec at line 562\0");
    }
    if (!(cosmofs_check(mnt(), rep(), CHECK_REPAIR) == 0 && Ptr.toBorrow(rr()).rollback_record.repaired == 1)) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, COSMOFS_CHECK_REPAIR) == 0 && re... at line 566\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 570\0");
    }
    if (poolFlagsNow() != 0) {
        return failed(reason, "check failed: pool_flags_now() == 0 at line 573\0");
    }
    var buffer = [0u8; 256];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-rollback: pending, cancelled, applied at the mount (the old tree in the safety ");
    line.text("snapshot, a later file in neither), held until BOOT_OK, every snapshot deleted with the filesystem ");
    line.text("clean; a bad record refused, named and repaired");
    say(line);
    return cfst_engine_unmount(bd, reason);
}

// ---- cosmofs-rollback-shared ----

/// After a rollback the live tree is an older one, and what it shares with the snapshots is not the line of history
/// the free path assumes. Here the target `t` holds a file the live tree deleted after it (`gone`, on t's deadlist
/// when the safety snapshot was taken) and an inode that was unlinked and open when it was taken (`orph`, whose orphan
/// record was the live tree's, not t's). After the switch: `gone` is live again; rewriting and deleting it, then
/// writing enough to reuse any block given back, leaves t's copy intact (a block freed because only the safety
/// snapshot was asked would be overwritten here); the checker finds no orphan and no leak (the switch put t's orphan
/// on the record and the mount released it). While held, a rollback to anything but the safety snapshot is refused --
/// it would drop the hold -- and one back to the safety snapshot is taken.
/// Safety: `reason` writable.
@export("selftest_cosmofs_rollback_shared")
unsafe fn selftestRollbackShared(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var bd = 0 as *mut blkdev;
    if (!cfst_engine_mount(borrow mut bd as *mut *mut blkdev, 2048, reason)) {
        return false;
    }
    let len: usize = 32 * 4096;
    xorshiftFill(big(), other(), len, 0x9E3779B97F4A7C15);
    var n: u32 = 0;
    let np = borrow mut n as *mut u32;
    var f = 0 as *mut file;

    if (!cfst_write_file(path("/mnt/eng/keep\0"), big() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/keep\", big, sizeof(big)) at line 609\0");
    }
    if (!cfst_write_file(path("/mnt/eng/gone\0"), big() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/gone\", big, sizeof(big)) at line 612\0");
    }
    if (!cfst_write_file(path("/mnt/eng/orph\0"), other() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/orph\", other, sizeof(other)) at line 615\0");
    }
    if (vfs_open(0 as *mut vnode, path("/mnt/eng/orph\0"), O_RDONLY, 0, borrow mut f as *mut *mut file) != 0) {
        return failed(reason, "check failed: vfs_open(NULL, ENG \"/orph\", COSMO_O_RDONLY, 0, &f) == 0 at line 618\0");
    }
    if (vfs_unlink(0 as *mut vnode, path("/mnt/eng/orph\0")) != 0) {
        return failed(reason, "check failed: vfs_unlink(NULL, ENG \"/orph\") == 0 at line 621\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 624\0");
    }
    if (create(path("t\0"), np) != 0) {
        return failed(reason, "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"t\", info, 1, &n) == 0 at line 627\0");
    }
    filePut(f);
    if (vfs_unlink(0 as *mut vnode, path("/mnt/eng/gone\0")) != 0) {
        return failed(reason, "check failed: vfs_unlink(NULL, ENG \"/gone\") == 0 at line 631\0");
    }
    if (!cfst_write_file(path("/mnt/eng/x\0"), other() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/x\", other, sizeof(other)) at line 634\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 637\0");
    }
    if (create(path("m\0"), np) != 0) {
        return failed(reason, "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"m\", info, 1, &n) == 0 at line 640\0");
    }
    if (!cfst_write_file(path("/mnt/eng/y\0"), other() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/y\", other, sizeof(other)) at line 643\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 646\0");
    }

    if (rollbackReq(path("t\0"), path("s\0"), info()) != 0) {
        return failed(reason, "check failed: rollback_req(\"t\", \"s\", info) == 0 at line 650\0");
    }
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 653\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/gone\0"), big() as *void, len)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/gone\", big, sizeof(big)) at line 656\0");
    }
    if (cosmofs_check(mnt(), rep(), 0) != 0) {
        return failed(reason, "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 at line 659\0");
    }
    if (!Ptr.toBorrow(rr()).clean) {
        sayCounts("cosmofs-rollback-shared", "the switch", true);
        return failed(reason, "check failed: rep.clean at line 663\0");
    }

    // Held: only back to the tree it replaced.
    if (poolFlagsNow() != POOL_HELD) {
        return failed(reason, "check failed: pool_flags_now() == COSMOFS_POOL_HELD at line 668\0");
    }
    if (rollbackReq(path("m\0"), 0 as *CChar, info()) != -EBUSY) {
        return failed(reason, "check failed: rollback_req(\"m\", NULL, info) == -EBUSY at line 671\0");
    }

    // The live tree rewrites and drops what it shares with t, then the allocator is made to hand out everything it
    // was given back.
    if (!cfst_write_file(path("/mnt/eng/gone\0"), other() as *void, len)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/gone\", other, sizeof(other)) at line 677\0");
    }
    if (vfs_unlink(0 as *mut vnode, path("/mnt/eng/keep\0")) != 0) {
        return failed(reason, "check failed: vfs_unlink(NULL, ENG \"/keep\") == 0 at line 680\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 683\0");
    }
    for (i in 0u32..8) {
        var name = [0u8; 32];
        var p = TextWriter.create(mut name[..]);
        p.text("/mnt/eng/churn");
        p.decimal(i as u64);
        if (!cfst_write_file(p.cText(), other() as *void, len)) {
            return failed(reason, "check failed: cfst_write_file(path, other, sizeof(other)) at line 691\0");
        }
        if (vfs_sync() != 0) {
            return failed(reason, "check failed: vfs_sync() == 0 at line 694\0");
        }
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/t/gone\0"), big() as *void, len)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/t/gone\", big, sizeof(big)) at line 699\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/t/keep\0"), big() as *void, len)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/t/keep\", big, sizeof(big)) at line 703\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 707\0");
    }

    // Back to the safety snapshot while held: allowed; withdrawn, the hold is back until BOOT_OK.
    if (rollbackReq(path("s\0"), 0 as *CChar, info()) != 0) {
        return failed(reason, "check failed: rollback_req(\"s\", NULL, info) == 0 at line 712\0");
    }
    if (poolFlagsNow() != POOL_PENDING) {
        return failed(reason, "check failed: pool_flags_now() == COSMOFS_POOL_PENDING at line 715\0");
    }
    if (snap(SNAP_CANCEL, 0 as *CChar) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_CANCEL, NULL, NULL, 0, NULL) == 0 at line 719\0");
    }
    if (poolFlagsNow() != POOL_HELD) {
        return failed(reason, "check failed: pool_flags_now() == COSMOFS_POOL_HELD at line 722\0");
    }
    if (snap(SNAP_DELETE, path("s\0")) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"s\", NULL, 0, NULL) == -EBUSY at line 726\0");
    }
    var total: u32 = 0;
    if (!(bootOk(borrow mut total as *mut u32) == 0 && total == 1)) {
        return failed(reason,
            "check failed: cosmofs_snapctl(cfst_mount_of(ENG), &ok) == 0 && ok.total == 1 at line 731\0");
    }
    if (snap(SNAP_DELETE, infoName()) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, info[0].name, NULL, 0, NULL) == 0 at line 735\0");
    }
    if (snap(SNAP_DELETE, path("s\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"s\", NULL, 0, NULL) == 0 at line 739\0");
    }
    if (snap(SNAP_DELETE, path("m\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"m\", NULL, 0, NULL) == 0 at line 743\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/t/gone\0"), big() as *void, len)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/t/gone\", big, sizeof(big)) at line 747\0");
    }
    if (snap(SNAP_DELETE, path("t\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"t\", NULL, 0, NULL) == 0 at line 751\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 754\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 758\0");
    }
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 761\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/gone\0"), other() as *void, len)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/gone\", other, sizeof(other)) at line 764\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 768\0");
    }
    var buffer = [0u8; 288];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-rollback-shared: the target's copy survived the live tree rewriting and dropping ");
    line.text("what it shares and 8 files of churn; its orphan released at the switch; ");
    line.text("a second rollback refused while ");
    line.text("held, one back to the safety snapshot taken; clean after every snapshot went");
    say(line);
    return cfst_engine_unmount(bd, reason);
}

// ---- cosmofs-rollback-atomic ----

/// CF19's same-transaction rule: a rollback's record and its safety snapshot reach the disk in one commit. The machine
/// is stopped at every commit boundary the request crosses (cosmofs_test_commit_budget) and the filesystem mounted
/// again: each time there is either neither or both -- never a record naming a safety snapshot that is not there
/// (`rollback_record`, which tools/b1-rollback-probe.py --old produces).
/// Safety: `reason` writable.
@export("selftest_cosmofs_rollback_atomic")
unsafe fn selftestRollbackAtomic(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var seenNeither: u32 = 0;
    var seenBoth: u32 = 0;
    for (budget in 0u32..4) {
        var bd = 0 as *mut blkdev;
        if (!cfst_engine_mount(borrow mut bd as *mut *mut blkdev, 512, reason)) {
            return false;
        }
        var n: u32 = 0;
        if (!cfst_write_file(path("/mnt/eng/a\0"), "one".ptr as *void, 3)) {
            return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"one\", 3) at line 799\0");
        }
        if (create(path("base\0"), borrow mut n as *mut u32) != 0) {
            return failed(reason,
                "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"base\", info, 1, &n) == 0 at line 803\0");
        }
        if (!cfst_write_file(path("/mnt/eng/a\0"), "two".ptr as *void, 3)) { // open work: the request commits it first
            return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"two\", 3) at line 806\0");
        }
        cosmofs_test_commit_budget(mnt(), true, budget);
        let rc = rollbackReq(path("base\0"), path("safe\0"), info());
        cosmofs_test_commit_budget(mnt(), false, 0);
        cosmofs_test_discard_on_unmount(mnt(), true);
        if (vfs_umount2(eng(), 0) != 0) {
            return failed(reason, "check failed: vfs_umount(ENG) == 0 at line 813\0");
        }
        if (vfs_mount(eng(), "cosmofs\0".ptr as *CChar, bd, 0) != 0) {
            return failed(reason, "check failed: vfs_mount(ENG, \"cosmofs\", bd, 0) == 0 at line 816\0");
        }
        cosmofs_test_set_writeback(mnt(), false);
        // The mount applies a pending rollback, so "both" shows as a switched tree with the safety snapshot held.
        let pf = poolFlagsNow();
        let sf = snapFlagsOf(path("safe\0"));
        let both = pf == POOL_HELD && sf == SNAP_I_HELD;
        let neither = pf == 0 && sf == 0xFFFFFFFF;
        var buffer = [0u8; 160];
        var line = TextWriter.create(mut buffer[..]);
        line.text("selftest: cosmofs-rollback-atomic: stopped after ");
        line.decimal(budget as u64);
        line.text(" commit(s): request ");
        line.signed(rc as i64);
        line.text(", pool flags ");
        line.decimal(pf as u64);
        line.text(", safety flags 0x");
        line.hex(sf as u64, 0);
        say(line);
        if (cosmofs_check(mnt(), rep(), 0) != 0) {
            return failed(reason, "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 at line 836\0");
        }
        if (!(Ptr.toBorrow(rr()).rollback_record.count == 0 && Ptr.toBorrow(rr()).hold.count == 0)) {
            return failed(reason, "check failed: rep.rollback_record.count == 0 && rep.hold.count == 0 at line 839\0");
        }
        if (!Ptr.toBorrow(rr()).clean) {
            return failed(reason, "check failed: rep.clean at line 842\0");
        }
        if (!(both || neither)) {
            return failed(reason, "check failed: both || neither at line 845\0");
        }
        if (both) {
            seenBoth += 1;
        }
        if (neither) {
            seenNeither += 1;
        }
        if (!cfst_engine_unmount(bd, reason)) {
            return failed(reason, "check failed: cfst_engine_unmount(bd, reason) at line 854\0");
        }
    }
    // Not vacuous: some stop fell before the commit and some after.
    if (!(seenNeither > 0 && seenBoth > 0)) {
        return failed(reason, "check failed: seen_neither > 0 && seen_both > 0 at line 859\0");
    }
    var buffer = [0u8; 128];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-rollback-atomic: ");
    line.decimal(seenNeither as u64);
    line.text(" stop(s) left neither, ");
    line.decimal(seenBoth as u64);
    line.text(" left both");
    say(line);
    return true;
}

// ---- cosmofs-rollback-record ----

/// A record of RB_SIZE bytes.
struct Record {
    w: [u64; 15];
}

impl Record {
    fn zero() -> Record => Record { w: [0u64; 15] };

    fn ptr(borrow mut this) -> *mut u8 => borrow mut this.w as *mut [u64; 15] as *mut u8;

    /// Safety: none; the record is RB_SIZE bytes.
    unsafe fn bytes(borrow mut this) -> SliceMut<u8> => SliceMut.fromRaw(this.ptr(), RB_SIZE);

    /// Safety: none.
    unsafe fn u32At(borrow mut this, off: usize) -> u32 => ByteOrder.readU32LE(this.bytes(), off);

    /// Safety: none.
    unsafe fn setU32(borrow mut this, off: usize, v: u32) { ByteOrder.writeU32LE(this.bytes(), off, v); }

    /// Safety: none.
    unsafe fn setU64(borrow mut this, off: usize, v: u64) { ByteOrder.writeU64LE(this.bytes(), off, v); }

    /// The crc recomputed over the record with its crc field zero, without sealing.
    /// Safety: none.
    unsafe fn recrc(borrow mut this) {
        this.setU32(RB_CRC, 0);
        let c = crc32c(this.ptr() as *void, RB_SIZE);
        this.setU32(RB_CRC, c);
    }

    /// Safety: none.
    unsafe fn seal(borrow mut this) { cfs_rollback_seal(this.ptr() as *mut cfs_rollback); }

    /// Safety: none.
    unsafe fn parse(borrow mut this, back: borrow mut Record) -> i32 =>
        cfs_rollback_parse(this.ptr() as *void, back.ptr() as *mut cfs_rollback);

    /// A copy.
    /// Safety: none.
    unsafe fn copy(borrow mut this) -> Record {
        var c = Record.zero();
        memcpy(c.ptr() as *mut void, this.ptr() as *void, RB_SIZE);
        return c;
    }
}

/// The rollback record's parse and checksum, on bytes alone: a sealed record of either state parses back field for
/// field; every single byte changed anywhere in it is refused (the crc's, or a field's under it); a wrong magic,
/// version or state is refused even with a crc that matches it.
/// Safety: `reason` writable.
@export("selftest_cosmofs_rollback_record")
unsafe fn selftestRollbackRecord(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var r = Record.zero();
    var back = Record.zero();
    r.setU32(RB_STATE, ROLLBACK_PENDING);
    for (i in 0usize..16) {
        r.ptr().add(RB_TARGET_UUID + i).write(truncate<u8>(0x10 + i));
        r.ptr().add(RB_SAFETY_UUID + i).write(truncate<u8>(0xA0 + i));
    }
    r.setU64(RB_TARGET_ID, 7);
    r.setU64(RB_SAFETY_ID, 9);
    r.setU64(RB_GENERATION, 0x123456789);
    r.setU64(RB_REQUESTED_NS, 0xFEDCBA9876543210);
    r.seal();
    if (!(r.u32At(RB_MAGIC) == ROLLBACK_MAGIC && r.u32At(RB_VERSION) == 1 && r.u32At(RB_CRC) != 0)) {
        return failed(reason,
            "check failed: r.magic == CFS_ROLLBACK_MAGIC && r.version == 1 && r.crc != 0 at line 941\0");
    }
    if (r.parse(mut back) != 0) {
        return failed(reason, "check failed: cfs_rollback_parse(&r, &back) == 0 at line 944\0");
    }
    if (memcmp(r.ptr() as *void, back.ptr() as *void, RB_SIZE) != 0) {
        return failed(reason, "check failed: memcmp(&r, &back, sizeof(r)) == 0 at line 947\0");
    }

    // Each byte, each of eight flips.
    var refused: u32 = 0;
    for (at in 0usize..RB_SIZE) {
        for (bit in 0u32..8) {
            var raw = r.copy();
            let b = raw.ptr().add(at);
            b.write(b.read() ^ truncate<u8>(1u32 << bit));
            if (raw.parse(mut back) != -EIO) {
                return failed(reason, "check failed: cfs_rollback_parse(raw, &back) == -EIO at line 958\0");
            }
            refused += 1;
        }
    }

    // Wrong in meaning, right in checksum.
    var bad = r.copy();
    bad.setU32(RB_MAGIC, bad.u32At(RB_MAGIC) ^ 1);
    bad.recrc();
    if (bad.parse(mut back) != -EIO) {
        return failed(reason, "check failed: cfs_rollback_parse(&bad, &back) == -EIO at line 969\0");
    }
    bad = r.copy();
    bad.setU32(RB_VERSION, 2);
    bad.recrc();
    if (bad.parse(mut back) != -EIO) {
        return failed(reason, "check failed: cfs_rollback_parse(&bad, &back) == -EIO at line 975\0");
    }
    let states: [u32; 3] = [0, 3, 0xFFFFFFFF];
    for (i in 0usize..3) {
        bad = r.copy();
        bad.setU32(RB_STATE, states[i]);
        bad.seal();
        if (bad.parse(mut back) != -EIO) {
            return failed(reason, "check failed: cfs_rollback_parse(&bad, &back) == -EIO at line 983\0");
        }
    }
    // A pending record whose safety snapshot is its target, or with no safety snapshot, keeps nothing of the tree it
    // replaces.
    bad = r.copy();
    memcpy(bad.ptr().add(RB_SAFETY_UUID) as *mut void, bad.ptr().add(RB_TARGET_UUID) as *void, 16);
    bad.seal();
    if (bad.parse(mut back) != -EIO) {
        return failed(reason, "check failed: cfs_rollback_parse(&bad, &back) == -EIO at line 992\0");
    }
    bad = r.copy();
    for (i in 0usize..16) {
        bad.ptr().add(RB_SAFETY_UUID + i).write(0);
    }
    bad.seal();
    if (bad.parse(mut back) != -EIO) {
        return failed(reason, "check failed: cfs_rollback_parse(&bad, &back) == -EIO at line 1000\0");
    }
    // HELD is the other state a record may be in.
    bad = r.copy();
    bad.setU32(RB_STATE, ROLLBACK_HELD);
    bad.seal();
    if (!(bad.parse(mut back) == 0 && back.u32At(RB_STATE) == ROLLBACK_HELD)) {
        return failed(reason,
            "check failed: cfs_rollback_parse(&bad, &back) == 0 && back.state == CFS_ROLLBACK_HELD at line 1008\0");
    }
    var buffer = [0u8; 192];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-rollback-record: ");
    line.decimal(refused as u64);
    line.text(" single-bit changes over ");
    line.decimal(RB_SIZE as u64);
    line.text(" bytes refused; wrong magic, version and state refused under a matching crc");
    say(line);
    return true;
}

// ---- cosmofs-clone ----

/// Clones (roadmap 1.2 B1; design.md, "Clones"; CF20): a clone of a snapshot is a writable tree under .snapshots that
/// starts as the snapshot's and shares its blocks. Its writes are seen neither in the snapshot nor in the live tree,
/// and the live tree's not in it; they survive a remount; the origin cannot be deleted while it has a clone, a clone
/// is no rollback target, and a rename between two trees is EXDEV. Deleting the clone gives back at least the blocks
/// of the file only it held, and the checker -- whose counts are the oracle -- calls the filesystem clean at every
/// step: a clone block freed too early is `seen_not_alloc`, one kept for nobody `alloc_not_seen`. A snapshot stays
/// read-only to symlink and rename too (they had no guard).
/// Safety: `reason` writable.
@export("selftest_cosmofs_clone")
unsafe fn selftestClone(reason: *mut *CChar) -> bool {
    if (cfg("!CONFIG_DEBUG")) {
        return true; // a debug build's test
    }
    var bd = 0 as *mut blkdev;
    if (!cfst_engine_mount(borrow mut bd as *mut *mut blkdev, 2048, reason)) {
        return false;
    }
    let len: usize = 16 * 4096;
    xorshiftFill(big(), 0 as *mut u8, len, 0xD1B54A32D192ED03);
    var n: u32 = 0;
    var f = 0 as *mut file;
    let fp = borrow mut f as *mut *mut file;

    if (!cfst_write_file(path("/mnt/eng/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"orig\", 4) at line 1045\0");
    }
    if (vfs_mkdir(0 as *mut vnode, path("/mnt/eng/d\0"), 493) != 0) {
        return failed(reason, "check failed: vfs_mkdir(NULL, ENG \"/d\", 0755) == 0 at line 1048\0");
    }
    if (!cfst_write_file(path("/mnt/eng/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/d/f\", \"deep\", 4) at line 1051\0");
    }
    if (create(path("o\0"), borrow mut n as *mut u32) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_CREATE, \"o\", info, 1, &n) == 0 at line 1055\0");
    }
    if (cloneReq(path("o\0"), path("o\0")) != -EEXIST) {
        return failed(reason, "check failed: clone_req(\"o\", \"o\") == -EEXIST at line 1058\0");
    }
    if (cloneReq(path("nope\0"), path("c\0")) != -ENOENT) {
        return failed(reason, "check failed: clone_req(\"nope\", \"c\") == -ENOENT at line 1061\0");
    }
    if (cloneReq(path("o\0"), path("c\0")) != 0) {
        return failed(reason, "check failed: clone_req(\"o\", \"c\") == 0 at line 1064\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1067\0");
    }
    var freeMade: u64 = 0;
    if (!freeBlocks(borrow mut freeMade as *mut u64)) {
        return failed(reason, "check failed: cosmofs_stats(cfst_mount_of(ENG), &st) == 0 at line 1071\0");
    }

    // It starts as the snapshot.
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/c/a\", \"orig\", 4) at line 1076\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/c/d/f\", \"deep\", 4) at line 1079\0");
    }
    // It is writable, and its writes are its own.
    if (!cfst_write_file(path("/mnt/eng/.snapshots/c/a\0"), "clone".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/.snapshots/c/a\", \"clone\", 5) at line 1083\0");
    }
    if (!cfst_write_file(path("/mnt/eng/.snapshots/c/new\0"), big() as *void, len)) {
        return failed(reason,
            "check failed: cfst_write_file(ENG \"/.snapshots/c/new\", big, sizeof(big)) at line 1087\0");
    }
    if (vfs_mkdir(0 as *mut vnode, path("/mnt/eng/.snapshots/c/sub\0"), 493) != 0) {
        return failed(reason, "check failed: vfs_mkdir(NULL, ENG \"/.snapshots/c/sub\", 0755) == 0 at line 1090\0");
    }
    if (vfs_unlink(0 as *mut vnode, path("/mnt/eng/.snapshots/c/d/f\0")) != 0) {
        return failed(reason, "check failed: vfs_unlink(NULL, ENG \"/.snapshots/c/d/f\") == 0 at line 1093\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1096\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"orig\", 4) at line 1099\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/d/f\", \"deep\", 4) at line 1102\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/a\", \"orig\", 4) at line 1105\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/d/f\", \"deep\", 4) at line 1108\0");
    }
    if (!absent(path("/mnt/eng/.snapshots/o/new\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/.snapshots/o/new\", &cs) == -ENOENT at line 1111\0");
    }
    if (!absent(path("/mnt/eng/new\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/new\", &cs) == -ENOENT at line 1114\0");
    }
    // And the live tree's are not the clone's.
    if (!cfst_write_file(path("/mnt/eng/a\0"), "live2".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/a\", \"live2\", 5) at line 1118\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/a\0"), "clone".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/c/a\", \"clone\", 5) at line 1121\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/a\", \"orig\", 4) at line 1124\0");
    }
    // An fsync is the vnode's own tree's: a clone file's inode goes to the clone, a snapshot file's nowhere -- neither
    // onto the live inode of the same number.
    if (vfs_open(0 as *mut vnode, path("/mnt/eng/.snapshots/c/a\0"), O_RDWR, 0, fp) != 0) {
        return failed(reason,
            "check failed: vfs_open(NULL, ENG \"/.snapshots/c/a\", COSMO_O_RDWR, 0, &f) == 0 at line 1130\0");
    }
    if (file_write(f, "fsync".ptr as *void, 5) != 5) {
        return failed(reason, "check failed: file_write(f, \"fsync\", 5) == 5 at line 1133\0");
    }
    if (file_sync(f) != 0) {
        return failed(reason, "check failed: file_sync(f) == 0 at line 1136\0");
    }
    filePut(f);
    f = 0 as *mut file;
    if (vfs_open(0 as *mut vnode, path("/mnt/eng/.snapshots/o/a\0"), O_RDONLY, 0, fp) != 0) {
        return failed(reason,
            "check failed: vfs_open(NULL, ENG \"/.snapshots/o/a\", COSMO_O_RDONLY, 0, &f) == 0 at line 1142\0");
    }
    if (file_sync(f) != 0) {
        return failed(reason, "check failed: file_sync(f) == 0 at line 1145\0");
    }
    filePut(f);
    f = 0 as *mut file;
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "live2".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"live2\", 5) at line 1150\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/a\0"), "fsync".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/c/a\", \"fsync\", 5) at line 1153\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/a\0"), "orig".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/a\", \"orig\", 4) at line 1156\0");
    }
    if (!cfst_write_file(path("/mnt/eng/.snapshots/c/a\0"), "clone".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_write_file(ENG \"/.snapshots/c/a\", \"clone\", 5) at line 1159\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 1163\0");
    }
    var freeWritten: u64 = 0;
    if (!freeBlocks(borrow mut freeWritten as *mut u64)) {
        return failed(reason, "check failed: cosmofs_stats(cfst_mount_of(ENG), &st) == 0 at line 1167\0");
    }
    if (!(freeWritten + 16 <= freeMade)) {
        return failed(reason, "check failed: free_written + 16 <= free_made at line 1170\0");
    }

    // The rules around it.
    if (snap(SNAP_DELETE, path("o\0")) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"o\", NULL, 0, NULL) == -EBUSY at line 1176\0");
    }
    if (rollbackReq(path("c\0"), 0 as *CChar, info()) != -EINVAL) {
        return failed(reason, "check failed: rollback_req(\"c\", NULL, info) == -EINVAL at line 1179\0");
    }
    if (cloneReq(path("c\0"), path("cc\0")) != -EINVAL) {
        return failed(reason, "check failed: clone_req(\"c\", \"cc\") == -EINVAL at line 1182\0");
    }
    if (vfs_rename(0 as *mut vnode, path("/mnt/eng/.snapshots/c/sub\0"), path("/mnt/eng/moved\0")) != -EXDEV) {
        return failed(reason,
            "check failed: vfs_rename(NULL, ENG \"/.snapshots/c/sub\", ENG \"/moved\") == -EXDEV at line 1186\0");
    }
    if (vfs_symlink(0 as *mut vnode, path("/mnt/eng/.snapshots/o/link\0"), path("x\0")) != -EROFS) {
        return failed(reason,
            "check failed: vfs_symlink(NULL, ENG \"/.snapshots/o/link\", \"x\") == -EROFS at line 1190\0");
    }
    if (vfs_rename(0 as *mut vnode, path("/mnt/eng/.snapshots/o/a\0"), path("/mnt/eng/.snapshots/o/b\0")) != -EROFS) {
        return failed(reason,
            "check failed: vfs_rename(NULL, ENG \"/.snapshots/o/a\", ENG \"/.snapshots/o/b\") == -E... at line 1194\0");
    }
    if (vfs_symlink(0 as *mut vnode, path("/mnt/eng/.snapshots/c/link\0"), path("a\0")) != 0) { // a clone takes one
        return failed(reason, "check failed: vfs_symlink(NULL, ENG \"/.snapshots/c/link\", \"a\") == 0 at line 1197\0");
    }

    // Its writes survive a remount.
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 1202\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/a\0"), "clone".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/c/a\", \"clone\", 5) at line 1205\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/c/new\0"), big() as *void, len)) {
        return failed(reason,
            "check failed: cfst_read_matches(ENG \"/.snapshots/c/new\", big, sizeof(big)) at line 1209\0");
    }
    if (!absent(path("/mnt/eng/.snapshots/c/d/f\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/.snapshots/c/d/f\", &cs) == -ENOENT at line 1212\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/d/f\", \"deep\", 4) at line 1215\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "live2".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"live2\", 5) at line 1218\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 1222\0");
    }

    // Busy while something inside it is open, like a snapshot.
    if (vfs_open(0 as *mut vnode, path("/mnt/eng/.snapshots/c/a\0"), O_RDONLY, 0, fp) != 0) {
        return failed(reason,
            "check failed: vfs_open(NULL, ENG \"/.snapshots/c/a\", COSMO_O_RDONLY, 0, &f) == 0 at line 1228\0");
    }
    if (snap(SNAP_DELETE, path("c\0")) != -EBUSY) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"c\", NULL, 0, NULL) == -EBUSY at line 1232\0");
    }
    filePut(f);

    // Deleted: what only it held goes back, nothing of the origin's.
    var freeBefore: u64 = 0;
    if (!freeBlocks(borrow mut freeBefore as *mut u64)) {
        return failed(reason, "check failed: cosmofs_stats(cfst_mount_of(ENG), &st) == 0 at line 1239\0");
    }
    if (snap(SNAP_DELETE, path("c\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"c\", NULL, 0, NULL) == 0 at line 1243\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1246\0");
    }
    if (cosmofs_check(mnt(), rep(), 0) != 0) {
        return failed(reason, "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 at line 1249\0");
    }
    if (!Ptr.toBorrow(rr()).clean) {
        sayCounts("cosmofs-clone", "the deletion", false);
        return failed(reason, "check failed: rep.clean at line 1253\0");
    }
    var freeNow: u64 = 0;
    if (!freeBlocks(borrow mut freeNow as *mut u64)) {
        return failed(reason, "check failed: cosmofs_stats(cfst_mount_of(ENG), &st) == 0 at line 1257\0");
    }
    if (!(freeNow >= freeBefore + 16)) {
        return failed(reason, "check failed: st.free_blocks >= free_before + 16 at line 1260\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/.snapshots/o/d/f\0"), "deep".ptr as *void, 4)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/.snapshots/o/d/f\", \"deep\", 4) at line 1263\0");
    }
    if (!absent(path("/mnt/eng/.snapshots/c\0"))) {
        return failed(reason, "check failed: vfs_stat(NULL, ENG \"/.snapshots/c\", &cs) == -ENOENT at line 1266\0");
    }
    if (snap(SNAP_DELETE, path("o\0")) != 0) {
        return failed(reason,
            "check failed: cfst_snapctl(COSMOFS_SNAP_DELETE, \"o\", NULL, 0, NULL) == 0 at line 1270\0");
    }
    if (vfs_sync() != 0) {
        return failed(reason, "check failed: vfs_sync() == 0 at line 1273\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 1277\0");
    }
    if (!cfst_remount_eng(bd, reason)) {
        return failed(reason, "check failed: cfst_remount_eng(bd, reason) at line 1280\0");
    }
    if (!cfst_read_matches(path("/mnt/eng/a\0"), "live2".ptr as *void, 5)) {
        return failed(reason, "check failed: cfst_read_matches(ENG \"/a\", \"live2\", 5) at line 1283\0");
    }
    if (!checkClean()) {
        return failed(reason,
            "check failed: cosmofs_check(cfst_mount_of(ENG), &rep, 0) == 0 && rep.clean at line 1287\0");
    }
    var buffer = [0u8; 192];
    var line = TextWriter.create(mut buffer[..]);
    line.text("selftest: cosmofs-clone: written apart from its snapshot and the live tree, kept across a remount, ");
    line.decimal(freeNow - freeBefore);
    line.text(" block(s) back when deleted, the checker clean throughout");
    say(line);
    return cfst_engine_unmount(bd, reason);
}
