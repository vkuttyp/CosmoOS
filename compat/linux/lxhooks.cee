// lxhooks.cee - The Linux personality's process hooks (kernel/process/process.c calls them through the personality's
// record; docs/compat/linux/design.md), in CeeSafe (roadmap 1.3 K1): a process's Linux state made at its creation,
// copied at fork, remade at exec and released; the auxiliary vector; which programs the personality claims; and the
// two calls on that state the table names, prctl and the handler of a number it does not implement. syscalls.c holds
// the table and the record that name these (linux_internal.h).

@header(
    "arch/cpu.h", "kernel/elf.h", "kernel/errno.h", "kernel/kmalloc.h", "kernel/log.h", "kernel/process.h",
    "kernel/random.h", "kernel/shm.h", "kernel/spinlock.h", "kernel/syscall.h", "kernel/types.h", "kernel/vmm.h",
    "linux_abi.h", "linux_internal.h",
)
extern "C" {
    struct syscall_args {
        nr: u64;
        a: [u64; 6];
    }
    struct vm_space;
    struct shm_segment;
    struct lx_shm_attach {
        next: *mut lx_shm_attach;
        addr: u64;
        size: usize;
        tag: u64;
        seg: *mut shm_segment;
    }
    struct linux_state {
        brk_start: u64;
        brk: u64;
        sigtramp: u64;
        unknown_syscalls: u32;
        shm_attaches: *mut lx_shm_attach;
        shm_lock: spinlock_t;
    }
    struct process {
        pid: u32;
        space: *mut vm_space;
        linux: *mut linux_state;
        dumpable: AtomicU8;
    }
    struct elf_info {
        entry: u64;
        hi: u64;
        phdr_vaddr: u64;
        phnum: u16;
        phent: u16;
    }
    struct personality_auxv_args {
        random_addr: u64;
        execfn_addr: u64;
        platform_addr: u64;
        interp_base: u64;
        ruid: u32;
        euid: u32;
        rgid: u32;
        egid: u32;
    }

    @cvalue("sizeof(struct lx_shm_attach) == 40 && sizeof(unsigned) == 4")
    const SIZES: bool = true;
    /// sizeof(struct linux_state): its lock's size is the build's.
    @constant
    fn LX_STATE_BYTES() -> usize;
    const ASLR_BRK_BITS: u32 = 13;
    const PAGE_SHIFT: u32 = 12;
    const PAGE_SIZE: u64 = 4096;
    const KLOG_DEBUG: u32 = 0;
    const LX_PR_GET_DUMPABLE: i32 = 3;
    const LX_PR_SET_DUMPABLE: i32 = 4;
    const LX_AT_NULL: u64 = 0;
    const LX_AT_PHDR: u64 = 3;
    const LX_AT_PHENT: u64 = 4;
    const LX_AT_PHNUM: u64 = 5;
    const LX_AT_PAGESZ: u64 = 6;
    const LX_AT_BASE: u64 = 7;
    const LX_AT_ENTRY: u64 = 9;
    const LX_AT_UID: u64 = 11;
    const LX_AT_EUID: u64 = 12;
    const LX_AT_GID: u64 = 13;
    const LX_AT_EGID: u64 = 14;
    const LX_AT_PLATFORM: u64 = 15;
    const LX_AT_HWCAP: u64 = 16;
    const LX_AT_CLKTCK: u64 = 17;
    const LX_AT_SECURE: u64 = 23;
    const LX_AT_RANDOM: u64 = 25;
    const LX_AT_HWCAP2: u64 = 26;
    const LX_AT_EXECFN: u64 = 31;
    const ENOMEM: i32 = 12;
    const EINVAL: i32 = 22;
    const ENOSYS: i32 = 38;

    fn process_current() -> *mut process;
    fn kzalloc(size: usize) -> *mut void;
    fn page_align_up(x: u64) -> u64;
    fn random_u64() -> u64;
    fn vm_user_find_free(space: *mut vm_space, from: u64, size: usize) -> u64;
    fn arch_user_hwcap() -> u64;
    fn arch_user_hwcap2() -> u64;
    fn shm_detach(seg: *mut shm_segment);
    fn shm_attach_dup(seg: *mut shm_segment);
    fn linux_sigtramp_map(p: *mut process, out: *mut u64) -> i32;
}

/// The build's sizeof(struct linux_state).
static STATE_BYTES: usize = LX_STATE_BYTES();

const ATTACH_SIZE: usize = 40; // sizeof(struct lx_shm_attach), checked above
const AUXV_WORDS: usize = 36;  // eighteen pairs

/// A zeroed Linux state with its lock made, or null.
/// Safety: none beyond the allocator's.
unsafe fn newState() -> *mut linux_state {
    let ls = kzalloc(STATE_BYTES) as *mut linux_state;
    if (!ls.isNull()) {
        spinlock_init(borrow mut Ptr.toBorrowMut(ls).shm_lock as *mut spinlock_t, "lx-shm-attach\0".ptr as *CChar);
    }
    return ls;
}

/// Frees a list of attach records linked by `next`, the records alone.
/// Safety: the list is this caller's and nothing else names its records.
unsafe fn freeRecords(head: *mut lx_shm_attach) {
    var r = head;
    while (!r.isNull()) {
        let next = Ptr.toBorrow(r as *lx_shm_attach).next;
        kfree(r as *mut void);
        r = next;
    }
}

/// A new Linux process's state.
///
/// Safety: process.c's: `p` is a process being built, its image loaded and described by `info`.
@export("linux_process_init")
unsafe fn processInit(p: *mut process, info: *elf_info) -> i32 {
    let ls = newState();
    if (ls.isNull()) {
        return -ENOMEM;
    }
    let state = Ptr.toBorrowMut(ls);
    let proc = Ptr.toBorrowMut(p);
    // The break starts a random number of pages above the image, up to 2^ASLR_BRK_BITS (roadmap M5, as Linux's
    // randomize_va_space=2); the gap below it stays unmapped. Drawn once per exec. The image is loaded already: a
    // fixed-address interpreter there pushes the start to the first free page above the draw, so brk(0) never names a
    // page someone else maps (PR #369 review).
    let pages = random_u64() & (((1 as u64) << ASLR_BRK_BITS) - 1);
    let brk = page_align_up(Ptr.toBorrow(info).hi).wrappingAdd(pages << PAGE_SHIFT);
    let free = vm_user_find_free(proc.space, brk, truncate<usize>(PAGE_SIZE));
    state.brk_start = if (free != 0) free else brk;
    state.brk = state.brk_start;
    proc.linux = ls;
    return linux_sigtramp_map(p, borrow mut state.sigtramp as *mut u64);
}

/// Where `p`'s signal trampoline is (0: none).
///
/// Safety: `p` is a live process.
@export("linux_sigtramp_addr")
unsafe fn sigtrampAddr(p: *process) -> u64 {
    let ls = Ptr.toBorrow(p).linux;
    return if (!ls.isNull()) Ptr.toBorrow(ls as *linux_state).sigtramp else 0;
}

/// Safety: process.c's: `p` is a process no thread runs in.
@export("linux_process_release")
unsafe fn processRelease(p: *mut process) {
    let proc = Ptr.toBorrowMut(p);
    let ls = proc.linux;
    if (ls.isNull()) {
        return; // the build failed before linux_process_init ran
    }
    let state = Ptr.toBorrowMut(ls);
    // Detach any shm segments still attached: drop each one's live-attach count and the attach's reference on its
    // record (freeing the record and its backing if it was the last and the segment was removed). The mappings
    // themselves are freed by the address-space teardown. Detach the whole list under the lock first, then drop the
    // references outside it (the free path must not run under a spinlock).
    let lock = borrow mut state.shm_lock as *mut spinlock_t;
    let st = spin_lock_irqsave(lock);
    var a = state.shm_attaches;
    state.shm_attaches = 0 as *mut lx_shm_attach;
    spin_unlock_irqrestore(lock, st);
    while (!a.isNull()) {
        let rec = Ptr.toBorrow(a as *lx_shm_attach);
        let next = rec.next;
        shm_detach(rec.seg);
        kfree(a as *mut void);
        a = next;
    }
    kfree(ls as *mut void);
    proc.linux = 0 as *mut linux_state;
}

/// How many attach records `ls` lists.
/// Safety: `ls`'s shm_lock is held.
unsafe fn attachCount(ls: *linux_state) -> u32 {
    var n: u32 = 0;
    var a = Ptr.toBorrow(ls).shm_attaches;
    while (!a.isNull()) {
        n += 1;
        a = Ptr.toBorrow(a as *lx_shm_attach).next;
    }
    return n;
}

/// fork: the child's own Linux state. The break is where the parent's is (the heap was copied with the space). Every
/// SysV shm attach is copied too: vm_space_fork gave the child each attach's mapping under the same tag, so a record
/// with that tag lets the child's shmdt remove exactly it, and the segment counts the child as one more attach. A
/// vfork child borrows the parent's space, attaches and all, and records none.
///
/// Safety: process.c's: `parent` is the forking process and `child` the one being built.
@export("linux_process_fork")
unsafe fn processFork(parent: *mut process, child: *mut process) -> i32 {
    let pls = Ptr.toBorrow(parent as *process).linux;
    let ls = newState();
    if (ls.isNull()) {
        return -ENOMEM;
    }
    let from = Ptr.toBorrowMut(pls);
    let state = Ptr.toBorrowMut(ls);
    state.brk_start = from.brk_start;
    state.brk = from.brk;
    state.sigtramp = from.sigtramp; // the page came with the copied space
    let kid = Ptr.toBorrowMut(child);
    kid.linux = ls; // linux_process_release frees it, records and all, if the fork fails
    if (kid.space == Ptr.toBorrow(parent as *process).space) {
        return 0;
    }
    let lock = borrow mut from.shm_lock as *mut spinlock_t;
    // Records are allocated outside the parent's lock; a list that grew meanwhile (another thread's shmat) sends the
    // count round again.
    while (true) {
        var st = spin_lock_irqsave(lock);
        let n = attachCount(pls as *linux_state);
        spin_unlock_irqrestore(lock, st);
        var pool = 0 as *mut lx_shm_attach;
        var i: u32 = 0;
        while (i < n) {
            let r = kmalloc(ATTACH_SIZE, 0) as *mut lx_shm_attach;
            if (r.isNull()) {
                freeRecords(pool);
                return -ENOMEM;
            }
            let rec = Ptr.toBorrowMut(r);
            rec.next = pool;
            pool = r;
            i += 1;
        }
        st = spin_lock_irqsave(lock);
        let m = attachCount(pls as *linux_state);
        if (m <= n) {
            var last = 0 as *mut lx_shm_attach; // the parent's order: each record goes after the one before it
            var a = from.shm_attaches;
            while (!a.isNull()) {
                let src = Ptr.toBorrow(a as *lx_shm_attach);
                let r = pool;
                if (r.isNull()) {
                    // m <= n under the lock: the pool holds a record for each of the parent's.
                    var buffer: [u8; 128] = [0; 128];
                    var line = TextWriter.create(mut buffer[..]);
                    line.text("assertion failed: fork's attach pool ran out at compat/linux/lxhooks.cee");
                    KernelLog.panic(line);
                    break; // not reached: the panic does not return
                }
                let rec = Ptr.toBorrowMut(r);
                pool = rec.next;
                rec.next = 0 as *mut lx_shm_attach;
                rec.addr = src.addr;
                rec.size = src.size;
                rec.tag = src.tag;
                rec.seg = src.seg;
                shm_attach_dup(src.seg);
                if (last.isNull()) {
                    state.shm_attaches = r;
                } else {
                    let before = Ptr.toBorrowMut(last);
                    before.next = r;
                }
                last = r;
                a = src.next;
            }
        }
        spin_unlock_irqrestore(lock, st);
        freeRecords(pool);
        if (m <= n) {
            return 0;
        }
    }
    return 0; // not reached
}

/// exec: the state for a new Linux image -- the old attaches detached (their mappings went with the old space), a
/// new break, the trampoline mapped in the new space.
///
/// Safety: process.c's: `p` is the calling process, alone in its new image.
@export("linux_process_exec")
unsafe fn processExec(p: *mut process, info: *elf_info) -> i32 {
    processRelease(p);
    return processInit(p, info);
}

/// The Linux auxiliary vector, into `w` (`max` words, at least AUXV_WORDS): the words written. Every pair fits
/// (PERSONALITY_AUXV_WORDS): a pair dropped for room would leave the vector without its AT_NULL.
///
/// Safety: `info` and `x` are the loader's; `w` holds `max` words. `p` is not read: the credentials come snapshotted
/// in `x`.
@export("linux_auxv")
unsafe fn auxv(p: *mut process, info: *elf_info, x: *personality_auxv_args, w: *mut u64, max: u32) -> u32 {
    if (max as usize < AUXV_WORDS) {
        var buffer: [u8; 96] = [0; 96];
        var line = TextWriter.create(mut buffer[..]);
        line.text("assertion failed: k + 2 <= max at compat/linux/lxhooks.cee");
        KernelLog.panic(line);
        return 0; // not reached: the panic does not return
    }
    let e = Ptr.toBorrow(info);
    let args = Ptr.toBorrow(x);
    // AT_SECURE, as Linux decides it for an exec that changes no credentials (setuid bits are ignored here): the
    // effective ids are not the real ones. musl's dynamic linker then ignores LD_LIBRARY_PATH and LD_PRELOAD (roadmap
    // 1.1 P4).
    let secure = args.euid != args.ruid || args.egid != args.rgid;
    let out = SliceMut.fromRaw(w, AUXV_WORDS);
    out[0] = LX_AT_PHDR;
    out[1] = e.phdr_vaddr;
    out[2] = LX_AT_PHENT;
    out[3] = e.phent as u64;
    out[4] = LX_AT_PHNUM;
    out[5] = e.phnum as u64;
    out[6] = LX_AT_PAGESZ;
    out[7] = PAGE_SIZE;
    out[8] = LX_AT_BASE;
    out[9] = args.interp_base;
    out[10] = LX_AT_ENTRY;
    out[11] = e.entry;
    out[12] = LX_AT_RANDOM;
    out[13] = args.random_addr;
    out[14] = LX_AT_EXECFN;
    out[15] = args.execfn_addr;
    out[16] = LX_AT_PLATFORM;
    out[17] = args.platform_addr;
    out[18] = LX_AT_UID;
    out[19] = args.ruid as u64;
    out[20] = LX_AT_EUID;
    out[21] = args.euid as u64;
    out[22] = LX_AT_GID;
    out[23] = args.rgid as u64;
    out[24] = LX_AT_EGID;
    out[25] = args.egid as u64;
    out[26] = LX_AT_SECURE;
    out[27] = if (secure) 1 else 0;
    out[28] = LX_AT_HWCAP;
    out[29] = arch_user_hwcap();
    out[30] = LX_AT_HWCAP2;
    out[31] = arch_user_hwcap2();
    out[32] = LX_AT_CLKTCK;
    out[33] = 100;
    out[34] = LX_AT_NULL;
    out[35] = 0;
    return 36;
}

/// Every ELF without the CosmoOS note: the fallback, asked after native.
///
/// Safety: none; `info` is not read.
@export("linux_claims_elf")
unsafe fn claimsElf(info: *elf_info) -> bool => true;

/// prctl: PR_SET_DUMPABLE and PR_GET_DUMPABLE (OpenSSH's sftp-server makes itself undumpable and refuses to run when
/// it cannot). The flag is kept on the process and reported back; nothing reads it, there being no core dumps or
/// ptrace. Linux's answer for an option it does not know is -EINVAL, and so is this one's for every other option.
///
/// Safety: the dispatcher's.
@export("lx_prctl")
unsafe fn prctl(a: *mut syscall_args) -> i64 {
    let args = Ptr.toBorrow(a as *syscall_args);
    let p = Ptr.toBorrow(process_current() as *process);
    let option = truncate<i32>(args.a[0]);
    if (option == LX_PR_GET_DUMPABLE) {
        return p.dumpable.loadWith(LoadOrdering.Relaxed) as i64;
    }
    if (option == LX_PR_SET_DUMPABLE) {
        if (args.a[1] > 1) {
            return -EINVAL as i64; // 2 (SUID_DUMP_ROOT) is not settable on Linux either
        }
        p.dumpable.storeWith(truncate<u8>(args.a[1]), StoreOrdering.Relaxed);
        return 0;
    }
    return -EINVAL as i64;
}

/// The handler of a number the table has no call for: -ENOSYS, the first eight of a process's said in the log.
///
/// Safety: the dispatcher's.
@export("lx_unknown")
unsafe fn unknown(a: *mut syscall_args) -> i64 {
    let p = Ptr.toBorrow(process_current() as *process);
    if (!p.linux.isNull()) {
        let ls = Ptr.toBorrowMut(p.linux);
        let seen = ls.unknown_syscalls;
        ls.unknown_syscalls = seen.wrappingAdd(1);
        if (seen < 8) {
            klog(
                KLOG_DEBUG,
                "linux: pid %u: unimplemented system call %llu\0".ptr as *CChar,
                p.pid,
                Ptr.toBorrow(a as *syscall_args).nr,
            );
        }
    }
    return -ENOSYS as i64;
}
