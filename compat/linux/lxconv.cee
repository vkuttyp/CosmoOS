// lxconv.cee - the Linux personality's conversions (compat/linux/convert.h; roadmap 2.0 SA5, the Linux-syscall-argument
// family, and SA8): the open flags, PROT bits, socket addresses and termios a guest passes; socket addresses, getdents64
// records, stat and statx records and the terminal's modes going back; wait statuses and dirent types.
//
// The Linux ABI's integers are little-endian on both CosmoOS targets (x86-64 and AArch64), and the records written and
// read here have the layouts linux_abi.h and syscall.h give them. What this file writes down rather than reads from
// those headers -- the byte order, the records' offsets, the numbers it restates -- is in the extern block, which the C
// compiler checks against them, so a target or a header where any differs does not build. Linux's struct stat differs
// between the architectures (st_nlink and st_blksize are 64 bits on x86-64, 32 on AArch64): those fields are
// configured by linux_abi.h's LX_ABI_IS_X86_64, and the generated C writes the build's own. A socket address's IPv4
// address is copied byte for byte into the netaddr's in6_addr, which shares its storage with `v4`, so its network order
// needs no byte-order assumption.
//
// tests/host/test_linux.c holds these to the C they replaced: the decoders' digest over 100,000 inputs (lxconv.c,
// 2026-10-31), and the encoders' over 100,000 more on each layout of struct stat (convert.c, 2026-11-10).

@header("kernel/errno.h", "convert.h")
extern "C" {
    struct in6_addr {
        s6_addr: [u8; 16];
    }
    struct netaddr {
        family: u16;
        port: u16;
        v6: in6_addr; // in a union with v4 (network order): the address's bytes either way
    }
    struct cosmo_termios {
        modes: u32;
        vmin: u8;
        vtime: u8;
        reserved: u16;
    }
    struct lx_termios {
        c_iflag: u32;
        c_oflag: u32;
        c_cflag: u32;
        c_lflag: u32;
        c_line: u8;
        c_cc: [u8; 19];
    }
    struct cosmo_stat {
        ino: u64;
        @cname("type") kind: u32;
        mode: u32;
        nlink: u32;
        uid: u32;
        gid: u32;
        dev: u32;
        size: u64;
        mtime_ns: u64;
        ctime_ns: u64;
    }
    struct lx_stat {
        st_dev: u64;
        st_ino: u64;
        @cfg("LX_ABI_IS_X86_64")
        st_nlink: u64;
        st_mode: u32;
        st_uid: u32;
        st_gid: u32;
        st_size: i64;
        @cfg("LX_ABI_IS_X86_64")
        st_blksize: i64;
        st_blocks: i64;
        st_atime: i64;
        st_atime_nsec: i64;
        st_mtime: i64;
        st_mtime_nsec: i64;
        st_ctime: i64;
        st_ctime_nsec: i64;
    }
    /// struct lx_stat's two fields that are 32 bits on AArch64, where they are (the same C type, its other view).
    @ctype("lx_stat_t")
    struct lx_stat_narrow {
        @cfg("!LX_ABI_IS_X86_64")
        st_nlink: u32;
        @cfg("!LX_ABI_IS_X86_64")
        st_blksize: i32;
    }
    struct lx_statx_timestamp {
        tv_sec: i64;
        tv_nsec: u32;
    }
    struct lx_statx {
        stx_mask: u32;
        stx_blksize: u32;
        stx_nlink: u32;
        stx_uid: u32;
        stx_gid: u32;
        stx_mode: u16;
        stx_ino: u64;
        stx_size: u64;
        stx_blocks: u64;
        stx_ctime: lx_statx_timestamp;
        stx_mtime: lx_statx_timestamp;
        stx_dev_major: u32;
        stx_dev_minor: u32;
    }

    /// The Linux ABI's fields are read and written little-endian.
    @cvalue("__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__")
    const LITTLE_ENDIAN: bool = true;

    // Linux's open flags that are the same on both architectures, and COSMO_O_*. The access modes coincide.
    const LX_O_ACCMODE: u32 = 3;
    const LX_O_CREAT: u32 = 0x40;
    const LX_O_EXCL: u32 = 0x80;
    const LX_O_NOCTTY: u32 = 0x100;
    const LX_O_TRUNC: u32 = 0x200;
    const LX_O_APPEND: u32 = 0x400;
    const LX_O_NONBLOCK: u32 = 0x800;
    const LX_O_CLOEXEC: u32 = 0x80000;
    @cvalue(
        "LX_O_RDONLY == 0 && LX_O_WRONLY == 1 && LX_O_RDWR == 2 && COSMO_O_RDONLY == 0 && COSMO_O_WRONLY == 1 && COSMO_O_RDWR == 2",
    )
    const ACCESS_MODES_ALIKE: bool = true;
    const COSMO_O_CREAT: u32 = 0x40;
    const COSMO_O_EXCL: u32 = 0x80;
    const COSMO_O_TRUNC: u32 = 0x200;
    const COSMO_O_APPEND: u32 = 0x400;
    const COSMO_O_NONBLOCK: u32 = 0x800;
    const COSMO_O_DIRECTORY: u32 = 0x10000;
    const COSMO_O_NOFOLLOW: u32 = 0x20000;
    const COSMO_O_NOCTTY: u32 = 0x40000;

    // PROT_* (the same bits on both sides).
    @cvalue("LX_PROT_READ")
    const PROT_READ: u32 = 1;
    @cvalue("LX_PROT_WRITE")
    const PROT_WRITE: u32 = 2;
    @cvalue("LX_PROT_EXEC")
    const PROT_EXEC: u32 = 4;
    @cvalue("LX_PROT_READ == COSMO_PROT_READ && LX_PROT_WRITE == COSMO_PROT_WRITE && LX_PROT_EXEC == COSMO_PROT_EXEC")
    const PROT_ALIKE: bool = true;

    // The native exit statuses (syscall.h) and Linux's wait status words.
    @cvalue("COSMO_STATUS_STOPPED(0)")
    const STATUS_STOPPED: u32 = 0x200;
    @cvalue("COSMO_STATUS_CONTINUED")
    const STATUS_CONTINUED: i32 = 0x400;
    @cvalue("COSMO_EXIT_FAULT")
    const EXIT_FAULT: i32 = 139;
    const LX_SIGSEGV: i32 = 11;

    // The terminal's flags: Linux's (linux_abi.h), then COSMO_TTY_*.
    const LX_ICRNL: u32 = 0x100;
    const LX_ISIG: u32 = 0x1;
    const LX_ICANON: u32 = 0x2;
    const LX_ECHO: u32 = 0x8;
    const LX_ECHOE: u32 = 0x10;
    const LX_ECHOK: u32 = 0x20;
    const LX_ECHOCTL: u32 = 0x200;
    const LX_ECHOKE: u32 = 0x800;
    const LX_IEXTEN: u32 = 0x8000;
    const LX_TOSTOP: u32 = 0x100;
    const LX_OPOST: u32 = 0x1;
    const LX_ONLCR: u32 = 0x4;
    const LX_B38400: u32 = 0xF;
    const LX_CS8: u32 = 0x30;
    const LX_CREAD: u32 = 0x80;
    const LX_VINTR: usize = 0;
    const LX_VQUIT: usize = 1;
    const LX_VERASE: usize = 2;
    const LX_VKILL: usize = 3;
    const LX_VEOF: usize = 4;
    const LX_VTIME: usize = 5;
    const LX_VMIN: usize = 6;
    const LX_VSTART: usize = 8;
    const LX_VSTOP: usize = 9;
    const LX_VSUSP: usize = 10;
    const LX_VREPRINT: usize = 12;
    const LX_VDISCARD: usize = 13;
    const LX_VWERASE: usize = 14;
    const LX_VLNEXT: usize = 15;
    const LX_NCCS: usize = 19;
    @cvalue("COSMO_TTY_ECHO")
    const TTY_ECHO: u32 = 1;
    @cvalue("COSMO_TTY_ICRNL")
    const TTY_ICRNL: u32 = 2;
    @cvalue("COSMO_TTY_ICANON")
    const TTY_ICANON: u32 = 4;
    @cvalue("COSMO_TTY_ISIG")
    const TTY_ISIG: u32 = 8;
    @cvalue("COSMO_TTY_OPOST")
    const TTY_OPOST: u32 = 16;
    @cvalue("COSMO_TTY_TOSTOP")
    const TTY_TOSTOP: u32 = 32;
    @cvalue("sizeof(struct lx_termios)")
    const LX_TERMIOS_SIZE: usize = 36;

    // Socket addresses: the families (Linux's and the native are the same numbers), and the records' layouts.
    @cvalue("LX_AF_INET")
    const AF_INET: u16 = 2;
    @cvalue("LX_AF_INET6")
    const AF_INET6: u16 = 10;
    @cvalue("LX_AF_INET == COSMO_AF_INET && LX_AF_INET6 == COSMO_AF_INET6")
    const FAMILIES_ALIKE: bool = true;
    @cvalue("sizeof(struct lx_sockaddr_in)")
    const SOCKADDR_IN: usize = 16;
    @cvalue("offsetof(struct lx_sockaddr_in, sin_port) == 2 && offsetof(struct lx_sockaddr_in, sin_addr) == 4")
    const SOCKADDR_IN_LAYOUT: bool = true;
    @cvalue("sizeof(struct lx_sockaddr_in6)")
    const SOCKADDR_IN6: usize = 28;
    @cvalue("offsetof(struct lx_sockaddr_in6, sin6_port) == 2 && offsetof(struct lx_sockaddr_in6, sin6_addr) == 8")
    const SOCKADDR_IN6_LAYOUT: bool = true;
    @cvalue("offsetof(struct netaddr, v4) == offsetof(struct netaddr, v6) && sizeof(struct netaddr) == 20")
    const NETADDR_V4_IN_V6: bool = true;
    const EINVAL: i32 = 22;
    const EAFNOSUPPORT: i32 = 97;

    // getdents: a native record's header (struct cosmo_dirent: 16 bytes with its padding, the name at 12) and a
    // linux_dirent64's (19 bytes: d_ino, d_off, d_reclen, d_type), and the dirent types.
    @cvalue("sizeof(struct cosmo_dirent)")
    const NATIVE_DIRENT: usize = 16;
    @cvalue("offsetof(struct cosmo_dirent, name)")
    const NATIVE_NAME: usize = 12;
    @cvalue(
        "offsetof(struct cosmo_dirent, ino) == 0 && offsetof(struct cosmo_dirent, reclen) == 8 && offsetof(struct cosmo_dirent, type) == 10 && offsetof(struct cosmo_dirent, namelen) == 11",
    )
    const NATIVE_DIRENT_LAYOUT: bool = true;
    @cvalue("offsetof(struct lx_dirent64, d_name)")
    const LX_DIRENT_HDR: usize = 19;
    @cvalue(
        "offsetof(struct lx_dirent64, d_off) == 8 && offsetof(struct lx_dirent64, d_reclen) == 16 && offsetof(struct lx_dirent64, d_type) == 18",
    )
    const LX_DIRENT_LAYOUT: bool = true;
    @cvalue(
        "COSMO_DT_REG == 1 && COSMO_DT_DIR == 2 && COSMO_DT_CHR == 3 && COSMO_DT_FIFO == 4 && COSMO_DT_SOCK == 5 && COSMO_DT_LNK == 6 && LX_DT_REG == 8 && LX_DT_DIR == 4 && LX_DT_CHR == 2 && LX_DT_FIFO == 1 && LX_DT_SOCK == 12 && LX_DT_LNK == 10 && LX_DT_UNKNOWN == 0",
    )
    const DIRENT_TYPES: bool = true;

    // stat and statx.
    const COSMO_DT_DIR: u32 = 2;
    const COSMO_DT_CHR: u32 = 3;
    const COSMO_DT_FIFO: u32 = 4;
    const COSMO_DT_SOCK: u32 = 5;
    const COSMO_DT_LNK: u32 = 6;
    const LX_S_IFSOCK: u32 = 0xC000;
    const LX_S_IFLNK: u32 = 0xA000;
    const LX_S_IFREG: u32 = 0x8000;
    const LX_S_IFDIR: u32 = 0x4000;
    const LX_S_IFCHR: u32 = 0x2000;
    const LX_S_IFIFO: u32 = 0x1000;
    const LX_STATX_BYTES: usize = 256;
    @cvalue("sizeof(struct lx_statx)")
    const STATX_SIZE: usize = 256;
    const LX_STATX_SUPPORTED: u32 = 0x7DF;
    /// sizeof(struct lx_stat): 144 bytes on x86-64, 128 on AArch64.
    @constant
    fn LX_STAT_BYTES() -> usize;
}

/// The build's sizeof(struct lx_stat).
static STAT_BYTES: usize = LX_STAT_BYTES();

// --- flags and numbers -----------------------------------------------------------------------------------------------

/// Linux open flags to COSMO_O_*, with this architecture's O_DIRECTORY, O_NOFOLLOW and O_LARGEFILE bits; -1 for an
/// access mode of 3 or a flag the kernel does not know. O_CLOEXEC and O_LARGEFILE are accepted and have no effect.
fn openFlags(lx: u32, dir: u32, nofollow: u32, largefile: u32, native: borrow mut u32) -> i32 {
    var n: u32 = 0;
    let mode = lx & LX_O_ACCMODE;
    if (mode == 3) {
        return -1;
    }
    n = mode; // RDONLY 0, WRONLY 1, RDWR 2 on both sides
    if ((lx & LX_O_CREAT) != 0) {
        n |= COSMO_O_CREAT;
    }
    if ((lx & LX_O_EXCL) != 0) {
        n |= COSMO_O_EXCL;
    }
    if ((lx & LX_O_TRUNC) != 0) {
        n |= COSMO_O_TRUNC;
    }
    if ((lx & LX_O_APPEND) != 0) {
        n |= COSMO_O_APPEND;
    }
    if ((lx & dir) != 0) {
        n |= COSMO_O_DIRECTORY;
    }
    if ((lx & nofollow) != 0) {
        n |= COSMO_O_NOFOLLOW;
    }
    if ((lx & LX_O_NONBLOCK) != 0) {
        n |= COSMO_O_NONBLOCK; // a FIFO's open rules, and the open's mode
    }
    if ((lx & LX_O_NOCTTY) != 0) {
        n |= COSMO_O_NOCTTY; // a session leader opening a terminal does not take it
    }
    let known = LX_O_ACCMODE | LX_O_CREAT | LX_O_EXCL | LX_O_TRUNC | LX_O_APPEND | dir | LX_O_CLOEXEC | LX_O_NONBLOCK |
        LX_O_NOCTTY | largefile | nofollow;
    if ((lx & (known ^ 0xffffffff)) != 0) {
        return -1;
    }
    native = n;
    return 0;
}

/// Linux PROT_* to the native bits, which coincide; -1 for any other bit.
fn prot(lx: u32, native: borrow mut i32) -> i32 {
    if ((lx & ((PROT_READ | PROT_WRITE | PROT_EXEC) ^ 0xffffffff)) != 0) {
        return -1;
    }
    native = truncate<u8>(lx) as i32; // at most 7: no other bit is set
    return 0;
}

/// A native exit status (exit n, 128 + signal, 139 for a fault, stopped, continued) as Linux's wait status word.
fn waitStatus(s: i32) -> i32 {
    // The status's bits, as C's `&` on an int sees them.
    let bits = truncate<u32>(s);
    // The job-control outcomes sit above the byte the exit and kill encodings use, so they are tested first.
    if ((bits & 0xffffff00) == STATUS_STOPPED) {       // COSMO_STATUS_STOPPED(sig) without the signal
        return truncate<u8>(bits) as i32 * 256 + 0x7f; // WIFSTOPPED: the signal, then 0x7f
    }
    if (s == STATUS_CONTINUED) {
        return 0xffff; // WIFCONTINUED
    }
    if (s == EXIT_FAULT) {
        return LX_SIGSEGV;
    }
    if (s > 128 && s < 128 + 64) {
        return s - 128; // terminated by that signal
    }
    return truncate<u8>(bits) as i32 * 256; // exited normally: the low byte, shifted
}

/// COSMO_DT_* to Linux's DT_*.
fn direntType(native: u8) -> u8 => match (native) {
    1 => 8,  // regular
    2 => 4,  // directory
    3 => 2,  // character device
    4 => 1,  // FIFO
    5 => 12, // socket
    6 => 10, // symbolic link
    _ => 0,
};

/// The guest's termios to the native modes: the flags this line discipline implements, and VMIN and VTIME.
fn termiosToNative(out: borrow mut cosmo_termios, t: borrow lx_termios) {
    var m: u32 = 0;
    if ((t.c_iflag & LX_ICRNL) != 0) {
        m |= TTY_ICRNL;
    }
    if ((t.c_lflag & LX_ISIG) != 0) {
        m |= TTY_ISIG;
    }
    if ((t.c_lflag & LX_ICANON) != 0) {
        m |= TTY_ICANON;
    }
    if ((t.c_lflag & LX_ECHO) != 0) {
        m |= TTY_ECHO;
    }
    if ((t.c_lflag & LX_TOSTOP) != 0) {
        m |= TTY_TOSTOP;
    }
    if ((t.c_oflag & LX_OPOST) != 0 && (t.c_oflag & LX_ONLCR) != 0) {
        m |= TTY_OPOST;
    }
    out.modes = m;
    out.vmin = t.c_cc[LX_VMIN];
    out.vtime = t.c_cc[LX_VTIME];
    out.reserved = 0;
}

// --- socket addresses ------------------------------------------------------------------------------------------------

/// The netaddr emptied: every byte (family, port, and the 16 of the address union).
fn clearNetaddr(out: borrow mut netaddr) {
    out.family = 0;
    out.port = 0;
    out.v6.s6_addr[..].fill(0);
}

/// A guest's sockaddr_in or sockaddr_in6, `sa.length` bytes, as a netaddr; -EINVAL when it is shorter than its
/// family's, -EAFNOSUPPORT for another family.
fn sockaddrToNetaddr(sa: Slice<u8>, out: borrow mut netaddr) -> i32 {
    clearNetaddr(out);
    if (sa.length < 2) {
        return -EINVAL;
    }
    let family = sa[0] as u16 | (sa[1] as u16) << 8; // native order: little-endian on both targets
    if (family == AF_INET) {
        if (sa.length < SOCKADDR_IN) {
            return -EINVAL;
        }
        out.family = AF_INET;
        out.port = (sa[2] as u16) << 8 | sa[3] as u16;
        out.v6.s6_addr[..4].copyFrom(sa[4..8]); // v4, network order
        return 0;
    }
    if (family == AF_INET6) {
        if (sa.length < SOCKADDR_IN6) {
            return -EINVAL;
        }
        out.family = AF_INET6;
        out.port = (sa[2] as u16) << 8 | sa[3] as u16;
        out.v6.s6_addr[..].copyFrom(sa[8..24]);
        return 0;
    }
    return -EAFNOSUPPORT;
}

/// A netaddr as a Linux sockaddr_in6 (an IPv6 one) or sockaddr_in (anything else), its first `out.length` bytes at
/// most; the full size the caller needed.
fn sockaddrFromNetaddr(a: borrow netaddr, out: SliceMut<u8>) -> usize {
    var b: [u8; 28] = [0; 28];
    var size = SOCKADDR_IN;
    if (a.family == AF_INET6) {
        size = SOCKADDR_IN6;
        b[0] = 10; // AF_INET6, little-endian
        b[8..24].copyFrom(a.v6.s6_addr[..]);
    } else {
        b[0] = 2;                            // AF_INET
        b[4..8].copyFrom(a.v6.s6_addr[..4]); // v4, network order
    }
    b[2] = truncate<u8>(a.port >> 8); // the port's high byte, network order
    b[3] = truncate<u8>(a.port);      // its low byte
    let n = if (out.length < size) out.length else size;
    out[..n].copyFrom(b[..n]);
    return size;
}

// --- getdents --------------------------------------------------------------------------------------------------------

/// The little-endian u64 at `at` (which has 8 bytes after it).
fn le64(b: Slice<u8>, at: usize) -> u64 {
    let x = b[at..at + 8];
    return (x[0] as u64) | (x[1] as u64) << 8 | (x[2] as u64) << 16 | (x[3] as u64) << 24 | (x[4] as u64) << 32 |
        (x[5] as u64) << 40 | (x[6] as u64) << 48 | (x[7] as u64) << 56;
}

/// A linux_dirent64 header: d_ino, d_off and d_reclen little-endian, then d_type. Built in an array whose length the
/// compiler knows, so its stores need no checks, and copied out in one copy.
fn direntHeader(h: SliceMut<u8>, ino: u64, off: u64, reclen: u64, kind: u8) {
    var b: [u8; 19] = [0; 19];
    for (k in 0..8u32) {
        b[k as usize] = truncate<u8>(ino >> (8 * k));
        b[8 + k as usize] = truncate<u8>(off >> (8 * k));
    }
    b[16] = truncate<u8>(reclen);
    b[17] = truncate<u8>(reclen >> 8);
    b[18] = kind;
    h.copyFrom(b[..]);
}

/// Native getdents records (`input`) to linux_dirent64 records in `out`: the bytes written, stopping at a record
/// whose length is below its header, past the input, or too short for its name, and before one that would not fit.
fn direntsFromNative(input: Slice<u8>, out: SliceMut<u8>) -> usize {
    var ip: usize = 0;
    var op: usize = 0;
    while (NATIVE_DIRENT <= input.length - ip) {
        // The record's header, copied out once: its fields then read from an array of known length, with no checks.
        var h: [u8; 16] = [0; 16];
        h[..].copyFrom(input[ip..ip + NATIVE_DIRENT]);
        let ino = le64(h[..], 0);
        let reclen = h[8] as usize | (h[9] as usize) << 8;
        let kind = h[10];
        let namelen = h[11] as usize;
        if (reclen < NATIVE_NAME || reclen > input.length - ip || namelen > reclen - NATIVE_NAME) {
            break;
        }
        let rec = (LX_DIRENT_HDR + namelen + 1 + 7) & (7usize ^ 0xffffffffffffffff); // header, name, NUL; 8-aligned
        if (rec > out.length - op) {
            break;
        }
        // The record's two windows, taken once: what follows slices within them.
        let src = input[ip..ip + reclen];
        let dst = borrow mut out[op..op + rec];
        direntHeader(mut dst[..LX_DIRENT_HDR], ino, (op + rec) as u64, rec as u64, direntType(kind));
        dst[LX_DIRENT_HDR..LX_DIRENT_HDR + namelen].copyFrom(src[NATIVE_NAME..NATIVE_NAME + namelen]);
        dst[LX_DIRENT_HDR + namelen..].fill(0);
        op += rec;
        ip += reclen;
    }
    return op;
}

// --- stat, statx and the terminal's modes out ----------------------------------------------------------------------

/// `n` bytes at `p` zeroed: a record cleared before its fields are written, its padding and reserved words with it.
/// Safety: `p` points to `n` writable bytes.
unsafe fn zero(p: *mut void, n: usize) {
    SliceMut.fromRaw(p as *mut u8, n).fill(0);
}

/// Linux's makedev (glibc's and musl's encoding): the minor's low byte, the major's twelve bits, then the minor's rest.
/// A file's device is makedev(0, its mount's id).
fn makedev(major: u32, minor: u32) -> u64 =>
    ((major & 0xFFFFF000) as u64) << 32 | ((major & 0xFFF) as u64) << 8 | ((minor & 0xFFFFFF00) as u64) << 12 |
        (minor & 0xFF) as u64;

/// A COSMO_DT_* as the S_IF* bits of a Linux mode; anything else is a regular file.
fn modeType(kind: u32) -> u32 {
    if (kind == COSMO_DT_DIR) {
        return LX_S_IFDIR;
    }
    if (kind == COSMO_DT_CHR) {
        return LX_S_IFCHR;
    }
    if (kind == COSMO_DT_FIFO) {
        return LX_S_IFIFO;
    }
    if (kind == COSMO_DT_SOCK) {
        return LX_S_IFSOCK;
    }
    if (kind == COSMO_DT_LNK) {
        return LX_S_IFLNK;
    }
    return LX_S_IFREG;
}

/// The native stat record as Linux's struct stat, this architecture's layout: `narrow` is `out` as AArch64's.
fn statFromNative(st: borrow cosmo_stat, out: borrow mut lx_stat, narrow: borrow mut lx_stat_narrow) {
    if (cfg("LX_ABI_IS_X86_64")) {
        out.st_nlink = st.nlink as u64;
        out.st_blksize = 4096;
    } else {
        narrow.st_nlink = st.nlink;
        narrow.st_blksize = 4096;
    }
    out.st_dev = makedev(0, st.dev);
    out.st_ino = st.ino;
    out.st_mode = modeType(st.kind) | (st.mode & 0xFFF);
    out.st_uid = st.uid;
    out.st_gid = st.gid;
    out.st_size = truncate<i64>(st.size);
    out.st_blocks = truncate<i64>((st.size + 511) / 512);
    out.st_mtime = truncate<i64>(st.mtime_ns / 1000000000);
    out.st_mtime_nsec = truncate<i64>(st.mtime_ns % 1000000000);
    out.st_ctime = truncate<i64>(st.ctime_ns / 1000000000);
    out.st_ctime_nsec = truncate<i64>(st.ctime_ns % 1000000000);
    out.st_atime = out.st_mtime;
    out.st_atime_nsec = out.st_mtime_nsec;
}

/// The native stat record as Linux's struct statx. Linux's mask is advisory: the fields reported are the ones this
/// kernel supplies (LX_STATX_SUPPORTED). atime and btime are left zero and out of the mask: the kernel records neither,
/// and statx says a field is meaningful only when its bit is set -- so the caller is told they are absent, not handed a
/// value.
fn statxFromNative(st: borrow cosmo_stat, out: borrow mut lx_statx) {
    out.stx_mode = truncate<u16>(modeType(st.kind) | (st.mode & 0xFFF));
    out.stx_nlink = st.nlink;
    out.stx_uid = st.uid;
    out.stx_gid = st.gid;
    out.stx_ino = st.ino;
    out.stx_dev_major = 0;
    out.stx_dev_minor = st.dev; // makedev(0, dev): what st_dev says
    out.stx_size = st.size;
    out.stx_blksize = 4096;
    out.stx_blocks = (st.size + 511) / 512;
    out.stx_mtime.tv_sec = truncate<i64>(st.mtime_ns / 1000000000);
    out.stx_mtime.tv_nsec = truncate<u32>(st.mtime_ns % 1000000000);
    out.stx_ctime.tv_sec = truncate<i64>(st.ctime_ns / 1000000000);
    out.stx_ctime.tv_nsec = truncate<u32>(st.ctime_ns % 1000000000);
    out.stx_mask = LX_STATX_SUPPORTED;
}

/// The terminal's modes, both ways: this direction. Linux's structure has four flag words and nineteen control
/// characters; this kernel has four flags and two numbers, so the translation is mostly deciding what to say about the
/// fields that do not exist. It says the truth: the bits this tree implements are reported as they are, and the rest
/// read as a plausible quiet terminal rather than as zero, because a libc that sees c_oflag with OPOST clear will stop
/// translating newlines itself and the console does that translation in its sink.
fn termiosFromNative(out: borrow mut lx_termios, t: borrow cosmo_termios) {
    out.c_iflag = if ((t.modes & TTY_ICRNL) != 0) LX_ICRNL else 0;
    // OPOST|ONLCR: the newline goes out as CR LF -- by a pty's output processing, or by the console's serial sink,
    // which does it whatever the mode says. Reporting it clear would make a libc translate too.
    out.c_oflag = if ((t.modes & TTY_OPOST) != 0) LX_OPOST | LX_ONLCR else 0;
    // A terminal that says 8 bits, receiver on, 38400 baud: there is no line to describe, and zero would read as a
    // hung-up modem (B0).
    out.c_cflag = LX_CS8 | LX_CREAD | LX_B38400;
    var l = LX_IEXTEN;
    if ((t.modes & TTY_ISIG) != 0) {
        l |= LX_ISIG;
    }
    if ((t.modes & TTY_ICANON) != 0) {
        l |= LX_ICANON;
    }
    if ((t.modes & TTY_ECHO) != 0) {
        l |= LX_ECHO | LX_ECHOE | LX_ECHOK | LX_ECHOCTL | LX_ECHOKE;
    }
    if ((t.modes & TTY_TOSTOP) != 0) {
        l |= LX_TOSTOP;
    }
    out.c_lflag = l;
    // The control characters this line discipline acts on, at Linux's defaults (they are fixed here: setting another
    // is accepted and has no effect).
    out.c_cc[LX_VINTR] = 0x03;
    out.c_cc[LX_VQUIT] = 0x1c;
    out.c_cc[LX_VERASE] = 0x7f;
    out.c_cc[LX_VKILL] = 0x15;
    out.c_cc[LX_VEOF] = 0x04;
    out.c_cc[LX_VSTART] = 0x11;
    out.c_cc[LX_VSTOP] = 0x13;
    out.c_cc[LX_VSUSP] = 0x1a;
    out.c_cc[LX_VREPRINT] = 0x12;
    out.c_cc[LX_VDISCARD] = 0x0f;
    out.c_cc[LX_VWERASE] = 0x17;
    out.c_cc[LX_VLNEXT] = 0x16;
    out.c_cc[LX_VMIN] = t.vmin;
    out.c_cc[LX_VTIME] = t.vtime;
}

// --- the exports -----------------------------------------------------------------------------------------------------

/// Safety: `native` is writable.
@export("lx_open_flags_for")
unsafe fn openFlagsC(lx: u32, dir: u32, nofollow: u32, largefile: u32, native: *mut u32) -> i32 =>
    openFlags(lx, dir, nofollow, largefile, Ptr.toBorrowMut(native));

/// Safety: `native` is writable.
@export("lx_prot")
unsafe fn protC(lx: u32, native: *mut i32) -> i32 => prot(lx, Ptr.toBorrowMut(native));

@export("lx_wait_status")
fn waitStatusC(s: i32) -> i32 => waitStatus(s);

@export("lx_dirent_type")
fn direntTypeC(native: u8) -> u8 => direntType(native);

/// Safety: `out` is writable and `t` readable (the guest's termios, already copied in).
@export("lx_termios_to_native")
unsafe fn termiosToNativeC(out: *mut cosmo_termios, t: *lx_termios) =>
    termiosToNative(Ptr.toBorrowMut(out), Ptr.toBorrow(t));

/// Safety: `sa` points to `len` readable bytes and `out` is writable.
@export("lx_sockaddr_to_netaddr")
unsafe fn sockaddrToNetaddrC(sa: *void, len: usize, out: *mut netaddr) -> i32 =>
    sockaddrToNetaddr(Slice.fromRaw(sa as *u8, len), Ptr.toBorrowMut(out));

/// Safety: `a` is readable and `out` points to `cap` writable bytes.
@export("lx_sockaddr_from_netaddr")
unsafe fn sockaddrFromNetaddrC(a: *netaddr, out: *mut void, cap: usize) -> usize =>
    sockaddrFromNetaddr(Ptr.toBorrow(a), SliceMut.fromRaw(out as *mut u8, cap));

/// Safety: `input` points to `inlen` readable bytes and `out` to `outcap` writable ones, not overlapping.
@export("lx_dirents_from_native")
unsafe fn direntsFromNativeC(input: *u8, inlen: usize, out: *mut u8, outcap: usize) -> usize =>
    direntsFromNative(Slice.fromRaw(input, inlen), SliceMut.fromRaw(out, outcap));

/// Safety: `st` is readable and `out` writable.
@export("lx_stat_from_native")
unsafe fn statFromNativeC(st: *cosmo_stat, out: *mut lx_stat) {
    zero(out as *mut void, STAT_BYTES);
    statFromNative(Ptr.toBorrow(st), Ptr.toBorrowMut(out), Ptr.toBorrowMut(out as *mut lx_stat_narrow));
}

/// Safety: `st` is readable and `out` writable. `mask` is advisory (statxFromNative).
@export("lx_statx_from_native")
unsafe fn statxFromNativeC(st: *cosmo_stat, mask: u32, out: *mut lx_statx) {
    let _ = mask;
    zero(out as *mut void, LX_STATX_BYTES);
    statxFromNative(Ptr.toBorrow(st), Ptr.toBorrowMut(out));
}

/// Safety: `out` is writable and `t` readable.
@export("lx_termios_from_native")
unsafe fn termiosFromNativeC(out: *mut lx_termios, t: *cosmo_termios) {
    zero(out as *mut void, LX_TERMIOS_SIZE);
    termiosFromNative(Ptr.toBorrowMut(out), Ptr.toBorrow(t));
}
