# /etc/rc.test - the shell and utilities exercise themselves. Only
# present in self-test builds (SELFTEST=1). Straight-line shell: every
# check is a command whose failure records a FAIL line; the last line
# reports the verdict. Output lines the boot harness requires are marked.
FAILS=0
mkdir -p /tmp/shtest/dir/sub || FAILS=1
echo hello > /tmp/shtest/a || FAILS=1
cat /tmp/shtest/a | cat > /tmp/shtest/b || FAILS=1
cat /tmp/shtest/b
echo world >> /tmp/shtest/b || FAILS=1
cat /tmp/shtest/a /tmp/shtest/b | cat | cat > /tmp/shtest/c || FAILS=1
cat /tmp/shtest/c
cp /tmp/shtest/c /tmp/shtest/dir/ || FAILS=1
cp -r /tmp/shtest/dir /tmp/shtest/copy || FAILS=1
ls /tmp/shtest/copy/sub || FAILS=1
mv /tmp/shtest/copy/c /tmp/shtest/moved || FAILS=1
rm /tmp/shtest/copy/c && FAILS=1
cat /tmp/shtest/moved | cat > /tmp/shtest/d || FAILS=1
rm -r /tmp/shtest/copy || FAILS=1
ls /tmp/shtest/copy && FAILS=1
false && FAILS=1
true || FAILS=1
false; echo "status $?"
cat /nonexistent 2> /tmp/shtest/err && FAILS=1
cat /tmp/shtest/err
sh -c "exit 3"; echo "exit $?"
nosuchcommand 2> /tmp/shtest/nf; echo "notfound $?"
X=42; echo "var $X ${X}1 $$"
export Y=hello; sh -c 'echo "exported $Y"'
cd /tmp/shtest && pwd
cd dir && pwd
cd .. && pwd
cd /
ls -l /tmp/shtest/a | cat > /tmp/shtest/l || FAILS=1
cat /tmp/shtest/l
echo -n "no newline"; echo
ps
sysctl kernel.name
kill 99999 2> /tmp/shtest/k && FAILS=1
# The package system (docs/pkg/testing.md): update, dependency closure, refusals, upgrade, removal order.
pkg update || FAILS=1
pkg install fortune || FAILS=1
fortune || FAILS=1
pkg list
pkg info fortune || FAILS=1
pkg verify || FAILS=1
pkg install badsig 2> /tmp/shtest/badsig && FAILS=1
cat /tmp/shtest/badsig
pkg install badsum 2> /tmp/shtest/badsum && FAILS=1
cat /tmp/shtest/badsum
pkg install hello=1.0 || FAILS=1
hello
pkg upgrade || FAILS=1
hello
pkg remove fortunes 2> /tmp/shtest/rmdep && FAILS=1
cat /tmp/shtest/rmdep
pkg remove fortune || FAILS=1
pkg remove fortunes || FAILS=1
fortune 2> /tmp/shtest/gone && FAILS=1
pkg remove hello || FAILS=1
# Resolution is order independent: demo-a wants demolib >= 2, demo-b wants < 3; 2.5 satisfies both.
pkg install demo-a demo-b || FAILS=1
pkg info demolib
pkg remove demo-a demo-b demolib || FAILS=1
pkg install demo-b demo-a || FAILS=1
cat /usr/share/demolib/VERSION
pkg remove demo-b demo-a demolib || FAILS=1
pkg list
# Linux programs (docs/compat/linux/testing.md): no CosmoOS note, so the kernel runs them as Linux.
# Both architectures carry them (milestone 10); a build without them reports the section skipped.
sh -c 'ls /boot/tests/linux/lxhello > /tmp/shtest/lx.probe 2>&1 || exit 0; sh /etc/rc.linux' || FAILS=1
ls /boot/tests/linux/lxhello > /tmp/shtest/lx.probe 2>&1 || echo "LINUXTEST: skipped"
# Snapshots (docs/kernel-services/filesystem/cosmofs/testing.md) through
# the interface a user actually has: mkdir and rmdir under .snapshots.
# The nvme self-test leaves a formatted cosmofs on nvme0n1, so the shell
# has a real filesystem to snapshot; a build without it skips. The whole
# check is one line because this shell has no multi-line quoting.
mkdir -p /tmp/snapmnt || FAILS=1
mount nvme0n1 /tmp/snapmnt cosmofs 2> /tmp/shtest/snap.err || echo "SNAPTEST: skipped"
sh -c 'ls /tmp/snapmnt/.snapshots > /tmp/shtest/snap.probe 2>&1 || exit 0; echo before > /tmp/snapmnt/snapfile || exit 1; mkdir /tmp/snapmnt/.snapshots/shell || exit 1; echo after > /tmp/snapmnt/snapfile || exit 1; cat /tmp/snapmnt/.snapshots/shell/snapfile || exit 1; cat /tmp/snapmnt/snapfile || exit 1; echo nope > /tmp/snapmnt/.snapshots/shell/snapfile && exit 1; ls /tmp/snapmnt/.snapshots || exit 1; rmdir /tmp/snapmnt/.snapshots/shell || exit 1; rm /tmp/snapmnt/snapfile || exit 1; echo "SNAPTEST: PASS"' || FAILS=1
umount /tmp/snapmnt 2> /tmp/shtest/snap.err2
# Virtualization (docs/kernel-services/virtualization/testing.md): run a
# guest under vmctl. The guest images are per-architecture, so the shell
# runs whichever one this build carries: the x86 console guest, or the
# AArch64 guest that calls its hypervisor and waits.
vmctl probe || echo "HVTEST: skipped"
ls /boot/tests/hv/guest_pio.bin > /tmp/shtest/hv.probe 2>&1 && vmctl probe && vmctl run /boot/tests/hv/guest_pio.bin > /tmp/shtest/hv.out && cat /tmp/shtest/hv.out && echo "HVTEST: PASS"
ls /boot/tests/hv/guest_hvc.bin > /tmp/shtest/hv.probe 2>&1 && vmctl probe && vmctl run /boot/tests/hv/guest_hvc.bin > /tmp/shtest/hv.out && cat /tmp/shtest/hv.out && echo "HVTEST: PASS"
vmctl info
rm -r /tmp/shtest || FAILS=1
sh -c "exit $FAILS" && echo "SHTEST: PASS" || echo "SHTEST: FAIL $FAILS"
