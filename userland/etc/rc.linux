# /etc/rc.linux - the Linux ABI programs (docs/compat/linux/testing.md).
# Run by rc.test only where /boot/tests/linux exists (x86-64 builds); the
# exit status of this script is the section's verdict.
/boot/tests/linux/lxhello || exit 1
/boot/tests/linux/lxtest || exit 1
/boot/tests/linux/lxdyn || exit 1
# Expected deaths (lxsig.c): the status is the shell's view, 128 + the signal.
/boot/tests/linux/lxsig term
echo "lxsig term: $?"
/boot/tests/linux/lxsig segv
echo "lxsig segv: $?"
/boot/tests/linux/lxsig ill
echo "lxsig ill: $?"
/boot/tests/linux/lxsig badret
echo "lxsig badret: $?"
/boot/tests/linux/lxsig badstack
echo "lxsig badstack: $?"
/boot/tests/linux/lxsig group
echo "lxsig group: $?"
/boot/tests/linux/lxsig lastthread
echo "lxsig lastthread: $?"
/boot/tests/linux/lxsig session
echo "lxsig session: $?"
# The musl programs, where the build had musl-gcc (both or neither): an
# inner shell skips the section when the first is absent and fails it when
# either program fails, the same shape rc.test uses to run this script.
cosmo-sh -c 'ls /boot/tests/linux/hello_musl > /tmp/.musl.probe 2>&1 || exit 0; /boot/tests/linux/hello_musl || exit 1; /boot/tests/linux/epoll_musl || exit 1' || exit 1
rm /tmp/.musl.probe
exit 0
