// blkserial.cee - Disk serial numbers (kernel/include/kernel/blk.h's `serial`), in CeeSafe: the printable ASCII a
// driver keeps of the serial its device reports, and the test disks the self-tests may write to, which their serial
// marks. Its C interface, kernel/include/kernel/blkserial.h, is ceesafec's; blk.h includes it.
//
// A name ("vda", "sda") is only where a disk landed: with the installed system's disk alone attached, "vda" is that
// disk, and on real hardware it may be anyone's. scripts/qemu-run.sh gives the disks made for the self-tests a serial
// beginning with TEST_PREFIX, and nothing else marks a disk as theirs (docs/kernel/device/testing.md, "Test disks").

@header("kernel/blk.h")
extern "C" {
    /// blk.h: the serial, set by the driver before blk_register (BLKDEV_SERIAL_MAX bytes, NUL-terminated).
    struct blkdev {
        obj: kobject;
        serial: [u8; 21];
    }

    fn blk_find(name: *CChar) -> *mut blkdev;
}

/// The serials of the disks made for the self-tests begin with these bytes.
const TEST_PREFIX: [u8; 11] = [0x63, 0x6f, 0x73, 0x6d, 0x6f, 0x2d, 0x74, 0x65, 0x73, 0x74, 0x2d]; // "cosmo-test-"

/// A disk made for the self-tests: its serial begins with "cosmo-test-". Never a partition (a partition has none).
/// Safety: `bd` is a referenced disk, whose serial is fixed while it is registered.
@export("blk_is_test_disk")
unsafe fn isTestDisk(bd: *blkdev) -> bool {
    let serial = Ptr.toBorrow(bd).serial;
    let prefix = TEST_PREFIX;
    for (i in 0..prefix.length) {
        if (serial[i] != prefix[i]) {
            return false;
        }
    }
    return true;
}

/// blk_find for a self-test that writes: the disk named `name` when it is a test disk, referenced; NULL when there is
/// no such disk, and NULL with a line in the log when there is one that is not a test disk. Sleeps.
/// Safety: `name` is a NUL-terminated string.
@export("blk_find_test")
unsafe fn findTest(name: *CChar) -> *mut blkdev {
    let bd = blk_find(name);
    if (bd.isNull() || isTestDisk(bd as *blkdev)) {
        return bd;
    }
    var buffer = [0u8; 128];
    var line = TextWriter.create(mut buffer[..]);
    line.text("blk: ");
    line.bytes(Slice.fromRaw(name as *u8, cLength(name as *u8)));
    line.text(" is not a test disk (serial \"");
    let serial = Ptr.toBorrow(bd as *blkdev).serial;
    line.bytes(cText(serial[..]));
    line.text("\"); the self-tests leave it alone");
    KernelLog.send(LogLevel.Info, line);
    kobject_put(borrow mut Ptr.toBorrowMut(bd).obj as *mut kobject); // blkdev_put, an inline in blk.h
    return 0 as *mut blkdev;
}

/// The length of the C string at `s`, read a byte at a time (never past its NUL), at most 32 (a disk's name is shorter).
/// Safety: `s` is a NUL-terminated string.
unsafe fn cLength(s: *u8) -> usize {
    var n: usize = 0;
    while (n < 32 && s.offset(truncate<isize>(n)).read() != 0) {
        n += 1;
    }
    return n;
}

/// The bytes of a C string before its NUL, at most `bytes.length` of them.
fn cText(bytes: Slice<u8>) -> Slice<u8> {
    for (i in 0..bytes.length) {
        if (bytes[i] == 0) {
            return bytes[..i];
        }
    }
    return bytes;
}

/// The printable ASCII (0x20-0x7e) at the start of a serial a device reported, into `out` as a C string: `count`
/// characters of `stride` bytes each (1: bytes, virtio-blk's GET_ID; 2: UTF-16LE, a USB string descriptor, whose high
/// byte must be zero), up to the first that is not printable and at most `outLength` - 1 of them. Device memory is
/// read only within `count` × `stride` bytes.
/// Safety: `chars` points to `count` × `stride` readable bytes, `out` to `outLength` (at least 1) writable ones.
@export("blk_serial_ascii")
unsafe fn serialAscii(chars: *u8, count: u32, stride: u32, out: *mut u8, outLength: u32) {
    let source = Slice.fromRaw(chars, (count as usize) * (stride as usize));
    let target = SliceMut.fromRaw(out, outLength as usize);
    var o: usize = 0;
    for (k in 0..count as usize) {
        if (o + 1 >= target.length) {
            break;
        }
        let c = source[k * (stride as usize)];
        if ((stride == 2 && source[k * 2 + 1] != 0) || c < 0x20 || c >= 0x7f) {
            break;
        }
        target[o] = c;
        o += 1;
    }
    target[o] = 0;
}
