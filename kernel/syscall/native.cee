// native.cee - The CosmoOS native personality: its system-call table and its record, in CeeSafe (roadmap 1.3 K1).
//
// Numbers come from uapi/cosmo/syscall.h, and the C compiler holds each constant below to that header. The calls are
// this directory's (io.cee, threads.cee, mmap.cee, files.cee, mount.cee, sockets.cee, procs.cee, sysctl.cee,
// jobctl.cee) and the subsystems' that syscall.h declares. The table, the list and the record are C's `const`
// objects, in read-only data (CeeSafe ADRs 0091 and 0098).

@header("kernel/elf.h", "kernel/process.h", "kernel/syscall.h", "uapi/cosmo/syscall.h")
extern "C" {
    struct syscall_args;
    struct process;
    struct elf_info;
    struct personality_auxv_args;
    struct arch_user_regs;
    struct sigaction_k;
    struct signal_info;
    @ctype("syscall_fn")
    struct syscall_fn;
    struct personality {
        name: *CChar;
        table: *syscall_fn;
        count: u32;
        always_allowed: *u16;
        nr_always_allowed: u32;
        signal_frame: extern "C" fn(*mut arch_user_regs, *sigaction_k, *signal_info, u64) -> i32;
        claims_elf: extern "C" fn(*elf_info) -> bool;
        auxv: extern "C" fn(*mut process, *elf_info, *personality_auxv_args, *mut u64, u32) -> u32;
    }
    const SYS_exit: u16 = 0;
    const SYS_write: u16 = 1;
    const SYS_read: u16 = 2;
    const SYS_getpid: u16 = 3;
    const SYS_yield: u16 = 4;
