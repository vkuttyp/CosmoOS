// fbrules.cee - The framebuffer console's rules that draw nothing (docs/kernel/diagnostics/design.md, "fbcon.c" and
// "The quiet screen"), in CeeSafe: which of the kernel's log lines the screen shows, a colour as a pixel of the
// screen's format, how large the font is drawn; and the self-test console-log-floor. fbcon.c does the drawing and
// owns the sink.
//
// The quiet screen: the framebuffer shows the kernel's errors and panics, and everything that is not a log line --
// the banner, programs' output, the shell. The informational lines stay on the serial port and in the ring (`dmesg`).
// `verbose` on the command line shows every line here too.

@header(
    "kernel/bootinfo.h", "kernel/cmdline.h", "kernel/console.h", "kernel/fbcon.h", "kernel/log.h",
    "kernel/selftest.h",
)
extern "C" {
    /// bootinfo.h: a validated framebuffer's colour channels.
    struct bootinfo_framebuffer {
        red_shift: u8;
        red_bits: u8;
        green_shift: u8;
        green_bits: u8;
        blue_shift: u8;
        blue_bits: u8;
    }
    /// console.h: an output device.
    struct console_sink {
        name: *CChar;
        write: extern "C" fn(*mut console_sink, *CChar, usize);
        log_floor: i32;
    }

    fn cmdline_get(key: *CChar, out: *mut CChar, outLen: usize) -> i32;
    fn console_register(sink: *mut console_sink);
    fn console_unregister(sink: *mut console_sink);
    fn console_puts(s: *CChar);
    fn klog(level: u32, format: *CChar, ...);
    fn klog_get_level() -> u32;
    fn klog_set_level(level: u32);

    /// fbcon.h: the escape parser's state.
    struct fbcon_esc {
        state: u32;
        count: u32;
        p0: u32;
        p1: u32;
        p2: u32;
        p3: u32;
        fg: u32;
        bg: u32;
        bold: u32;
        a: u32;
        n: u32;
    }
    // fbcon.h's meanings of a byte, which the C compiler checks.
    const FBCON_ESC_PUT: u32 = 0;
    const FBCON_ESC_NONE: u32 = 1;
    const FBCON_ESC_CLEAR: u32 = 2;
    const FBCON_ESC_MOVE: u32 = 3;
    const FBCON_ESC_REL: u32 = 4;
    const FBCON_ESC_ERASE: u32 = 5;

    // log.h's levels, which the C compiler checks.
    const KLOG_DEBUG: i32 = 0;
    const KLOG_INFO: i32 = 1;
    const KLOG_WARN: i32 = 2;
    const KLOG_ERROR: i32 = 3;
    const KLOG_PANIC: i32 = 4;
}

/// Above every level: what is not a log line passes every floor.
const NOT_A_LOG_LINE: i32 = 2147483647;
/// The length of a level's tag, `[ INFO] `.
const TAG: usize = 8;
const NEWLINE: u8 = 10;

// ---- Which log lines the screen shows ----

/// Whether `line[at..]` begins with `s`.
fn beginsAt(line: Slice<u8>, at: usize, s: StringView) -> bool {
    let b = s.bytes();
    if (line.length < at || line.length - at < b.length) {
        return false;
    }
    var i: usize = 0;
    while (i < b.length) {
        if (line[at + i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// The level a log line's first bytes name, by log.c's tags, or NOT_A_LOG_LINE.
fn levelOf(head: Slice<u8>) -> i32 {
    if (beginsAt(head, 0, "[DEBUG] ")) { return KLOG_DEBUG; }
    if (beginsAt(head, 0, "[ INFO] ")) { return KLOG_INFO; }
    if (beginsAt(head, 0, "[ WARN] ")) { return KLOG_WARN; }
    if (beginsAt(head, 0, "[ERROR] ")) { return KLOG_ERROR; }
    if (beginsAt(head, 0, "[PANIC] ")) { return KLOG_PANIC; }
    return NOT_A_LOG_LINE;
}

/// The log's text without the lines below `floor`, in place: the new length. A line is hidden if it begins with the
/// tag of a level below the floor; the text is the ring's (klog_copy), whole lines.
fn dropHidden(buf: SliceMut<u8>, floor: i32) -> usize {
    var out: usize = 0;
    var at: usize = 0;
    while (at < buf.length) {
        var end = at;
        while (end < buf.length && buf[end] != NEWLINE) {
            end += 1;
        }
        if (end < buf.length) {
            end += 1;
        }
        var head: [u8; 8] = [0; 8];
        var h: usize = 0;
        while (h < TAG && at + h < end) {
            head[h] = buf[at + h];
            h += 1;
        }
        if (levelOf(head[..h]) >= floor) {
            var k = at;
            while (k < end) {
                buf[out] = buf[k];
                out += 1;
                k += 1;
            }
        }
        at = end;
    }
    return out;
}

/// Safety: fbcon.h's contract: `buf` points to `n` writable bytes nothing else uses during the call.
@export("fbcon_drop_hidden")
unsafe fn dropHiddenC(buf: *mut CChar, n: usize, floor: i32) -> usize =>
    dropHidden(SliceMut.fromRaw(buf as *mut u8, n), floor);

/// The screen's log floor: ERROR, or none with `verbose` on the command line.
/// Safety: after bootinfo_init, which the command line needs.
@export("fbcon_log_floor")
unsafe fn logFloorC() -> i32 {
    var value: [u8; 2] = [0; 2];
    let found = cmdline_get("verbose\0".ptr as *CChar, borrow mut value[0] as *mut u8 as *mut CChar, 2);
    return if (found == -1) KLOG_ERROR else 0;
}

// ---- Colours and the font's size ----

/// An eight-bit intensity in a channel of `bits` bits. Deeper channels exist (ten bits a colour is a real mode) and
/// the validator allows them, so this scales both ways. A channel the validator would refuse gives 0, not a failed
/// shift.
fn channel(value8: u32, bits: u8, shift: u8) -> u32 {
    if (bits > 32 || shift >= 32) {
        return 0;
    }
    let scaled = if (bits >= 8) value8.wrappingShl((bits - 8) as u32) else value8 >> ((8 - bits) as u32);
    return scaled.wrappingShl(shift as u32);
}

/// Safety: fbcon.h's contract: `fb` points to a live framebuffer description.
@export("fbcon_pack")
unsafe fn packC(fb: *bootinfo_framebuffer, r: u32, g: u32, b: u32) -> u32 {
    let f = Ptr.toBorrow(fb);
    return channel(r & 0xff, f.red_bits, f.red_shift) | channel(g & 0xff, f.green_bits, f.green_shift) |
        channel(b & 0xff, f.blue_bits, f.blue_shift);
}

/// How many screen pixels a font pixel is, each way. The face is 8x16, the size of a PC or Linux text console, and is
/// drawn one-to-one up to 1920x1080 (Parallels Desktop's 1024x768: 128x48 cells, the owner's choice on 2026-10-13
/// after trying 2x). A screen of twice that each way (4K) and up draws it larger: min(width / 1920, height / 1080),
/// 1 to `max`.
@export("fbcon_scale")
fn scaleC(width: u32, height: u32, max: u32) -> u32 {
    let s = if (width / 1920 < height / 1080) width / 1920 else height / 1080;
    if (s < 1) {
        return 1;
    }
    return if (s > max) max else s;
}

// ---- Colours and escapes ----

// The parser's states.
const GROUND: u32 = 0;
const ESCAPE: u32 = 1;
const CSI: u32 = 2;
/// A parameter's ceiling: larger numbers saturate rather than wrap.
const PARAM_MAX: u32 = 9999;
/// The parameters kept; a fifth and later are read and ignored.
const PARAMS: u32 = 4;
const DEFAULT_FG: u32 = 7;
const DEFAULT_BG: u32 = 0;

/// The `i`th parameter, 0 when absent.
fn param(e: borrow fbcon_esc, i: u32) -> u32 {
    if (i == 0) { return e.p0; }
    if (i == 1) { return e.p1; }
    if (i == 2) { return e.p2; }
    if (i == 3) { return e.p3; }
    return 0;
}

fn setParam(e: borrow mut fbcon_esc, i: u32, v: u32) {
    if (i == 0) { e.p0 = v; }
    if (i == 1) { e.p1 = v; }
    if (i == 2) { e.p2 = v; }
    if (i == 3) { e.p3 = v; }
}

/// The colours back to the defaults, the parser to its ground state.
fn reset(e: borrow mut fbcon_esc) {
    e.state = GROUND;
    e.count = 0;
    e.fg = DEFAULT_FG;
    e.bg = DEFAULT_BG;
    e.bold = 0;
}

/// One SGR parameter (ECMA-48 8.3.117, as the Linux console reads it): reset, bold, the eight colours and their
/// bright versions, foreground and background, and their defaults. Others (underline, 256 colours) are ignored.
fn sgr(e: borrow mut fbcon_esc, v: u32) {
    if (v == 0) {
        e.fg = DEFAULT_FG;
        e.bg = DEFAULT_BG;
        e.bold = 0;
    } else if (v == 1) {
        e.bold = 1;
    } else if (v == 22) {
        e.bold = 0;
    } else if (v >= 30 && v <= 37) {
        e.fg = v - 30;
    } else if (v == 39) {
        e.fg = DEFAULT_FG;
    } else if (v >= 40 && v <= 47) {
        e.bg = v - 40;
    } else if (v == 49) {
        e.bg = DEFAULT_BG;
    } else if (v >= 90 && v <= 97) {
        e.fg = v - 90 + 8;
    } else if (v >= 100 && v <= 107) {
        e.bg = v - 100 + 8;
    }
}

/// What a byte means to the screen, given the bytes before it: FBCON_ESC_PUT (draw it, or the control it is),
/// FBCON_ESC_NONE (part of an escape sequence, or one with nothing to draw), CLEAR (`ESC [ 2 J`, `ESC [ 3 J`,
/// `ESC c`), MOVE to row `e.a`, column `e.n` (`ESC [ r ; c H`, 1-based in the stream), REL by `e.n` cells in
/// direction `e.a` (`ESC [ n A` to `D`), ERASE to the end of the line (`ESC [ K`). An escape sequence the screen does not obey is
/// consumed whole and draws nothing. A byte that cannot be in one ends it and is drawn.
fn feed(e: borrow mut fbcon_esc, b: u32) -> u32 {
    if (e.state == GROUND) {
        if (b == 27) {
            e.state = ESCAPE;
            return FBCON_ESC_NONE;
        }
        return FBCON_ESC_PUT;
    }
    if (e.state == ESCAPE) {
        if (b == 91) { // '['
            e.state = CSI;
            e.count = 0;
            e.p0 = 0;
            e.p1 = 0;
            e.p2 = 0;
            e.p3 = 0;
            return FBCON_ESC_NONE;
        }
        e.state = GROUND;
        if (b == 99) { // 'c': a full reset
            reset(e);
            return FBCON_ESC_CLEAR;
        }
        return if (b < 32) FBCON_ESC_PUT else FBCON_ESC_NONE;
    }
    // CSI: parameters, then one final byte.
    if (b >= 48 && b <= 57) { // a digit
        if (e.count < PARAMS) {
            let v = param(e, e.count) * 10 + (b - 48);
            setParam(e, e.count, if (v > PARAM_MAX) PARAM_MAX else v);
        }
        return FBCON_ESC_NONE;
    }
    if (b == 59) { // ';'
        if (e.count < PARAMS) {
            e.count += 1;
        }
        return FBCON_ESC_NONE;
    }
    if (b >= 32 && b < 64) { // '?', '>' and other private or intermediate bytes: read past
        return FBCON_ESC_NONE;
    }
    e.state = GROUND;
    if (b < 32 || b > 126) {
        return FBCON_ESC_PUT; // not a sequence after all: the byte is drawn (or obeyed) on its own
    }
    if (b == 109) { // 'm'
        let last = if (e.count < PARAMS) e.count else PARAMS - 1;
        var i: u32 = 0;
        while (i <= last) {
            sgr(e, param(e, i));
            i += 1;
        }
        return FBCON_ESC_NONE;
    }
    if (b == 74) { // 'J'
        return if (e.p0 == 2 || e.p0 == 3) FBCON_ESC_CLEAR else FBCON_ESC_NONE;
    }
    if (b == 72 || b == 102) { // 'H', 'f'
        e.a = if (e.p0 > 0) e.p0 - 1 else 0;
        e.n = if (e.p1 > 0) e.p1 - 1 else 0;
        return FBCON_ESC_MOVE;
    }
    if (b >= 65 && b <= 68) { // 'A' to 'D'
        e.a = b;
        e.n = if (e.p0 > 0) e.p0 else 1;
        return FBCON_ESC_REL;
    }
    if (b == 75) { // 'K'
        return if (e.p0 == 0) FBCON_ESC_ERASE else FBCON_ESC_NONE;
    }
    return FBCON_ESC_NONE;
}

/// Safety: fbcon.h's contract: `e` points to a parser state nothing else uses during the call.
@export("fbcon_esc_feed")
unsafe fn feedC(e: *mut fbcon_esc, b: u32) -> u32 => feed(Ptr.toBorrowMut(e), b);

/// Safety: as feedC.
@export("fbcon_esc_reset")
unsafe fn resetC(e: *mut fbcon_esc) {
    reset(Ptr.toBorrowMut(e));
}

/// Where a MOVE or REL that `feed` returned puts the cursor (`cx`, `cy`) on a screen of `cols` by `rows` cells: inside
/// it, whatever the stream asked for: x in the high 32 bits, y in the low.
fn place(e: borrow fbcon_esc, cx: u32, cy: u32, cols: u32, rows: u32) -> u64 {
    if (e.state != GROUND || cols == 0 || rows == 0) {
        return (cx as u64 << 32) | cy as u64;
    }
    var x = cx;
    var y = cy;
    if (e.a == 65) { // 'A': up
        y = if (y > e.n) y - e.n else 0;
    } else if (e.a == 66) { // 'B': down
        y = if (y + e.n < rows - 1) y + e.n else rows - 1;
    } else if (e.a == 67) { // 'C': right
        x = if (x + e.n < cols - 1) x + e.n else cols - 1;
    } else if (e.a == 68) { // 'D': left
        x = if (x > e.n) x - e.n else 0;
    } else { // MOVE: row e.a, column e.n
        y = if (e.a < rows) e.a else rows - 1;
        x = if (e.n < cols) e.n else cols - 1;
    }
    return (x as u64 << 32) | y as u64;
}

/// Safety: `e` points to a parser state, `cx` and `cy` to the cursor, nothing else using them during the call.
@export("fbcon_esc_place")
unsafe fn placeC(e: *fbcon_esc, cx: *mut u32, cy: *mut u32, cols: u32, rows: u32) {
    let xy = place(Ptr.toBorrow(e), cx.read(), cy.read(), cols, rows);
    cx.write(truncate<u32>(xy >> 32));
    cy.write(truncate<u32>(xy & 0xffffffff));
}

/// The attribute byte a cell is drawn with: the foreground (bright when bold) and the background, as palette indices.
fn attr(e: borrow fbcon_esc) -> u32 {
    let fg = if (e.bold != 0 && e.fg < 8) e.fg + 8 else e.fg;
    return (fg & 15) | ((e.bg & 15) << 4);
}

/// Safety: `e` points to a live parser state.
@export("fbcon_esc_attr")
unsafe fn attrC(e: *fbcon_esc) -> u32 => attr(Ptr.toBorrow(e));

/// The sixteen colours as eight-bit red, green, blue: the PC's, as the Linux console draws them, but for light grey,
/// which is the 0xd0 the console has always drawn its text in.
const PALETTE: [u32; 16] = [
    0x000000, 0xaa0000, 0x00aa00, 0xaa5500, 0x0000aa, 0xaa00aa, 0x00aaaa, 0xd0d0d0,
    0x555555, 0xff5555, 0x55ff55, 0xffff55, 0x5555ff, 0xff55ff, 0x55ffff, 0xffffff,
];

/// Safety: `fb` points to a live framebuffer description and `out` to 16 writable words.
@export("fbcon_palette")
unsafe fn paletteC(fb: *bootinfo_framebuffer, out: *mut u32) {
    let colours = SliceMut.fromRaw(out, 16);
    var i: usize = 0;
    while (i < 16) {
        let rgb = PALETTE[i];
        colours[i] = packC(fb, (rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
        i += 1;
    }
}

/// Where the last `rows` lines of `text` start: after the `rows`th newline from the end, or at 0.
fn tailStart(text: Slice<u8>, rows: u32) -> usize {
    var start = text.length;
    var lines: u32 = 0;
    while (start > 0 && lines < rows) {
        start -= 1;
        if (text[start] == NEWLINE) {
            lines += 1;
            if (lines == rows) {
                return start + 1;
            }
        }
    }
    return start;
}

/// Safety: `buf` points to `n` readable bytes.
@export("fbcon_tail_start")
unsafe fn tailStartC(buf: *CChar, n: usize, rows: u32) -> usize => tailStart(Slice.fromRaw(buf as *u8, n), rows);

// ---- The self-test console-log-floor ----

/// The two sinks' addresses, and what each was given of the test's lines.
static QUIET_SINK: AtomicUSize = AtomicUSize.constant(0);
static QUIET_DEBUG: AtomicU32 = AtomicU32.constant(0);
static QUIET_INFO: AtomicU32 = AtomicU32.constant(0);
static QUIET_PLAIN: AtomicU32 = AtomicU32.constant(0);
static ALL_DEBUG: AtomicU32 = AtomicU32.constant(0);
static ALL_INFO: AtomicU32 = AtomicU32.constant(0);
static ALL_PLAIN: AtomicU32 = AtomicU32.constant(0);

/// Count one of the test's lines: a DEBUG or an INFO log line that carries the test's mark, or the mark alone.
/// Safety: the console's call, under its lock: `s` points to `len` readable bytes.
@callback
@context(atomic)
unsafe fn countLine(sink: *mut console_sink, s: *CChar, len: usize) {
    let line = Slice.fromRaw(s as *u8, len);
    let quiet = sink as usize == QUIET_SINK.load();
    if (beginsAt(line, TAG, "console-log-floor: ")) {
        if (beginsAt(line, 0, "[DEBUG] ")) {
            if (quiet) { QUIET_DEBUG.fetchAdd(1); } else { ALL_DEBUG.fetchAdd(1); }
        } else if (beginsAt(line, 0, "[ INFO] ")) {
            if (quiet) { QUIET_INFO.fetchAdd(1); } else { ALL_INFO.fetchAdd(1); }
        }
    } else if (beginsAt(line, 0, "console-log-floor: ")) {
        if (quiet) { QUIET_PLAIN.fetchAdd(1); } else { ALL_PLAIN.fetchAdd(1); }
    }
}

/// Safety: `reason` is the runner's; `why` is a zero-terminated literal.
unsafe fn failed(reason: *mut *CChar, why: StringView) -> bool {
    reason.write(why.ptr as *CChar);
    return false;
}

/// console-log-floor: a sink with a floor is given the log lines at or above it and everything that is not a log
/// line; a sink without one is given all of it. Two sinks, the same four writes; then the replay's filter on a text.
/// Safety: the self-test runner's call; `reason` is its.
@export("selftest_console_log_floor")
unsafe fn logFloorTest(reason: *mut *CChar) -> bool {
    var quiet: console_sink;
    var all: console_sink;
    quiet.name = "selftest-floor\0".ptr as *CChar;
    quiet.write = countLine;
    quiet.log_floor = KLOG_INFO;
    all.name = "selftest-nofloor\0".ptr as *CChar;
    all.write = countLine;
    let quietSink = borrow mut quiet as *mut console_sink;
    let allSink = borrow mut all as *mut console_sink;
    QUIET_SINK.store(quietSink as usize);
    QUIET_DEBUG.store(0);
    QUIET_INFO.store(0);
    QUIET_PLAIN.store(0);
    ALL_DEBUG.store(0);
    ALL_INFO.store(0);
    ALL_PLAIN.store(0);

    // A release kernel's log starts at INFO: the test's DEBUG lines must be written to be counted.
    let level = klog_get_level();
    klog_set_level(truncate<u32>(KLOG_DEBUG));
    console_register(quietSink);
    console_register(allSink);
    klog(truncate<u32>(KLOG_DEBUG), "console-log-floor: a line below the floor\0".ptr as *CChar);
    klog(truncate<u32>(KLOG_DEBUG), "console-log-floor: another\0".ptr as *CChar);
    klog(truncate<u32>(KLOG_INFO), "console-log-floor: a line at the floor\0".ptr as *CChar);
    console_puts("console-log-floor: not a log line\n\0".ptr as *CChar);
    console_unregister(allSink);
    console_unregister(quietSink);
    klog_set_level(level);

    klog(
        truncate<u32>(KLOG_INFO),
        "selftest: console-log-floor: the sink with a floor at INFO was given %u DEBUG, %u INFO and %u plain line(s); the sink with none %u, %u and %u\0".ptr as *CChar,
        QUIET_DEBUG.load(), QUIET_INFO.load(), QUIET_PLAIN.load(), ALL_DEBUG.load(), ALL_INFO.load(), ALL_PLAIN.load(),
    );
    if (ALL_DEBUG.load() != 2 || ALL_INFO.load() != 1 || ALL_PLAIN.load() != 1) {
        return failed(reason, "check failed: the sink with no floor was given 2 DEBUG, 1 INFO and 1 plain line\0");
    }
    if (QUIET_DEBUG.load() != 0) {
        return failed(reason, "check failed: the sink with a floor at INFO was given no DEBUG line\0");
    }
    if (QUIET_INFO.load() != 1) {
        return failed(reason, "check failed: the sink with a floor at INFO was given the INFO line\0");
    }
    if (QUIET_PLAIN.load() != 1) {
        return failed(reason, "check failed: the sink with a floor at INFO was given what is not a log line\0");
    }

    // The replay's filter: a ring's text, with the floor at ERROR.
    var text: [u8; 64] = [0; 64];
    let ring = "[ INFO] a\n[ERROR] b\nplain\n[ WARN] c\n[DEBUG] d".bytes();
    var i: usize = 0;
    while (i < ring.length) {
        text[i] = ring[i];
        i += 1;
    }
    let kept = dropHidden(mut text[..ring.length], KLOG_ERROR);
    if (kept != 16 || !beginsAt(text[..kept], 0, "[ERROR] b\nplain\n")) {
        return failed(reason, "check failed: the replay's filter keeps the ERROR line and the plain one\0");
    }
    return true;
}

// ---- The self-test fb-escapes ----

/// Feed ESC and then `s` to `e`: the meaning of the last byte.
fn esc(e: borrow mut fbcon_esc, s: StringView) -> u32 {
    let b = s.bytes();
    var kind = feed(e, 27);
    var i: usize = 0;
    while (i < b.length) {
        kind = feed(e, b[i] as u32);
        i += 1;
    }
    return kind;
}

/// fb-escapes: the escape parser alone, on the sequences a terminal program writes: colours (bold makes the eight
/// bright), a clear, a cursor placed and moved (and kept on the screen), an erase, a private mode read past, an
/// unfinished sequence ended by a newline; and where the replay's last rows start.
/// Safety: the self-test runner's call; `reason` is its.
@export("selftest_fb_escapes")
unsafe fn escapesTest(reason: *mut *CChar) -> bool {
    var e: fbcon_esc;
    reset(borrow mut e);
    if (attr(borrow e) != 0x07) {
        return failed(reason, "check failed: the default attribute is light grey on black (0x07)\0");
    }
    if (esc(borrow mut e, "[1;31m") != FBCON_ESC_NONE || attr(borrow e) != 0x09) {
        return failed(reason, "check failed: ESC [ 1 ; 31 m draws nothing and makes bright red (0x09)\0");
    }
    if (esc(borrow mut e, "[44m") != FBCON_ESC_NONE || attr(borrow e) != 0x49) {
        return failed(reason, "check failed: ESC [ 44 m adds a blue background (0x49)\0");
    }
    if (esc(borrow mut e, "[0m") != FBCON_ESC_NONE || attr(borrow e) != 0x07) {
        return failed(reason, "check failed: ESC [ 0 m restores the default attribute\0");
    }
    if (esc(borrow mut e, "[2J") != FBCON_ESC_CLEAR) {
        return failed(reason, "check failed: ESC [ 2 J clears the screen\0");
    }
    if (esc(borrow mut e, "[5;10H") != FBCON_ESC_MOVE || e.a != 4 || e.n != 9) {
        return failed(reason, "check failed: ESC [ 5 ; 10 H moves to row 4, column 9 (from 0)\0");
    }
    if (place(borrow e, 0, 0, 128, 48) != ((9 as u64 << 32) | 4)) {
        return failed(reason, "check failed: the move places the cursor at column 9, row 4\0");
    }
    if (esc(borrow mut e, "[300C") != FBCON_ESC_REL || place(borrow e, 120, 3, 128, 48) != ((127 as u64 << 32) | 3)) {
        return failed(reason, "check failed: ESC [ 300 C stops at the last column\0");
    }
    if (esc(borrow mut e, "[K") != FBCON_ESC_ERASE) {
        return failed(reason, "check failed: ESC [ K erases to the end of the line\0");
    }
    if (esc(borrow mut e, "[?25l") != FBCON_ESC_NONE || feed(borrow mut e, 120) != FBCON_ESC_PUT) {
        return failed(reason, "check failed: ESC [ ? 25 l is read past and the next byte drawn\0");
    }
    if (esc(borrow mut e, "[1") != FBCON_ESC_NONE || feed(borrow mut e, 10) != FBCON_ESC_PUT ||
        feed(borrow mut e, 65) != FBCON_ESC_PUT) {
        return failed(reason, "check failed: a newline ends an unfinished sequence and is obeyed\0");
    }
    if (tailStart("a\nb\nc".bytes(), 2) != 2 || tailStart("abc".bytes(), 2) != 0) {
        return failed(reason, "check failed: the last two rows of a\\nb\\nc start at b\0");
    }
    return true;
}
